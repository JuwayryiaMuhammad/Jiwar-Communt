# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3100
LOG_LEVEL=debug
# Comma-separated list. Empty = CORS disabled.
CORS_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# Database (see docker/postgres/init.sql)
# ---------------------------------------------------------------------------
# Runtime role: no ownership, no BYPASSRLS. The app never connects as anything else.
DATABASE_URL=postgresql://jiwar_app:jiwar_app_dev@127.0.0.1:5435/jiwar
# Table owner. Used only by the Prisma CLI (migrate) through prisma.config.ts.
MIGRATOR_DATABASE_URL=postgresql://jiwar_migrator:jiwar_migrator_dev@127.0.0.1:5435/jiwar
DB_POOL_MAX=10
# Database-side cap (statement_timeout) on each security event insert, in ms.
SECURITY_EVENT_TIMEOUT_MS=500

# e2e tests run against a separate database in the same container.
TEST_DATABASE_URL=postgresql://jiwar_app:jiwar_app_dev@127.0.0.1:5435/jiwar_test
TEST_MIGRATOR_DATABASE_URL=postgresql://jiwar_migrator:jiwar_migrator_dev@127.0.0.1:5435/jiwar_test
# Superuser on the TEST database, used only by test/ to clear the immutable
# audit tables between runs (ADR 0014). Never used by src/ or prisma/.
TEST_SUPERUSER_DATABASE_URL=postgresql://postgres:postgres_dev@127.0.0.1:5435/jiwar_test

# ---------------------------------------------------------------------------
# Redis (OTP rate limits, login tickets)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6381
# e2e tests use logical database 1 and flush it on start.
TEST_REDIS_URL=redis://127.0.0.1:6381/1

# ---------------------------------------------------------------------------
# Object storage (ADR 0029): any S3 API. Cloudflare R2 in production (values
# in deploy/README.md), MinIO from docker-compose here (console on
# http://localhost:9006); run `pnpm storage:init` once to create the bucket.
# The bucket is private: uploads and reads use presigned URLs.
# ---------------------------------------------------------------------------
# R2: https://<account>.r2.cloudflarestorage.com. Unset = AWS.
S3_ENDPOINT=http://127.0.0.1:9005
# R2: auto
S3_REGION=us-east-1
S3_BUCKET=jiwar
S3_ACCESS_KEY_ID=jiwar_minio
S3_SECRET_ACCESS_KEY=jiwar_minio_dev
# MinIO needs path-style URLs; R2 accepts either.
S3_FORCE_PATH_STYLE=true
# Lifetime of a presigned upload or read URL, at most 3600.
S3_URL_TTL_SECONDS=300
# e2e tests always use this local MinIO and bucket (emptied on start),
# whatever S3_* above points at. The R2 smoke test is the one run that uses
# S3_* above: point them at the R2 dev bucket, then R2_SMOKE=1 pnpm test:r2-smoke.
TEST_S3_ENDPOINT=http://127.0.0.1:9005
TEST_S3_BUCKET=jiwar-test

# ---------------------------------------------------------------------------
# SMTP (Mailpit locally: UI on http://localhost:8025)
# ---------------------------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Jiwar <no-reply@jiwar.local>"

# Email outbox (ADR 0019): non-OTP emails are queued in the transaction of
# the action and delivered by an in-app poller, at least once.
OUTBOX_ENABLED=true
OUTBOX_POLL_MS=5000
OUTBOX_MAX_ATTEMPTS=8
# Sent rows are deleted after this; dead rows lose recipient and params.
OUTBOX_RETENTION_DAYS=30
# Push notifications through Firebase Cloud Messaging (ADR 0041). Leave all
# three empty and push is off: the app says so once at startup, tokens are
# still accepted, nothing is queued or sent. Set all three or none. They are
# `project_id`, `client_email` and `private_key` of the service-account JSON
# from the Firebase console; the key goes on one line with its newlines
# written as \n, exactly as the JSON has it:
#   FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# It is a private key: keep it out of git and out of logs.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
PUSH_ENABLED=true
PUSH_POLL_MS=5000
# A push FCM did not take is retried (30 s, 2 m, 10 m, 30 m) this many times.
PUSH_MAX_ATTEMPTS=5
# In-app sweep (Phase 2.2): majority notices, registration expiry, exports and
# account deletions. Every task is idempotent and safe on several instances.
SWEEP_ENABLED=true
SWEEP_INTERVAL_MS=3600000
# A self-registration nobody decided expires (and loses its personal data).
REGISTRATION_PENDING_DAYS=30
# Account deletion (ADR 0036): the cooling-off, during which the holder can
# undo; then the sweep erases the account, or queues the request for the
# managers when something blocks it.
DELETION_GRACE_DAYS=14
# Read in-app notifications are deleted after this (ADR 0027).
NOTIFICATIONS_RETENTION_DAYS=90
# A worker's photo is deleted once no engagement of theirs has been open for
# this long (ADR 0029).
WORKER_PHOTO_RETENTION_DAYS=90
# The gate (ADR 0028): someone recorded inside this long gets an unconfirmed
# exit; verify attempts allowed per guard per minute.
GATE_UNCONFIRMED_EXIT_HOURS=12
GATE_VERIFY_RATE_LIMIT_PER_MINUTE=30
PARCEL_CODE_RATE_LIMIT_PER_MINUTE=30
# The public web pages (apps/public): a pass's link is
# <PUBLIC_APP_URL>/v#<token> (ADR 0030) and an email's is
# <PUBLIC_APP_URL>/a/<page>#<token> (ADR 0036). Required; https in
# production; no trailing slash.
PUBLIC_APP_URL=http://localhost:3003
# The public visitor page: requests per minute per IP and per link.
VISITOR_PAGE_RATE_LIMIT_PER_IP=60
VISITOR_PAGE_RATE_LIMIT_PER_TOKEN=20
# A registrant's status link (<PUBLIC_APP_URL>/r#<token>, ADR 0062): per IP and per link.
REGISTRATION_STATUS_RATE_LIMIT_PER_IP=30
REGISTRATION_STATUS_RATE_LIMIT_PER_TOKEN=20
# e2e tests always send through Mailpit (these default to 127.0.0.1:1025) and
# read the delivered codes from its API, whatever SMTP_* above points at.
TEST_SMTP_HOST=127.0.0.1
TEST_SMTP_PORT=1025
MAILPIT_API_URL=http://127.0.0.1:8025

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# At least 32 characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# HMAC key for login identifiers and OTP codes. Rotating it invalidates every
# login_identifiers row, so treat it as permanent.
IDENTIFIER_PEPPER=change-me-change-me-change-me-change-me
# Derives every resident's entry secret (ADR 0031). Whoever holds it can forge
# a resident QR in every compound, and rotating it invalidates every entry
# credential (every phone must register again). Must differ from
# IDENTIFIER_PEPPER and from one environment to the next; real values come from
# `openssl rand -base64 48`, never from this file. At least 32 characters.
ENTRY_CREDENTIAL_KEY=change-me-entry-credential-key-change-me-too
# Derives the token behind every parcel code and QR (ADR 0035). Whoever holds
# it and a credential id can compute that credential's code, and rotating it
# strands the codes of the parcels held at the time. Different per
# environment; never equal to IDENTIFIER_PEPPER or ENTRY_CREDENTIAL_KEY (boot
# refuses); real values come from `openssl rand -base64 48`, never from this
# file. At least 32 characters.
PARCEL_TOKEN_KEY=change-me-parcel-token-key-change-me-three
# Keys the opaque references of the community life (ADR 0040): which ballot is
# a unit's while a poll is open, and the marks that count an announcement's
# readers. Without it the database holds no way from a unit to its choice.
# Required: the app refuses to boot without it. Rotating it while a poll is
# open orphans the ballots already cast. Different per environment; never
# equal to IDENTIFIER_PEPPER, ENTRY_CREDENTIAL_KEY or PARCEL_TOKEN_KEY; real
# values come from `openssl rand -base64 48`, never from this file. At least
# 32 characters.
ENGAGEMENT_REF_SECRET=change-me-engagement-ref-secret-change-me-four
# Derives the token behind every visitor pass's code, QR and link (ADR 0043),
# so the host can see them again. Whoever holds it and a pass id can compute
# that pass's code. Required: the app refuses to boot without it. Rotating it
# hides the codes of the passes active at the time (they keep working; the
# host reissues the link to see one again). Different per environment; never
# equal to IDENTIFIER_PEPPER, ENTRY_CREDENTIAL_KEY, PARCEL_TOKEN_KEY or
# ENGAGEMENT_REF_SECRET; real values come from `openssl rand -base64 48`, never
# from this file. At least 32 characters.
VISITOR_PASS_TOKEN_KEY=change-me-visitor-pass-token-key-change-me-five
# Derives the token behind every worker card's code and QR (ADR 0057), so the
# gate's offline bundle can carry what a guard device needs to know a card
# while the server stores only their HMACs. A ring, `ver:key[,ver:key]`, and
# the version new and reissued cards take. Rotating: add `2:<new key>` and set
# the version to 2; printed cards keep the key they were derived with, so a
# key leaves the ring only once no live card uses it. Required: the app
# refuses to boot without it. Different per environment; no key equal to
# another key here; real keys come from `openssl rand -base64 48`, never from
# this file. Each at least 32 characters.
ENGAGEMENT_TOKEN_KEYS=1:change-me-engagement-token-key-change-me-six
ENGAGEMENT_TOKEN_KEY_VERSION=1
# Signs every gate bundle a guard device downloads (ADR 0057): the 32-byte
# seed of an Ed25519 key, base64 (`openssl rand -base64 32`, never from this
# file). Whoever holds it can make a bundle a device trusts. Rotating: raise
# the version, put the old key's PUBLIC half in
# GATE_BUNDLE_PREVIOUS_PUBLIC_KEYS (`ver:key`) for a day, then drop it.
# Required. Different per environment and never equal to another key here.
GATE_BUNDLE_SIGNING_KEY=Y2hhbmdlLW1lLWdhdGUtYnVuZGxlLXNpZ25pbmcta3k=
GATE_BUNDLE_SIGNING_KEY_VERSION=1
GATE_BUNDLE_PREVIOUS_PUBLIC_KEYS=
# ---------------------------------------------------------------------------
# Online payment through each compound's Paymob account (ADR 0046)
# ---------------------------------------------------------------------------
# Seals every compound's Paymob credentials and open checkout secrets
# (AES-256-GCM). Base64 of exactly 32 bytes: `openssl rand -base64 32`, never
# from this file. Optional while no compound takes online payment; once one
# does, the app refuses to boot without it. Different per environment and
# never equal to another key here (boot refuses).
PAYMENT_CREDENTIALS_KEY=
# The version new ciphertexts carry; raise it when the key rotates, and move
# the old key to PAYMENT_CREDENTIALS_PREVIOUS_KEYS as `<version>:<key>`.
PAYMENT_CREDENTIALS_KEY_VERSION=1
PAYMENT_CREDENTIALS_PREVIOUS_KEYS=
# The public HTTPS origin Paymob posts payment results to (no path): see
# deploy/README.md. Required once a compound takes online payment.
PAYMENT_WEBHOOK_BASE_URL=
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_REQUEST_TIMEOUT_MS=15000
PAYMENT_SESSION_TTL_MINUTES=30
RECEIPT_PAGE_RATE_LIMIT_PER_IP=30
# Guard vendor adapters (ADR 0068): fake | off. Unset is fake outside
# production and off in production; fake is refused in production. A real
# vendor's driver reads the compound's credentials from its vault.
GATE_FACE_DRIVER=
GATE_ID_SCAN_DRIVER=
GATE_CALL_DRIVER=
GATE_ALARM_DRIVER=
CONTROL_ROOM_DRIVER=
GATE_VENDOR_TIMEOUT_MS=5000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOGIN_TICKET_TTL_SECONDS=300
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_PER_IDENTIFIER=5
OTP_RATE_LIMIT_PER_IP=20

# ---------------------------------------------------------------------------
# Platform super admin (ADR 0011)
# ---------------------------------------------------------------------------
# Must differ from JWT_ACCESS_SECRET. At least 32 characters.
PLATFORM_JWT_SECRET=change-me-platform-change-me-platform-change-me
# First start only: creates the super admin if none exists (must change the
# password on first login). Never updates an existing admin. In production,
# remove SUPERADMIN_PASSWORD from the environment after the first login.
SUPERADMIN_EMAIL=owner@jiwar.local
SUPERADMIN_PASSWORD=change-me-on-first-login
PLATFORM_LOGIN_MAX_FAILURES=5
PLATFORM_LOCKOUT_SECONDS=900
PLATFORM_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PLATFORM_LOGIN_RATE_LIMIT_PER_IP=20
PLATFORM_LOGIN_RATE_LIMIT_PER_EMAIL=10

# --- development only ---
# Every OTP becomes this code (the email is still sent). Rejected when
# NODE_ENV=production: the app refuses to start.
OTP_FIXED_CODE=123456
