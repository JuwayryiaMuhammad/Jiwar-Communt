# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3100
LOG_LEVEL=debug
# Comma-separated list. Empty = CORS disabled.
CORS_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# Database (see docker/postgres/init.sql)
# ---------------------------------------------------------------------------
# Runtime role: no ownership, no BYPASSRLS. The app never connects as anything else.
DATABASE_URL=postgresql://jiwar_app:jiwar_app_dev@127.0.0.1:5435/jiwar
# Table owner. Used only by the Prisma CLI (migrate) through prisma.config.ts.
MIGRATOR_DATABASE_URL=postgresql://jiwar_migrator:jiwar_migrator_dev@127.0.0.1:5435/jiwar
DB_POOL_MAX=10

# e2e tests run against a separate database in the same container.
TEST_DATABASE_URL=postgresql://jiwar_app:jiwar_app_dev@127.0.0.1:5435/jiwar_test
TEST_MIGRATOR_DATABASE_URL=postgresql://jiwar_migrator:jiwar_migrator_dev@127.0.0.1:5435/jiwar_test

# ---------------------------------------------------------------------------
# Redis (OTP rate limits, login tickets)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6381
# e2e tests use logical database 1 and flush it on start.
TEST_REDIS_URL=redis://127.0.0.1:6381/1

# ---------------------------------------------------------------------------
# SMTP (Mailpit locally: UI on http://localhost:8025)
# ---------------------------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Jiwar <no-reply@jiwar.local>"
# Used by the e2e tests to read delivered codes.
MAILPIT_API_URL=http://127.0.0.1:8025

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# At least 32 characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# HMAC key for login identifiers and OTP codes. Rotating it invalidates every
# login_identifiers row, so treat it as permanent.
IDENTIFIER_PEPPER=change-me-change-me-change-me-change-me
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOGIN_TICKET_TTL_SECONDS=300
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_PER_IDENTIFIER=5
OTP_RATE_LIMIT_PER_IP=20

# --- development only ---
# Every OTP becomes this code (the email is still sent). Rejected when
# NODE_ENV=production: the app refuses to start.
OTP_FIXED_CODE=123456
