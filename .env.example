# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3100
LOG_LEVEL=debug
# Comma-separated list. Empty = CORS disabled.
CORS_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# Database (see docker/postgres/init.sql)
# ---------------------------------------------------------------------------
# Runtime role: no ownership, no BYPASSRLS. The app never connects as anything else.
DATABASE_URL=postgresql://jiwar_app:jiwar_app_dev@127.0.0.1:5435/jiwar
# Table owner. Used only by the Prisma CLI (migrate) through prisma.config.ts.
MIGRATOR_DATABASE_URL=postgresql://jiwar_migrator:jiwar_migrator_dev@127.0.0.1:5435/jiwar
DB_POOL_MAX=10
# Database-side cap (statement_timeout) on each security event insert, in ms.
SECURITY_EVENT_TIMEOUT_MS=500

# e2e tests run against a separate database in the same container.
TEST_DATABASE_URL=postgresql://jiwar_app:jiwar_app_dev@127.0.0.1:5435/jiwar_test
TEST_MIGRATOR_DATABASE_URL=postgresql://jiwar_migrator:jiwar_migrator_dev@127.0.0.1:5435/jiwar_test
# Superuser on the TEST database, used only by test/ to clear the immutable
# audit tables between runs (ADR 0014). Never used by src/ or prisma/.
TEST_SUPERUSER_DATABASE_URL=postgresql://postgres:postgres_dev@127.0.0.1:5435/jiwar_test

# ---------------------------------------------------------------------------
# Redis (OTP rate limits, login tickets)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6381
# e2e tests use logical database 1 and flush it on start.
TEST_REDIS_URL=redis://127.0.0.1:6381/1

# ---------------------------------------------------------------------------
# Object storage (ADR 0029): any S3 API. Cloudflare R2 in production (values
# in deploy/README.md), MinIO from docker-compose here (console on
# http://localhost:9006); run `pnpm storage:init` once to create the bucket.
# The bucket is private: uploads and reads use presigned URLs.
# ---------------------------------------------------------------------------
# R2: https://<account>.r2.cloudflarestorage.com. Unset = AWS.
S3_ENDPOINT=http://127.0.0.1:9005
# R2: auto
S3_REGION=us-east-1
S3_BUCKET=jiwar
S3_ACCESS_KEY_ID=jiwar_minio
S3_SECRET_ACCESS_KEY=jiwar_minio_dev
# MinIO needs path-style URLs; R2 accepts either.
S3_FORCE_PATH_STYLE=true
# Lifetime of a presigned upload or read URL, at most 3600.
S3_URL_TTL_SECONDS=300
# e2e tests always use this local MinIO and bucket (emptied on start),
# whatever S3_* above points at. The R2 smoke test is the one run that uses
# S3_* above: point them at the R2 dev bucket, then R2_SMOKE=1 pnpm test:r2-smoke.
TEST_S3_ENDPOINT=http://127.0.0.1:9005
TEST_S3_BUCKET=jiwar-test

# ---------------------------------------------------------------------------
# SMTP (Mailpit locally: UI on http://localhost:8025)
# ---------------------------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Jiwar <no-reply@jiwar.local>"

# Email outbox (ADR 0019): non-OTP emails are queued in the transaction of
# the action and delivered by an in-app poller, at least once.
OUTBOX_ENABLED=true
OUTBOX_POLL_MS=5000
OUTBOX_MAX_ATTEMPTS=8
# Sent rows are deleted after this; dead rows lose recipient and params.
OUTBOX_RETENTION_DAYS=30
# In-app sweep (Phase 2.2): majority notices, registration expiry, overdue
# erasures. Every task is idempotent and safe on several instances.
SWEEP_ENABLED=true
SWEEP_INTERVAL_MS=3600000
# A self-registration nobody decided expires (and loses its personal data).
REGISTRATION_PENDING_DAYS=30
# Account deletion: the holder can undo for this long; staff are told when an
# erasure waits longer than ERASURE_OVERDUE_DAYS after that.
DELETION_GRACE_DAYS=30
ERASURE_OVERDUE_DAYS=7
# Read in-app notifications are deleted after this (ADR 0027).
NOTIFICATIONS_RETENTION_DAYS=90
# A worker's photo is deleted once no engagement of theirs has been open for
# this long (ADR 0029).
WORKER_PHOTO_RETENTION_DAYS=90
# The gate (ADR 0028): someone recorded inside this long gets an unconfirmed
# exit; verify attempts allowed per guard per minute.
GATE_UNCONFIRMED_EXIT_HOURS=12
GATE_VERIFY_RATE_LIMIT_PER_MINUTE=30
PARCEL_CODE_RATE_LIMIT_PER_MINUTE=30
# The web app visitors open: a pass's link is <PUBLIC_APP_URL>/v#<token>
# (ADR 0030). Required; https in production; no trailing slash.
PUBLIC_APP_URL=http://localhost:5173
# The public visitor page: requests per minute per IP and per link.
VISITOR_PAGE_RATE_LIMIT_PER_IP=60
VISITOR_PAGE_RATE_LIMIT_PER_TOKEN=20
# e2e tests always send through Mailpit (these default to 127.0.0.1:1025) and
# read the delivered codes from its API, whatever SMTP_* above points at.
TEST_SMTP_HOST=127.0.0.1
TEST_SMTP_PORT=1025
MAILPIT_API_URL=http://127.0.0.1:8025

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# At least 32 characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# HMAC key for login identifiers and OTP codes. Rotating it invalidates every
# login_identifiers row, so treat it as permanent.
IDENTIFIER_PEPPER=change-me-change-me-change-me-change-me
# Derives every resident's entry secret (ADR 0031). Whoever holds it can forge
# a resident QR in every compound, and rotating it invalidates every entry
# credential (every phone must register again). Must differ from
# IDENTIFIER_PEPPER and from one environment to the next; real values come from
# `openssl rand -base64 48`, never from this file. At least 32 characters.
ENTRY_CREDENTIAL_KEY=change-me-entry-credential-key-change-me-too
# Derives the token behind every parcel code and QR (ADR 0035). Whoever holds
# it and a credential id can compute that credential's code, and rotating it
# strands the codes of the parcels held at the time. Different per
# environment; never equal to IDENTIFIER_PEPPER or ENTRY_CREDENTIAL_KEY (boot
# refuses); real values come from `openssl rand -base64 48`, never from this
# file. At least 32 characters.
PARCEL_TOKEN_KEY=change-me-parcel-token-key-change-me-three
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOGIN_TICKET_TTL_SECONDS=300
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_PER_IDENTIFIER=5
OTP_RATE_LIMIT_PER_IP=20

# ---------------------------------------------------------------------------
# Platform super admin (ADR 0011)
# ---------------------------------------------------------------------------
# Must differ from JWT_ACCESS_SECRET. At least 32 characters.
PLATFORM_JWT_SECRET=change-me-platform-change-me-platform-change-me
# First start only: creates the super admin if none exists (must change the
# password on first login). Never updates an existing admin. In production,
# remove SUPERADMIN_PASSWORD from the environment after the first login.
SUPERADMIN_EMAIL=owner@jiwar.local
SUPERADMIN_PASSWORD=change-me-on-first-login
PLATFORM_LOGIN_MAX_FAILURES=5
PLATFORM_LOCKOUT_SECONDS=900
PLATFORM_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PLATFORM_LOGIN_RATE_LIMIT_PER_IP=20
PLATFORM_LOGIN_RATE_LIMIT_PER_EMAIL=10

# --- development only ---
# Every OTP becomes this code (the email is still sent). Rejected when
# NODE_ENV=production: the app refuses to start.
OTP_FIXED_CODE=123456
