# Backend origin, without /api/v1. Read on the server only (the proxy under
# /api); the browser never talks to the backend directly.
JIWAR_API_URL=http://localhost:3100

# Storage's origin as the browser sees it (scheme, host, port; no path), the
# host of the URLs the API signs. Only the registrant's status page (/rs)
# may connect to it, to upload a document. Unset: that page cannot upload.
UPLOAD_ORIGIN=http://127.0.0.1:9005
