{
  "components": {
    "schemas": {
      "AccountStatus": {
        "enum": [
          "active",
          "inactive",
          "frozen",
          "erased"
        ],
        "type": "string"
      },
      "AccountType": {
        "enum": [
          "resident",
          "staff",
          "manager",
          "family"
        ],
        "type": "string"
      },
      "AuditActorType": {
        "enum": [
          "account",
          "platform_admin",
          "system"
        ],
        "type": "string"
      },
      "ChangePasswordDto": {
        "properties": {
          "currentPassword": {
            "maxLength": 200,
            "type": "string"
          },
          "newPassword": {
            "description": "At least 12 characters (checked by the service).",
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "CreateAccountDto": {
        "properties": {
          "birthDate": {
            "description": "Required for a passport, ignored for a national ID.",
            "format": "date",
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "fullName": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "idDocumentNumber": {
            "description": "14-digit national ID, or a passport number.",
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "idDocumentType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IdDocumentType"
              }
            ]
          },
          "nationality": {
            "description": "ISO 3166-1 alpha-2; required for a passport.",
            "type": "string"
          },
          "phone": {
            "description": "Local Egyptian format, or international with `+`; stored as E.164.",
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountType"
              }
            ]
          }
        },
        "required": [
          "type",
          "fullName",
          "idDocumentType",
          "idDocumentNumber",
          "phone",
          "email"
        ],
        "type": "object"
      },
      "CreateTenantDto": {
        "properties": {
          "manager": {
            "$ref": "#/components/schemas/NewManagerDto"
          },
          "name": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          }
        },
        "required": [
          "name",
          "manager"
        ],
        "type": "object"
      },
      "CreateUnitDto": {
        "properties": {
          "building": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "code": {
            "description": "Unit code, unique within the compound, e.g. `B2-104`.",
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "floor": {
            "maximum": 200,
            "minimum": -5,
            "type": "number"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "IdDocumentType": {
        "enum": [
          "national_id",
          "passport"
        ],
        "type": "string"
      },
      "Locale": {
        "enum": [
          "ar",
          "en"
        ],
        "type": "string"
      },
      "LoginAccountView": {
        "properties": {
          "accountId": {
            "format": "uuid",
            "type": "string"
          },
          "accountType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountType"
              }
            ]
          },
          "tenantName": {
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "tenantName",
          "accountType"
        ],
        "type": "object"
      },
      "ManagerView": {
        "properties": {
          "email": {
            "nullable": true,
            "type": "string"
          },
          "erased": {
            "description": "Only on an erased account, which has no other field.",
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "fullName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "phone": {
            "description": "Null while frozen.",
            "nullable": true,
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountStatus"
              }
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "NewManagerDto": {
        "properties": {
          "birthDate": {
            "description": "Required for a passport, ignored for a national ID.",
            "format": "date",
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "fullName": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "idDocumentNumber": {
            "description": "14-digit national ID, or a passport number.",
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "idDocumentType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IdDocumentType"
              }
            ]
          },
          "nationality": {
            "description": "ISO 3166-1 alpha-2; required for a passport.",
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "preferredLocale": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Locale"
              }
            ]
          }
        },
        "required": [
          "idDocumentType",
          "idDocumentNumber",
          "fullName",
          "phone",
          "email"
        ],
        "type": "object"
      },
      "OtpRequestedView": {
        "properties": {
          "code": {
            "description": "Stable key for the frontend to translate.",
            "enum": [
              "OTP_REQUESTED"
            ],
            "type": "string"
          },
          "message": {
            "description": "English, for developers only.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "OtpVerifiedView": {
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/LoginAccountView"
            },
            "type": "array"
          },
          "loginTicket": {
            "description": "Single use, short-lived. Exchange it with POST /auth/select-account.",
            "type": "string"
          }
        },
        "required": [
          "loginTicket",
          "accounts"
        ],
        "type": "object"
      },
      "PlatformAuditEntryView": {
        "properties": {
          "action": {
            "type": "string"
          },
          "actorId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "actorType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AuditActorType"
              }
            ]
          },
          "changes": {
            "description": "Changed fields; personal values are `{ changed: true }`.",
            "nullable": true,
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "ip": {
            "nullable": true,
            "type": "string"
          },
          "metadata": {
            "description": "Codes and counts only; never personal data.",
            "nullable": true,
            "type": "object"
          },
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "requestId": {
            "nullable": true,
            "type": "string"
          },
          "targetId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "targetTenantId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "targetType": {
            "type": "string"
          },
          "userAgent": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "occurredAt",
          "actorType",
          "actorId",
          "action",
          "targetType",
          "targetId",
          "changes",
          "metadata",
          "requestId",
          "targetTenantId",
          "ip",
          "userAgent"
        ],
        "type": "object"
      },
      "PlatformAuditEntryViewList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/PlatformAuditEntryView"
            },
            "type": "array"
          },
          "nextCursor": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "data",
          "nextCursor"
        ],
        "type": "object"
      },
      "PlatformLoginDto": {
        "properties": {
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "PlatformRefreshDto": {
        "properties": {
          "refreshToken": {
            "maxLength": 200,
            "minLength": 20,
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "PlatformTokensView": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "description": "seconds",
            "type": "number"
          },
          "refreshToken": {
            "description": "Full scope only.",
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "scope": {
            "description": "`password_change`: only POST /platform/auth/change-password accepts this token.",
            "enum": [
              "full",
              "password_change"
            ],
            "type": "string"
          }
        },
        "required": [
          "scope",
          "accessToken",
          "accessTokenExpiresIn"
        ],
        "type": "object"
      },
      "RefreshTokenDto": {
        "properties": {
          "refreshToken": {
            "maxLength": 200,
            "minLength": 20,
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "RequestOtpDto": {
        "properties": {
          "identifier": {
            "description": "Email or phone (local Egyptian format or international).",
            "maxLength": 254,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "identifier"
        ],
        "type": "object"
      },
      "SecurityEventView": {
        "properties": {
          "accountId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "identifierHash": {
            "description": "HMAC of the login identifier; never the email or phone.",
            "nullable": true,
            "type": "string"
          },
          "ip": {
            "nullable": true,
            "type": "string"
          },
          "metadata": {
            "nullable": true,
            "type": "object"
          },
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "platformAdminId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "requestId": {
            "nullable": true,
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "userAgent": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "occurredAt",
          "event",
          "identifierHash",
          "accountId",
          "tenantId",
          "platformAdminId",
          "ip",
          "userAgent",
          "requestId",
          "metadata"
        ],
        "type": "object"
      },
      "SecurityEventViewList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/SecurityEventView"
            },
            "type": "array"
          },
          "nextCursor": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "data",
          "nextCursor"
        ],
        "type": "object"
      },
      "SelectAccountDto": {
        "properties": {
          "accountId": {
            "format": "uuid",
            "type": "string"
          },
          "loginTicket": {
            "maxLength": 200,
            "minLength": 20,
            "type": "string"
          }
        },
        "required": [
          "loginTicket",
          "accountId"
        ],
        "type": "object"
      },
      "TenantDetailView": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "managers": {
            "items": {
              "$ref": "#/components/schemas/ManagerView"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TenantStatus"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "createdAt",
          "managers"
        ],
        "type": "object"
      },
      "TenantStatus": {
        "enum": [
          "active",
          "suspended"
        ],
        "type": "string"
      },
      "TenantStatusDto": {
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TenantStatus"
              }
            ]
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "TenantView": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TenantStatus"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "createdAt"
        ],
        "type": "object"
      },
      "TenantViewList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/TenantView"
            },
            "type": "array"
          },
          "nextCursor": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "data",
          "nextCursor"
        ],
        "type": "object"
      },
      "TokensView": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "description": "seconds",
            "type": "number"
          },
          "accountId": {
            "format": "uuid",
            "type": "string"
          },
          "accountType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountType"
              }
            ]
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "refreshTokenExpiresAt",
          "accountId",
          "accountType"
        ],
        "type": "object"
      },
      "UpdateAccountStatusDto": {
        "properties": {
          "status": {
            "enum": [
              "active",
              "inactive"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "VerifyOtpDto": {
        "properties": {
          "code": {
            "pattern": "^\\d{6}$",
            "type": "string"
          },
          "identifier": {
            "maxLength": 254,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "code"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
