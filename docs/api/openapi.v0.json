{
  "components": {
    "schemas": {
      "AccountStatus": {
        "enum": [
          "active",
          "inactive",
          "frozen",
          "erased"
        ],
        "type": "string"
      },
      "AccountType": {
        "enum": [
          "resident",
          "staff",
          "manager",
          "family"
        ],
        "type": "string"
      },
      "CreateAccountDto": {
        "properties": {
          "birthDate": {
            "description": "Required for a passport, ignored for a national ID.",
            "format": "date",
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "fullName": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "idDocumentNumber": {
            "description": "14-digit national ID, or a passport number.",
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "idDocumentType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IdDocumentType"
              }
            ]
          },
          "nationality": {
            "description": "ISO 3166-1 alpha-2; required for a passport.",
            "type": "string"
          },
          "phone": {
            "description": "Local Egyptian format, or international with `+`; stored as E.164.",
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountType"
              }
            ]
          }
        },
        "required": [
          "type",
          "fullName",
          "idDocumentType",
          "idDocumentNumber",
          "phone",
          "email"
        ],
        "type": "object"
      },
      "CreateUnitDto": {
        "properties": {
          "building": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "code": {
            "description": "Unit code, unique within the compound, e.g. `B2-104`.",
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "floor": {
            "maximum": 200,
            "minimum": -5,
            "type": "number"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "IdDocumentType": {
        "enum": [
          "national_id",
          "passport"
        ],
        "type": "string"
      },
      "LoginAccountView": {
        "properties": {
          "accountId": {
            "format": "uuid",
            "type": "string"
          },
          "accountType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountType"
              }
            ]
          },
          "tenantName": {
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "tenantName",
          "accountType"
        ],
        "type": "object"
      },
      "OtpRequestedView": {
        "properties": {
          "code": {
            "description": "Stable key for the frontend to translate.",
            "enum": [
              "OTP_REQUESTED"
            ],
            "type": "string"
          },
          "message": {
            "description": "English, for developers only.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "OtpVerifiedView": {
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/LoginAccountView"
            },
            "type": "array"
          },
          "loginTicket": {
            "description": "Single use, short-lived. Exchange it with POST /auth/select-account.",
            "type": "string"
          }
        },
        "required": [
          "loginTicket",
          "accounts"
        ],
        "type": "object"
      },
      "RefreshTokenDto": {
        "properties": {
          "refreshToken": {
            "maxLength": 200,
            "minLength": 20,
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "RequestOtpDto": {
        "properties": {
          "identifier": {
            "description": "Email or phone (local Egyptian format or international).",
            "maxLength": 254,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "identifier"
        ],
        "type": "object"
      },
      "SelectAccountDto": {
        "properties": {
          "accountId": {
            "format": "uuid",
            "type": "string"
          },
          "loginTicket": {
            "maxLength": 200,
            "minLength": 20,
            "type": "string"
          }
        },
        "required": [
          "loginTicket",
          "accountId"
        ],
        "type": "object"
      },
      "TokensView": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "description": "seconds",
            "type": "number"
          },
          "accountId": {
            "format": "uuid",
            "type": "string"
          },
          "accountType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountType"
              }
            ]
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "refreshTokenExpiresAt",
          "accountId",
          "accountType"
        ],
        "type": "object"
      },
      "UpdateAccountStatusDto": {
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountStatus"
              }
            ]
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "VerifyOtpDto": {
        "properties": {
          "code": {
            "pattern": "^\\d{6}$",
            "type": "string"
          },
          "identifier": {
            "maxLength": 254,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "code"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
