generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// Conventions (ADR 0005, 0006):
// - ids are UUIDv7 generated by the app: no @default on `id`.
// - timestamps are timestamptz.
// - GLOBAL tables have no RLS and are reached only through GlobalDbService.
// - TENANT tables carry tenant_id and are protected by RLS + FORCE; the
//   policies live in the migration SQL because Prisma cannot express them.

// ============================================================================
// ENUMS
// ============================================================================

enum TenantStatus {
  active
  suspended

  @@map("tenant_status")
}

enum AccountType {
  resident
  staff
  manager

  @@map("account_type")
}

enum AccountStatus {
  active
  inactive

  @@map("account_status")
}

enum IdentifierType {
  email
  phone

  @@map("identifier_type")
}

// ============================================================================
// GLOBAL — no RLS
// ============================================================================

/// One tenant = one compound (ADR 0001).
model Tenant {
  id        String       @id @db.Uuid
  name      String
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  accounts         Account[]
  units            Unit[]
  loginIdentifiers LoginIdentifier[]

  @@map("tenants")
}

/// Global login lookup: identifier → accounts, across tenants. No PII: the
/// identifier is stored only as HMAC-SHA256(IDENTIFIER_PEPPER, "<type>:<value>").
/// `status` and `account_type` mirror the account so the login bootstrap never
/// has to read tenant data to decide what to offer.
model LoginIdentifier {
  identifierHash String         @map("identifier_hash") @db.Char(64)
  identifierType IdentifierType @map("identifier_type")
  accountId      String         @map("account_id") @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  accountType    AccountType    @map("account_type")
  status         AccountStatus
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@id([identifierHash, accountId])
  @@index([accountId])
  @@map("login_identifiers")
}

/// One row per (request, destination email). A code unlocks only the
/// accounts in `account_ids` — the ones behind the email it was sent to.
model OtpChallenge {
  id             String    @id @db.Uuid
  identifierHash String    @map("identifier_hash") @db.Char(64)
  accountIds     String[]  @map("account_ids") @db.Uuid
  codeHash       String    @map("code_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt  DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifierHash])
  @@map("otp_challenges")
}

model Session {
  id               String    @id @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)

  @@index([accountId])
  @@map("sessions")
}

// ============================================================================
// TENANT-SCOPED — RLS + FORCE (policy in the migration)
// ============================================================================

/// Separate per capacity (ADR 0002): the same phone/email may exist once per
/// account type within a tenant, and freely across tenants.
model Account {
  id         String        @id @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  type       AccountType
  fullName   String        @map("full_name")
  nationalId String        @map("national_id")
  /// E.164
  phone      String
  /// trimmed + lowercased
  email      String
  status     AccountStatus @default(active)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  loginIdentifiers LoginIdentifier[]

  @@unique([tenantId, type, email])
  @@unique([tenantId, type, phone])
  @@map("accounts")
}

model Unit {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  building  String?
  floor     Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("units")
}
