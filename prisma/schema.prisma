/// Per-tenant copy of a role (ADR 0010). System roles are identified by `key`
/// and have no `name` (ADR 0013); `name` is for future custom roles.
model Role {
  id                 String      @id @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  key                String
  name               String?
  kind               AccountType
  isSystem           Boolean     @default(false) @map("is_system")
  /// Bumped in the same transaction as every permission change; part of the
  /// permission cache key, so a stale cache entry is never read again.
  permissionsVersion Int         @default(1) @map("permissions_version")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  ownedTopics ManagementRequestTopic[]
  accounts    Account[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@unique([tenantId, id, kind])
  @@map("roles")
}

model RolePermission {
  tenantId   String @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onUpdate: Restrict)

  @@id([roleId, permission])
  @@index([tenantId])
  @@map("role_permissions")
}

/// Which code permissions this tenant has already been offered (ADR 0010).
/// A permission listed here is never re-added by `access:sync`.
model TenantPermissionCatalog {
  tenantId    String   @map("tenant_id") @db.Uuid
  permission  String
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, permission])
  @@map("tenant_permission_catalog")
}

model Unit {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  code        String
  building    String?
  floor       Int?
  /// Closed-unit mode (ADR 0020), set by the owner-resident primary.
  closedSince DateTime? @map("closed_since") @db.Timestamptz(3)
  /// Filled progressively (activation card); the manager's value wins.
  unitType    UnitType? @map("unit_type")
  areaSqm     Decimal?  @map("area_sqm") @db.Decimal(8, 2)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                     Tenant                    @relation(fields: [tenantId], references: [id])
  occupancies                UnitOccupancy[]
  householdMembers           HouseholdMember[]
  householdInvites           HouseholdInvite[]
  delegations                HouseholdDelegation[]
  workerEngagements          WorkerEngagement[]
  reviewFlags                UnitReviewFlag[]
  deferredActions            HouseholdDeferredAction[]
  visitorPasses              VisitorPass[]
  gateInstructions           UnitGateInstruction[]
  standingInstructions       UnitStandingInstruction[]
  gateRequests               GateApprovalRequest[]
  tickets                    Ticket[]
  parcels                    Parcel[]
  managementRequests         ManagementRequest[]
  eventRsvps                 EventRsvp[]
  pollParticipations         PollParticipation[]
  suggestions                Suggestion[]
  neighbourComplaintsFrom    NeighbourComplaint[]      @relation("NeighbourComplaintAuthorUnit")
  neighbourComplaintsAgainst NeighbourComplaint[]      @relation("NeighbourComplaintTargetUnit")
  neighbourPosts             NeighbourPost[]
  neighbourConversations     NeighbourConversation[]
  neighbourWelcomes          NeighbourWelcome[]
  bookings                   Booking[]
  bookingSuspensions         BookingSuspension[]
  clubMembership             ClubMembership?
  invoiceBatches             InvoiceBatch[]
  invoices                   Invoice[]
  instalmentPlans            InstalmentPlan[]
  invoiceDisputes            InvoiceDispute[]
  financeRefunds             FinanceRefund[]
  billingPlanOverrides       BillingPlanOverride[]
  financePayments            FinancePayment[]
  paymentSessions            PaymentSession[]
  fieldExceptions        GateFieldException[]
  overstayAlerts         VisitOverstayAlert[]
  serviceVehicles        ServiceVehicleVisit[]

  documents UnitDocument[]
  contracts UnitContract[]
  clearances FinanceClearance[]
  deposits FinanceDeposit[]
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("units")
}

/// Resident ↔ unit (ADR 0012). Never deleted: ending sets status + ended_at.
/// One active occupancy per (unit, account): partial unique index in SQL.
model UnitOccupancy {
  id              String              @id @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  unitId          String              @map("unit_id") @db.Uuid
  accountId       String              @map("account_id") @db.Uuid
  occupancyType   OccupancyType       @map("occupancy_type")
  status          OccupancyStatus     @default(active)
  /// One per unit among active occupancies (partial unique index in SQL).
  isPrimary       Boolean             @default(false) @map("is_primary")
  startedAt       DateTime            @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime?           @map("ended_at") @db.Timestamptz(3)
  createdById     String              @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Capacity (ADR 0020): an owner who does not live there is a landlord.
  /// A tenant always resides; a landlord is never primary (CHECKs).
  resides         Boolean             @default(true)
  endReason       OccupancyEndReason? @map("end_reason")
  /// Shown to the person; erasable, never in the audit trail.
  endNote         String?             @map("end_note")
  /// Tenant → owner conversion keeps the history as two rows.
  convertedFromId String?             @map("converted_from_id") @db.Uuid
  /// Set while primary; the new primary reviews members added before it.
  primarySince    DateTime?           @map("primary_since") @db.Timestamptz(3)
  /// After leaving: emergency stays visible until the unit is handed over.
  handedOverAt    DateTime?           @map("handed_over_at") @db.Timestamptz(3)

  unit          Unit                   @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  account       Account                @relation("OccupancyAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  createdBy     Account                @relation("OccupancyCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onUpdate: Restrict)
  convertedFrom UnitOccupancy?         @relation("OccupancyConversion", fields: [tenantId, convertedFromId], references: [tenantId, id], onUpdate: Restrict)
  convertedTo   UnitOccupancy[]        @relation("OccupancyConversion")
  registration  ResidentRegistration[]

  neighbourWelcome NeighbourWelcome?
  clubCoverage     ClubMembershipPerson[]

  documents UnitDocument[]
  contractParties UnitContractParty[]
  contractRenewals ContractRenewal[]
  clearances FinanceClearance[]
  deposits FinanceDeposit[]
  @@unique([tenantId, id])
  @@index([tenantId, accountId])
  @@index([tenantId, unitId])
  @@map("unit_occupancies")
}

/// One row per compound (ADR 0016), created with the compound.
model TenantSettings {
  tenantId                   String   @id @map("tenant_id") @db.Uuid
  familyJoinRequiresApproval Boolean  @default(false) @map("family_join_requires_approval")
  /// off | optional | required (CHECK): proof of kinship on an invite (ADR 0062).
  familyKinshipProof         String   @default("optional") @map("family_kinship_proof")
  /// What a lease's renewal and a move-out cost, EGP (ADR 0062); invoiced by the management.
  renewalFee                 Decimal? @map("renewal_fee") @db.Decimal(12, 2)
  moveOutFee                 Decimal? @map("move_out_fee") @db.Decimal(12, 2)
  maxHouseholdMembers        Int      @default(10) @map("max_household_members")
  /// IANA time zone for schedules (ADR 0017).
  timezone                   String   @default("Africa/Cairo")
  /// Active visitor passes per unit (ADR 0028).
  maxActiveVisitorPasses     Int      @default(50) @map("max_active_visitor_passes")
  /// How long a household has to answer the gate before its instruction applies.
  gateRequestTimeoutSeconds  Int      @default(180) @map("gate_request_timeout_seconds")
  /// Free text the compound writes for its visitors (the public page, ADR 0030).
  visitorDirections          String?  @map("visitor_directions")
  /// E.164; on the visitor page and the worker card.
  emergencyPhone             String?  @map("emergency_phone")
  /// E.164 (ADR 0047): the community office, in a unit's emergency contacts.
  officePhone                String?  @map("office_phone")
  /// E.164 (ADR 0047): the duty manager; also a staff responder's phone.
  dutyPhone                  String?  @map("duty_phone")
  /// Whether households may write `always_allow` instructions (ADR 0043).
  allowAlwaysAllow           Boolean  @default(true) @map("allow_always_allow")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

/// A unit's household (ADR 0016). Adults have a `family` account and their
/// personal data lives there; minors have no account, so their name and
/// national ID live here (CHECK in SQL). Never deleted: removal is a status.
model HouseholdMember {
  id                    String                @id @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  unitId                String                @map("unit_id") @db.Uuid
  accountId             String?               @map("account_id") @db.Uuid
  relation              HouseholdRelation
  isMinor               Boolean               @map("is_minor")
  fullName              String?               @map("full_name")
  idDocumentNumber      String?               @map("id_document_number")
  idDocumentType        IdDocumentType?       @map("id_document_type")
  nationality           String?               @db.Char(2)
  birthDate             DateTime              @map("birth_date") @db.Date
  status                HouseholdMemberStatus
  addedById             String                @map("added_by") @db.Uuid
  removedById           String?               @map("removed_by") @db.Uuid
  removedReason         String?               @map("removed_reason")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt             DateTime?             @map("removed_at") @db.Timestamptz(3)
  /// The primary confirmed this member's permissions (ADR 0021); earlier
  /// than the primary's `primary_since` means "to review".
  permissionsReviewedAt DateTime?             @map("permissions_reviewed_at") @db.Timestamptz(3)
  /// The sweep told the primary this minor reached 18 (once).
  majorityNotifiedAt    DateTime?             @map("majority_notified_at") @db.Timestamptz(3)

  unit      Unit     @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  account   Account? @relation("MemberAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  addedBy   Account  @relation("MemberAddedBy", fields: [tenantId, addedById], references: [tenantId, id], onUpdate: Restrict)
  removedBy Account? @relation("MemberRemovedBy", fields: [tenantId, removedById], references: [tenantId, id], onUpdate: Restrict)

  grants          HouseholdMemberGrant[]
  majorityInvites HouseholdInvite[]
  deferredActions HouseholdDeferredAction[]
  clubCoverage    ClubMembershipPerson[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, isMinor])
  @@unique([tenantId, id, unitId, isMinor])
  @@index([tenantId, unitId])
  @@index([tenantId, accountId])
  @@map("household_members")
}

/// An invitation for an adult to join a unit's household (ADR 0016). The raw
/// token is shown once to the inviter; only its HMAC is stored.
model HouseholdInvite {
  id                String                @id @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  unitId            String                @map("unit_id") @db.Uuid
  invitedById       String                @map("invited_by") @db.Uuid
  /// Personal fields are NULL only once stripped (the invitee was erased).
  fullName          String?               @map("full_name")
  /// E.164
  phone             String?
  /// trimmed + lowercased; the acceptance code goes here and nowhere else
  email             String?
  idDocumentNumber  String?               @map("id_document_number")
  idDocumentType    IdDocumentType?       @default(national_id) @map("id_document_type")
  nationality       String?               @default("EG") @db.Char(2)
  birthDate         DateTime?             @map("birth_date") @db.Date
  relation          HouseholdRelation
  tokenHash         String                @unique @map("token_hash") @db.Char(64)
  expiresAt         DateTime              @map("expires_at") @db.Timestamptz(3)
  status            HouseholdInviteStatus @default(pending)
  acceptedAccountId String?               @map("accepted_account_id") @db.Uuid
  /// A majority invite: the minor member this invite turns into an adult.
  memberId          String?               @map("member_id") @db.Uuid
  strippedAt        DateTime?             @map("stripped_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  unit            Unit             @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  invitedBy       Account          @relation("InviteInvitedBy", fields: [tenantId, invitedById], references: [tenantId, id], onUpdate: Restrict)
  acceptedAccount Account?         @relation("InviteAcceptedAccount", fields: [tenantId, acceptedAccountId], references: [tenantId, id], onUpdate: Restrict)
  member          HouseholdMember? @relation(fields: [tenantId, memberId], references: [tenantId, id], onUpdate: Restrict)
  documents       HouseholdInviteDocument[]

  @@index([tenantId, unitId])
  @@unique([tenantId, id])
  @@map("household_invites")
}

/// Primary resident → adult household member, for a limited time and scope
/// (ADR 0016). Ended by revocation or automatically; never deleted.
model HouseholdDelegation {
  id                 String               @id @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  unitId             String               @map("unit_id") @db.Uuid
  delegatorAccountId String               @map("delegator_account_id") @db.Uuid
  delegateAccountId  String               @map("delegate_account_id") @db.Uuid
  scopes             DelegationScope[]
  expiresAt          DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt          DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokedById        String?              @map("revoked_by") @db.Uuid
  endReason          DelegationEndReason? @map("end_reason")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  unit      Unit     @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  delegator Account  @relation("DelegationDelegator", fields: [tenantId, delegatorAccountId], references: [tenantId, id], onUpdate: Restrict)
  delegate  Account  @relation("DelegationDelegate", fields: [tenantId, delegateAccountId], references: [tenantId, id], onUpdate: Restrict)
  revokedBy Account? @relation("DelegationRevokedBy", fields: [tenantId, revokedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, unitId])
  @@index([tenantId, delegateAccountId])
  @@map("household_delegations")
}

/// A domestic worker known to the compound (ADR 0017). No account, no login.
/// One record per person per compound, found by the national-ID HMAC.
model DomesticWorker {
  id                    String         @id @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  /// National ID: HMAC(pepper, "worker-national-id:<id>");
  /// passport: HMAC(pepper, "passport:<nationality>:<number>") (ADR 0018).
  idDocumentHash        String         @map("id_document_hash") @db.Char(64)
  idDocumentNumber      String         @map("id_document_number")
  idDocumentType        IdDocumentType @default(national_id) @map("id_document_type")
  nationality           String         @default("EG") @db.Char(2)
  fullName              String         @map("full_name")
  /// E.164
  phone                 String
  birthDate             DateTime       @map("birth_date") @db.Date
  /// Passport workers: a manager attests the entered birth date once
  /// (ADR 0018). Cleared when the date is corrected.
  birthDateVerifiedById String?        @map("birth_date_verified_by") @db.Uuid
  birthDateVerifiedAt   DateTime?      @map("birth_date_verified_at") @db.Timestamptz(3)
  preferredLanguage     String         @default("ar") @map("preferred_language")
  /// The worker's photo (ADR 0029): a file attached to this record.
  photoFileId           String?        @map("photo_file_id") @db.Uuid
  bannedAt              DateTime?      @map("banned_at") @db.Timestamptz(3)
  bannedById            String?        @map("banned_by") @db.Uuid
  banReason             String?        @map("ban_reason")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  bannedBy            Account?               @relation("WorkerBannedBy", fields: [tenantId, bannedById], references: [tenantId, id], onUpdate: Restrict)
  birthDateVerifiedBy Account?               @relation("WorkerBirthDateVerifiedBy", fields: [tenantId, birthDateVerifiedById], references: [tenantId, id], onUpdate: Restrict)
  photo               StoredFile?            @relation("WorkerPhoto", fields: [tenantId, photoFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  engagements         WorkerEngagement[]
  notices             WorkerNotice[]
  obligations         WorkerWageObligation[]
  complianceCases     WorkerComplianceCase[]
  cardIncidents       WorkerCardIncident[]

  @@unique([tenantId, idDocumentHash])
  @@unique([tenantId, id])
  @@map("domestic_workers")
}

/// A worker serving one unit (ADR 0017). The access code is stored only as
/// an HMAC; it works only while the engagement is `active`.
model WorkerEngagement {
  id                    String                 @id @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  workerId              String                 @map("worker_id") @db.Uuid
  unitId                String                 @map("unit_id") @db.Uuid
  requestedById         String                 @map("requested_by") @db.Uuid
  capacity              WorkerCapacity
  /// { days: (0–6)[], windows: [{ from: "HH:MM", to: "HH:MM" }] }; empty for live-in
  schedule              Json
  validUntil            DateTime?              @map("valid_until") @db.Timestamptz(3)
  status                WorkerEngagementStatus @default(pending_review)
  statusReason          String?                @map("status_reason")
  suspendedByManagement Boolean                @default(false) @map("suspended_by_management")
  /// HMAC(IDENTIFIER_PEPPER, "worker-code:<tenantId>:<code>")
  accessCodeHash        String?                @map("access_code_hash") @db.Char(64)
  /// HMAC(IDENTIFIER_PEPPER, "qr:<tenantId>:<token>"): the card's QR (ADR 0030).
  /// NULL on engagements whose code predates 4.1.
  qrTokenHash           String?                @map("qr_token_hash") @db.Char(64)
  codeIssuedAt          DateTime?              @map("code_issued_at") @db.Timestamptz(3)
  /// The card's derivation (ADR 0057): its number and key version, both or
  /// neither (a card issued before is random).
  tokenSeq              Int?                   @map("token_seq")
  tokenKeyVersion       Int?                   @map("token_key_version") @db.SmallInt
  reviewedById          String?                @map("reviewed_by") @db.Uuid
  /// What the household agreed to pay a month (ADR 0037); null until set.
  monthlyWage           Decimal?               @map("monthly_wage") @db.Decimal(10, 2)
  /// When a review decided it, and a rejection's code (ADR 0059).
  decidedAt             DateTime?              @map("decided_at") @db.Timestamptz(3)
  rejectReason          String?                @map("reject_reason")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  worker          DomesticWorker         @relation(fields: [tenantId, workerId], references: [tenantId, id], onUpdate: Restrict)
  unit            Unit                   @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  requestedBy     Account                @relation("EngagementRequestedBy", fields: [tenantId, requestedById], references: [tenantId, id], onUpdate: Restrict)
  reviewedBy      Account?               @relation("EngagementReviewedBy", fields: [tenantId, reviewedById], references: [tenantId, id], onUpdate: Restrict)
  notices         WorkerNotice[]
  obligations     WorkerWageObligation[]
  cardIncidents   WorkerCardIncident[]
  gateRequests    GateApprovalRequest[]
  visitReceptions TicketVisit[]
  fieldExceptions        GateFieldException[]

  @@unique([tenantId, id])
  @@index([tenantId, unitId])
  @@index([tenantId, workerId])
  @@map("worker_engagements")
}

/// What a worker must be told (ADR 0017). Written in the transaction of the
/// change that causes it; a future SMS/WhatsApp channel sends them.
model WorkerNotice {
  id           String             @id @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  workerId     String             @map("worker_id") @db.Uuid
  engagementId String             @map("engagement_id") @db.Uuid
  noticeKey    String             @map("notice_key")
  params       Json
  status       WorkerNoticeStatus @default(pending)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  worker     DomesticWorker   @relation(fields: [tenantId, workerId], references: [tenantId, id], onUpdate: Restrict)
  engagement WorkerEngagement @relation(fields: [tenantId, engagementId], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, engagementId])
  @@map("worker_notices")
}

/// A reason a unit is under review (ADR 0021). One open row per reason
/// (partial unique index); cleared rows stay as history. Never deleted.
model UnitReviewFlag {
  id              String           @id @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  unitId          String           @map("unit_id") @db.Uuid
  reason          UnitReviewReason
  reasonCode      String?          @map("reason_code")
  /// Managers only: never shown to members, never audited.
  note            String?
  flaggedAt       DateTime         @default(now()) @map("flagged_at") @db.Timestamptz(3)
  flaggedById     String?          @map("flagged_by") @db.Uuid
  clearedAt       DateTime?        @map("cleared_at") @db.Timestamptz(3)
  clearedById     String?          @map("cleared_by") @db.Uuid
  clearReasonCode String?          @map("clear_reason_code")

  unit      Unit     @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  flaggedBy Account? @relation("ReviewFlaggedBy", fields: [tenantId, flaggedById], references: [tenantId, id], onUpdate: Restrict)
  clearedBy Account? @relation("ReviewClearedBy", fields: [tenantId, clearedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, flaggedAt(sort: Desc), id(sort: Desc)])
  @@map("unit_review_flags")
}

/// A wage obligation (ADR 0017, 0022): recorded here, never paid here; a
/// manager closes it (ADR 0037).
model WorkerWageObligation {
  id               String             @id @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  engagementId     String             @map("engagement_id") @db.Uuid
  workerId         String             @map("worker_id") @db.Uuid
  kind             WageObligationKind
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt        DateTime?          @map("settled_at") @db.Timestamptz(3)
  settledById      String?            @map("settled_by") @db.Uuid
  /// Why a manager closed it (ADR 0037); set with the two above, or none.
  settleReasonCode String?            @map("settle_reason_code")

  engagement WorkerEngagement @relation(fields: [tenantId, engagementId], references: [tenantId, id], onUpdate: Restrict)
  worker     DomesticWorker   @relation(fields: [tenantId, workerId], references: [tenantId, id], onUpdate: Restrict)
  settledBy  Account?         @relation("WageSettledBy", fields: [tenantId, settledById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, workerId])
  @@map("worker_wage_obligations")
}

/// One month's wage, paid by the household (ADR 0037): recorded, not
/// processed. Append-only, no foreign keys: ids only, like gate_entries.
model WorkerWagePayment {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  engagementId String   @map("engagement_id") @db.Uuid
  workerId     String   @map("worker_id") @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  /// The month paid for: its first day.
  period       DateTime @db.Date
  amount       Decimal  @db.Decimal(10, 2)
  paidById     String   @map("paid_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, engagementId, period], map: "worker_wage_payments_one_per_period")
  @@index([tenantId, engagementId, createdAt, id], map: "worker_wage_payments_engagement_idx")
  @@map("worker_wage_payments")
}

/// A permission a household member holds (ADR 0021). Revoked, never
/// deleted. `member_is_minor` follows the member (ON UPDATE CASCADE) so a
/// CHECK refuses finance to a minor at the database level.
model HouseholdMemberGrant {
  id               String           @id @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  memberId         String           @map("member_id") @db.Uuid
  memberIsMinor    Boolean          @map("member_is_minor")
  permission       MemberPermission
  capPerOperation  Decimal?         @map("cap_per_operation") @db.Decimal(12, 2)
  grantedById      String?          @map("granted_by") @db.Uuid
  grantedAt        DateTime         @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(3)
  revokedById      String?          @map("revoked_by") @db.Uuid
  revokeReasonCode String?          @map("revoke_reason_code")
  /// What the member was told; erasable, never audited.
  revokeNote       String?          @map("revoke_note")

  member    HouseholdMember @relation(fields: [tenantId, memberId, memberIsMinor], references: [tenantId, id, isMinor], onUpdate: Cascade, map: "household_member_grants_member_fkey")
  grantedBy Account?        @relation("GrantGrantedBy", fields: [tenantId, grantedById], references: [tenantId, id], onUpdate: Restrict)
  revokedBy Account?        @relation("GrantRevokedBy", fields: [tenantId, revokedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, memberId])
  @@map("household_member_grants")
}

/// An action a member had started when the permission it needed was
/// revoked: saved, and sent to the primary as a request (05 §7).
model HouseholdDeferredAction {
  id                 String               @id @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  unitId             String               @map("unit_id") @db.Uuid
  memberId           String               @map("member_id") @db.Uuid
  permission         MemberPermission
  payload            Json?
  status             DeferredActionStatus @default(pending)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt          DateTime?            @map("decided_at") @db.Timestamptz(3)
  decidedById        String?              @map("decided_by") @db.Uuid
  decisionReasonCode String?              @map("decision_reason_code")
  decisionNote       String?              @map("decision_note")

  unit      Unit            @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  member    HouseholdMember @relation(fields: [tenantId, memberId], references: [tenantId, id], onUpdate: Restrict)
  decidedBy Account?        @relation("DeferredDecidedBy", fields: [tenantId, decidedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, unitId])
  @@map("household_deferred_actions")
}

/// A compliance file on a worker (ADR 0022): kept in the compliance record,
/// one open per (worker, kind), closed with a reason, never deleted.
model WorkerComplianceCase {
  id              String               @id @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  workerId        String               @map("worker_id") @db.Uuid
  kind            ComplianceCaseKind
  status          ComplianceCaseStatus @default(open)
  source          ComplianceCaseSource
  reasonCode      String?              @map("reason_code")
  note            String?
  openedAt        DateTime             @default(now()) @map("opened_at") @db.Timestamptz(3)
  openedById      String?              @map("opened_by") @db.Uuid
  closedAt        DateTime?            @map("closed_at") @db.Timestamptz(3)
  closedById      String?              @map("closed_by") @db.Uuid
  closeReasonCode String?              @map("close_reason_code")
  closeNote       String?              @map("close_note")

  worker   DomesticWorker @relation(fields: [tenantId, workerId], references: [tenantId, id], onUpdate: Restrict)
  openedBy Account?       @relation("CaseOpenedBy", fields: [tenantId, openedById], references: [tenantId, id], onUpdate: Restrict)
  closedBy Account?       @relation("CaseClosedBy", fields: [tenantId, closedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, openedAt(sort: Desc)])
  @@map("worker_compliance_cases")
}

/// A lost or confiscated card (ADR 0022). Management and security see it;
/// the resident only ever sees that the code was reissued.
model WorkerCardIncident {
  id           String               @id @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  engagementId String               @map("engagement_id") @db.Uuid
  workerId     String               @map("worker_id") @db.Uuid
  type         CardIncidentType
  reportedVia  CardIncidentReporter @map("reported_via")
  reportedById String               @map("reported_by") @db.Uuid
  reportedAt   DateTime             @default(now()) @map("reported_at") @db.Timestamptz(3)
  note         String?
  status       CardIncidentStatus   @default(open)
  closedAt     DateTime?            @map("closed_at") @db.Timestamptz(3)
  closedById   String?              @map("closed_by") @db.Uuid

  engagement WorkerEngagement @relation(fields: [tenantId, engagementId], references: [tenantId, id], onUpdate: Restrict)
  worker     DomesticWorker   @relation(fields: [tenantId, workerId], references: [tenantId, id], onUpdate: Restrict)
  reportedBy Account          @relation("IncidentReportedBy", fields: [tenantId, reportedById], references: [tenantId, id], onUpdate: Restrict)
  closedBy   Account?         @relation("IncidentClosedBy", fields: [tenantId, closedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, reportedAt(sort: Desc)])
  @@map("worker_card_incidents")
}

/// A frozen account (ADR 0023). The released phone's HMAC stays here so the
/// number is never put back on this account. Never deleted.
model AccountFreeze {
  id                String              @id @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  accountId         String              @map("account_id") @db.Uuid
  reason            AccountFreezeReason
  /// The released number's HMAC; only when the phone went to someone else.
  releasedPhoneHash String?             @map("released_phone_hash") @db.Char(64)
  note              String?
  frozenAt          DateTime            @default(now()) @map("frozen_at") @db.Timestamptz(3)
  frozenById        String?             @map("frozen_by") @db.Uuid
  reactivatedAt     DateTime?           @map("reactivated_at") @db.Timestamptz(3)
  reactivatedById   String?             @map("reactivated_by") @db.Uuid

  account       Account  @relation("FreezeAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  frozenBy      Account? @relation("FreezeFrozenBy", fields: [tenantId, frozenById], references: [tenantId, id], onUpdate: Restrict)
  reactivatedBy Account? @relation("FreezeReactivatedBy", fields: [tenantId, reactivatedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, accountId])
  @@map("account_freezes")
}

/// Proof of an invitee's relation (ADR 0062): read by the inviter and by
/// whoever approves the join; `released_at` stamped once the invite is
/// settled, the file deleted 30 days later and the row with it.
model HouseholdInviteDocument {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  inviteId   String    @map("invite_id") @db.Uuid
  fileId     String    @unique @map("file_id") @db.Uuid
  /// birth_certificate | marriage_certificate | family_record | other (CHECK).
  kind       String
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invite HouseholdInvite @relation(fields: [tenantId, inviteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file   StoredFile      @relation("InviteDocumentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([tenantId, inviteId], map: "household_invite_documents_invite_idx")
  @@map("household_invite_documents")
}

/// A document in a unit's vault (ADR 0062): an occupancy's (a resident's
/// upload, a registrant's proof) or the unit's (the management's). Seen by
/// its visibility; deleted once, its row going with its file.
model UnitDocument {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  unitId           String    @map("unit_id") @db.Uuid
  fileId           String    @unique @map("file_id") @db.Uuid
  /// warranty | manual | handover_report | utility | insurance | capacity_proof | inspection_report | other (CHECK).
  kind             String
  title            String
  ownerOccupancyId String?   @map("owner_occupancy_id") @db.Uuid
  uploadedBy       String?   @map("uploaded_by") @db.Uuid
  /// private | owners | occupants (CHECK).
  visibility       String
  expiresOn        DateTime? @map("expires_on") @db.Date
  expiryNotifiedAt DateTime? @map("expiry_notified_at") @db.Timestamptz(3)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit           Unit           @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file           StoredFile     @relation("UnitDocumentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  ownerOccupancy UnitOccupancy? @relation(fields: [tenantId, ownerOccupancyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploader       Account?       @relation("UnitDocumentUploader", fields: [tenantId, uploadedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("unit_documents")
}

/// A version of one of the compound's documents (ADR 0062): the bylaws,
/// the occupants' rights, the code of conduct, the moving guide. Numbered
/// per kind, never changed; an amendment is a new version. The bylaws cite
/// the board's published decision.
model CompoundDocumentVersion {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  /// bylaws | occupant_rights | conduct_guide | moving_guide (CHECK).
  kind               String
  versionNo          Int      @map("version_no")
  titleEn            String   @map("title_en")
  titleAr            String   @map("title_ar")
  bodyEn             String   @map("body_en")
  bodyAr             String   @map("body_ar")
  changesEn          String?  @map("changes_en")
  changesAr          String?  @map("changes_ar")
  effectiveOn        DateTime @map("effective_on") @db.Date
  fileId             String?  @map("file_id") @db.Uuid
  boardPublicationId String?  @map("board_publication_id") @db.Uuid
  publishedBy        String   @map("published_by") @db.Uuid
  publishedAt        DateTime @map("published_at") @db.Timestamptz(3)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  file             StoredFile?       @relation("CompoundDocumentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  boardPublication BoardPublication? @relation(fields: [tenantId, boardPublicationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  publisher        Account           @relation("CompoundDocumentPublisher", fields: [tenantId, publishedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, kind, versionNo], map: "compound_document_versions_number_key")
  @@map("compound_document_versions")
}

/// A contract the management holds a copy of (ADR 0062): a lease or an
/// ownership contract, its key dates, its file and its parties. Never
/// changes but for its set-once marks (trigger); a renewal is a new lease.
model UnitContract {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  number           Int
  unitId           String    @map("unit_id") @db.Uuid
  /// lease | ownership (CHECK).
  kind             String
  signedOn         DateTime  @map("signed_on") @db.Date
  startsOn         DateTime  @map("starts_on") @db.Date
  endsOn           DateTime? @map("ends_on") @db.Date
  noticeDays       Int?      @map("notice_days")
  fileId           String?   @map("file_id") @db.Uuid
  filePurgedAt     DateTime? @map("file_purged_at") @db.Timestamptz(3)
  renewsId         String?   @map("renews_id") @db.Uuid
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  voidedAt         DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason       String?   @map("void_reason")
  expiryNotifiedAt DateTime? @map("expiry_notified_at") @db.Timestamptz(3)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit       Unit                  @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file       StoredFile?           @relation("ContractFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  renews     UnitContract?         @relation("ContractRenews", fields: [tenantId, renewsId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  renewedBy  UnitContract[]        @relation("ContractRenews")
  creator    Account               @relation("ContractCreator", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  parties    UnitContractParty[]
  renewals   ContractRenewal[]     @relation("RenewalContract")
  renewedFor ContractRenewal[]     @relation("RenewalOutcome")

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "unit_contracts_number_key")
  @@map("unit_contracts")
}

/// The occupancies a contract binds (ADR 0062): written once.
model UnitContractParty {
  tenantId    String @map("tenant_id") @db.Uuid
  contractId  String @map("contract_id") @db.Uuid
  occupancyId String @map("occupancy_id") @db.Uuid

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contract  UnitContract  @relation(fields: [tenantId, contractId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  occupancy UnitOccupancy @relation(fields: [tenantId, occupancyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([contractId, occupancyId])
  @@index([tenantId, occupancyId], map: "unit_contract_parties_occupancy_idx")
  @@map("unit_contract_parties")
}

/// A tenant asks to renew their lease (ADR 0062): one open per contract;
/// closes once — renewed by the next lease, declined with a code, withdrawn.
model ContractRenewal {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  contractId        String    @map("contract_id") @db.Uuid
  occupancyId       String    @map("occupancy_id") @db.Uuid
  requestedBy       String    @map("requested_by") @db.Uuid
  /// open | renewed | declined | withdrawn (CHECK).
  status            String    @default("open")
  renewedContractId String?   @map("renewed_contract_id") @db.Uuid
  reasonCode        String?   @map("reason_code")
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  closedBy          String?   @map("closed_by") @db.Uuid

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contract        UnitContract  @relation("RenewalContract", fields: [tenantId, contractId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  occupancy       UnitOccupancy @relation(fields: [tenantId, occupancyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  requester       Account       @relation("RenewalRequester", fields: [tenantId, requestedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  renewedContract UnitContract? @relation("RenewalOutcome", fields: [tenantId, renewedContractId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  closer          Account?      @relation("RenewalCloser", fields: [tenantId, closedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("contract_renewals")
}

/// A clearance certificate (ADR 0062): the unit owed nothing as of
/// `as_of`. Issued only at a zero balance; never changes; its PDF is drawn
/// on demand by `template`.
model FinanceClearance {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  number      Int
  unitId      String   @map("unit_id") @db.Uuid
  occupancyId String?  @map("occupancy_id") @db.Uuid
  requestedBy String   @map("requested_by") @db.Uuid
  asOf        DateTime @map("as_of") @db.Timestamptz(3)
  validUntil  DateTime @map("valid_until") @db.Date
  verifyCode  String   @unique @map("verify_code") @db.Char(22)
  template    String

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit           @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  occupancy UnitOccupancy? @relation(fields: [tenantId, occupancyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  requester Account        @relation("ClearanceRequester", fields: [tenantId, requestedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  links     ClearanceLink[]

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "finance_clearances_number_key")
  @@map("finance_clearances")
}

/// Global pointer from a clearance's code to its record (ADR 0062): the
/// code's SHA-256. Read by the public page before the compound is known.
model ClearanceLink {
  codeHash    String   @id @map("code_hash") @db.Char(64)
  tenantId    String   @map("tenant_id") @db.Uuid
  clearanceId String   @map("clearance_id") @db.Uuid
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clearance FinanceClearance @relation(fields: [tenantId, clearanceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@map("clearance_links")
}

/// Money the management holds (ADR 0062): recorded once; what happens to
/// it is its events. What is held is computed.
model FinanceDeposit {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  number      Int
  unitId      String   @map("unit_id") @db.Uuid
  occupancyId String   @map("occupancy_id") @db.Uuid
  /// finishing_works | move | maintenance_fund | other (CHECK).
  kind        String
  amount      Decimal  @db.Decimal(12, 2)
  receivedOn  DateTime @map("received_on") @db.Date
  /// cash | bank_transfer | cheque (CHECK).
  method      String
  reference   String?
  recordedBy  String   @map("recorded_by") @db.Uuid
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit                  @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  occupancy UnitOccupancy         @relation(fields: [tenantId, occupancyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  recorder  Account               @relation("DepositRecorder", fields: [tenantId, recordedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  events    FinanceDepositEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "finance_deposits_number_key")
  @@map("finance_deposits")
}

/// What happened to a deposit (ADR 0062): append-only.
model FinanceDepositEvent {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  depositId  String   @map("deposit_id") @db.Uuid
  /// refund_requested | refund_withdrawn | refunded | deducted | forfeited (CHECK).
  kind       String
  amount     Decimal? @db.Decimal(12, 2)
  reasonCode String?  @map("reason_code")
  channel    String?
  paymentId  String?  @map("payment_id") @db.Uuid
  byAccount  String   @map("by_account") @db.Uuid
  at         DateTime @db.Timestamptz(3)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deposit FinanceDeposit  @relation(fields: [tenantId, depositId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  payment FinancePayment? @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  by      Account         @relation("DepositEventBy", fields: [tenantId, byAccount], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, depositId, at], map: "finance_deposit_events_deposit_idx")
  @@map("finance_deposit_events")
}

/// A self-registration request (ADR 0024). Personal data only while
/// pending (CHECK); an account exists only after a manager approves.
model ResidentRegistration {
  id                  String             @id @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  status              RegistrationStatus @default(pending)
  fullName            String?            @map("full_name")
  phone               String?
  email               String?
  idDocumentType      IdDocumentType?    @map("id_document_type")
  idDocumentNumber    String?            @map("id_document_number")
  nationality         String?            @db.Char(2)
  birthDate           DateTime?          @map("birth_date") @db.Date
  preferredLocale     Locale             @default(ar) @map("preferred_locale")
  unitCode            String             @map("unit_code")
  occupancyType       OccupancyType      @map("occupancy_type")
  resides             Boolean            @default(true)
  unitType            UnitType?          @map("unit_type")
  areaSqm             Decimal?           @map("area_sqm") @db.Decimal(8, 2)
  building            String?
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  decidedAt           DateTime?          @map("decided_at") @db.Timestamptz(3)
  decidedById         String?            @map("decided_by") @db.Uuid
  decisionReasonCode  String?            @map("decision_reason_code")
  approvedAccountId   String?            @map("approved_account_id") @db.Uuid
  approvedOccupancyId String?            @map("approved_occupancy_id") @db.Uuid
  /// What the management asked to correct (ADR 0062), exactly while `needs_correction`.
  correctionCodes       String[]  @default([]) @map("correction_codes")
  correctionRequestedAt DateTime? @map("correction_requested_at") @db.Timestamptz(3)
  resubmittedAt         DateTime? @map("resubmitted_at") @db.Timestamptz(3)
  /// The status links emailed so far; only the newest works (ADR 0062).
  statusLinkSeq         Int       @default(0) @map("status_link_seq")

  decidedBy         Account?                 @relation("RegistrationDecidedBy", fields: [tenantId, decidedById], references: [tenantId, id], onUpdate: Restrict)
  approvedAccount   Account?                 @relation("RegistrationAccount", fields: [tenantId, approvedAccountId], references: [tenantId, id], onUpdate: Restrict)
  approvedOccupancy UnitOccupancy?           @relation(fields: [tenantId, approvedOccupancyId], references: [tenantId, id], onUpdate: Restrict)
  documents         RegistrationDocument[]
  statusLinks       RegistrationStatusLink[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("resident_registrations")
}

/// A registrant's proof of capacity (ADR 0062): a file attached when its
/// upload starts, so the limit of three counts live uploads. Goes with its
/// file (an upload never finalized is swept); never changes.
model RegistrationDocument {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  fileId         String   @unique @map("file_id") @db.Uuid
  /// ownership_proof | lease_proof | other_proof (CHECK).
  kind           String
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  registration ResidentRegistration @relation(fields: [tenantId, registrationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file         StoredFile           @relation("RegistrationDocumentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([tenantId, registrationId, createdAt], map: "registration_documents_registration_idx")
  @@map("registration_documents")
}

/// A name or phone change an account asked for (ADR 0062): a manager
/// decides. One pending per account; the value only while pending; moves
/// once, forward (trigger).
model AccountIdentityChange {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  /// name | phone (CHECK).
  field      String
  newValue   String?   @map("new_value")
  /// pending | approved | rejected | cancelled (CHECK).
  status     String    @default("pending")
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  decidedAt  DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedBy  String?   @map("decided_by") @db.Uuid
  reasonCode String?   @map("reason_code")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account   Account  @relation("IdentityChangeAccount", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  decider   Account? @relation("IdentityChangeDecider", fields: [tenantId, decidedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt], map: "account_identity_changes_queue_idx")
  @@index([tenantId, accountId, createdAt(sort: Desc)], map: "account_identity_changes_account_idx")
  @@map("account_identity_changes")
}

/// "Delete my account" (ADR 0023, 0036): undo until `effective_at`; then
/// the sweep erases it, or queues it for the managers when something blocks
/// it. One open (pending or queued) per account. Never deleted.
model AccountDeletionRequest {
  id                String                @id @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  accountId         String                @map("account_id") @db.Uuid
  status            DeletionRequestStatus @default(pending)
  requestedAt       DateTime              @default(now()) @map("requested_at") @db.Timestamptz(3)
  effectiveAt       DateTime              @map("effective_at") @db.Timestamptz(3)
  cancelledAt       DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  completedAt       DateTime?             @map("completed_at") @db.Timestamptz(3)
  completedById     String?               @map("completed_by") @db.Uuid
  overdueNotifiedAt DateTime?             @map("overdue_notified_at") @db.Timestamptz(3)
  /// The account itself, or the manager who filed it for it (ADR 0036).
  requestedById     String                @map("requested_by") @db.Uuid
  assisted          Boolean               @default(false)
  assistReasonCode  String?               @map("assist_reason_code")
  /// The account was told the execution is two days away.
  remindedAt        DateTime?             @map("reminded_at") @db.Timestamptz(3)
  /// Moved to the managers' queue, with what blocked it.
  queuedAt          DateTime?             @map("queued_at") @db.Timestamptz(3)
  blockerCodes      String[]              @default([]) @map("blocker_codes")
  closedAt          DateTime?             @map("closed_at") @db.Timestamptz(3)
  closedById        String?               @map("closed_by") @db.Uuid
  closeReasonCode   String?               @map("close_reason_code")

  account     Account  @relation("DeletionAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  completedBy Account? @relation("DeletionCompletedBy", fields: [tenantId, completedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, status, effectiveAt])
  @@map("account_deletion_requests")
}

/// A legal obligation to keep an account's data (ADR 0023): blocks erasure.
model LegalHold {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  reasonCode        String    @map("reason_code")
  note              String?
  placedAt          DateTime  @default(now()) @map("placed_at") @db.Timestamptz(3)
  placedById        String    @map("placed_by") @db.Uuid
  releasedAt        DateTime? @map("released_at") @db.Timestamptz(3)
  releasedById      String?   @map("released_by") @db.Uuid
  releaseReasonCode String?   @map("release_reason_code")

  account    Account  @relation("HoldAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  placedBy   Account  @relation("HoldPlacedBy", fields: [tenantId, placedById], references: [tenantId, id], onUpdate: Restrict)
  releasedBy Account? @relation("HoldReleasedBy", fields: [tenantId, releasedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, accountId])
  @@map("legal_holds")
}

/// The in-app inbox (ADR 0027): one row per recipient, a catalog code and
/// params, never text. Read rows are purged by the retention sweep.
model Notification {
  id         String               @id @db.Uuid
  tenantId   String               @map("tenant_id") @db.Uuid
  accountId  String               @map("account_id") @db.Uuid
  kind       String
  priority   NotificationPriority
  params     Json                 @default("{}")
  targetType String?              @map("target_type")
  targetId   String?              @map("target_id") @db.Uuid
  readAt     DateTime?            @map("read_at") @db.Timestamptz(3)
  /// Its holder archived it (ADR 0058): out of the list; always read.
  archivedAt DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation("NotificationAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, accountId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, targetId])
  @@map("notifications")
}

/// Delivery preference categories (ADR 0036).
enum NotificationCategory {
  maintenance
  gate_visitors
  parcels
  household
  account_security
  /// Management requests and their appointments (ADR 0039).
  management
  /// Important announcements, cancelled events, a suggestion's answer (ADR 0040).
  community
  /// Complaints between units, the boards and masked contact (ADR 0042).
  neighbours
  /// A resident's bookings of the facilities, and the club (ADR 0044).
  bookings
  /// A unit's vehicles, their permits and fines (ADR 0045).
  vehicles
  /// A unit's invoices and payments (ADR 0046).
  finance
  /// Emergencies and the services security gives at the gate (ADR 0047).
  safety
  /// A unit's permits: works, moves, material exits, events (ADR 0049).
  permits
  /// The guards' work: shifts, the roster, tasks, swaps, instructions (ADR 0050).
  guard_duty
  /// The owners' board, its polls and elections (ADR 0051).
  governance
  /// A resident's requests to the compound's service partners (ADR 0060).
  partners

  @@map("notification_category")
}

/// `push`: whether a notification is also pushed to the phone (ADR 0041).
enum DeliveryChannel {
  email
  push

  @@map("delivery_channel")
}

/// An account's quiet hours and pause (ADR 0036). No row: the defaults (no
/// quiet hours, no pause). Locked by every preference change.
model NotificationSettings {
  tenantId           String    @map("tenant_id") @db.Uuid
  accountId          String    @map("account_id") @db.Uuid
  /// Minutes after local midnight in the compound's time zone; both or neither.
  quietStartMinute   Int?      @map("quiet_start_minute") @db.SmallInt
  quietEndMinute     Int?      @map("quiet_end_minute") @db.SmallInt
  /// A timed pause (1 h, 8 h) ends at this instant.
  pausedUntil        DateTime? @map("paused_until") @db.Timestamptz(3)
  /// A pause "until turned back on".
  pausedIndefinitely Boolean   @default(false) @map("paused_indefinitely")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation("NotificationSettingsAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)

  @@id([tenantId, accountId])
  @@map("notification_settings")
}

/// One category × channel switch (ADR 0036). No row: on.
model NotificationChannelPref {
  tenantId  String               @map("tenant_id") @db.Uuid
  accountId String               @map("account_id") @db.Uuid
  category  NotificationCategory
  channel   DeliveryChannel
  enabled   Boolean
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation("ChannelPrefAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)

  @@id([tenantId, accountId, category, channel])
  @@map("notification_channel_prefs")
}

/// Consents (ADR 0036): a grant or a revocation.
enum ConsentAction {
  grant
  revoke

  @@map("consent_action")
}

/// Who wrote a consent event: the account, a manager for it (`assisted`),
/// or the system (an erasure revokes what was granted).
enum ConsentActorType {
  account
  system

  @@map("consent_actor_type")
}

/// Append-only (ADR 0036): every grant and revocation, with the version of
/// the text it answered. SELECT and INSERT only; triggers refuse UPDATE,
/// DELETE and TRUNCATE for every role. No foreign keys, like the histories.
model ConsentEvent {
  id               String           @id @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  accountId        String           @map("account_id") @db.Uuid
  /// CONSENT_CATALOG in src/core/consents/consent-catalog.ts.
  code             String
  version          Int
  action           ConsentAction
  actorType        ConsentActorType @map("actor_type")
  actorAccountId   String?          @map("actor_account_id") @db.Uuid
  /// A manager acted for the account (`residents.assist`), for this reason.
  assisted         Boolean          @default(false)
  assistReasonCode String?          @map("assist_reason_code")
  occurredAt       DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([tenantId, accountId, occurredAt, id])
  @@map("consent_events")
}

/// The current state of each consent (ADR 0036), written with every event
/// and rebuildable from them. Counts only while `granted_version` is the
/// catalog's current version.
model AccountConsent {
  tenantId       String    @map("tenant_id") @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  code           String
  grantedVersion Int?      @map("granted_version")
  grantedAt      DateTime? @map("granted_at") @db.Timestamptz(3)
  lastEventId    String?   @map("last_event_id") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation("ConsentAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)

  @@id([tenantId, accountId, code])
  @@map("account_consents")
}

/// Where an account logs in from (ADR 0036): a device never seen on the
/// account raises an alert. Only a keyed hash and a coarse type: no user
/// agent, no IP. The first device recorded is the baseline and raises none.
enum KnownDeviceSource {
  /// The app's install id (`X-Jiwar-Install-Id`).
  app
  /// A browser: family and OS from the user agent.
  web

  @@map("known_device_source")
}

model KnownDevice {
  id          String            @id @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  accountId   String            @map("account_id") @db.Uuid
  /// IdentifierHasher.hashDevice: bound to the account.
  deviceHash  String            @map("device_hash") @db.Char(64)
  source      KnownDeviceSource
  /// ios, android, desktop_web, mobile_web or unknown.
  deviceType  String            @map("device_type")
  firstSeenAt DateTime          @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// The account said "not me" about it.
  disownedAt  DateTime?         @map("disowned_at") @db.Timestamptz(3)
  /// The coarse label (ADR 0058): ios, android, windows, macos, linux, other.
  os          String
  /// app, or a browser family: edge, opera, samsung, firefox, chrome,
  /// safari, other.
  client      String
  /// Its holder signed it out (ADR 0058); a later login from it is new.
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz(3)

  account  Account        @relation("KnownDeviceAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  sessions Session[]
  logins   AccountLogin[]

  @@unique([tenantId, accountId, deviceHash])
  @@unique([tenantId, id])
  @@map("known_devices")
}

/// One login of an account (ADR 0058): when, on which known device, which
/// session. Never an IP, a user agent or a place. Insert-only; kept 90 days.
model AccountLogin {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  knownDeviceId String   @map("known_device_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account     Account     @relation("AccountLoginAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict, map: "account_logins_account_fkey")
  knownDevice KnownDevice @relation(fields: [tenantId, knownDeviceId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict, map: "account_logins_device_fkey")
  session     Session     @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict, map: "account_logins_session_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId], map: "account_logins_session_key")
  @@index([tenantId, accountId, createdAt(sort: Desc), id(sort: Desc)], map: "account_logins_account_idx")
  @@index([tenantId, createdAt], map: "account_logins_created_idx")
  @@map("account_logins")
}

/// The compound's formal notice numbers (ADR 0058): `FN-000123`.
model FormalNoticeCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  @@map("formal_notice_counters")
}

/// A formal notice (ADR 0058): a decision about a unit that must be proven
/// delivered and read; the compound's record, never changed. One per type
/// and subject. Codes, amounts and dates only.
model FormalNotice {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  number      Int
  /// late_payment.
  type        String
  unitId      String   @map("unit_id") @db.Uuid
  /// invoice.
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  dueOn       DateTime @map("due_on") @db.Date
  issuedAt    DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  recipients FormalNoticeRecipient[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, type, subjectType, subjectId], map: "formal_notices_one_per_subject")
  @@index([tenantId, issuedAt(sort: Desc), id(sort: Desc)], map: "formal_notices_issued_idx")
  @@map("formal_notices")
}

/// Who a formal notice was for, and its proofs, each set once (ADR 0058).
model FormalNoticeRecipient {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  noticeId    String    @map("notice_id") @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  /// The inbox row, written at issue.
  deliveredAt DateTime  @default(now()) @map("delivered_at") @db.Timestamptz(3)
  /// The email was sent (copied by the outbox when it marks it sent).
  emailedAt   DateTime? @map("emailed_at") @db.Timestamptz(3)
  /// The recipient first opened it.
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)

  notice FormalNotice @relation(fields: [tenantId, noticeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "formal_notice_recipients_notice_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, noticeId, accountId], map: "formal_notice_recipients_once")
  @@index([tenantId, accountId, deliveredAt(sort: Desc), id(sort: Desc)], map: "formal_notice_recipients_account_idx")
  @@map("formal_notice_recipients")
}

/// A personal-data export (ADR 0036).
enum DataExportStatus {
  pending
  building
  ready
  expired
  failed

  @@map("data_export_status")
}

/// Where a ready export goes: the account's own app, or (assisted) only
/// the account's own email.
enum DataExportDelivery {
  in_app
  email

  @@map("data_export_delivery")
}

/// A personal-data export (ADR 0036): built in the background into the
/// private bucket, downloadable for 7 days, then deleted. One active
/// (pending or building) per account; at most one request a day.
model DataExport {
  id                   String             @id @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  accountId            String             @map("account_id") @db.Uuid
  status               DataExportStatus   @default(pending)
  requestedAt          DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  /// The account itself, or the manager who filed it (assisted).
  requestedByAccountId String             @map("requested_by") @db.Uuid
  assisted             Boolean            @default(false)
  assistReasonCode     String?            @map("assist_reason_code")
  delivery             DataExportDelivery
  attempts             Int                @default(0)
  /// While building: the build's lease.
  lockedUntil          DateTime?          @map("locked_until") @db.Timestamptz(3)
  /// The object being built (`t/<tenant>/<object_id>`): named here until the
  /// file row exists, so it never outlives what names it.
  objectId             String?            @map("object_id") @db.Uuid
  fileId               String?            @map("file_id") @db.Uuid
  readyAt              DateTime?          @map("ready_at") @db.Timestamptz(3)
  expiresAt            DateTime?          @map("expires_at") @db.Timestamptz(3)
  endedAt              DateTime?          @map("ended_at") @db.Timestamptz(3)
  failureCode          String?            @map("failure_code")

  account Account     @relation("DataExportAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  file    StoredFile? @relation("DataExportFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, accountId, requestedAt])
  @@index([tenantId, status])
  @@map("data_exports")
}

/// Idempotent writes (ADR 0028): claimed inside the action's transaction;
/// the body is stored after the response and re-rendered from the
/// resource when lost. Purged after `expires_at` (24 h).
model IdempotencyKey {
  tenantId       String   @map("tenant_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  route          String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id") @db.Uuid
  responseStatus Int      @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  account Account @relation("IdempotencyAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)

  @@id([tenantId, accountId, key])
  @@index([tenantId, expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// GATE (ADR 0028)
// ============================================================================

/// A gate of the compound. Never deleted: entries point at it.
model Gate {
  id        String     @id @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  name      String
  kind      GateKind
  status    GateStatus @default(active)
  /// E.164 (ADR 0043): the household calls the gate from a request.
  phone     String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  shifts   GuardShift[]
  requests GateApprovalRequest[]
  works    Announcement[]
  fieldExceptions        GateFieldException[]
  overstayAlerts         VisitOverstayAlert[]
  serviceVehiclesIn      ServiceVehicleVisit[] @relation("ServiceVehicleEnteredGate")
  serviceVehiclesOut     ServiceVehicleVisit[] @relation("ServiceVehicleExitedGate")

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("gates")
}

/// A guard on duty at one post: a gate, or a zone (a place, ADR 0050);
/// exactly one (CHECK). At most one open per guard (partial unique index in
/// SQL). Every gate action records its shift; a zone shift takes none.
model GuardShift {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  guardAccountId     String    @map("guard_account_id") @db.Uuid
  gateId             String?   @map("gate_id") @db.Uuid
  /// The zone, for a shift that is not at a gate.
  placeId            String?   @map("place_id") @db.Uuid
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(3)
  endReason          String?   @map("end_reason")
  /// At the end, for a shift that filled a slot: minutes worked beyond the
  /// slot's length (ADR 0050). Recorded only, no payroll.
  overtimeMinutes    Int?      @map("overtime_minutes")
  /// At the end, for a shift that filled no slot: its length. Never
  /// overtime (ADR 0050).
  unscheduledMinutes Int?      @map("unscheduled_minutes")

  guard    Account               @relation("ShiftGuard", fields: [tenantId, guardAccountId], references: [tenantId, id], onUpdate: Restrict)
  gate     Gate?                 @relation(fields: [tenantId, gateId], references: [tenantId, id], onUpdate: Restrict)
  place    Place?                @relation(fields: [tenantId, placeId], references: [tenantId, id], onUpdate: Restrict)
  requests GateApprovalRequest[]
  fieldExceptions GateFieldException[]
  serviceVehiclesIn  ServiceVehicleVisit[] @relation("ServiceVehicleEnteredShift")
  serviceVehiclesOut ServiceVehicleVisit[] @relation("ServiceVehicleExitedShift")

  @@unique([tenantId, id])
  @@index([tenantId, gateId])
  @@index([tenantId, placeId])
  @@map("guard_shifts")
}

/// A visitor's name and phone (ADR 0028): personal data, deleted by the
/// retention sweep at `expires_at`; what pointed at it stays.
model VisitorDetails {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  fullName     String?  @map("full_name")
  phone        String?
  /// Optional (ADR 0043): letters (Arabic or Latin), digits and spaces.
  vehiclePlate String?  @map("vehicle_plate")
  /// Generated by the database from the plate (ADR 0045); never written.
  plateKey     String?  @map("plate_key")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  passes   VisitorPass[]
  requests GateApprovalRequest[]
  fieldExceptions GateFieldException[]
  /// Generated by the database from the name (ADR 0056): the log search's exact key; never written.
  nameKey      String?  @map("name_key")

  @@unique([tenantId, id])
  @@index([tenantId, expiresAt])
  @@map("visitor_details")
}

/// A host's pass for visitors (ADR 0028). The code is an HMAC, present only
/// while the pass is active (CHECK); the key makes creation idempotent.
model VisitorPass {
  id               String            @id @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  unitId           String            @map("unit_id") @db.Uuid
  hostAccountId    String            @map("host_account_id") @db.Uuid
  kind             VisitorPassKind
  partySize        Int               @map("party_size")
  validFrom        DateTime          @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime          @map("valid_until") @db.Timestamptz(3)
  /// Recurring passes only: { days, windows } in the compound's time zone.
  schedule         Json?
  status           VisitorPassStatus @default(active)
  codeHash         String?           @map("code_hash") @db.Char(64)
  /// HMAC(IDENTIFIER_PEPPER, "qr:<tenantId>:<token>"); with the code, never
  /// alone (ADR 0030). NULL on passes issued before 4.1.
  qrTokenHash      String?           @map("qr_token_hash") @db.Char(64)
  /// The live token's sequence number (ADR 0043): the token is derived from
  /// VISITOR_PASS_TOKEN_KEY, the pass and this. NULL on passes issued before.
  tokenSeq         Int?              @map("token_seq")
  /// One-time passes (ADR 0043): people who came in; `used` at `partySize`.
  entriesUsed      Int               @default(0) @map("entries_used")
  visitorDetailsId String?           @map("visitor_details_id") @db.Uuid
  usedAt           DateTime?         @map("used_at") @db.Timestamptz(3)
  cancelledAt      DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledById    String?           @map("cancelled_by") @db.Uuid
  cancelReasonCode String?           @map("cancel_reason_code")
  idempotencyKey   String?           @map("idempotency_key")
  requestHash      String?           @map("request_hash")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  unit           Unit            @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  host           Account         @relation("PassHost", fields: [tenantId, hostAccountId], references: [tenantId, id], onUpdate: Restrict)
  cancelledBy    Account?        @relation("PassCancelledBy", fields: [tenantId, cancelledById], references: [tenantId, id], onUpdate: Restrict)
  visitorDetails VisitorDetails? @relation(fields: [tenantId, visitorDetailsId], references: [tenantId, id], onUpdate: Restrict)
  /// Minutes a visit on it is expected to last (ADR 0056); else the compound's.
  expectedMinutes  Int?              @map("expected_minutes") @db.SmallInt

  @@unique([tenantId, id])
  @@unique([tenantId, hostAccountId, idempotencyKey])
  @@index([tenantId, unitId, createdAt(sort: Desc)])
  @@index([tenantId, hostAccountId, status])
  @@map("visitor_passes")
}

/// A household's standing instructions for the gate (ADR 0028).
model UnitGateInstruction {
  tenantId         String              @map("tenant_id") @db.Uuid
  unitId           String              @map("unit_id") @db.Uuid
  uninvitedVisitor VisitorInstruction  @default(ask) @map("uninvited_visitor")
  delivery         DeliveryInstruction @default(ask)
  updatedById      String              @map("updated_by") @db.Uuid
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit      Unit    @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  updatedBy Account @relation("InstructionsUpdatedBy", fields: [tenantId, updatedById], references: [tenantId, id], onUpdate: Restrict)

  @@id([tenantId, unitId])
  @@map("unit_gate_instructions")
}

/// The gate log (ADR 0028): append-only, like the audit tables. SELECT and
/// INSERT only for jiwar_app; triggers reject UPDATE, DELETE and TRUNCATE.
/// No foreign keys on purpose (see the migration): ids are resolved by the
/// service in its tenant transaction.
/// A household's standing instruction for the gate (ADR 0043): a few words
/// about someone who may come uninvited and what the guard does then.
/// Created and deleted, never updated; the author's erasure deletes it.
model UnitStandingInstruction {
  id          String                    @id @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  unitId      String                    @map("unit_id") @db.Uuid
  /// Personal free text: never audited, never in a notification.
  description String
  action      StandingInstructionAction
  createdById String                    @map("created_by") @db.Uuid
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit    @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "unit_standing_instructions_tenant_id_unit_fkey")
  createdBy Account @relation("StandingInstructionAuthor", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "unit_standing_instructions_tenant_id_created_by_fkey")

  @@unique([tenantId, id])
  @@index([tenantId, unitId, createdAt, id], map: "unit_standing_instructions_unit_idx")
  @@index([tenantId, createdById], map: "unit_standing_instructions_author_idx")
  @@map("unit_standing_instructions")
}

model GateEntry {
  id                String          @id @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  gateId            String          @map("gate_id") @db.Uuid
  shiftId           String?         @map("shift_id") @db.Uuid
  guardAccountId    String?         @map("guard_account_id") @db.Uuid
  subjectType       GateSubjectType @map("subject_type")
  subjectId         String          @map("subject_id") @db.Uuid
  unitId            String          @map("unit_id") @db.Uuid
  direction         GateDirection
  method            GateEntryMethod
  approvalRequestId String?         @map("approval_request_id") @db.Uuid
  occurredAt        DateTime        @map("occurred_at") @db.Timestamptz(3)
  recordedAt        DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(3)
  unconfirmed       Boolean         @default(false)
  /// A pointer: the details are deleted when they expire.
  visitorDetailsId  String?         @map("visitor_details_id") @db.Uuid
  /// The field exception it came in on (ADR 0056): no key, as approvals.
  fieldExceptionId  String?         @map("field_exception_id") @db.Uuid

  @@index([tenantId, subjectType, subjectId, occurredAt(sort: Desc)], map: "gate_entries_tenant_id_subject_idx")
  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, unitId, occurredAt(sort: Desc)])
  /// The daily report's visitors of a gate (ADR 0050).
  @@index([tenantId, gateId, occurredAt], map: "gate_entries_gate_day_idx")
  @@map("gate_entries")
}

/// A guard asks a household (ADR 0028). The first decision wins; a deny
/// wins over an approval until the entry; a timeout applies the unit's
/// standing instruction. Never deleted: entries point at it.
model GateApprovalRequest {
  id               String              @id @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  unitId           String              @map("unit_id") @db.Uuid
  gateId           String              @map("gate_id") @db.Uuid
  shiftId          String              @map("shift_id") @db.Uuid
  requestedById    String              @map("requested_by") @db.Uuid
  kind             GateRequestKind
  partySize        Int                 @map("party_size")
  engagementId     String?             @map("engagement_id") @db.Uuid
  visitorDetailsId String?             @map("visitor_details_id") @db.Uuid
  status           GateRequestStatus   @default(pending)
  decidedById      String?             @map("decided_by") @db.Uuid
  decidedAt        DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionSource   GateDecisionSource? @map("decision_source")
  expiresAt        DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The guard's photo of the visitor (ADR 0043); gone 7 days after the decision.
  photoFileId      String?             @map("photo_file_id") @db.Uuid

  unit           Unit              @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  gate           Gate              @relation(fields: [tenantId, gateId], references: [tenantId, id], onUpdate: Restrict)
  photo          StoredFile?       @relation("GateRequestPhoto", fields: [tenantId, photoFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "gate_approval_requests_tenant_id_photo_file_fkey")
  shift          GuardShift        @relation(fields: [tenantId, shiftId], references: [tenantId, id], onUpdate: Restrict)
  requestedBy    Account           @relation("RequestRequestedBy", fields: [tenantId, requestedById], references: [tenantId, id], onUpdate: Restrict)
  decidedBy      Account?          @relation("RequestDecidedBy", fields: [tenantId, decidedById], references: [tenantId, id], onUpdate: Restrict)
  engagement     WorkerEngagement? @relation(fields: [tenantId, engagementId], references: [tenantId, id], onUpdate: Restrict)
  visitorDetails VisitorDetails?   @relation(fields: [tenantId, visitorDetailsId], references: [tenantId, id], onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, unitId, status])
  @@map("gate_approval_requests")
}

/// The gate's settings (ADR 0056): one row per compound, created with it.
/// Each column belongs to one feature.
model GateSettings {
  tenantId               String   @id @map("tenant_id") @db.Uuid
  /// How long the management has to answer a field exception.
  exceptionAnswerMinutes Int      @default(10) @map("exception_answer_minutes") @db.SmallInt
  /// How long an approved field exception lets its one entry in.
  exceptionEntryMinutes  Int      @default(15) @map("exception_entry_minutes") @db.SmallInt
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// A visit's expected minutes when its pass gives none; null: no overstay alert.
  visitExpectedMinutes   Int?     @default(240) @map("visit_expected_minutes") @db.SmallInt
  /// Minutes outside a patrol route's geofence that flag an exit.
  geofenceExitMinutes    Int      @default(3) @map("geofence_exit_minutes") @db.SmallInt
  /// Recordings a patrol note or an incident takes (ADR 0056).
  audioMaxSeconds        Int      @default(300) @map("audio_max_seconds") @db.SmallInt
  videoMaxSeconds        Int      @default(120) @map("video_max_seconds") @db.SmallInt
  audioMaxMb             Int      @default(20) @map("audio_max_mb") @db.SmallInt
  videoMaxMb             Int      @default(100) @map("video_max_mb") @db.SmallInt
  /// Minutes a device on shift may go unseen before the management is told (ADR 0057).
  offlineSyncAlertMinutes Int @default(15) @map("offline_sync_alert_minutes") @db.SmallInt

  @@map("gate_settings")
}

/// A guard asks the on-duty management to let in, once, someone the gate
/// refused (ADR 0056). The first decision wins; nobody answering by
/// `answerBy` expires it; an approval lets one entry in at its gate until
/// `entryUntil`. Never a lockdown's or a ban's override. Never deleted:
/// entries point at it.
model GateFieldException {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  number             Int
  /// worker_outside_hours | visitor_without_pass | unregistered_vehicle
  kind               String
  /// REASON_CODES.gateExceptionRaise.
  reasonCode         String    @map("reason_code")
  gateId             String    @map("gate_id") @db.Uuid
  shiftId            String    @map("shift_id") @db.Uuid
  raisedById         String    @map("raised_by_account_id") @db.Uuid
  unitId             String    @map("unit_id") @db.Uuid
  engagementId       String?   @map("engagement_id") @db.Uuid
  permitWorkerId     String?   @map("permit_worker_id") @db.Uuid
  /// The visitor's name and the vehicle's plate: deleted when they expire.
  visitorDetailsId   String?   @map("visitor_details_id") @db.Uuid
  /// pending | approved | rejected | expired | withdrawn
  status             String    @default("pending")
  raisedAt           DateTime  @map("raised_at") @db.Timestamptz(3)
  answerBy           DateTime  @map("answer_by") @db.Timestamptz(3)
  decidedAt          DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedById        String?   @map("decided_by_account_id") @db.Uuid
  /// REASON_CODES.gateExceptionReject.
  rejectReasonCode   String?   @map("reject_reason_code")
  entryUntil         DateTime? @map("entry_until") @db.Timestamptz(3)
  usedAt             DateTime? @map("used_at") @db.Timestamptz(3)
  usedEntryId        String?   @map("used_entry_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  gate           Gate              @relation(fields: [tenantId, gateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  shift          GuardShift        @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  raisedBy       Account           @relation("FieldExceptionRaisedBy", fields: [tenantId, raisedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "gate_field_exceptions_tenant_id_raised_by_fkey")
  decidedBy      Account?          @relation("FieldExceptionDecidedBy", fields: [tenantId, decidedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "gate_field_exceptions_tenant_id_decided_by_fkey")
  unit           Unit              @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  engagement     WorkerEngagement? @relation(fields: [tenantId, engagementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  permitWorker   PermitWorker?     @relation(fields: [tenantId, permitWorkerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  visitorDetails VisitorDetails?   @relation(fields: [tenantId, visitorDetailsId], references: [tenantId, id], onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "gate_field_exceptions_number_key")
  @@unique([tenantId, usedEntryId], map: "gate_field_exceptions_used_entry_key")
  @@index([tenantId, raisedAt(sort: Desc), id(sort: Desc)], map: "gate_field_exceptions_list_idx")
  @@index([tenantId, shiftId], map: "gate_field_exceptions_shift_idx")
  @@map("gate_field_exceptions")
}

/// A visitor still inside past their visit's expected length (ADR 0056):
/// the guards and the host were told, once per `in` entry. Never changed.
model VisitOverstayAlert {
  tenantId        String          @map("tenant_id") @db.Uuid
  entryId         String          @map("entry_id") @db.Uuid
  subjectType     GateSubjectType @map("subject_type")
  subjectId       String          @map("subject_id") @db.Uuid
  gateId          String          @map("gate_id") @db.Uuid
  unitId          String          @map("unit_id") @db.Uuid
  enteredAt       DateTime        @map("entered_at") @db.Timestamptz(3)
  expectedMinutes Int             @map("expected_minutes") @db.SmallInt
  alertedAt       DateTime        @map("alerted_at") @db.Timestamptz(3)

  gate Gate @relation(fields: [tenantId, gateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit Unit @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, entryId])
  @@index([tenantId, alertedAt(sort: Desc)], map: "visit_overstay_alerts_alerted_idx")
  @@map("visit_overstay_alerts")
}

/// A service vehicle's visit (ADR 0056): a tanker, a waste truck, a
/// delivery, another; in at a gate and out once, by a guard on shift or by
/// the system (unconfirmed). A plate is inside once at a time.
model ServiceVehicleVisit {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  plate              String
  /// Generated by the database from the plate (ADR 0045); never written.
  plateKey           String?   @map("plate_key")
  /// tanker | waste | delivery | other
  kind               String
  company            String
  unitId             String?   @map("unit_id") @db.Uuid
  facilityId         String?   @map("facility_id") @db.Uuid
  enteredAt          DateTime  @map("entered_at") @db.Timestamptz(3)
  enteredGateId      String    @map("entered_gate_id") @db.Uuid
  enteredShiftId     String    @map("entered_shift_id") @db.Uuid
  enteredById        String    @map("entered_by_account_id") @db.Uuid
  exitedAt           DateTime? @map("exited_at") @db.Timestamptz(3)
  exitedGateId       String?   @map("exited_gate_id") @db.Uuid
  exitedShiftId      String?   @map("exited_shift_id") @db.Uuid
  exitedById         String?   @map("exited_by_account_id") @db.Uuid
  exitUnconfirmed    Boolean   @default(false) @map("exit_unconfirmed")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  unit         Unit?       @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  facility     Facility?   @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  enteredGate  Gate        @relation("ServiceVehicleEnteredGate", fields: [tenantId, enteredGateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "service_vehicle_visits_entered_gate_fkey")
  enteredShift GuardShift  @relation("ServiceVehicleEnteredShift", fields: [tenantId, enteredShiftId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "service_vehicle_visits_entered_shift_fkey")
  enteredBy    Account     @relation("ServiceVehicleEnteredBy", fields: [tenantId, enteredById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "service_vehicle_visits_entered_by_fkey")
  exitedGate   Gate?       @relation("ServiceVehicleExitedGate", fields: [tenantId, exitedGateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "service_vehicle_visits_exited_gate_fkey")
  exitedShift  GuardShift? @relation("ServiceVehicleExitedShift", fields: [tenantId, exitedShiftId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "service_vehicle_visits_exited_shift_fkey")
  exitedBy     Account?    @relation("ServiceVehicleExitedBy", fields: [tenantId, exitedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "service_vehicle_visits_exited_by_fkey")

  @@unique([tenantId, id])
  @@index([tenantId, enteredGateId, enteredAt], map: "service_vehicle_visits_day_idx")
  @@map("service_vehicle_visits")
}

/// A visitor's photo at entry (ADR 0056): one per `in` entry, seen by the
/// guards on shift and the management; deleted 30 days after the entry
/// unless an incident's evidence keeps it (its key restricts the delete).
model GateEntryPhoto {
  tenantId     String          @map("tenant_id") @db.Uuid
  entryId      String          @map("entry_id") @db.Uuid
  fileId       String          @map("file_id") @db.Uuid
  subjectType  GateSubjectType @map("subject_type")
  subjectId    String          @map("subject_id") @db.Uuid
  gateId       String          @map("gate_id") @db.Uuid
  unitId       String          @map("unit_id") @db.Uuid
  takenById    String          @map("taken_by_account_id") @db.Uuid
  enteredAt    DateTime        @map("entered_at") @db.Timestamptz(3)
  purgeAfter   DateTime        @map("purge_after") @db.Timestamptz(3)

  @@id([tenantId, entryId])
  @@unique([tenantId, fileId], map: "gate_entry_photos_file_key")
  @@index([tenantId, purgeAfter], map: "gate_entry_photos_purge_idx")
  @@map("gate_entry_photos")
}

/// What an incident keeps beyond its own photos (ADR 0056): a visitor's
/// photo at entry. Added, never removed: the incident is kept, and so is
/// what it names.
model IncidentEvidence {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  incidentId  String   @map("incident_id") @db.Uuid
  /// visitor_photo | patrol_track
  kind        String
  entryId     String?  @map("entry_id") @db.Uuid
  runId       String?  @map("run_id") @db.Uuid
  linkedById  String   @map("linked_by_account_id") @db.Uuid
  linkedAt    DateTime @map("linked_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, incidentId, linkedAt], map: "incident_evidence_incident_idx")
  @@map("incident_evidence")
}

/// Resident vehicles through the gate, counted (ADR 0056): per compound
/// day, gate and direction, nothing else — no vehicle, no unit, no time.
/// A count only grows, by one.
model GateVehicleCount {
  tenantId  String        @map("tenant_id") @db.Uuid
  day       DateTime      @db.Date
  gateId    String        @map("gate_id") @db.Uuid
  direction GateDirection
  count     Int

  @@id([tenantId, day, gateId, direction])
  @@map("gate_vehicle_counts")
}

// ============================================================================
// The gate offline (ADR 0057): guard devices, the bundles they download, the
// batches they upload and what those record or flag.
// ============================================================================

/// A guard device (ADR 0057): the compound's phone, known by its Ed25519
/// public key; revoked once by the management.
model GateDevice {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  publicKey          String    @map("public_key")
  label              String?
  enrolledById       String    @map("enrolled_by_account_id") @db.Uuid
  enrolledAt         DateTime  @map("enrolled_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById        String?   @map("revoked_by_account_id") @db.Uuid
  /// REASON_CODES.gateDeviceRevoke
  revokeReason       String?   @map("revoke_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Its bundles so far (ADR 0057): the last one's number and when.
  bundleVersion      Int       @default(0) @map("bundle_version")
  lastBundleAt       DateTime? @map("last_bundle_at") @db.Timestamptz(3)
  /// Its actions received without a gap, the highest received.
  ackedSeq           Int       @default(0) @map("acked_seq")
  maxSeq             Int       @default(0) @map("max_seq")
  /// When the management was last told of an upload it refused.
  rejectionAlertedAt DateTime? @map("rejection_alerted_at") @db.Timestamptz(3)

  /// Sync health: when it last called, last uploaded, what it holds, and
  /// when the management was told of an outage or a gap.
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)
  lastUploadAt     DateTime? @map("last_upload_at") @db.Timestamptz(3)
  pendingCount     Int?      @map("pending_count")
  overdueAlertedAt DateTime? @map("overdue_alerted_at") @db.Timestamptz(3)
  gapAlertedAt     DateTime? @map("gap_alerted_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, publicKey], map: "gate_devices_public_key_key")
  @@index([tenantId, enrolledAt(sort: Desc), id(sort: Desc)], map: "gate_devices_list_idx")
  @@map("gate_devices")
}

/// A gate bundle a device downloaded (ADR 0057): never its contents, only
/// its number, validity, key id, hash and counts. Append-only.
model GateOfflineBundle {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  version        Int
  shiftId        String   @map("shift_id") @db.Uuid
  gateId         String   @map("gate_id") @db.Uuid
  guardAccountId String   @map("guard_account_id") @db.Uuid
  issuedAt       DateTime @map("issued_at") @db.Timestamptz(3)
  validUntil     DateTime @map("valid_until") @db.Timestamptz(3)
  keyVersion     Int      @map("key_version") @db.SmallInt
  contentSha256  String   @map("content_sha256") @db.Char(64)
  /// How many of each section.
  counts         Json

  @@unique([tenantId, id])
  @@unique([tenantId, deviceId, version], map: "gate_offline_bundles_version_key")
  @@index([tenantId, shiftId], map: "gate_offline_bundles_shift_idx")
  @@map("gate_offline_bundles")
}

/// A batch a device uploaded (ADR 0057): never its payload.
model GateOfflineBatch {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  deviceId      String   @map("device_id") @db.Uuid
  uploadedById  String   @map("uploaded_by_account_id") @db.Uuid
  receivedAt    DateTime @map("received_at") @db.Timestamptz(3)
  sentAt        DateTime @map("sent_at") @db.Timestamptz(3)
  /// The device's clock less the server's, when it was sent.
  clockOffsetMs Int      @map("clock_offset_ms")
  payloadSha256 String   @map("payload_sha256") @db.Char(64)
  actionCount   Int      @map("action_count") @db.SmallInt
  /// accepted | quarantined (a revoked device's)
  status        String

  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedById   String?   @map("reviewed_by_account_id") @db.Uuid
  /// accepted | rejected: a quarantined batch, decided once.
  reviewDecision String?   @map("review_decision")

  @@unique([tenantId, id])
  @@index([tenantId, deviceId, receivedAt(sort: Desc)], map: "gate_offline_batches_device_idx")
  @@map("gate_offline_batches")
}

/// An action a device recorded offline (ADR 0057), its id the app's: what
/// it recorded, or why it was not. Never a code, a plate or a name.
model GateOfflineAction {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  batchId        String    @map("batch_id") @db.Uuid
  seq            Int
  /// entry | contractor | service_vehicle_in | service_vehicle_out | material_entry | patrol_scan | child_exit
  type           String
  contentSha256  String    @map("content_sha256") @db.Char(64)
  bundleId       String?   @map("bundle_id") @db.Uuid
  deviceTime     DateTime  @map("device_time") @db.Timestamptz(3)
  occurredAt     DateTime? @map("occurred_at") @db.Timestamptz(3)
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(3)
  /// recorded | rejected | quarantined
  status         String
  /// offline-rules.ts REJECTIONS
  rejectReason   String?   @map("reject_reason")
  guardAccountId String?   @map("guard_account_id") @db.Uuid
  shiftId        String?   @map("shift_id") @db.Uuid
  gateId         String?   @map("gate_id") @db.Uuid
  /// The entry it recorded: a pointer.
  entryId        String?   @map("entry_id") @db.Uuid

  /// A quarantined action as sent, less anything secret, until decided.
  body       Json?
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)

  /// What else it recorded: a service vehicle's visit, a material entry, a patrol's scan.
  serviceVehicleVisitId String? @map("service_vehicle_visit_id") @db.Uuid
  materialEntryId       String? @map("material_entry_id") @db.Uuid
  patrolScanId          String? @map("patrol_scan_id") @db.Uuid

  /// A child's exit it recorded: deleted with it (the 30-day purge's cascade).
  childPickupId String? @map("child_pickup_id") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, deviceId, seq], map: "gate_offline_actions_seq_key")
  @@index([tenantId, batchId, seq], map: "gate_offline_actions_batch_idx")
  @@map("gate_offline_actions")
}

/// What the server knew at sync that the device did not (ADR 0057): codes
/// and numbers only; told per batch, cleared or reviewed once.
model GateOfflineFlag {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  batchId       String    @map("batch_id") @db.Uuid
  actionId      String?   @map("action_id") @db.Uuid
  deviceId      String    @map("device_id") @db.Uuid
  /// offline-rules.ts FLAG_KINDS
  kind          String
  /// security | manager | info
  class         String
  subjectType   String?   @map("subject_type")
  subjectId     String?   @map("subject_id") @db.Uuid
  gateId        String?   @map("gate_id") @db.Uuid
  shiftId       String?   @map("shift_id") @db.Uuid
  params        Json      @default("{}")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  alertedAt     DateTime? @map("alerted_at") @db.Timestamptz(3)
  clearedAt     DateTime? @map("cleared_at") @db.Timestamptz(3)
  /// reconciled
  clearedReason String?   @map("cleared_reason")
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedById  String?   @map("reviewed_by_account_id") @db.Uuid
  /// REASON_CODES.offlineFlagReview
  reviewCode    String?   @map("review_code")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "gate_offline_flags_list_idx")
  @@index([tenantId, batchId], map: "gate_offline_flags_batch_idx")
  @@map("gate_offline_flags")
}

/// The replay guard of what devices sign (ADR 0057)/// The replay guard of what devices sign (ADR 0057): an envelope's
/// signature, hashed, once per device for a day.
model GateDeviceEnvelope {
  tenantId        String   @map("tenant_id") @db.Uuid
  deviceId        String   @map("device_id") @db.Uuid
  signatureSha256 String   @map("signature_sha256") @db.Char(64)
  sentAt          DateTime @map("sent_at") @db.Timestamptz(3)
  receivedAt      DateTime @map("received_at") @db.Timestamptz(3)

  @@id([tenantId, deviceId, signatureSha256])
  @@map("gate_device_envelopes")
}

// ============================================================================
// AUDIT (ADR 0014) — immutable: SELECT/INSERT only for jiwar_app, triggers
// reject UPDATE/DELETE/TRUNCATE for every role. No foreign keys on purpose:
// entries must survive anything that happens to what they reference.
// ============================================================================

enum FilePurpose {
  worker_photo
  document
  resident_photo
  ticket_photo
  parcel_photo
  /// A personal-data export's archive (ADR 0036): written by the server.
  data_export
  /// A management request message's attachment (ADR 0039): image or PDF.
  request_attachment
  /// An announcement's, an event's or a "we did" note's attachment (ADR 0040): image or PDF.
  community_attachment
  /// A complaint's evidence (ADR 0042): image or PDF, never a video.
  complaint_evidence
  /// A lost-and-found or lending post's photo (ADR 0042).
  neighbour_post_photo
  gate_request_photo
  /// A vehicle's licence (ADR 0045): image or PDF, the resident's.
  vehicle_licence
  /// A resident's photo of a parking report or a fine's appeal (ADR 0045).
  parking_photo
  /// A vehicle fine's photo (ADR 0045): the staff's.
  vehicle_fine_photo
  /// A suspicious-activity report's photo (ADR 0047), the resident's.
  gate_service_photo
  /// A resident's photo backing an invoice dispute (ADR 0048).
  dispute_photo
  /// A contractor worker's face, shown to the guard (ADR 0049).
  contractor_photo
  /// A material exit's photo of the goods (ADR 0049), the resident's.
  permit_photo
  /// A guard's photo of a task's work (ADR 0050): a closed unit inspected.
  guard_task_photo
  /// A found item's photo, taken at the gate (ADR 0050).
  found_item_photo
  /// A patrol note's photo of a place (ADR 0052), the guard's.
  patrol_photo
  /// An incident's photo (ADR 0053), the guard's or the management's.
  incident_photo
  /// A banned or watched person's face (ADR 0053), the management's.
  blocklist_photo
  /// A violation's photo (ADR 0053), the guard's or the office's.
  violation_photo
  /// A resident's photo backing a violation's appeal (ADR 0053).
  violation_appeal_photo
  /// A child's photo under exit control (ADR 0054), the household's.
  child_photo
  /// An outside escort's photo (ADR 0054), the household's.
  child_escort_photo
  /// An approval request's document or photo (ADR 0055), the staff's.
  approval_attachment
  /// An owner's document or photo backing an appeal to the board (ADR 0055).
  board_appeal_attachment
  /// An expense's invoice (ADR 0055), the accountant's.
  expense_invoice
  /// A visitor's photo at entry (ADR 0056), taken by the guard.
  visitor_photo
  /// A patrol note's sound (ADR 0056): audio/mp4.
  patrol_note_audio
  /// A patrol note's video (ADR 0056): video/mp4 or QuickTime.
  patrol_note_video
  /// An incident's sound (ADR 0056): audio/mp4.
  incident_audio
  /// An incident's video (ADR 0056): video/mp4 or QuickTime.
  incident_video
  /// A drawn signature on an incident report (ADR 0056): PNG, 256 KB.
  incident_signature
  /// A decision appeal's attachment (ADR 0059): an image or a PDF, 10 MB.
  decision_appeal_attachment
  /// A registrant's proof of capacity (ADR 0062), uploaded with no account.
  registration_document
  /// Proof of an invitee's relation to the household (ADR 0062).
  kinship_proof
  /// A document in a unit's vault (ADR 0062).
  unit_document
  /// A compound document version's PDF (ADR 0062).
  compound_document
  /// A unit contract's scan (ADR 0062).
  contract
  /// An asset's, asset type's or common area's document (ADR 0064): image or PDF, 10 MB.
  asset_document
  /// A checklist answer's photo (ADR 0064), the technician's.
  checklist_photo
  /// A sheet the management imports (ADR 0064): text/csv, 1 MB.
  data_import

  @@map("file_purpose")
}

enum FileStatus {
  pending
  ready

  @@map("file_status")
}

/// An object in the private bucket (ADR 0029), at `t/<tenantId>/<id>`.
/// `pending` until finalize has checked the bytes; a deleted row stays until
/// the sweep has deleted the object. The uploader's file name is not kept.
/// An attached file (a worker's photo) has no owner: its record decides.
model StoredFile {
  id              String      @id @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  ownerAccountId  String?     @map("owner_account_id") @db.Uuid
  purpose         FilePurpose
  contentType     String      @map("content_type")
  sizeBytes       Int         @map("size_bytes")
  status          FileStatus  @default(pending)
  uploadExpiresAt DateTime    @map("upload_expires_at") @db.Timestamptz(3)
  finalizedAt     DateTime?   @map("finalized_at") @db.Timestamptz(3)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)
  attachedAt      DateTime?   @map("attached_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  workers                       DomesticWorker[]               @relation("WorkerPhoto")
  accounts                      Account[]                      @relation("AccountPhoto")
  exports                       DataExport[]                   @relation("DataExportFile")
  tickets                       TicketAttachment[]             @relation("AttachmentFile")
  parcelPhotos                  Parcel[]                       @relation("ParcelPhoto")
  gateRequestPhotos             GateApprovalRequest[]          @relation("GateRequestPhoto")
  parcelHandoverPhotos          Parcel[]                       @relation("ParcelHandoverPhoto")
  managementAttachments         ManagementRequestAttachment[]  @relation("ManagementAttachmentFile")
  announcementAttachments       AnnouncementAttachment[]       @relation("AnnouncementAttachmentFile")
  eventAttachments              EventAttachment[]              @relation("EventAttachmentFile")
  suggestionAttachments         SuggestionAttachment[]         @relation("SuggestionAttachmentFile")
  neighbourComplaintAttachments NeighbourComplaintAttachment[] @relation("NeighbourComplaintAttachmentFile")
  neighbourPostPhotos           NeighbourPostPhoto[]           @relation("NeighbourPostPhotoFile")
  registrationDocuments         RegistrationDocument[]         @relation("RegistrationDocumentFile")
  inviteDocuments               HouseholdInviteDocument[]      @relation("InviteDocumentFile")
  unitDocuments                 UnitDocument[]                 @relation("UnitDocumentFile")
  compoundDocumentVersions      CompoundDocumentVersion[]      @relation("CompoundDocumentFile")
  contracts                     UnitContract[]                 @relation("ContractFile")
  owner                         Account?                       @relation("FileOwner", fields: [tenantId, ownerAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// A recording's length, read from its container at finalize (ADR 0056).
  mediaDurationMs Int?        @map("media_duration_ms")
  /// A record's upload with no account behind it (ADR 0062): no owner from
  /// the start, attached to its record at finalize.
  recordUpload    Boolean     @default(false) @map("record_upload")

  @@unique([tenantId, id])
  @@map("files")
}

enum AuditActorType {
  account
  platform_admin
  system

  @@map("audit_actor_type")
}

/// Tenant table (RLS + FORCE). Written in the transaction of the action.
model AuditLog {
  id         String         @id @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  targetType String         @map("target_type")
  targetId   String?        @map("target_id") @db.Uuid
  changes    Json?
  requestId  String?        @map("request_id")
  ip         String?        @db.Inet
  userAgent  String?        @map("user_agent")
  metadata   Json?

  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, actorId])
  @@map("audit_log")
}

/// Global: the platform owner's actions. `target_tenant_id` is a pointer.
model PlatformAuditLog {
  id             String         @id @db.Uuid
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.Uuid
  action         String
  targetType     String         @map("target_type")
  targetId       String?        @map("target_id") @db.Uuid
  targetTenantId String?        @map("target_tenant_id") @db.Uuid
  changes        Json?
  requestId      String?        @map("request_id")
  ip             String?        @db.Inet
  userAgent      String?        @map("user_agent")
  metadata       Json?

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([targetTenantId])
  @@index([targetType, targetId])
  @@map("platform_audit_log")
}

/// Global, fail-open. Never a raw email or phone: only the identifier HMAC.
model SecurityEvent {
  id              String   @id @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  event           String
  identifierHash  String?  @map("identifier_hash") @db.Char(64)
  accountId       String?  @map("account_id") @db.Uuid
  tenantId        String?  @map("tenant_id") @db.Uuid
  platformAdminId String?  @map("platform_admin_id") @db.Uuid
  ip              String?  @db.Inet
  userAgent       String?  @map("user_agent")
  requestId       String?  @map("request_id")
  metadata        Json?

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([event])
  @@index([identifierHash])
  @@map("security_events")
}

/// A phone registered for the rotating entry QR (ADR 0031). The secret is
/// derived from ENTRY_CREDENTIAL_KEY and never stored; there is no last-used
/// time, because a resident's scan leaves no trace. Never deleted.
model EntryCredential {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  /// Personal: kept only while the credential is live (CHECK).
  deviceName   String?   @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// ENTRY_REVOKE_REASONS in src/gate/entry/entry-credentials.service.ts.
  revokeReason String?   @map("revoke_reason")

  account Account @relation("CredentialAccount", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("entry_credentials")
}

// ============================================================================
// MAINTENANCE (ADR 0032)
// ============================================================================

enum TicketPriority {
  normal
  urgent
  emergency

  @@map("ticket_priority")
}

enum TicketStatus {
  new
  assigned
  /// The technician is on the way (ADR 0038); in their hands like assigned.
  en_route
  in_progress
  on_hold
  completed
  closed
  cancelled

  @@map("ticket_status")
}

enum TicketConfirmationStatus {
  pending
  confirmed
  rejected
  auto_closed

  @@map("ticket_confirmation_status")
}

enum TicketHoldReason {
  awaiting_resident
  awaiting_parts
  other

  @@map("ticket_hold_reason")
}

enum TicketAssignmentType {
  manual
  reassignment
  declined
  /// Written by the dispatch engine (ADR 0033), with no actor.
  automatic
  /// A system unassignment: escalated to the queue, or the technician left.
  released

  @@map("ticket_assignment_type")
}

enum TicketAttachmentKind {
  report
  before
  after

  @@map("ticket_attachment_kind")
}

/// What a ticket is for (ADR 0038): something broke, or a check-up booked
/// before something does.
enum TicketKind {
  repair
  preventive

  @@map("ticket_kind")
}

/// Where in the unit (ADR 0038): the room, for whoever comes to fix it.
enum TicketUnitLocation {
  kitchen
  bathroom
  living_room
  bedroom
  balcony
  other

  @@map("ticket_unit_location")
}

enum TicketFeedbackKind {
  confirmed
  rejected
  reopened

  @@map("ticket_feedback_kind")
}

/// The compound's own categories, seeded with five defaults. Never deleted:
/// tickets point at them; `active = false` retires one.
model TicketCategory {
  id                String         @id @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  key               String
  nameAr            String         @map("name_ar")
  nameEn            String         @map("name_en")
  defaultPriority   TicketPriority @default(normal) @map("default_priority")
  commonAreaAllowed Boolean        @default(true) @map("common_area_allowed")
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tickets            Ticket[]
  specialties        CategorySpecialty[]
  slaTargets         SlaTarget[]
  preventiveServices PreventiveService[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("ticket_categories")
}

/// What a resident may book a check-up for (ADR 0038): the compound's own
/// list, seeded with four defaults. Never deleted: preventive tickets point
/// at them; `active = false` retires one. The category says who can do it.
model PreventiveService {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  key        String
  nameAr     String   @map("name_ar")
  nameEn     String   @map("name_en")
  categoryId String   @map("category_id") @db.Uuid
  /// The order the residents see; ties by key.
  position   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category TicketCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "preventive_services_tenant_id_category_id_fkey")
  tickets  Ticket[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("preventive_services")
}

/// One row per compound, created with it.
model MaintenanceSettings {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  autoCloseHours   Int      @default(72) @map("auto_close_hours")
  reopenDays       Int      @default(7) @map("reopen_days")
  maxReportPhotos  Int      @default(5) @map("max_report_photos")
  /// Visiting hours (ADR 0038): minutes after local midnight, and the slot.
  visitHoursStart  Int      @default(480) @map("visit_hours_start")
  visitHoursEnd    Int      @default(1080) @map("visit_hours_end")
  visitSlotMinutes Int      @default(60) @map("visit_slot_minutes")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("maintenance_settings")
}

/// The last ticket number of a compound, taken under its row lock.
model TicketCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("ticket_counters")
}

/// A maintenance ticket (ADR 0032): a unit's or a common area's record.
/// Never deleted. `status` is the work, `confirmationStatus` the reporter's
/// verdict on the last completion; CHECKs tie them together.
model Ticket {
  id                  String                    @id @db.Uuid
  tenantId            String                    @map("tenant_id") @db.Uuid
  number              Int
  unitId              String?                   @map("unit_id") @db.Uuid
  /// A short label until common areas have a table. Free text: never in
  /// the audit trail or a notification.
  commonArea          String?                   @map("common_area")
  /// The room (ADR 0038); a unit's ticket only, optional.
  unitLocation        TicketUnitLocation?       @map("unit_location")
  categoryId          String                    @map("category_id") @db.Uuid
  createdById         String                    @map("created_by_account_id") @db.Uuid
  reporterId          String                    @map("reporter_account_id") @db.Uuid
  priority            TicketPriority
  status              TicketStatus              @default(new)
  holdReason          TicketHoldReason?         @map("hold_reason")
  confirmationStatus  TicketConfirmationStatus? @map("confirmation_status")
  technicianId        String?                   @map("technician_account_id") @db.Uuid
  cycle               Int                       @default(1)
  rejectionCount      Int                       @default(0) @map("rejection_count")
  /// Free text, may name people: never in the audit trail or a notification.
  /// Null only for a preventive ticket without a note (ADR 0038).
  description         String?
  /// ADR 0038. A preventive ticket names its service and the window the
  /// resident asked for; a trigger refuses any later change to the four.
  kind                TicketKind                @default(repair)
  preventiveServiceId String?                   @map("preventive_service_id") @db.Uuid
  requestedStartsAt   DateTime?                 @map("requested_starts_at") @db.Timestamptz(3)
  requestedEndsAt     DateTime?                 @map("requested_ends_at") @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignedAt          DateTime?                 @map("assigned_at") @db.Timestamptz(3)
  completedAt         DateTime?                 @map("completed_at") @db.Timestamptz(3)
  closedAt            DateTime?                 @map("closed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  /// ADR 0039: the last thing a resident on the ticket could see happen (a
  /// status or cycle change, a non-internal message, a photo). Kept by
  /// triggers; nothing in the app writes it.
  lastActivityAt      DateTime                  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  /// resident, plan, inspection, field (ADR 0064): who opened it. Never changes.
  origin              String                    @default("resident")
  /// The asset a compound's work order is for (ADR 0064).
  assetId             String?                   @map("asset_id") @db.Uuid
  /// The area of an inspection's finding without an asset; its name is `commonArea`.
  commonAreaId        String?                   @map("common_area_id") @db.Uuid

  unit              Unit?              @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  category          TicketCategory     @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy         Account            @relation("TicketCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tickets_tenant_id_created_by_fkey")
  reporter          Account            @relation("TicketReporter", fields: [tenantId, reporterId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tickets_tenant_id_reporter_fkey")
  technician        Account?           @relation("TicketTechnician", fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tickets_tenant_id_technician_fkey")
  preventiveService PreventiveService? @relation(fields: [tenantId, preventiveServiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tickets_tenant_id_preventive_service_id_fkey")
  feedback          TicketFeedback[]
  messages          TicketMessage[]
  attachments       TicketAttachment[]
  visits            TicketVisit[]
  slaClocks         TicketSlaClock[]
  quotes            TicketQuote[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt(sort: Desc), id(sort: Desc)], map: "tickets_tenant_id_status_created_at_idx")
  @@index([tenantId, technicianId, status], map: "tickets_tenant_id_technician_idx")
  @@index([tenantId, reporterId], map: "tickets_tenant_id_reporter_idx")
  @@index([tenantId, createdById], map: "tickets_tenant_id_created_by_idx")
  @@index([tenantId, unitId])
  @@index([tenantId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "tickets_tenant_id_last_activity_idx")
  @@index([tenantId, origin, createdAt(sort: Desc), id(sort: Desc)], map: "tickets_origin_idx")
  @@map("tickets")
}

/// Append-only (ADR 0032): SELECT and INSERT for jiwar_app, triggers refuse
/// the rest for every role. No foreign keys, like gate_entries.
model TicketStatusHistory {
  id         String        @id @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus  @map("to_status")
  /// NULL for the system (the sweep, an escalation).
  actorId    String?       @map("actor_account_id") @db.Uuid
  /// A reason from a closed list; for a hold, the hold reason.
  reasonCode String?       @map("reason_code")
  cycle      Int
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, ticketId, createdAt, id], map: "ticket_status_history_ticket_idx")
  @@map("ticket_status_history")
}

/// A quote on a ticket (ADR 0058): what the work will cost, stated by the
/// dispatch before it starts and approved or declined by the reporter or
/// the unit's primary. The terms never change; decided or withdrawn once.
model TicketQuote {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  ticketId      String    @map("ticket_id") @db.Uuid
  amount        Decimal   @db.Decimal(12, 2)
  /// Staff's words for the residents, 1–1000 characters.
  note          String?
  /// proposed, approved, declined, withdrawn.
  status        String    @default("proposed")
  proposedById  String    @map("proposed_by_account_id") @db.Uuid
  proposedAt    DateTime  @default(now()) @map("proposed_at") @db.Timestamptz(3)
  decidedById   String?   @map("decided_by_account_id") @db.Uuid
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(3)
  /// REASON_CODES.ticketQuoteDecline.
  declineReason String?   @map("decline_reason")
  withdrawnById String?   @map("withdrawn_by_account_id") @db.Uuid
  withdrawnAt   DateTime? @map("withdrawn_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onUpdate: Restrict, map: "ticket_quotes_ticket_fkey")

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, proposedAt, id], map: "ticket_quotes_ticket_idx")
  @@map("ticket_quotes")
}

/// A resident asked for attention on an overdue ticket (ADR 0038): once per
/// SLA cycle. Append-only, like the status history; no foreign keys.
model TicketEscalation {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  /// The SLA's cycle (ADR 0034), not the ticket's.
  slaCycle  Int      @map("sla_cycle")
  accountId String   @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, ticketId, slaCycle], map: "ticket_escalations_once_per_cycle")
  @@map("ticket_escalations")
}

/// Append-only, like the status history. A decline or a release has no `to`.
model TicketAssignment {
  id             String               @id @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  ticketId       String               @map("ticket_id") @db.Uuid
  fromId         String?              @map("from_account_id") @db.Uuid
  toId           String?              @map("to_account_id") @db.Uuid
  /// Who acted: a dispatcher, the technician on a decline, NULL for system.
  assignedById   String?              @map("assigned_by_account_id") @db.Uuid
  assignmentType TicketAssignmentType @map("assignment_type")
  reasonCode     String?              @map("reason_code")
  cycle          Int
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, ticketId, createdAt, id], map: "ticket_assignments_ticket_idx")
  /// What the dispatch engine's tie-break reads (ADR 0033): when a technician
  /// was last given a ticket. The only 5.2 change to a 5.1 table, and only an index.
  @@index([tenantId, toId, createdAt], map: "ticket_assignments_to_account_idx")
  @@map("ticket_assignments")
}

/// The reporter's verdict on a cycle: a confirmation (rating, comment), a
/// rejection or a reopen (a reason code; the note is a message).
model TicketFeedback {
  id                String             @id @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  ticketId          String             @map("ticket_id") @db.Uuid
  cycle             Int
  kind              TicketFeedbackKind
  authorId          String             @map("author_account_id") @db.Uuid
  rating            Int?
  reasonCode        String?            @map("reason_code")
  /// Content: erased with its author, never audited.
  comment           String?
  /// ADR 0038: the technician who did the work, rated on its own; optional.
  technicianRating  Int?               @map("technician_rating")
  ratedTechnicianId String?            @map("rated_technician_account_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket Ticket  @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  author Account @relation("FeedbackAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_feedback_tenant_id_author_fkey")

  @@unique([tenantId, ticketId, cycle, kind])
  @@map("ticket_feedback")
}

/// A ticket's thread. An erasure nulls the body and sets `deletedAt`; the
/// sender stays, pointing at the tombstone.
model TicketMessage {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  ticketId  String    @map("ticket_id") @db.Uuid
  senderId  String    @map("sender_account_id") @db.Uuid
  body      String?
  /// Staff only: never shown to a resident.
  internal  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  ticket Ticket  @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sender Account @relation("MessageSender", fields: [tenantId, senderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_messages_tenant_id_sender_fkey")

  @@index([tenantId, ticketId, createdAt, id], map: "ticket_messages_ticket_idx")
  @@index([tenantId, senderId], map: "ticket_messages_sender_idx")
  @@map("ticket_messages")
}

/// A photo attached to a ticket. The file belongs to the ticket (no owner).
model TicketAttachment {
  id           String               @id @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  ticketId     String               @map("ticket_id") @db.Uuid
  fileId       String               @unique @map("file_id") @db.Uuid
  kind         TicketAttachmentKind
  uploadedById String               @map("uploaded_by_account_id") @db.Uuid
  cycle        Int
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket     Ticket     @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file       StoredFile @relation("AttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy Account    @relation("AttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, ticketId, createdAt, id], map: "ticket_attachments_ticket_idx")
  @@map("ticket_attachments")
}

enum TechnicianAvailabilityState {
  available
  unavailable

  @@map("technician_availability_state")
}

enum DispatchTrigger {
  created
  declined
  available
  manual
  sweep
  role_lost
  released
  /// A manager turned automatic dispatch on: the bounded pass over the queue.
  enabled

  @@map("dispatch_trigger")
}

enum DispatchOutcome {
  assigned
  no_candidate
  skipped

  @@map("dispatch_outcome")
}

/// What a technician can do (ADR 0033): the compound's own data, never
/// deleted; a retired one is `active: false`.
model Specialty {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categories  CategorySpecialty[]
  technicians TechnicianSpecialty[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("specialties")
}

/// Which specialties can handle a category. A category with none can go to
/// any technician.
model CategorySpecialty {
  tenantId    String   @map("tenant_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  specialtyId String   @map("specialty_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  category  TicketCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "category_specialties_tenant_id_category_id_fkey")
  specialty Specialty      @relation(fields: [tenantId, specialtyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "category_specialties_tenant_id_specialty_id_fkey")

  @@id([tenantId, categoryId, specialtyId])
  @@index([tenantId, specialtyId], map: "category_specialties_specialty_idx")
  @@map("category_specialties")
}

/// Set by dispatchers. A row switched off is kept (`active: false`).
model TechnicianSpecialty {
  tenantId    String   @map("tenant_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  specialtyId String   @map("specialty_id") @db.Uuid
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account   Account   @relation("TechnicianSpecialtyAccount", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "technician_specialties_tenant_id_account_id_fkey")
  specialty Specialty @relation(fields: [tenantId, specialtyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "technician_specialties_tenant_id_specialty_id_fkey")

  @@id([tenantId, accountId, specialtyId])
  @@index([tenantId, specialtyId], map: "technician_specialties_specialty_idx")
  @@map("technician_specialties")
}

/// A technician's current state; no row means unavailable (opt-in).
model TechnicianAvailability {
  tenantId  String                      @map("tenant_id") @db.Uuid
  accountId String                      @map("account_id") @db.Uuid
  state     TechnicianAvailabilityState
  changedAt DateTime                    @default(now()) @map("changed_at") @db.Timestamptz(3)

  account Account @relation("TechnicianAvailabilityAccount", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "technician_availability_tenant_id_account_id_fkey")

  @@id([tenantId, accountId])
  @@map("technician_availability")
}

/// Append-only (ADR 0033), like ticket_assignments: SELECT and INSERT for
/// jiwar_app, triggers refuse the rest, no foreign keys.
model TechnicianAvailabilityHistory {
  id          String                       @id @db.Uuid
  tenantId    String                       @map("tenant_id") @db.Uuid
  accountId   String                       @map("account_id") @db.Uuid
  fromState   TechnicianAvailabilityState? @map("from_state")
  toState     TechnicianAvailabilityState  @map("to_state")
  /// The technician, a dispatcher, or NULL for the system.
  changedById String?                      @map("changed_by_account_id") @db.Uuid
  reasonCode  String?                      @map("reason_code")
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, accountId, createdAt, id], map: "technician_availability_history_account_idx")
  @@map("technician_availability_history")
}

/// One row per compound (ADR 0033). Automatic dispatch starts off.
model MaintenanceDispatchSettings {
  tenantId            String   @id @map("tenant_id") @db.Uuid
  autoDispatchEnabled Boolean  @default(false) @map("auto_dispatch_enabled")
  weightAssigned      Decimal  @default(1) @map("weight_assigned") @db.Decimal(5, 2)
  weightInProgress    Decimal  @default(2) @map("weight_in_progress") @db.Decimal(5, 2)
  weightOnHold        Decimal  @default(0) @map("weight_on_hold") @db.Decimal(5, 2)
  multiplierNormal    Decimal  @default(1) @map("multiplier_normal") @db.Decimal(5, 2)
  multiplierUrgent    Decimal  @default(1.5) @map("multiplier_urgent") @db.Decimal(5, 2)
  multiplierEmergency Decimal  @default(3) @map("multiplier_emergency") @db.Decimal(5, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("maintenance_dispatch_settings")
}

/// Every run of the dispatch engine on a ticket (ADR 0033). Append-only,
/// no foreign keys. `notified` marks the row that told the dispatchers the
/// ticket is unassignable: at most one per ticket and cycle.
model TicketDispatchAttempt {
  id             String          @id @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  ticketId       String          @map("ticket_id") @db.Uuid
  cycle          Int
  trigger        DispatchTrigger
  outcome        DispatchOutcome
  candidateCount Int             @map("candidate_count")
  technicianId   String?         @map("technician_account_id") @db.Uuid
  /// Only for `skipped`.
  reasonCode     String?         @map("reason_code")
  notified       Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, ticketId, createdAt, id], map: "ticket_dispatch_attempts_ticket_idx")
  @@map("ticket_dispatch_attempts")
}

// ============================================================================
// Phase 5.3 — visits and the SLA (ADR 0034)
// ============================================================================
enum VisitStatus {
  proposed
  confirmed
  arrived
  done
  no_access
  cancelled
  rescheduled

  @@map("visit_status")
}

/// Which side acted. A dispatcher acts on the technician's side.
enum VisitSide {
  technician
  resident
  system

  @@map("visit_side")
}

enum VisitReceiverKind {
  household
  worker

  @@map("visit_receiver_kind")
}

enum VisitEventKind {
  proposed
  countered
  confirmed
  rescheduled
  cancelled
  consent_granted
  consent_revoked
  consent_voided
  receiver_set
  receiver_cleared
  arrived
  done
  no_access
  late_notified
  /// The residents' side says the technician is really there (ADR 0038).
  arrival_confirmed

  @@map("visit_event_kind")
}

enum SlaClock {
  response
  resolution

  @@map("sla_clock")
}

enum SlaEventKind {
  started
  paused
  resumed
  met
  breached
  retargeted
  stopped

  @@map("sla_event_kind")
}

enum SlaClockState {
  running
  paused
  met
  breached
  stopped

  @@map("sla_clock_state")
}

/// A window in which the technician comes. Its window, consent and receiver
/// tell when a home is empty: never in the audit trail, and notifications
/// carry the window only.
model TicketVisit {
  id                   String             @id @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  ticketId             String             @map("ticket_id") @db.Uuid
  cycle                Int
  technicianId         String             @map("technician_account_id") @db.Uuid
  status               VisitStatus        @default(proposed)
  startsAt             DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime           @map("ends_at") @db.Timestamptz(3)
  proposedBySide       VisitSide          @map("proposed_by_side")
  proposedById         String             @map("proposed_by_account_id") @db.Uuid
  previousVisitId      String?            @map("previous_visit_id") @db.Uuid
  confirmedAt          DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  confirmedById        String?            @map("confirmed_by_account_id") @db.Uuid
  absenceEntryApproved Boolean            @default(false) @map("absence_entry_approved")
  consentById          String?            @map("consent_by_account_id") @db.Uuid
  consentAt            DateTime?          @map("consent_at") @db.Timestamptz(3)
  receiverKind         VisitReceiverKind? @map("receiver_kind")
  receiverAccountId    String?            @map("receiver_account_id") @db.Uuid
  receiverEngagementId String?            @map("receiver_engagement_id") @db.Uuid
  arrivedAt            DateTime?          @map("arrived_at") @db.Timestamptz(3)
  finishedAt           DateTime?          @map("finished_at") @db.Timestamptz(3)
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelReasonCode     String?            @map("cancel_reason_code")
  cancelledBySide      VisitSide?         @map("cancelled_by_side")
  cancelledById        String?            @map("cancelled_by_account_id") @db.Uuid
  lateNotifiedAt       DateTime?          @map("late_notified_at") @db.Timestamptz(3)
  /// The residents' side confirmed the arrival (ADR 0038), once.
  arrivalConfirmedAt   DateTime?          @map("arrival_confirmed_at") @db.Timestamptz(3)
  arrivalConfirmedById String?            @map("arrival_confirmed_by_account_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket             Ticket            @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_visits_tenant_id_ticket_id_fkey")
  technician         Account           @relation("VisitTechnician", fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_visits_tenant_id_technician_fkey")
  receiverAccount    Account?          @relation("VisitReceiver", fields: [tenantId, receiverAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_visits_tenant_id_receiver_account_fkey")
  receiverEngagement WorkerEngagement? @relation(fields: [tenantId, receiverEngagementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_visits_tenant_id_receiver_engagement_fkey")
  previous           TicketVisit?      @relation("VisitPrevious", fields: [tenantId, previousVisitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_visits_tenant_id_previous_fkey")
  next               TicketVisit[]     @relation("VisitPrevious")

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, createdAt, id], map: "ticket_visits_ticket_idx")
  @@map("ticket_visits")
}

/// Append-only: what happened to a visit and who did it. No window times.
model TicketVisitEvent {
  id         String         @id @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  visitId    String         @map("visit_id") @db.Uuid
  ticketId   String         @map("ticket_id") @db.Uuid
  kind       VisitEventKind
  actorSide  VisitSide      @map("actor_side")
  /// NULL for the system.
  actorId    String?        @map("actor_account_id") @db.Uuid
  reasonCode String?        @map("reason_code")
  at         DateTime       @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, ticketId, at, id], map: "ticket_visit_events_ticket_idx")
  @@map("ticket_visit_events")
}

/// One row per compound. Off until the manager turns it on.
model MaintenanceSlaSettings {
  tenantId   String    @id @map("tenant_id") @db.Uuid
  slaEnabled Boolean   @default(false) @map("sla_enabled")
  /// The last activation: an older clock is stopped, never resumed.
  enabledAt  DateTime? @map("enabled_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("maintenance_sla_settings")
}

model SlaTarget {
  tenantId          String         @map("tenant_id") @db.Uuid
  categoryId        String         @map("category_id") @db.Uuid
  priority          TicketPriority
  responseMinutes   Int            @map("response_minutes")
  resolutionMinutes Int            @map("resolution_minutes")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  category TicketCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "sla_targets_tenant_id_category_id_fkey")

  @@id([tenantId, categoryId, priority])
  @@map("sla_targets")
}

/// Append-only. `cycle` is the SLA's own (creation, reopen, activation).
model TicketSlaEvent {
  id            String       @id @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  ticketId      String       @map("ticket_id") @db.Uuid
  cycle         Int
  clock         SlaClock
  seq           Int
  kind          SlaEventKind
  at            DateTime     @db.Timestamptz(3)
  targetMinutes Int          @map("target_minutes")
  reasonCode    String?      @map("reason_code")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, ticketId, cycle, clock, seq], map: "ticket_sla_events_seq_key")
  @@map("ticket_sla_events")
}

/// The projection of ticket_sla_events: rebuildable from them alone.
model TicketSlaClock {
  tenantId      String        @map("tenant_id") @db.Uuid
  ticketId      String        @map("ticket_id") @db.Uuid
  cycle         Int
  clock         SlaClock
  state         SlaClockState
  targetMinutes Int           @map("target_minutes")
  startedAt     DateTime      @map("started_at") @db.Timestamptz(3)
  dueAt         DateTime?     @map("due_at") @db.Timestamptz(3)
  pausedAt      DateTime?     @map("paused_at") @db.Timestamptz(3)
  endedAt       DateTime?     @map("ended_at") @db.Timestamptz(3)
  lastSeq       Int           @map("last_seq")
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_sla_clocks_tenant_id_ticket_id_fkey")

  @@id([tenantId, ticketId, cycle, clock])
  @@map("ticket_sla_clocks")
}

// ============================================================================
// Parcels (ADR 0035)
// ============================================================================

enum ParcelStatus {
  held
  handed_over
  rejected
  returned

  @@map("parcel_status")
}

enum ParcelCarrier {
  aramex
  dhl
  fedex
  ups
  bosta
  mylerz
  egypt_post
  amazon
  noon
  jumia
  talabat
  other

  @@map("parcel_carrier")
}

enum ParcelMethod {
  code
  resident_qr
  delegate

  @@map("parcel_method")
}

enum ParcelEventKind {
  received
  delegate_authorized
  delegate_revoked
  handed_over
  rejected
  returned

  @@map("parcel_event_kind")
}

enum ParcelActorSide {
  guard
  resident
  system

  @@map("parcel_actor_side")
}

enum ParcelCredentialKind {
  holder
  delegate

  @@map("parcel_credential_kind")
}

/// A parcel received at the gate for a unit. `labelName` and the two photos
/// are personal: never in the audit trail or a notification, and cleared 30
/// days after the parcel is handed over or returned. The ids of accounts
/// (guard, recipient) have no foreign key: they name no one.
model Parcel {
  id                  String        @id @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  number              Int
  unitId              String        @map("unit_id") @db.Uuid
  gateId              String        @map("gate_id") @db.Uuid
  shiftId             String        @map("shift_id") @db.Uuid
  receivedById        String        @map("received_by_account_id") @db.Uuid
  carrier             ParcelCarrier
  pieces              Int
  /// The recipient's name as printed on the label. Never shown to a guard
  /// or a manager.
  labelName           String?       @map("label_name")
  photoFileId         String?       @map("photo_file_id") @db.Uuid
  handoverPhotoFileId String?       @map("handover_photo_file_id") @db.Uuid
  status              ParcelStatus  @default(held)
  receivedAt          DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  handedOverAt        DateTime?     @map("handed_over_at") @db.Timestamptz(3)
  handedOverMethod    ParcelMethod? @map("handed_over_method")
  /// The occupant whose entry QR received it (an id, on this row only).
  handedToId          String?       @map("handed_to_account_id") @db.Uuid
  rejectedAt          DateTime?     @map("rejected_at") @db.Timestamptz(3)
  rejectReason        String?       @map("reject_reason")
  returnedAt          DateTime?     @map("returned_at") @db.Timestamptz(3)
  returnReason        String?       @map("return_reason")
  /// Handover or return: the start of the 30 days of retention.
  closedAt            DateTime?     @map("closed_at") @db.Timestamptz(3)
  remindedAt          DateTime?     @map("reminded_at") @db.Timestamptz(3)
  heldLongAt          DateTime?     @map("held_long_at") @db.Timestamptz(3)
  unclaimableAt       DateTime?     @map("unclaimable_notified_at") @db.Timestamptz(3)
  dataClearedAt       DateTime?     @map("data_cleared_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit          Unit               @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  photo         StoredFile?        @relation("ParcelPhoto", fields: [tenantId, photoFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "parcels_tenant_id_photo_file_fkey")
  handoverPhoto StoredFile?        @relation("ParcelHandoverPhoto", fields: [tenantId, handoverPhotoFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "parcels_tenant_id_handover_photo_file_fkey")
  credentials   ParcelCredential[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status, receivedAt(sort: Desc), id(sort: Desc)], map: "parcels_tenant_id_status_received_at_idx")
  @@index([tenantId, unitId, receivedAt(sort: Desc)], map: "parcels_tenant_id_unit_id_idx")
  @@map("parcels")
}

/// The codes of a parcel: its holder code, and at most one live delegate
/// code. Only HMACs are stored, and only while the credential is live; the
/// token behind them is derived from PARCEL_TOKEN_KEY (ADR 0035).
model ParcelCredential {
  id           String               @id @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  parcelId     String               @map("parcel_id") @db.Uuid
  kind         ParcelCredentialKind
  /// Collision retries: the token is derived from (credential id, attempt).
  attempt      Int                  @default(0)
  codeHash     String?              @map("code_hash") @db.Char(64)
  qrTokenHash  String?              @map("qr_token_hash") @db.Char(64)
  /// A delegate's name: personal, kept only while useful (ADR 0035).
  delegateName String?              @map("delegate_name")
  /// The guard who received the parcel, or the occupant who authorized
  /// the delegate (an id, no foreign key).
  createdById  String               @map("created_by_account_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  endedAt      DateTime?            @map("ended_at") @db.Timestamptz(3)
  endReason    String?              @map("end_reason")

  parcel Parcel @relation(fields: [tenantId, parcelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, parcelId], map: "parcel_credentials_parcel_idx")
  @@map("parcel_credentials")
}

/// Append-only (ADR 0035): SELECT and INSERT for jiwar_app, triggers refuse
/// the rest for every role. No foreign keys, like gate_entries. No text.
model ParcelEvent {
  id         String          @id @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  parcelId   String          @map("parcel_id") @db.Uuid
  kind       ParcelEventKind
  actorSide  ParcelActorSide @map("actor_side")
  /// NULL for the system (a sweep, a lifecycle hook).
  actorId    String?         @map("actor_account_id") @db.Uuid
  method     ParcelMethod?
  reasonCode String?         @map("reason_code")
  at         DateTime        @default(now()) @db.Timestamptz(3)

  @@index([tenantId, parcelId, at, id], map: "parcel_events_parcel_idx")
  @@map("parcel_events")
}

/// One row per compound, created with it (like maintenance_settings).
model ParcelSettings {
  tenantId           String   @id @map("tenant_id") @db.Uuid
  parcelReminderDays Int      @default(3) @map("parcel_reminder_days")
  parcelManagerDays  Int      @default(14) @map("parcel_manager_days")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("parcel_settings")
}

/// The last parcel number of a compound, taken under its row lock.
model ParcelCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("parcel_counters")
}

// ============================================================================
// Phase R2 — talking to management (ADR 0039)
//
// A management request is a resident's question, general matter or
// appointment booking, with a conversation between its author and the staff.
// It is private to its author on the resident side. Internal notes are
// staff's alone. Messages, attachments, escalations and ratings never
// change: triggers refuse it for every role, and let through only the
// erasure that clears a message's body or a rating's comment.
// ============================================================================

enum ManagementRequestType {
  question
  general
  appointment

  @@map("management_request_type")
}

enum ManagementRequestStatus {
  open
  in_progress
  answered
  closed

  @@map("management_request_status")
}

enum ManagementSide {
  resident
  staff

  @@map("management_side")
}

enum ManagementActorSide {
  resident
  staff
  system

  @@map("management_actor_side")
}

enum ManagementAppointmentStatus {
  /// The resident's slot, waiting for staff.
  requested
  /// Staff's slot, waiting for the resident.
  proposed
  confirmed
  cancelled
  /// Replaced by a counter-proposal or a new booking.
  superseded

  @@map("management_appointment_status")
}

enum ManagementAppointmentMode {
  in_person
  phone

  @@map("management_appointment_mode")
}

/// A compound's closed list of topics. Never deleted; retired with `active`.
model ManagementRequestTopic {
  id                  String   @id @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  key                 String
  nameAr              String   @map("name_ar")
  nameEn              String   @map("name_en")
  /// The hours management gives itself to answer a request of this topic.
  targetResponseHours Int      @map("target_response_hours")
  active              Boolean  @default(true)
  /// The role that owns the topic (ADR 0058): residents see it, and an
  /// unassigned request goes to that role's handlers. Never a person.
  ownerRoleId         String?  @map("owner_role_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerRole Role?               @relation(fields: [tenantId, ownerRoleId], references: [tenantId, id], onDelete: SetNull, onUpdate: Restrict, map: "management_request_topics_owner_role_fkey")
  requests  ManagementRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("management_request_topics")
}

/// One row per compound, created with it.
model ManagementRequestSettings {
  tenantId                String   @id @map("tenant_id") @db.Uuid
  /// Days an answered request waits for its author before it closes itself.
  autoCloseDays           Int      @default(7) @map("auto_close_days")
  appointmentSlotMinutes  Int      @default(30) @map("appointment_slot_minutes")
  /// Appointments one slot takes.
  appointmentSlotCapacity Int      @default(1) @map("appointment_slot_capacity")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("management_request_settings")
}

/// A weekly office-hours window: weekday 0 is Sunday, minutes after local
/// midnight. The set is replaced as a whole.
model ManagementOfficeHours {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, weekday, startMinute], map: "management_office_hours_window_key")
  @@map("management_office_hours")
}

/// The last request number of a compound, taken under its row lock.
model ManagementRequestCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("management_request_counters")
}

model ManagementRequest {
  id              String                  @id @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  number          Int
  type            ManagementRequestType
  topicId         String                  @map("topic_id") @db.Uuid
  /// Always the resident, also when staff opened it for them.
  authorId        String                  @map("author_account_id") @db.Uuid
  /// The staff member who opened it on the resident's behalf.
  openedById      String?                 @map("opened_by_account_id") @db.Uuid
  onBehalfReason  String?                 @map("on_behalf_reason")
  unitId          String?                 @map("unit_id") @db.Uuid
  status          ManagementRequestStatus @default(open)
  /// 1 at creation, +1 at every reopening.
  cycle           Int                     @default(1)
  cycleStartedAt  DateTime                @map("cycle_started_at") @db.Timestamptz(3)
  /// The cycle's start plus the topic's target, fixed for the cycle.
  responseDueAt   DateTime                @map("response_due_at") @db.Timestamptz(3)
  /// The cycle's first staff response: stops the response clock.
  firstResponseAt DateTime?               @map("first_response_at") @db.Timestamptz(3)
  /// The cycle was escalated (at most once).
  escalatedAt     DateTime?               @map("escalated_at") @db.Timestamptz(3)
  assigneeId      String?                 @map("assignee_account_id") @db.Uuid
  answeredAt      DateTime?               @map("answered_at") @db.Timestamptz(3)
  closedAt        DateTime?               @map("closed_at") @db.Timestamptz(3)
  closeReason     String?                 @map("close_reason")
  closedBySide    ManagementActorSide?    @map("closed_by_side")
  /// What both lists are ordered by. Internal notes do not move it.
  lastActivityAt  DateTime                @map("last_activity_at") @db.Timestamptz(3)
  /// What the request is about, when it asks to release a hold (ADR 0058):
  /// maintenance (a ticket), unit_permit (a stopped work), unit_credit (a
  /// unit's id). Fixed, with the hold's reason code as it was.
  aboutType       String?                 @map("about_type")
  aboutId         String?                 @map("about_id") @db.Uuid
  aboutReason     String?                 @map("about_reason")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  topic        ManagementRequestTopic     @relation(fields: [tenantId, topicId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  author       Account                    @relation("ManagementRequestAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_requests_tenant_id_author_fkey")
  openedBy     Account?                   @relation("ManagementRequestOpenedBy", fields: [tenantId, openedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_requests_tenant_id_opened_by_fkey")
  assignee     Account?                   @relation("ManagementRequestAssignee", fields: [tenantId, assigneeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_requests_tenant_id_assignee_fkey")
  unit         Unit?                      @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  messages     ManagementRequestMessage[]
  rating       ManagementRequestRating?
  appointments ManagementAppointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, authorId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "management_requests_author_activity_idx")
  @@index([tenantId, status, lastActivityAt(sort: Desc), id(sort: Desc)], map: "management_requests_status_activity_idx")
  @@index([tenantId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "management_requests_activity_idx")
  @@map("management_requests")
}

model ManagementRequestMessage {
  id         String         @id @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  requestId  String         @map("request_id") @db.Uuid
  senderId   String         @map("sender_account_id") @db.Uuid
  senderSide ManagementSide @map("sender_side")
  /// A staff note: no resident route returns it or its attachments.
  internal   Boolean        @default(false)
  /// Chosen by staff when sending; makes the request answered.
  official   Boolean        @default(false)
  /// Free text, may name people: never in the audit trail or a
  /// notification. NULL once its sender is erased.
  body       String?
  cycle      Int
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  erasedAt   DateTime?      @map("erased_at") @db.Timestamptz(3)

  request     ManagementRequest             @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sender      Account                       @relation("ManagementMessageSender", fields: [tenantId, senderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_request_messages_tenant_id_sender_fkey")
  attachments ManagementRequestAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, requestId, id], map: "management_request_messages_request_message_key")
  @@index([tenantId, requestId, createdAt, id], map: "management_request_messages_request_idx")
  @@index([tenantId, senderId], map: "management_request_messages_sender_idx")
  @@map("management_request_messages")
}

model ManagementRequestAttachment {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  fileId       String   @unique @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message    ManagementRequestMessage @relation(fields: [tenantId, requestId, messageId], references: [tenantId, requestId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_request_attachments_message_fkey")
  file       StoredFile               @relation("ManagementAttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy Account                  @relation("ManagementAttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_request_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, messageId, createdAt, id], map: "management_request_attachments_message_idx")
  @@map("management_request_attachments")
}

/// Append-only, no foreign keys: one per cycle, written by the sweep.
model ManagementRequestEscalation {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  cycle     Int
  /// The response time that passed.
  dueAt     DateTime @map("due_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, requestId, cycle], map: "management_request_escalations_once_per_cycle")
  @@map("management_request_escalations")
}

/// Once per request, by its author. Shown only to `requests.manage`.
model ManagementRequestRating {
  tenantId  String   @map("tenant_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  authorId  String   @map("author_account_id") @db.Uuid
  rating    Int
  /// Free text: NULL once its author is erased.
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request ManagementRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  author  Account           @relation("ManagementRatingAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_request_ratings_tenant_id_author_fkey")

  @@id([tenantId, requestId])
  @@index([tenantId, authorId], map: "management_request_ratings_author_idx")
  @@map("management_request_ratings")
}

model ManagementAppointment {
  id              String                      @id @db.Uuid
  tenantId        String                      @map("tenant_id") @db.Uuid
  requestId       String                      @map("request_id") @db.Uuid
  status          ManagementAppointmentStatus
  mode            ManagementAppointmentMode
  startsAt        DateTime                    @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime                    @map("ends_at") @db.Timestamptz(3)
  proposedBySide  ManagementSide              @map("proposed_by_side")
  proposedById    String                      @map("proposed_by_account_id") @db.Uuid
  confirmedAt     DateTime?                   @map("confirmed_at") @db.Timestamptz(3)
  /// Cancelled or superseded.
  endedAt         DateTime?                   @map("ended_at") @db.Timestamptz(3)
  cancelReason    String?                     @map("cancel_reason")
  cancelledBySide ManagementActorSide?        @map("cancelled_by_side")
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  request    ManagementRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  proposedBy Account           @relation("ManagementAppointmentProposer", fields: [tenantId, proposedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_appointments_tenant_id_proposed_by_fkey")

  @@index([tenantId, status, startsAt, id], map: "management_appointments_status_idx")
  @@index([tenantId, requestId, createdAt, id], map: "management_appointments_request_idx")
  @@map("management_appointments")
}

/// A slot's lock row: a booking locks it, then counts the live appointments
/// on that window. It holds no count.
model ManagementAppointmentSlot {
  tenantId String   @map("tenant_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, startsAt])
  @@map("management_appointment_slots")
}

/// The compound's last decision appeal number (ADR 0059).
model DecisionAppealCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  @@map("decision_appeal_counters")
}

/// A resident's appeal of a staff decision about their unit, to the
/// management (ADR 0059): a rejected permit, vehicle or worker, a neighbour
/// notice. Decided once by a manager who did not take the decision, with a
/// rationale; its domain applies an overturn through its normal approval,
/// or leaves it to be followed up.
model DecisionAppeal {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  number           Int
  kind             String
  subjectId        String    @map("subject_id") @db.Uuid
  unitId           String    @map("unit_id") @db.Uuid
  appellantId      String    @map("appellant_account_id") @db.Uuid
  grounds          String?
  groundsClearedAt DateTime? @map("grounds_cleared_at") @db.Timestamptz(3)
  decisionAt       DateTime  @map("decision_at") @db.Timestamptz(3)
  /// Who took the decision appealed (they may not decide the appeal).
  decisionById     String?   @map("decision_by_account_id") @db.Uuid
  lodgedAt         DateTime  @map("lodged_at") @db.Timestamptz(3)
  status           String    @default("pending")
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedById      String?   @map("decided_by_account_id") @db.Uuid
  /// The decider's role as it was then: its key, and its name if named.
  deciderRoleKey   String?   @map("decider_role_key")
  deciderRoleName  String?   @map("decider_role_name")
  rationale        String?
  withdrawnAt      DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  effect           String?
  effectReason     String?   @map("effect_reason")
  followedUpAt     DateTime? @map("followed_up_at") @db.Timestamptz(3)
  followedUpById   String?   @map("followed_up_by_account_id") @db.Uuid
  /// Taken to the board once upheld (`management_appeal`), and the board's
  /// decision: set once each.
  boardAppealAt       DateTime? @map("board_appeal_at") @db.Timestamptz(3)
  boardAppealClosedAt DateTime? @map("board_appeal_closed_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "decision_appeals_number_key")
  @@unique([tenantId, kind, subjectId], map: "decision_appeals_one_per_decision")
  @@index([tenantId, status, lodgedAt, id], map: "decision_appeals_status_idx")
  @@index([tenantId, unitId, lodgedAt, id], map: "decision_appeals_unit_idx")
  @@index([tenantId, appellantId, lodgedAt, id], map: "decision_appeals_appellant_idx")
  @@map("decision_appeals")
}

/// A decision appeal's attached file, in order (ADR 0059). Never changed.
model DecisionAppealAttachment {
  tenantId String @map("tenant_id") @db.Uuid
  appealId String @map("appeal_id") @db.Uuid
  fileId   String @map("file_id") @db.Uuid
  position Int    @db.SmallInt

  @@id([tenantId, appealId, position])
  @@unique([tenantId, fileId], map: "decision_appeal_attachments_file_key")
  @@map("decision_appeal_attachments")
}

// ============================================================================
// Community life (ADR 0040): announcements, works and closures, events,
// consultative polls, suggestions. The domain is src/engagement.
// ============================================================================

/// One row per compound, created with it.
model EngagementSettings {
  tenantId       String   @id @map("tenant_id") @db.Uuid
  /// Guests one "going" answer to an event may bring, at most.
  eventMaxGuests Int      @default(2) @map("event_max_guests")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("engagement_settings")
}

/// The compound's closed list of what a suggestion is about. Never deleted;
/// retired with `active`.
model SuggestionTopic {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  suggestions Suggestion[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("suggestion_topics")
}

/// Which capacities a piece of community content is put to (ADR 0040).
enum AudienceOccupancy {
  everyone
  owners
  tenants

  @@map("audience_occupancy")
}

enum AnnouncementKind {
  general
  /// Works and closures: dated, with the area they affect.
  works
  /// The owners' board's decisions and minutes (ADR 0051): a board
  /// publication names each; the staff never write one.
  board

  @@map("announcement_kind")
}

enum AnnouncementPriority {
  normal
  important

  @@map("announcement_priority")
}

enum WorksAreaKind {
  road
  facility
  gate

  @@map("works_area_kind")
}

enum ReadMarkKind {
  account
  unit

  @@map("read_mark_kind")
}

/// An announcement (ADR 0040). Never deleted: archived. Draft while
/// `publishAt` is null, scheduled while it is ahead. Its audience is a rule
/// read against today's residents; `audienceBuildings` empty is the whole
/// compound. What it says is its current version's.
model Announcement {
  id                String               @id @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  kind              AnnouncementKind
  priority          AnnouncementPriority @default(normal)
  /// Only an important announcement is pinned (CHECK).
  pinnedUntil       DateTime?            @map("pinned_until") @db.Timestamptz(3)
  publishAt         DateTime?            @map("publish_at") @db.Timestamptz(3)
  /// A general announcement's; works end by their own dates.
  expiresAt         DateTime?            @map("expires_at") @db.Timestamptz(3)
  archivedAt        DateTime?            @map("archived_at") @db.Timestamptz(3)
  audienceBuildings String[]             @default([]) @map("audience_buildings")
  audienceOccupancy AudienceOccupancy    @default(everyone) @map("audience_occupancy")
  currentVersion    Int                  @default(1) @map("current_version")
  /// The last edit made after it was out: what "edited" shows.
  editedAt          DateTime?            @map("edited_at") @db.Timestamptz(3)
  /// When its audience was told (important ones only).
  notifiedAt        DateTime?            @map("notified_at") @db.Timestamptz(3)
  worksStartsAt     DateTime?            @map("works_starts_at") @db.Timestamptz(3)
  worksEndsAt       DateTime?            @map("works_ends_at") @db.Timestamptz(3)
  worksAreaKind     WorksAreaKind?       @map("works_area_kind")
  worksGateId       String?              @map("works_gate_id") @db.Uuid
  worksPlace        String?              @map("works_place")
  createdById       String               @map("created_by_account_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy   Account                  @relation("AnnouncementCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "announcements_tenant_id_created_by_fkey")
  worksGate   Gate?                    @relation(fields: [tenantId, worksGateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  versions    AnnouncementVersion[]
  attachments AnnouncementAttachment[]
  readMarks   AnnouncementReadMark[]

  @@unique([tenantId, id])
  @@index([tenantId, publishAt, id], map: "announcements_feed_idx")
  @@index([tenantId, createdAt, id], map: "announcements_created_idx")
  @@map("announcements")
}

/// What an announcement said, version by version. Append-only.
model AnnouncementVersion {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  version        Int
  titleEn        String?  @map("title_en")
  bodyEn         String?  @map("body_en")
  titleAr        String?  @map("title_ar")
  bodyAr         String?  @map("body_ar")
  /// The attachments this version shows (announcement_attachments ids).
  attachmentIds  String[] @default([]) @map("attachment_ids") @db.Uuid
  editedById     String   @map("edited_by_account_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  announcement Announcement @relation(fields: [tenantId, announcementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  editedBy     Account      @relation("AnnouncementVersionEditor", fields: [tenantId, editedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "announcement_versions_tenant_id_edited_by_fkey")

  @@unique([tenantId, announcementId, version], map: "announcement_versions_announcement_version_key")
  @@map("announcement_versions")
}

/// A file attached to an announcement. Append-only.
model AnnouncementAttachment {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  fileId         String   @unique @map("file_id") @db.Uuid
  uploadedById   String   @map("uploaded_by_account_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  announcement Announcement @relation(fields: [tenantId, announcementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file         StoredFile   @relation("AnnouncementAttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy   Account      @relation("AnnouncementAttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "announcement_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, announcementId, createdAt, id], map: "announcement_attachments_announcement_idx")
  @@map("announcement_attachments")
}

/// Counts an announcement's readers without naming them: `ref` is a keyed
/// hash of the account or the unit. Append-only.
model AnnouncementReadMark {
  tenantId       String       @map("tenant_id") @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  kind           ReadMarkKind
  ref            Bytes

  announcement Announcement @relation(fields: [tenantId, announcementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, announcementId, kind, ref])
  @@map("announcement_read_marks")
}

enum EventRsvpResponse {
  going
  not_going

  @@map("event_rsvp_response")
}

/// An event of the compound (ADR 0040). Out from the moment it is written;
/// never deleted: cancelled. Its audience is a rule, as an announcement's.
model CommunityEvent {
  id                String            @id @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  titleEn           String?           @map("title_en")
  descriptionEn     String?           @map("description_en")
  titleAr           String?           @map("title_ar")
  descriptionAr     String?           @map("description_ar")
  place             String
  startsAt          DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime          @map("ends_at") @db.Timestamptz(3)
  /// Seats, guests included. Null: no limit.
  capacity          Int?
  audienceBuildings String[]          @default([]) @map("audience_buildings")
  audienceOccupancy AudienceOccupancy @default(everyone) @map("audience_occupancy")
  /// The attachments it shows (event_attachments ids).
  attachmentIds     String[]          @default([]) @map("attachment_ids") @db.Uuid
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  /// A code from the closed list `communityEventCancel`.
  cancelReason      String?           @map("cancel_reason")
  /// For children of an age range (ADR 0054): fixed once written.
  forChildren       Boolean           @default(false) @map("for_children")
  childAgeMin       Int?              @map("child_age_min")
  childAgeMax       Int?              @map("child_age_max")
  createdById       String            @map("created_by_account_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy   Account           @relation("CommunityEventCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "community_events_tenant_id_created_by_fkey")
  attachments EventAttachment[]
  rsvps       EventRsvp[]

  @@unique([tenantId, id])
  @@index([tenantId, startsAt, id], map: "community_events_starts_idx")
  @@map("community_events")
}

/// A file attached to an event. Append-only.
model EventAttachment {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  fileId       String   @unique @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event      CommunityEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file       StoredFile     @relation("EventAttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy Account        @relation("EventAttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "event_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, eventId, createdAt, id], map: "event_attachments_event_idx")
  @@map("event_attachments")
}

/// One account's answer to an event, changed in place. Seats are counted
/// under the event's row lock: 1 + guests for each "going".
model EventRsvp {
  id        String            @id @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  eventId   String            @map("event_id") @db.Uuid
  accountId String            @map("account_id") @db.Uuid
  unitId    String            @map("unit_id") @db.Uuid
  response  EventRsvpResponse
  guests    Int               @default(0)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  event   CommunityEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account Account        @relation("EventRsvpAccount", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit    Unit           @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, eventId, accountId], map: "event_rsvps_one_per_account")
  @@index([tenantId, eventId, createdAt, id], map: "event_rsvps_list_idx")
  @@index([tenantId, accountId], map: "event_rsvps_account_idx")
  @@map("event_rsvps")
}

/// A consultative poll (ADR 0040): one vote per unit, a secret ballot.
/// `ballotSalt` lives while the poll is neither closed nor cancelled.
model Poll {
  id                String            @id @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  questionEn        String?           @map("question_en")
  questionAr        String?           @map("question_ar")
  /// Several options may be chosen.
  multiple          Boolean           @default(false)
  opensAt           DateTime          @map("opens_at") @db.Timestamptz(3)
  closesAt          DateTime          @map("closes_at") @db.Timestamptz(3)
  audienceBuildings String[]          @default([]) @map("audience_buildings")
  audienceOccupancy AudienceOccupancy @default(everyone) @map("audience_occupancy")
  ballotSalt        Bytes?            @map("ballot_salt")
  closedAt          DateTime?         @map("closed_at") @db.Timestamptz(3)
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  /// Units that voted, written at the close.
  finalTurnout      Int?              @map("final_turnout")
  createdById       String            @map("created_by_account_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      Account             @relation("PollCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "polls_tenant_id_created_by_fkey")
  options        PollOption[]
  ballotBox      PollBallotBox?
  participations PollParticipation[]

  @@unique([tenantId, id])
  @@index([tenantId, closesAt, id], map: "polls_closes_idx")
  @@map("polls")
}

model PollOption {
  id         String  @id @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  pollId     String  @map("poll_id") @db.Uuid
  position   Int
  labelEn    String? @map("label_en")
  labelAr    String? @map("label_ar")
  /// Written once, when the poll closes.
  finalCount Int?    @map("final_count")

  poll Poll @relation(fields: [tenantId, pollId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, pollId, position], map: "poll_options_position_key")
  @@map("poll_options")
}

/// Every ballot of an open poll, in one row: `{ <ballot reference>: [option
/// ids] }`. No unit, no account, no time; deleted when the poll ends.
model PollBallotBox {
  tenantId String @map("tenant_id") @db.Uuid
  pollId   String @map("poll_id") @db.Uuid
  ballots  Json   @default("{}")

  poll Poll @relation(fields: [tenantId, pollId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, pollId])
  @@map("poll_ballot_boxes")
}

/// A unit took part in a closed poll; never what it chose. Written at the
/// close, for all units at once. Append-only.
model PollParticipation {
  tenantId String @map("tenant_id") @db.Uuid
  pollId   String @map("poll_id") @db.Uuid
  unitId   String @map("unit_id") @db.Uuid

  poll Poll @relation(fields: [tenantId, pollId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit Unit @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, pollId, unitId])
  @@map("poll_participations")
}

enum SuggestionStatus {
  received
  under_review
  planned
  done
  declined

  @@map("suggestion_status")
}

/// A resident's suggestion (ADR 0040): private to its author and the
/// staff. `body` is the resident's words; an erasure clears it and nothing
/// else. On the board it is shown by the staff's public summary, never by
/// the body or the author. A trigger keeps the author, topic and words.
model Suggestion {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  authorId          String           @map("author_account_id") @db.Uuid
  unitId            String?          @map("unit_id") @db.Uuid
  topicId           String           @map("topic_id") @db.Uuid
  body              String?
  erasedAt          DateTime?        @map("erased_at") @db.Timestamptz(3)
  status            SuggestionStatus @default(received)
  /// The staff's answer to the author, as it stands now.
  response          String?
  respondedAt       DateTime?        @map("responded_at") @db.Timestamptz(3)
  publishedAt       DateTime?        @map("published_at") @db.Timestamptz(3)
  publicTitleEn     String?          @map("public_title_en")
  publicTextEn      String?          @map("public_text_en")
  publicTitleAr     String?          @map("public_title_ar")
  publicTextAr      String?          @map("public_text_ar")
  doneAt            DateTime?        @map("done_at") @db.Timestamptz(3)
  doneNoteEn        String?          @map("done_note_en")
  doneNoteAr        String?          @map("done_note_ar")
  /// The photos the "we did" note shows (suggestion_attachments ids).
  doneAttachmentIds String[]         @default([]) @map("done_attachment_ids") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author      Account                @relation("SuggestionAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "suggestions_tenant_id_author_fkey")
  unit        Unit?                  @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  topic       SuggestionTopic        @relation(fields: [tenantId, topicId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  updates     SuggestionUpdate[]
  attachments SuggestionAttachment[]
  supports    SuggestionSupport[]

  @@unique([tenantId, id])
  @@index([tenantId, authorId, createdAt, id], map: "suggestions_author_idx")
  @@index([tenantId, createdAt, id], map: "suggestions_created_idx")
  @@index([tenantId, publishedAt, id], map: "suggestions_board_idx")
  @@index([tenantId, doneAt, id], map: "suggestions_done_idx")
  @@map("suggestions")
}

/// Each move and each answer of a suggestion, in the staff's words.
/// Append-only.
model SuggestionUpdate {
  id           String           @id @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  suggestionId String           @map("suggestion_id") @db.Uuid
  status       SuggestionStatus
  response     String?
  byId         String           @map("by_account_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  suggestion Suggestion @relation(fields: [tenantId, suggestionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  by         Account    @relation("SuggestionUpdateBy", fields: [tenantId, byId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "suggestion_updates_tenant_id_by_fkey")

  @@index([tenantId, suggestionId, createdAt, id], map: "suggestion_updates_suggestion_idx")
  @@map("suggestion_updates")
}

/// A photo of what was done. Append-only.
model SuggestionAttachment {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  suggestionId String   @map("suggestion_id") @db.Uuid
  fileId       String   @unique @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  suggestion Suggestion @relation(fields: [tenantId, suggestionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file       StoredFile @relation("SuggestionAttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy Account    @relation("SuggestionAttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "suggestion_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, suggestionId, createdAt, id], map: "suggestion_attachments_suggestion_idx")
  @@map("suggestion_attachments")
}

/// An account supports a published suggestion: one row, deleted to take it
/// back.
model SuggestionSupport {
  tenantId     String @map("tenant_id") @db.Uuid
  suggestionId String @map("suggestion_id") @db.Uuid
  accountId    String @map("account_id") @db.Uuid

  suggestion Suggestion @relation(fields: [tenantId, suggestionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account    Account    @relation("SuggestionSupporter", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, suggestionId, accountId])
  @@index([tenantId, accountId], map: "suggestion_supports_account_idx")
  @@map("suggestion_supports")
}

// ============================================================================
// Neighbours (ADR 0042): complaints between units, lost and found, the
// lending board, masked contact and the welcome. The domain is
// src/neighbours.
// ============================================================================

/// One row per compound, created with it.
model NeighbourSettings {
  tenantId                  String   @id @map("tenant_id") @db.Uuid
  /// Complaints one author may have open at once.
  maxOpenComplaints         Int      @default(5) @map("max_open_complaints")
  /// Days a lost or found post stays on the board.
  lostFoundExpiryDays       Int      @default(30) @map("lost_found_expiry_days")
  /// Days a lending post stays on the board.
  lendingExpiryDays         Int      @default(14) @map("lending_expiry_days")
  /// Posts one author may have on the boards at once.
  maxOpenPosts              Int      @default(5) @map("max_open_posts")
  /// Conversations one account may start in 24 hours.
  maxNewConversationsPerDay Int      @default(10) @map("max_new_conversations_per_day")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("neighbour_settings")
}

/// The compound's closed list of what a complaint against a unit is about.
/// Never deleted; retired with `active`.
model NeighbourComplaintCategory {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  complaints NeighbourComplaint[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("neighbour_complaint_categories")
}

enum NeighbourComplaintStatus {
  submitted
  under_review
  notice_sent
  mediation
  resolved
  dismissed

  @@map("neighbour_complaint_status")
}

/// Whose a complaint message is: the complainant's thread with the staff,
/// the complained-about unit's thread with the staff, or the staff's notes.
enum NeighbourThread {
  complainant
  target
  internal

  @@map("neighbour_thread")
}

enum NeighbourSide {
  resident
  staff

  @@map("neighbour_side")
}

/// Who a notice went to: the household living in the unit, or its owners.
enum NeighbourRecipientKind {
  household
  owners

  @@map("neighbour_recipient_kind")
}

/// One row per compound; its row lock serializes the compound's new
/// complaints.
model NeighbourComplaintCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("neighbour_complaint_counters")
}

/// A complaint against a unit, never a person. No free text of its own:
/// what it says is its first message. Its number, parties and category
/// never change (trigger).
model NeighbourComplaint {
  id             String                   @id @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  /// `NC-000123` to the complainant and the staff; never shown to the unit
  /// complained about.
  number         Int
  authorId       String                   @map("author_account_id") @db.Uuid
  /// One of the author's own units, when they name one.
  authorUnitId   String?                  @map("author_unit_id") @db.Uuid
  /// The unit complained about.
  targetUnitId   String                   @map("target_unit_id") @db.Uuid
  categoryId     String                   @map("category_id") @db.Uuid
  status         NeighbourComplaintStatus @default(submitted)
  closedAt       DateTime?                @map("closed_at") @db.Timestamptz(3)
  closeReason    String?                  @map("close_reason")
  closedBySide   NeighbourSide?           @map("closed_by_side")
  /// What the lists are ordered by. Internal notes and the unit's own
  /// thread do not move it.
  lastActivityAt DateTime                 @map("last_activity_at") @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author     Account                          @relation("NeighbourComplaintAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaints_tenant_id_author_fkey")
  authorUnit Unit?                            @relation("NeighbourComplaintAuthorUnit", fields: [tenantId, authorUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaints_tenant_id_author_unit_fkey")
  targetUnit Unit                             @relation("NeighbourComplaintTargetUnit", fields: [tenantId, targetUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaints_tenant_id_target_unit_fkey")
  category   NeighbourComplaintCategory       @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  history    NeighbourComplaintStatusChange[]
  messages   NeighbourComplaintMessage[]
  notice     NeighbourComplaintNotice?

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, authorId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "neighbour_complaints_author_activity_idx")
  @@index([tenantId, status, lastActivityAt(sort: Desc), id(sort: Desc)], map: "neighbour_complaints_status_activity_idx")
  @@index([tenantId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "neighbour_complaints_activity_idx")
  @@index([tenantId, targetUnitId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "neighbour_complaints_target_unit_idx")
  @@map("neighbour_complaints")
}

/// Every status a complaint has had, in order; the first is its filing.
/// Append-only.
model NeighbourComplaintStatusChange {
  id          String                    @id @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  complaintId String                    @map("complaint_id") @db.Uuid
  fromStatus  NeighbourComplaintStatus? @map("from_status")
  toStatus    NeighbourComplaintStatus  @map("to_status")
  actorId     String                    @map("actor_account_id") @db.Uuid
  actorSide   NeighbourSide             @map("actor_side")
  reasonCode  String?                   @map("reason_code")
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  complaint NeighbourComplaint @relation(fields: [tenantId, complaintId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  actor     Account            @relation("NeighbourComplaintStatusActor", fields: [tenantId, actorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaint_status_history_tenant_id_actor_fkey")

  @@index([tenantId, complaintId, createdAt, id], map: "neighbour_complaint_status_history_complaint_idx")
  @@map("neighbour_complaint_status_history")
}

/// One message in one of a complaint's three threads. Never changes; an
/// erasure clears its body.
model NeighbourComplaintMessage {
  id          String          @id @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  complaintId String          @map("complaint_id") @db.Uuid
  thread      NeighbourThread
  senderId    String          @map("sender_account_id") @db.Uuid
  senderSide  NeighbourSide   @map("sender_side")
  /// Free text, may name people: never in the audit trail or a
  /// notification. NULL once its sender is erased.
  body        String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  erasedAt    DateTime?       @map("erased_at") @db.Timestamptz(3)

  complaint   NeighbourComplaint             @relation(fields: [tenantId, complaintId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sender      Account                        @relation("NeighbourComplaintMessageSender", fields: [tenantId, senderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaint_messages_tenant_id_sender_fkey")
  attachments NeighbourComplaintAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, complaintId, id], map: "neighbour_complaint_messages_complaint_message_key")
  @@index([tenantId, complaintId, thread, createdAt, id], map: "neighbour_complaint_messages_thread_idx")
  @@index([tenantId, senderId], map: "neighbour_complaint_messages_sender_idx")
  @@map("neighbour_complaint_messages")
}

model NeighbourComplaintAttachment {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  complaintId  String   @map("complaint_id") @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  fileId       String   @unique @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message    NeighbourComplaintMessage @relation(fields: [tenantId, complaintId, messageId], references: [tenantId, complaintId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaint_attachments_message_fkey")
  file       StoredFile                @relation("NeighbourComplaintAttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy Account                   @relation("NeighbourComplaintAttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaint_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, messageId, createdAt, id], map: "neighbour_complaint_attachments_message_idx")
  @@map("neighbour_complaint_attachments")
}

/// The notice to the unit complained about: at most one per complaint, in
/// the staff's words. Append-only.
model NeighbourComplaintNotice {
  id            String                 @id @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  complaintId   String                 @map("complaint_id") @db.Uuid
  /// The staff's text: the only words of the matter the unit ever reads.
  body          String
  recipientKind NeighbourRecipientKind @map("recipient_kind")
  sentById      String                 @map("sent_by_account_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Withdrawn once, by an overturned decision appeal (ADR 0059).
  withdrawnAt   DateTime?              @map("withdrawn_at") @db.Timestamptz(3)

  complaint  NeighbourComplaint                  @relation(fields: [tenantId, complaintId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sentBy     Account                             @relation("NeighbourNoticeSender", fields: [tenantId, sentById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaint_notices_tenant_id_sent_by_fkey")
  recipients NeighbourComplaintNoticeRecipient[]

  @@unique([tenantId, id])
  @@unique([tenantId, complaintId], map: "neighbour_complaint_notices_one_per_complaint")
  @@map("neighbour_complaint_notices")
}

/// Who a notice went to, written down when it was sent. Append-only.
model NeighbourComplaintNoticeRecipient {
  tenantId  String @map("tenant_id") @db.Uuid
  noticeId  String @map("notice_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  notice  NeighbourComplaintNotice @relation(fields: [tenantId, noticeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account Account                  @relation("NeighbourNoticeRecipient", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, noticeId, accountId])
  @@index([tenantId, accountId], map: "neighbour_complaint_notice_recipients_account_idx")
  @@map("neighbour_complaint_notice_recipients")
}

enum NeighbourPostKind {
  lost
  found
  lend
  borrow

  @@map("neighbour_post_kind")
}

enum NeighbourPostStatus {
  open
  closed

  @@map("neighbour_post_status")
}

enum NeighbourClaimStatus {
  pending
  handed_over
  declined
  withdrawn

  @@map("neighbour_claim_status")
}

/// A post on one of the two boards: lost and found (`lost`, `found`), or
/// lending (`lend`, `borrow`). It leaves the board at `expiresAt`, by the
/// reader's clock. Its author, kind and dates never change (trigger).
model NeighbourPost {
  id           String              @id @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  kind         NeighbourPostKind
  authorId     String              @map("author_account_id") @db.Uuid
  authorSide   NeighbourSide       @map("author_side")
  /// The resident author's own unit: only its building is ever shown.
  authorUnitId String?             @map("author_unit_id") @db.Uuid
  /// Free text: never in the audit trail or a notification. NULL once its
  /// author is erased.
  body         String?
  /// Free text, as `body`.
  place        String?
  occurredOn   DateTime?           @map("occurred_on") @db.Date
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(3)
  status       NeighbourPostStatus @default(open)
  closedAt     DateTime?           @map("closed_at") @db.Timestamptz(3)
  closeReason  String?             @map("close_reason")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  erasedAt     DateTime?           @map("erased_at") @db.Timestamptz(3)

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author        Account                 @relation("NeighbourPostAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_posts_tenant_id_author_fkey")
  authorUnit    Unit?                   @relation(fields: [tenantId, authorUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_posts_tenant_id_author_unit_fkey")
  photos        NeighbourPostPhoto[]
  claims        NeighbourItemClaim[]
  handover      NeighbourItemHandover?
  conversations NeighbourConversation[]

  @@unique([tenantId, id])
  @@index([tenantId, status, kind, createdAt(sort: Desc), id(sort: Desc)], map: "neighbour_posts_board_idx")
  @@index([tenantId, authorId, createdAt(sort: Desc), id(sort: Desc)], map: "neighbour_posts_author_idx")
  @@map("neighbour_posts")
}

/// Never updated; deleted only with its file, by an erasure (trigger).
model NeighbourPostPhoto {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  fileId    String   @unique @map("file_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post NeighbourPost @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file StoredFile    @relation("NeighbourPostPhotoFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, postId, createdAt, id], map: "neighbour_post_photos_post_idx")
  @@map("neighbour_post_photos")
}

/// A resident's claim on a found item held at the office.
model NeighbourItemClaim {
  id            String               @id @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  postId        String               @map("post_id") @db.Uuid
  claimantId    String               @map("claimant_account_id") @db.Uuid
  /// Free text for the staff: NULL once its claimant is erased.
  note          String?
  status        NeighbourClaimStatus @default(pending)
  declineReason String?              @map("decline_reason")
  decidedAt     DateTime?            @map("decided_at") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  post     NeighbourPost          @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  claimant Account                @relation("NeighbourClaimant", fields: [tenantId, claimantId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_item_claims_tenant_id_claimant_fkey")
  handover NeighbourItemHandover?

  @@unique([tenantId, id])
  @@index([tenantId, postId, createdAt, id], map: "neighbour_item_claims_post_idx")
  @@index([tenantId, claimantId, createdAt(sort: Desc), id(sort: Desc)], map: "neighbour_item_claims_claimant_idx")
  @@map("neighbour_item_claims")
}

/// A found item handed over at the office: to whom, by whom, when.
/// Append-only.
model NeighbourItemHandover {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  /// The claim it settled; none for someone who came without one.
  claimId     String?  @map("claim_id") @db.Uuid
  recipientId String   @map("recipient_account_id") @db.Uuid
  handedById  String   @map("handed_by_account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post      NeighbourPost       @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  claim     NeighbourItemClaim? @relation(fields: [tenantId, claimId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  recipient Account             @relation("NeighbourHandoverRecipient", fields: [tenantId, recipientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_item_handovers_tenant_id_recipient_fkey")
  handedBy  Account             @relation("NeighbourHandoverStaff", fields: [tenantId, handedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_item_handovers_tenant_id_handed_by_fkey")

  @@unique([tenantId, postId], map: "neighbour_item_handovers_one_per_post")
  @@unique([tenantId, claimId], map: "neighbour_item_handovers_claim_id_key")
  @@map("neighbour_item_handovers")
}

enum NeighbourReportStatus {
  open
  closed

  @@map("neighbour_report_status")
}

/// A masked conversation on a board post, between the post's author and
/// one responder. Names show only when both `*RevealAt` are set. Its
/// parties never change (trigger).
model NeighbourConversation {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  postId            String    @map("post_id") @db.Uuid
  /// The post's author.
  authorId          String    @map("author_account_id") @db.Uuid
  responderId       String    @map("responder_account_id") @db.Uuid
  /// The responder's own unit: only its building is ever shown.
  responderUnitId   String?   @map("responder_unit_id") @db.Uuid
  authorRevealAt    DateTime? @map("author_reveal_at") @db.Timestamptz(3)
  responderRevealAt DateTime? @map("responder_reveal_at") @db.Timestamptz(3)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  /// Never shown to a participant: both read the same "closed".
  closeReason       String?   @map("close_reason")
  lastMessageAt     DateTime  @map("last_message_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  post          NeighbourPost                  @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  author        Account                        @relation("NeighbourConversationAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversations_tenant_id_author_fkey")
  responder     Account                        @relation("NeighbourConversationResponder", fields: [tenantId, responderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversations_tenant_id_responder_fkey")
  responderUnit Unit?                          @relation(fields: [tenantId, responderUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversations_tenant_id_responder_unit_fkey")
  messages      NeighbourConversationMessage[]
  blocks        NeighbourBlock[]
  reports       NeighbourConversationReport[]

  @@unique([tenantId, id])
  @@unique([tenantId, postId, responderId], map: "neighbour_conversations_one_per_responder")
  @@index([tenantId, authorId, lastMessageAt(sort: Desc), id(sort: Desc)], map: "neighbour_conversations_author_idx")
  @@index([tenantId, responderId, lastMessageAt(sort: Desc), id(sort: Desc)], map: "neighbour_conversations_responder_idx")
  @@index([tenantId, responderId, createdAt], map: "neighbour_conversations_started_idx")
  @@map("neighbour_conversations")
}

/// Text only. Never changes; an erasure clears its body.
model NeighbourConversationMessage {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_account_id") @db.Uuid
  /// Free text between two residents: read by the staff only through an
  /// open report. NULL once its sender is erased.
  body           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  erasedAt       DateTime? @map("erased_at") @db.Timestamptz(3)

  conversation NeighbourConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sender       Account               @relation("NeighbourConversationMessageSender", fields: [tenantId, senderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversation_messages_tenant_id_sender_fkey")

  @@index([tenantId, conversationId, createdAt, id], map: "neighbour_conversation_messages_conversation_idx")
  @@index([tenantId, senderId], map: "neighbour_conversation_messages_sender_idx")
  @@map("neighbour_conversation_messages")
}

/// One account keeps another away. Deleted to undo it.
model NeighbourBlock {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  blockerId      String   @map("blocker_account_id") @db.Uuid
  blockedId      String   @map("blocked_account_id") @db.Uuid
  /// Where it was made: the label on the blocker's list comes from it.
  conversationId String   @map("conversation_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker      Account               @relation("NeighbourBlocker", fields: [tenantId, blockerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_blocks_tenant_id_blocker_fkey")
  blocked      Account               @relation("NeighbourBlocked", fields: [tenantId, blockedId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_blocks_tenant_id_blocked_fkey")
  conversation NeighbourConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, blockerId, blockedId], map: "neighbour_blocks_one_per_pair")
  @@index([tenantId, blockedId], map: "neighbour_blocks_blocked_idx")
  @@map("neighbour_blocks")
}

/// A participant asks the staff to look at one conversation.
model NeighbourConversationReport {
  id             String                @id @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  reporterId     String                @map("reporter_account_id") @db.Uuid
  reasonCode     String                @map("reason_code")
  /// Free text for the staff: NULL once its reporter is erased.
  note           String?
  status         NeighbourReportStatus @default(open)
  outcome        String?
  closedById     String?               @map("closed_by_account_id") @db.Uuid
  closedAt       DateTime?             @map("closed_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation NeighbourConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reporter     Account               @relation("NeighbourReporter", fields: [tenantId, reporterId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversation_reports_tenant_id_reporter_fkey")
  closedBy     Account?              @relation("NeighbourReportCloser", fields: [tenantId, closedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversation_reports_tenant_id_closed_by_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, conversationId, reporterId], map: "neighbour_conversation_reports_one_per_reporter")
  @@index([tenantId, status, createdAt(sort: Desc), id(sort: Desc)], map: "neighbour_conversation_reports_status_idx")
  @@map("neighbour_conversation_reports")
}

/// The compound's welcome text: one row per compound, created with it. A
/// language is whole or absent.
model NeighbourWelcomeTemplate {
  tenantId      String   @id @map("tenant_id") @db.Uuid
  /// Off: no household is greeted.
  enabled       Boolean  @default(true)
  rulesEn       String?  @map("rules_en")
  officeHoursEn String?  @map("office_hours_en")
  emergencyEn   String?  @map("emergency_en")
  rulesAr       String?  @map("rules_ar")
  officeHoursAr String?  @map("office_hours_ar")
  emergencyAr   String?  @map("emergency_ar")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("neighbour_welcome_templates")
}

/// A welcome sent to a household's primary: once per household.
/// Append-only.
model NeighbourWelcome {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// The occupancy that began as its unit's primary: the household.
  occupancyId String   @map("occupancy_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  occupancy UnitOccupancy @relation(fields: [tenantId, occupancyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit          @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account   Account       @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, occupancyId], map: "neighbour_welcomes_once_per_household")
  @@index([tenantId, accountId], map: "neighbour_welcomes_account_idx")
  @@map("neighbour_welcomes")
}

// ============================================================================
// Facilities and bookings, the club (ADR 0044). The domain is src/facilities.
// ============================================================================

enum FacilityMode {
  /// Courts, the hall, the barbecue area: slots, capacity, bookings.
  bookable
  /// The pool, the gym: what it is and when it is open, no booking.
  walk_in

  @@map("facility_mode")
}

enum FacilityCapacityUnit {
  /// A slot takes so many bookings (a court: one).
  bookings
  /// A slot takes so many people, each booking its booker and guests.
  people

  @@map("facility_capacity_unit")
}

/// One of the compound's facilities. Never deleted (bookings point at it);
/// retired with `active`. Its mode never changes (trigger). The rules are
/// set exactly when it is bookable (CHECK facilities_rules_shape).
model Facility {
  id                  String                @id @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  mode                FacilityMode
  nameEn              String                @map("name_en")
  nameAr              String                @map("name_ar")
  descriptionEn       String?               @map("description_en")
  descriptionAr       String?               @map("description_ar")
  active              Boolean               @default(true)
  /// The order the compound lists its facilities in.
  position            Int                   @default(0)
  slotMinutes         Int?                  @map("slot_minutes")
  capacity            Int?
  capacityUnit        FacilityCapacityUnit? @map("capacity_unit")
  maxDaysAhead        Int?                  @map("max_days_ahead")
  minMinutesBefore    Int?                  @map("min_minutes_before")
  cancelCutoffMinutes Int?                  @map("cancel_cutoff_minutes")
  maxGuests           Int?                  @map("max_guests")
  requiresApproval    Boolean               @default(false) @map("requires_approval")
  /// A child may be a booking's occasion (ADR 0054); bookable only.
  childOccasions      Boolean @default(false) @map("child_occasions")
  requiresMembership  Boolean               @default(false) @map("requires_membership")
  weeklyQuota         Int?                  @map("weekly_quota")
  peakQuota           Int?                  @map("peak_quota")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  hours       FacilityHours[]
  peakWindows FacilityPeakWindow[]
  slotLocks   FacilitySlotLock[]
  bookings    Booking[]
  closures    FacilityClosure[]
  serviceVehicles     ServiceVehicleVisit[]

  @@unique([tenantId, id])
  @@index([tenantId, position, id], map: "facilities_position_idx")
  @@map("facilities")
}

/// A facility's opening hours: weekly windows in the compound's time zone
/// (weekday 0 is Sunday; minutes after local midnight), replaced as a whole
/// under the facility's row lock.
model FacilityHours {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  facilityId  String @map("facility_id") @db.Uuid
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, facilityId, weekday, startMinute], map: "facility_hours_window_key")
  @@map("facility_hours")
}

/// A bookable facility's peak times, inside its hours: a slot that
/// overlaps one is a peak slot, with its own quota.
model FacilityPeakWindow {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  facilityId  String @map("facility_id") @db.Uuid
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, facilityId, weekday, startMinute], map: "facility_peak_windows_window_key")
  @@map("facility_peak_windows")
}

/// A slot's lock row: a booking locks it, then counts what holds the
/// slot's window. It holds no count. One row per slot ever booked.
model FacilitySlotLock {
  tenantId   String   @map("tenant_id") @db.Uuid
  facilityId String   @map("facility_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)

  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, facilityId, startsAt])
  @@map("facility_slot_locks")
}

enum BookingStatus {
  /// Waits for the management's approval (a facility that requires it).
  pending
  confirmed
  rejected
  cancelled
  /// Confirmed, and nobody came: marked by the staff after the slot.
  no_show

  @@map("booking_status")
}

enum BookingSide {
  resident
  staff
  system

  @@map("booking_side")
}

/// A unit's booking of a facility's slot (ADR 0044), made by one of its
/// people. Its facility, unit, booker, times and party never change
/// (trigger); it is never deleted. An erased booker stays as the tombstone.
model Booking {
  id               String        @id @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  facilityId       String        @map("facility_id") @db.Uuid
  unitId           String        @map("unit_id") @db.Uuid
  bookedById       String        @map("booked_by_account_id") @db.Uuid
  startsAt         DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime      @map("ends_at") @db.Timestamptz(3)
  guests           Int
  /// The booker and their guests: what the booking takes of a slot counted in people.
  partySize        Int           @map("party_size")
  /// The slot overlapped a peak time when it was booked.
  peak             Boolean
  status           BookingStatus
  /// Approved or rejected by the staff; null for a booking confirmed at once.
  decidedById      String?       @map("decided_by_account_id") @db.Uuid
  decidedAt        DateTime?     @map("decided_at") @db.Timestamptz(3)
  rejectReason     String?       @map("reject_reason")
  cancelledSide    BookingSide?  @map("cancelled_side")
  cancelReason     String?       @map("cancel_reason")
  /// Null when the system cancelled it.
  cancelledById    String?       @map("cancelled_by_account_id") @db.Uuid
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  noShowMarkedById String?       @map("no_show_marked_by_account_id") @db.Uuid
  noShowMarkedAt   DateTime?     @map("no_show_marked_at") @db.Timestamptz(3)
  /// The reminder before the slot was sent (once).
  remindedAt       DateTime?     @map("reminded_at") @db.Timestamptz(3)
  /// The closure that cancelled it.
  closureId        String?       @map("closure_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  facility    Facility           @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit        Unit               @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  bookedBy    Account            @relation("BookingBooker", fields: [tenantId, bookedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_tenant_id_booked_by_fkey")
  decidedBy   Account?           @relation("BookingDecider", fields: [tenantId, decidedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_tenant_id_decided_by_fkey")
  cancelledBy Account?           @relation("BookingCanceller", fields: [tenantId, cancelledById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_tenant_id_cancelled_by_fkey")
  noShowBy    Account?           @relation("BookingNoShowMarker", fields: [tenantId, noShowMarkedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_tenant_id_no_show_by_fkey")
  closure     FacilityClosure?   @relation(fields: [tenantId, closureId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_tenant_id_closure_id_fkey")
  suspension  BookingSuspension?

  /// One of the unit's minors, the booking's occasion (ADR 0054). Never changes.
  occasionMemberId     String?       @map("occasion_member_id") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, unitId, startsAt, id], map: "bookings_unit_idx")
  @@index([tenantId, bookedById, startsAt, id], map: "bookings_booker_idx")
  @@index([tenantId, facilityId, startsAt, id], map: "bookings_facility_idx")
  @@index([tenantId, status, startsAt, id], map: "bookings_status_idx")
  @@map("bookings")
}

/// A facility closed for a time, with a reason code (ADR 0044). Creating
/// one cancels the future bookings it overlaps. Only lifting it changes it,
/// once (trigger); it is never deleted. Lifting restores nothing.
model FacilityClosure {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  facilityId     String    @map("facility_id") @db.Uuid
  startsAt       DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime  @map("ends_at") @db.Timestamptz(3)
  reasonCode     String    @map("reason_code")
  createdById    String    @map("created_by_account_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  liftedAt       DateTime? @map("lifted_at") @db.Timestamptz(3)
  liftedById     String?   @map("lifted_by_account_id") @db.Uuid
  liftReasonCode String?   @map("lift_reason_code")

  facility  Facility  @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy Account   @relation("FacilityClosureCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "facility_closures_tenant_id_created_by_fkey")
  liftedBy  Account?  @relation("FacilityClosureLifter", fields: [tenantId, liftedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "facility_closures_tenant_id_lifted_by_fkey")
  bookings  Booking[]

  @@unique([tenantId, id])
  @@index([tenantId, facilityId, startsAt, id], map: "facility_closures_facility_idx")
  @@map("facility_closures")
}

/// The compound's no-show rules (ADR 0044): one row per compound.
model FacilitySettings {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  noShowThreshold  Int      @default(3) @map("no_show_threshold")
  noShowWindowDays Int      @default(30) @map("no_show_window_days")
  suspensionDays   Int      @default(14) @map("suspension_days")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("facility_settings")
}

/// A unit suspended from booking after too many no-shows (ADR 0044). In
/// force while not lifted and not over. Only the lift changes it, once.
model BookingSuspension {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  unitId           String    @map("unit_id") @db.Uuid
  startsAt         DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime  @map("ends_at") @db.Timestamptz(3)
  /// The no-show that reached the threshold.
  triggerBookingId String    @map("trigger_booking_id") @db.Uuid
  noShowCount      Int       @map("no_show_count")
  boardAppealAt    DateTime? @map("board_appeal_at") @db.Timestamptz(3)
  boardAppealClosedAt DateTime? @map("board_appeal_closed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  liftedAt         DateTime? @map("lifted_at") @db.Timestamptz(3)
  liftedById       String?   @map("lifted_by_account_id") @db.Uuid
  liftReasonCode   String?   @map("lift_reason_code")

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit           Unit     @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  triggerBooking Booking  @relation(fields: [tenantId, triggerBookingId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "booking_suspensions_tenant_id_trigger_booking_id_fkey")
  liftedBy       Account? @relation("BookingSuspensionLifter", fields: [tenantId, liftedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "booking_suspensions_tenant_id_lifted_by_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, triggerBookingId], map: "booking_suspensions_trigger_booking_id_key")
  @@index([tenantId, unitId, startsAt, id], map: "booking_suspensions_unit_idx")
  @@index([tenantId, startsAt, id], map: "booking_suspensions_starts_idx")
  @@map("booking_suspensions")
}

// ----------------------------------------------------------------------------
// The club (ADR 0044): plans, a unit's membership and who it covers, and
// the payments made at the office that keep it.
// ----------------------------------------------------------------------------

enum ClubDurationKind {
  monthly
  quarterly
  annual
  /// `duration_days` days.
  custom

  @@map("club_duration_kind")
}

enum ClubPaymentKind {
  payment
  reversal

  @@map("club_payment_kind")
}

/// A plan the management offers. Never deleted; retired with `active`.
model ClubPlan {
  id           String           @id @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  nameEn       String           @map("name_en")
  nameAr       String           @map("name_ar")
  durationKind ClubDurationKind @map("duration_kind")
  durationDays Int?             @map("duration_days")
  /// What the plan costs, in EGP: shown, not enforced.
  price        Decimal          @db.Decimal(10, 2)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payments ClubPaymentRecord[]

  @@unique([tenantId, id])
  @@map("club_plans")
}

/// A unit's membership: one per unit, created on its first use. Its rows
/// of payments say when it is active; its people, whom it covers.
model ClubMembership {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  createdById String   @map("created_by_account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit                   @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy Account                @relation("ClubMembershipCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_memberships_tenant_id_created_by_fkey")
  people    ClubMembershipPerson[]
  payments  ClubPaymentRecord[]
  reminders ClubExpiryReminder[]

  @@unique([tenantId, id])
  @@unique([tenantId, unitId], map: "club_memberships_one_per_unit")
  @@map("club_memberships")
}

/// Someone a membership covers: one of the unit's occupancies or household
/// members (a minor too). Added, and later removed; never deleted. Covered
/// only while that occupancy or membership of the household is active.
model ClubMembershipPerson {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  membershipId      String    @map("membership_id") @db.Uuid
  occupancyId       String?   @map("occupancy_id") @db.Uuid
  householdMemberId String?   @map("household_member_id") @db.Uuid
  addedById         String    @map("added_by_account_id") @db.Uuid
  addedAt           DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  removedAt         DateTime? @map("removed_at") @db.Timestamptz(3)
  removedById       String?   @map("removed_by_account_id") @db.Uuid

  membership ClubMembership   @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  occupancy  UnitOccupancy?   @relation(fields: [tenantId, occupancyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_membership_people_tenant_id_occupancy_id_fkey")
  member     HouseholdMember? @relation(fields: [tenantId, householdMemberId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_membership_people_tenant_id_household_member_id_fkey")
  addedBy    Account          @relation("ClubPersonAdder", fields: [tenantId, addedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_membership_people_tenant_id_added_by_fkey")
  removedBy  Account?         @relation("ClubPersonRemover", fields: [tenantId, removedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_membership_people_tenant_id_removed_by_fkey")

  @@index([tenantId, membershipId, addedAt, id], map: "club_membership_people_membership_idx")
  @@map("club_membership_people")
}

/// A payment made at the office, or the reversal of one (ADR 0044).
/// Append-only: a wrong record is reversed by a new one, never edited.
model ClubPaymentRecord {
  id             String          @id @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  membershipId   String          @map("membership_id") @db.Uuid
  kind           ClubPaymentKind
  planId         String?         @map("plan_id") @db.Uuid
  amount         Decimal?        @db.Decimal(10, 2)
  currency       String?
  receiptNumber  String?         @map("receipt_number")
  paidOn         DateTime?       @map("paid_on") @db.Date
  /// The local days it pays for, the end excluded.
  periodStartsOn DateTime?       @map("period_starts_on") @db.Date
  periodEndsOn   DateTime?       @map("period_ends_on") @db.Date
  reversesId     String?         @map("reverses_id") @db.Uuid
  reasonCode     String?         @map("reason_code")
  recordedById   String          @map("recorded_by_account_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  membership ClubMembership     @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  plan       ClubPlan?          @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_payment_records_tenant_id_plan_id_fkey")
  reverses   ClubPaymentRecord? @relation("ClubReversal", fields: [tenantId, reversesId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_payment_records_tenant_id_reverses_id_fkey")
  reversedBy ClubPaymentRecord? @relation("ClubReversal")
  recordedBy Account            @relation("ClubPaymentRecorder", fields: [tenantId, recordedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_payment_records_tenant_id_recorded_by_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, reversesId], map: "club_payment_records_one_reversal")
  @@index([tenantId, membershipId, createdAt, id], map: "club_payment_records_membership_idx")
  @@map("club_payment_records")
}

/// A membership's reminder before it ends: once per end date. Append-only.
model ClubExpiryReminder {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  endsOn       DateTime @map("ends_on") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership ClubMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, membershipId, endsOn], map: "club_expiry_reminders_once")
  @@map("club_expiry_reminders")
}

// ============================================================================
// Phase G2 — vehicles and parking (ADR 0045)
// ============================================================================

enum VehicleType {
  car
  motorcycle
  van

  @@map("vehicle_type")
}

/// A vehicle's own state. `expires_soon` and `expired` are read from
/// `permitValidUntil`, never stored.
enum VehicleStatus {
  pending
  active
  rejected
  removed

  @@map("vehicle_status")
}

enum VehicleRemovalSide {
  resident
  staff
  system

  @@map("vehicle_removal_side")
}

enum VehicleCounterKind {
  vehicle
  parking_booking
  fine
  parking_report

  @@map("vehicle_counter_kind")
}

/// A compound's vehicle and parking settings: one row, created with it.
model VehicleSettings {
  tenantId                        String   @id @map("tenant_id") @db.Uuid
  maxVehiclesPerUnit              Int      @default(4) @map("max_vehicles_per_unit")
  visitorParkingMaxHours          Int      @default(12) @map("visitor_parking_max_hours")
  maxActiveVisitorParkingBookings Int      @default(3) @map("max_active_visitor_parking_bookings")
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("vehicle_settings")
}

/// The last number per kind (V-, P-, F-, R-), taken under its row lock.
model VehicleCounter {
  tenantId   String             @map("tenant_id") @db.Uuid
  kind       VehicleCounterKind
  lastNumber Int                @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, kind])
  @@map("vehicle_counters")
}

/// A unit's vehicle. Its unit, number and registrant never change; a
/// removal is final (trigger). One active permit per plate (unique).
model Vehicle {
  id                 String              @id @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  number             Int
  unitId             String              @map("unit_id") @db.Uuid
  registeredById     String              @map("registered_by_account_id") @db.Uuid
  plate              String
  /// Generated by the database from the plate (ADR 0045); never written.
  plateKey           String?             @map("plate_key")
  makeAndModel       String              @map("make_and_model")
  color              String
  type               VehicleType
  status             VehicleStatus       @default(pending)
  /// +1 on each plate edit; an approval names the version it saw.
  version            Int                 @default(1)
  stickerNumber      String?             @map("sticker_number")
  /// The last local day the permit is valid.
  permitValidUntil   DateTime?           @map("permit_valid_until") @db.Date
  rejectionReason    String?             @map("rejection_reason")
  licencePhotoFileId String?             @map("licence_photo_file_id") @db.Uuid
  decidedById        String?             @map("decided_by_account_id") @db.Uuid
  decidedAt          DateTime?           @map("decided_at") @db.Timestamptz(3)
  removedAt          DateTime?           @map("removed_at") @db.Timestamptz(3)
  removedById        String?             @map("removed_by_account_id") @db.Uuid
  removalSide        VehicleRemovalSide? @map("removal_side")
  removalReason      String?             @map("removal_reason")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  stickers  VehicleSticker[]
  reminders VehicleExpiryReminder[]

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "vehicles_number_key")
  @@index([tenantId, unitId, status], map: "vehicles_unit_idx")
  @@index([tenantId, status, createdAt, id], map: "vehicles_status_idx")
  @@map("vehicles")
}

/// A sticker issued to a vehicle: append-only, its number once per compound.
model VehicleSticker {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  vehicleId     String   @map("vehicle_id") @db.Uuid
  stickerNumber String   @map("sticker_number")
  issuedById    String   @map("issued_by_account_id") @db.Uuid
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, stickerNumber], map: "vehicle_stickers_number_key")
  @@unique([tenantId, vehicleId, stickerNumber], map: "vehicle_stickers_vehicle_number_key")
  @@map("vehicle_stickers")
}

/// A permit's expiring notice: once per vehicle and last day. Append-only.
model VehicleExpiryReminder {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  validUntil DateTime @map("valid_until") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, vehicleId, validUntil], map: "vehicle_expiry_reminders_once")
  @@map("vehicle_expiry_reminders")
}

enum VisitorParkingStatus {
  confirmed
  cancelled

  @@map("visitor_parking_status")
}

enum VisitorParkingCancelSide {
  resident
  staff
  system

  @@map("visitor_parking_cancel_side")
}

/// A unit's own parking slot: configuration, kept by the staff.
model UnitParkingSlot {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  unitId    String   @map("unit_id") @db.Uuid
  code      String
  place     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, code], map: "unit_parking_slots_code_key")
  @@index([tenantId, unitId, code], map: "unit_parking_slots_unit_idx")
  @@map("unit_parking_slots")
}

/// A visitor parking area: never deleted, retired with `active`.
model VisitorParkingArea {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  capacity  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings VisitorParkingBooking[]

  @@unique([tenantId, id])
  @@unique([tenantId, name], map: "visitor_parking_areas_name_key")
  @@map("visitor_parking_areas")
}

/// One space of an area for a visitor, for a window. Its window, unit,
/// area and pass never change; it is cancelled once (trigger).
model VisitorParkingBooking {
  id                   String                    @id @db.Uuid
  tenantId             String                    @map("tenant_id") @db.Uuid
  number               Int
  unitId               String                    @map("unit_id") @db.Uuid
  areaId               String                    @map("area_id") @db.Uuid
  visitorPassId        String?                   @map("visitor_pass_id") @db.Uuid
  visitorName          String?                   @map("visitor_name")
  visitorNameClearedAt DateTime?                 @map("visitor_name_cleared_at") @db.Timestamptz(3)
  startsAt             DateTime                  @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime                  @map("ends_at") @db.Timestamptz(3)
  status               VisitorParkingStatus      @default(confirmed)
  bookedById           String                    @map("booked_by_account_id") @db.Uuid
  cancelledAt          DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?                   @map("cancelled_by_account_id") @db.Uuid
  cancelSide           VisitorParkingCancelSide? @map("cancel_side")
  cancelReason         String?                   @map("cancel_reason")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  area VisitorParkingArea @relation(fields: [tenantId, areaId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "visitor_parking_bookings_number_key")
  @@index([tenantId, unitId, startsAt, id], map: "visitor_parking_bookings_unit_idx")
  @@map("visitor_parking_bookings")
}

enum VehicleFineStatus {
  unpaid
  under_appeal
  paid
  cancelled

  @@map("vehicle_fine_status")
}

enum VehicleFineDecision {
  upheld
  cancelled

  @@map("vehicle_fine_decision")
}

enum VehicleFinePaymentKind {
  payment
  reversal

  @@map("vehicle_fine_payment_kind")
}

/// A fine to a unit. Its terms never change; its appeal is written once
/// (its words and photo cleared once, on erasure); a decision and a
/// cancellation are final (trigger). Nothing of a parking report.
model VehicleFine {
  id                String               @id @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  number            Int
  unitId            String               @map("unit_id") @db.Uuid
  vehicleId         String?              @map("vehicle_id") @db.Uuid
  plate             String
  /// Generated by the database from the plate (ADR 0045); never written.
  plateKey          String?              @map("plate_key")
  reason            String
  note              String?
  amount            Decimal              @db.Decimal(10, 2)
  currency          String               @default("EGP")
  occurredOn        DateTime             @map("occurred_on") @db.Date
  photoFileId       String?              @map("photo_file_id") @db.Uuid
  issuedById        String               @map("issued_by_account_id") @db.Uuid
  status            VehicleFineStatus    @default(unpaid)
  appealText        String?              @map("appeal_text")
  appealPhotoFileId String?              @map("appeal_photo_file_id") @db.Uuid
  appealedById      String?              @map("appealed_by_account_id") @db.Uuid
  appealedAt        DateTime?            @map("appealed_at") @db.Timestamptz(3)
  appealClearedAt   DateTime?            @map("appeal_cleared_at") @db.Timestamptz(3)
  appealDecision    VehicleFineDecision? @map("appeal_decision")
  decidedById       String?              @map("decided_by_account_id") @db.Uuid
  decidedAt         DateTime?            @map("decided_at") @db.Timestamptz(3)
  cancelReason      String?              @map("cancel_reason")
  cancelledById     String?              @map("cancelled_by_account_id") @db.Uuid
  cancelledAt       DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  boardAppealAt     DateTime?            @map("board_appeal_at") @db.Timestamptz(3)
  boardAppealClosedAt DateTime?            @map("board_appeal_closed_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  payments VehicleFinePayment[]

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "vehicle_fines_number_key")
  @@index([tenantId, unitId, status, createdAt, id], map: "vehicle_fines_unit_idx")
  @@index([tenantId, status, createdAt, id], map: "vehicle_fines_status_idx")
  @@map("vehicle_fines")
}

/// A fine's payment at the office, or its reversal: append-only.
model VehicleFinePayment {
  id            String                 @id @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  fineId        String                 @map("fine_id") @db.Uuid
  kind          VehicleFinePaymentKind
  amount        Decimal?               @db.Decimal(10, 2)
  currency      String?
  receiptNumber String?                @map("receipt_number")
  paidOn        DateTime?              @map("paid_on") @db.Date
  reversesId    String?                @map("reverses_id") @db.Uuid
  reasonCode    String?                @map("reason_code")
  recordedById  String                 @map("recorded_by_account_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  fine VehicleFine @relation(fields: [tenantId, fineId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, reversesId], map: "vehicle_fine_payments_one_reversal")
  @@index([tenantId, fineId, createdAt, id], map: "vehicle_fine_payments_fine_idx")
  @@map("vehicle_fine_payments")
}

enum ParkingReportStatus {
  open
  closed
  converted

  @@map("parking_report_status")
}

/// A resident's report of a wrongly parked vehicle: about a plate, never a
/// unit. Its words never change but for the reporter's erasure; it is
/// handled once (trigger). It points at the fine it became; never back.
model ParkingReport {
  id            String              @id @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  number        Int
  reporterId    String              @map("reporter_account_id") @db.Uuid
  plate         String
  /// Generated by the database from the plate (ADR 0045); never written.
  plateKey      String?             @map("plate_key")
  location      String
  note          String?
  noteClearedAt DateTime?           @map("note_cleared_at") @db.Timestamptz(3)
  photoFileId   String?             @map("photo_file_id") @db.Uuid
  status        ParkingReportStatus @default(open)
  closeReason   String?             @map("close_reason")
  fineId        String?             @map("fine_id") @db.Uuid
  handledById   String?             @map("handled_by_account_id") @db.Uuid
  handledAt     DateTime?           @map("handled_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "parking_reports_number_key")
  @@unique([tenantId, fineId], map: "parking_reports_fine_key")
  @@index([tenantId, status, createdAt, id], map: "parking_reports_status_idx")
  @@map("parking_reports")
}

// ============================================================================
// Phase R6a — finance: invoices and payments (ADR 0046)
// ============================================================================

enum FinanceGatewayMode {
  sandbox
  live

  @@map("finance_gateway_mode")
}

/// One per compound (ADR 0046): online payment on or off. The platform's
/// switch wins over the manager's.
model FinanceSettings {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  onlineEnabled        Boolean  @default(false) @map("online_enabled")
  platformDisabled     Boolean  @default(false) @map("platform_disabled")
  /// The month (1–12) a fiscal year starts on (ADR 0055); fixed once a
  /// budget was submitted.
  fiscalYearStartMonth Int      @default(1) @map("fiscal_year_start_month") @db.SmallInt
  /// Days after the due date before a late-payment notice (ADR 0058): 0–60.
  lateNoticeCureDays   Int      @default(14) @map("late_notice_cure_days") @db.SmallInt
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("finance_settings")
}

/// A compound's own Paymob account (ADR 0046), sealed by the credential
/// vault: each *Enc is iv ‖ tag ‖ ciphertext under `keyVersion`. Only the
/// last four characters are ever shown. Replaced as a whole; never deleted.
model FinanceGateway {
  tenantId               String             @id @map("tenant_id") @db.Uuid
  provider               String             @default("paymob")
  mode                   FinanceGatewayMode
  keyVersion             Int                @map("key_version")
  secretKeyEnc           Bytes              @map("secret_key_enc")
  publicKeyEnc           Bytes              @map("public_key_enc")
  hmacSecretEnc          Bytes              @map("hmac_secret_enc")
  cardIntegrationEnc     Bytes              @map("card_integration_enc")
  walletIntegrationEnc   Bytes?             @map("wallet_integration_enc")
  secretKeyLast4         String             @map("secret_key_last4")
  publicKeyLast4         String             @map("public_key_last4")
  hmacSecretLast4        String             @map("hmac_secret_last4")
  cardIntegrationLast4   String             @map("card_integration_last4")
  walletIntegrationLast4 String?            @map("wallet_integration_last4")
  updatedById            String?            @map("updated_by_account_id") @db.Uuid
  updatedByPlatform      Boolean            @map("updated_by_platform")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy Account? @relation("FinanceGatewayUpdater", fields: [tenantId, updatedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_gateways_tenant_id_updated_by_fkey")

  @@map("finance_gateways")
}

enum InvoiceKind {
  service_charge
  maintenance
  other

  @@map("invoice_kind")
}

enum InvoiceBatchTarget {
  unit
  building
  all

  @@map("invoice_batch_target")
}

/// Gapless numbers per compound and kind (`invoice`, `credit_note`,
/// `receipt`), taken in the creating transaction (ADR 0046).
model FinanceCounter {
  tenantId   String @map("tenant_id") @db.Uuid
  kind       String
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, kind])
  @@map("finance_counters")
}

/// One issue of invoices by the staff (ADR 0046): one unit, a building, or
/// every unit. Append-only.
model InvoiceBatch {
  id             String             @id @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  target         InvoiceBatchTarget
  unitId         String?            @map("unit_id") @db.Uuid
  building       String?
  kind           InvoiceKind
  unitCount      Int                @map("unit_count")
  issuedOn       DateTime           @map("issued_on") @db.Date
  dueOn          DateTime           @map("due_on") @db.Date
  createdById    String?            @map("created_by_account_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  /// A plan's issue: the plan and the period it bills.
  planId         String?            @map("plan_id") @db.Uuid
  periodStartsOn DateTime?          @map("period_starts_on") @db.Date

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit?        @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  plan      BillingPlan? @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_batches_tenant_id_plan_id_fkey")
  createdBy Account?     @relation("InvoiceBatchCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_batches_tenant_id_created_by_fkey")
  invoices  Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id], map: "invoice_batches_created_idx")
  @@map("invoice_batches")
}

/// A unit's invoice (ADR 0046): immutable once issued; corrected by credit
/// notes. What it still asks for is computed, never stored.
model Invoice {
  id                 String      @id @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  number             Int
  batchId            String      @map("batch_id") @db.Uuid
  unitId             String      @map("unit_id") @db.Uuid
  kind               InvoiceKind
  total              Decimal     @db.Decimal(12, 2)
  currency           String
  issuedOn           DateTime    @map("issued_on") @db.Date
  dueOn              DateTime    @map("due_on") @db.Date
  createdById        String?     @map("created_by_account_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  /// A plan's invoice: the plan and the period it bills, the end excluded.
  planId             String?     @map("plan_id") @db.Uuid
  periodStartsOn     DateTime?   @map("period_starts_on") @db.Date
  periodEndsOn       DateTime?   @map("period_ends_on") @db.Date
  /// An instalment (ADR 0048): its plan and its place in it, from 1.
  instalmentPlanId   String?     @map("instalment_plan_id") @db.Uuid
  instalmentPosition Int?        @map("instalment_position")

  plan            BillingPlan?            @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoices_tenant_id_plan_id_fkey")
  instalmentPlan  InstalmentPlan?         @relation("InstalmentPlanInstalments", fields: [tenantId, instalmentPlanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  rescheduledBy   InstalmentPlan?         @relation("InstalmentPlanOriginal")
  remainderOf     InstalmentPlan?         @relation("InstalmentPlanRemainder")
  disputes        InvoiceDispute[]
  batch           InvoiceBatch            @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit            Unit                    @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       Account?                @relation("InvoiceCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoices_tenant_id_created_by_fkey")
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines           InvoiceLine[]
  creditNotes     CreditNote[]
  notices         InvoiceNotice[]
  allocations     FinanceAllocation[]
  sessionInvoices PaymentSessionInvoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, batchId, unitId], map: "invoices_one_per_batch_unit")
  @@unique([tenantId, instalmentPlanId, instalmentPosition], map: "invoices_instalment_position_key")
  @@index([tenantId, unitId, dueOn, number], map: "invoices_unit_idx")
  @@index([tenantId, createdAt, id], map: "invoices_created_idx")
  @@index([tenantId, dueOn], map: "invoices_due_idx")
  @@index([tenantId, issuedOn], map: "invoices_issued_idx")
  @@map("invoices")
}

/// What an invoice is for, in both languages (staff text). Append-only.
model InvoiceLine {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  invoiceId     String  @map("invoice_id") @db.Uuid
  position      Int
  descriptionEn String  @map("description_en")
  descriptionAr String  @map("description_ar")
  amount        Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, position], map: "invoice_lines_position_key")
  @@map("invoice_lines")
}

/// Reduces what one invoice asks for (ADR 0046), by a reason's code.
/// Append-only; no free text.
model CreditNote {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  number             Int
  invoiceId          String   @map("invoice_id") @db.Uuid
  amount             Decimal  @db.Decimal(12, 2)
  reasonCode         String   @map("reason_code")
  createdById        String   @map("created_by_account_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Reason `instalment_plan` (ADR 0048): the plan it opened or cancelled.
  instalmentPlanId   String?  @map("instalment_plan_id") @db.Uuid
  /// Reason `dispute` (ADR 0048): the dispute whose acceptance wrote it.
  disputeId          String?  @map("dispute_id") @db.Uuid
  /// Reason `compensation` (ADR 0058): why, from creditNoteCompensation.
  compensationReason String?  @map("compensation_reason")

  invoice        Invoice                    @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      Account                    @relation("CreditNoteCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "credit_notes_tenant_id_created_by_fkey")
  instalmentPlan InstalmentPlan?            @relation(fields: [tenantId, instalmentPlanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  dispute        InvoiceDispute?            @relation(fields: [tenantId, disputeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  releases       FinanceAllocationRelease[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, disputeId], map: "credit_notes_one_per_dispute")
  @@index([tenantId, invoiceId, createdAt], map: "credit_notes_invoice_idx")
  @@index([tenantId, instalmentPlanId], map: "credit_notes_instalment_plan_idx")
  @@index([tenantId, createdAt, id], map: "credit_notes_created_idx")
  @@map("credit_notes")
}

enum InvoiceDisputeStatus {
  open
  accepted
  rejected

  @@map("invoice_dispute_status")
}

/// A resident's dispute of an invoice (ADR 0048): a reason's code, optional
/// words and photo (cleared on the opener's erasure), and the staff's
/// decision, made once. One open dispute per invoice.
model InvoiceDispute {
  id                  String               @id @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  invoiceId           String               @map("invoice_id") @db.Uuid
  unitId              String               @map("unit_id") @db.Uuid
  openedById          String               @map("opened_by_account_id") @db.Uuid
  reasonCode          String               @map("reason_code")
  text                String?
  photoFileId         String?              @map("photo_file_id") @db.Uuid
  textClearedAt       DateTime?            @map("text_cleared_at") @db.Timestamptz(3)
  status              InvoiceDisputeStatus @default(open)
  decidedById         String?              @map("decided_by_account_id") @db.Uuid
  decidedAt           DateTime?            @map("decided_at") @db.Timestamptz(3)
  decisionReasonCode  String?              @map("decision_reason_code")
  boardAppealAt       DateTime?            @map("board_appeal_at") @db.Timestamptz(3)
  boardAppealClosedAt DateTime?            @map("board_appeal_closed_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice    Invoice     @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit       Unit        @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  openedBy   Account     @relation("InvoiceDisputeOpener", fields: [tenantId, openedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_disputes_tenant_id_opened_by_fkey")
  decidedBy  Account?    @relation("InvoiceDisputeDecider", fields: [tenantId, decidedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_disputes_tenant_id_decided_by_fkey")
  creditNote CreditNote?

  @@unique([tenantId, id])
  @@index([tenantId, invoiceId, createdAt], map: "invoice_disputes_invoice_idx")
  @@index([tenantId, createdAt, id], map: "invoice_disputes_created_idx")
  @@index([tenantId, openedById], map: "invoice_disputes_opened_by_idx")
  @@map("invoice_disputes")
}

/// An open invoice's outstanding turned into instalment invoices (ADR
/// 0048). Immutable but for its cancellation, set once with the remainder
/// invoice that cancellation issued.
model InstalmentPlan {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  number             Int
  unitId             String    @map("unit_id") @db.Uuid
  invoiceId          String    @map("invoice_id") @db.Uuid
  instalmentCount    Int       @map("instalment_count")
  total              Decimal   @db.Decimal(12, 2)
  createdById        String    @map("created_by_account_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?   @map("cancelled_by_account_id") @db.Uuid
  remainderInvoiceId String?   @map("remainder_invoice_id") @db.Uuid

  unit             Unit         @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice          Invoice      @relation("InstalmentPlanOriginal", fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  remainderInvoice Invoice?     @relation("InstalmentPlanRemainder", fields: [tenantId, remainderInvoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy        Account      @relation("InstalmentPlanCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "instalment_plans_tenant_id_created_by_fkey")
  cancelledBy      Account?     @relation("InstalmentPlanCanceller", fields: [tenantId, cancelledById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "instalment_plans_tenant_id_cancelled_by_fkey")
  instalments      Invoice[]    @relation("InstalmentPlanInstalments")
  creditNotes      CreditNote[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, invoiceId], map: "instalment_plans_one_per_invoice")
  @@unique([tenantId, remainderInvoiceId], map: "instalment_plans_remainder_key")
  @@index([tenantId, unitId, createdAt, id], map: "instalment_plans_unit_idx")
  @@index([tenantId, createdAt, id], map: "instalment_plans_created_idx")
  @@map("instalment_plans")
}

/// What a unit's people were told about an invoice (ADR 0046): `issued`,
/// `due_soon`, `overdue`, each once. Append-only.
model InvoiceNotice {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  kind      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, invoiceId, kind], map: "invoice_notices_once")
  @@map("invoice_notices")
}

enum BillingFrequency {
  monthly
  quarterly
  annual

  @@map("billing_frequency")
}

/// Recurring billing (ADR 0046): every unit, a fixed amount each period,
/// with per-unit overrides. What it bills and when is fixed; names, amount
/// and days apply to periods issued afterwards. Never deleted.
model BillingPlan {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  nameEn            String           @map("name_en")
  nameAr            String           @map("name_ar")
  kind              InvoiceKind
  frequency         BillingFrequency
  amount            Decimal          @db.Decimal(12, 2)
  /// The first day of the first period: the first of a month.
  startsOn          DateTime         @map("starts_on") @db.Date
  issueDaysBefore   Int              @map("issue_days_before")
  dueDaysAfterIssue Int              @map("due_days_after_issue")
  active            Boolean          @default(true)
  createdById       String           @map("created_by_account_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy Account               @relation("BillingPlanCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "billing_plans_tenant_id_created_by_fkey")
  overrides BillingPlanOverride[]
  batches   InvoiceBatch[]
  invoices  Invoice[]

  @@unique([tenantId, id])
  @@map("billing_plans")
}

/// A unit's own terms in a plan (ADR 0046): another amount, or excluded.
model BillingPlanOverride {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  amount      Decimal? @db.Decimal(12, 2)
  excluded    Boolean
  updatedById String   @map("updated_by_account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan      BillingPlan @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit        @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy Account     @relation("BillingPlanOverrideUpdater", fields: [tenantId, updatedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "billing_plan_overrides_tenant_id_updated_by_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, planId, unitId], map: "billing_plan_overrides_one_per_unit")
  @@map("billing_plan_overrides")
}

enum PaymentKind {
  payment
  reversal

  @@map("payment_kind")
}

enum PaymentChannel {
  office
  online

  @@map("payment_channel")
}

enum PaymentMethod {
  cash
  bank_transfer
  cheque
  card
  wallet
  /// A deposit's deduction for unpaid dues (ADR 0062); never chosen at the office.
  deposit_offset

  @@map("payment_method")
}

/// A unit's payment, or the reversal of one made at the office (ADR 0046).
/// Append-only. Each payment has a receipt: a number and a random code the
/// public page verifies.
model FinancePayment {
  id                   String          @id @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  kind                 PaymentKind
  unitId               String          @map("unit_id") @db.Uuid
  channel              PaymentChannel?
  method               PaymentMethod?
  amount               Decimal?        @db.Decimal(12, 2)
  currency             String?
  /// The local day it was paid.
  paidOn               DateTime?       @map("paid_on") @db.Date
  receiptNumber        Int?            @map("receipt_number")
  receiptCode          String?         @map("receipt_code")
  /// A transfer's or cheque's reference, as written on it.
  reference            String?
  recordedById         String?         @map("recorded_by_account_id") @db.Uuid
  reversesId           String?         @map("reverses_id") @db.Uuid
  reasonCode           String?         @map("reason_code")
  /// Online only: the checkout, Paymob's transaction (once per compound)
  /// and who paid.
  sessionId            String?         @map("session_id") @db.Uuid
  gatewayTransactionId String?         @map("gateway_transaction_id")
  payerId              String?         @map("payer_account_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  session       PaymentSession?       @relation("PaymentSessionPayments", fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_payments_tenant_id_session_id_fkey")
  payer         Account?              @relation("FinancePaymentPayer", fields: [tenantId, payerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_payments_tenant_id_payer_fkey")
  settles       PaymentSession?       @relation("PaymentSessionPayment")
  unit          Unit                  @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy    Account?              @relation("FinancePaymentRecorder", fields: [tenantId, recordedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_payments_tenant_id_recorded_by_fkey")
  reverses      FinancePayment?       @relation("FinancePaymentReversal", fields: [tenantId, reversesId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_payments_tenant_id_reverses_id_fkey")
  reversedBy    FinancePayment?       @relation("FinancePaymentReversal")
  allocations   FinanceAllocation[]
  refundSources FinanceRefundSource[]

  depositEvents FinanceDepositEvent[]
  @@unique([tenantId, id])
  @@unique([tenantId, reversesId], map: "finance_payments_one_reversal")
  @@index([tenantId, unitId, createdAt, id], map: "finance_payments_unit_idx")
  @@index([tenantId, createdAt, id], map: "finance_payments_created_idx")
  @@map("finance_payments")
}

enum RefundKind {
  refund
  reversal

  @@map("refund_kind")
}

enum RefundChannel {
  cash
  bank_transfer
  gateway_manual

  @@map("refund_channel")
}

/// A refund of a unit's credit, recorded by hand (ADR 0048), or the reversal
/// of one. Append-only.
model FinanceRefund {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  kind         RefundKind
  unitId       String         @map("unit_id") @db.Uuid
  number       Int?
  amount       Decimal?       @db.Decimal(12, 2)
  currency     String?
  channel      RefundChannel?
  /// The transfer's or the gateway's own reference, as given.
  reference    String?
  /// The local day the money was paid back.
  refundedOn   DateTime?      @map("refunded_on") @db.Date
  reversesId   String?        @map("reverses_id") @db.Uuid
  reasonCode   String?        @map("reason_code")
  recordedById String         @map("recorded_by_account_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  unit       Unit                  @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy Account               @relation("FinanceRefundRecorder", fields: [tenantId, recordedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_refunds_tenant_id_recorded_by_fkey")
  reverses   FinanceRefund?        @relation("FinanceRefundReversal", fields: [tenantId, reversesId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_refunds_tenant_id_reverses_id_fkey")
  reversedBy FinanceRefund?        @relation("FinanceRefundReversal")
  sources    FinanceRefundSource[]

  @@unique([tenantId, id])
  @@unique([tenantId, reversesId], map: "finance_refunds_one_reversal")
  @@index([tenantId, unitId, createdAt, id], map: "finance_refunds_unit_idx")
  @@index([tenantId, createdAt, id], map: "finance_refunds_created_idx")
  @@map("finance_refunds")
}

/// Which live payment's free money a refund took, and how much (ADR 0048).
/// Append-only; it stops counting when its refund is reversed.
model FinanceRefundSource {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  refundId  String   @map("refund_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  refund  FinanceRefund  @relation(fields: [tenantId, refundId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  payment FinancePayment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, refundId, paymentId], map: "finance_refund_sources_once")
  @@index([tenantId, paymentId], map: "finance_refund_sources_payment_idx")
  @@map("finance_refund_sources")
}

/// Which invoice a payment paid, and how much (ADR 0046). Append-only; it
/// stops counting when its payment is reversed.
model FinanceAllocation {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  invoiceId  String   @map("invoice_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  /// Poured from money the unit already held as credit, not in the
  /// payment's own transaction (ADR 0048; false before R6b).
  fromCredit Boolean  @default(false) @map("from_credit")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment  FinancePayment             @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice  Invoice                    @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  releases FinanceAllocationRelease[]

  @@unique([tenantId, id])
  @@index([tenantId, invoiceId], map: "finance_allocations_invoice_idx")
  @@index([tenantId, paymentId], map: "finance_allocations_payment_idx")
  @@map("finance_allocations")
}

/// Part of an allocation given back to the unit's credit by a credit note on
/// its invoice (ADR 0048). Append-only.
model FinanceAllocationRelease {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  allocationId String   @map("allocation_id") @db.Uuid
  creditNoteId String   @map("credit_note_id") @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  allocation FinanceAllocation @relation(fields: [tenantId, allocationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  creditNote CreditNote        @relation(fields: [tenantId, creditNoteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, allocationId], map: "finance_allocation_releases_allocation_idx")
  @@index([tenantId, creditNoteId], map: "finance_allocation_releases_credit_note_idx")
  @@index([tenantId, createdAt, id], map: "finance_allocation_releases_created_idx")
  @@map("finance_allocation_releases")
}

/// Global pointer from a receipt's code to its compound (ADR 0046), read by
/// the public page before any tenant is known. Only the code's SHA-256.
model ReceiptLink {
  codeHash  String   @id @map("code_hash") @db.Char(64)
  tenantId  String   @map("tenant_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([paymentId], map: "receipt_links_payment_idx")
  @@map("receipt_links")
}

enum PaymentSessionStatus {
  opening
  open
  succeeded
  failed
  expired
  superseded

  @@map("payment_session_status")
}

/// A hosted checkout for some of a unit's invoices (ADR 0046): one live
/// per unit; the Paymob client secret sealed by the vault. Only the status
/// moves (trigger), and only the webhook makes it a payment.
model PaymentSession {
  id               String               @id @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  unitId           String               @map("unit_id") @db.Uuid
  accountId        String               @map("account_id") @db.Uuid
  amount           Decimal              @db.Decimal(12, 2)
  currency         String
  status           PaymentSessionStatus
  dedupeKey        String               @map("dedupe_key") @db.Char(64)
  specialReference String               @unique(map: "payment_sessions_special_reference_key") @map("special_reference")
  intentionId      String?              @map("intention_id")
  gatewayOrderId   String?              @map("gateway_order_id")
  clientSecretEnc  Bytes?               @map("client_secret_enc")
  keyVersion       Int?                 @map("key_version")
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(3)
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(3)
  paymentId        String?              @map("payment_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit     Unit                    @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account  Account                 @relation("PaymentSessionPayer", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  payment  FinancePayment?         @relation("PaymentSessionPayment", fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "payment_sessions_tenant_id_payment_id_fkey")
  payments FinancePayment[]        @relation("PaymentSessionPayments")
  invoices PaymentSessionInvoice[]
  events   PaymentGatewayEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, paymentId], map: "payment_sessions_payment_id_key")
  @@index([tenantId, unitId, createdAt], map: "payment_sessions_unit_idx")
  @@map("payment_sessions")
}

/// What a checkout pays: its invoices and what each owed when it opened.
model PaymentSessionInvoice {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  sessionId String  @map("session_id") @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  amount    Decimal @db.Decimal(12, 2)

  session PaymentSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice Invoice        @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId, invoiceId], map: "payment_session_invoices_once")
  @@map("payment_session_invoices")
}

/// A Paymob callback that passed the HMAC, and what came of it (ADR 0046).
/// Signed scalar fields only. Append-only.
model PaymentGatewayEvent {
  id                   String   @id @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  sessionId            String?  @map("session_id") @db.Uuid
  gatewayTransactionId String   @map("gateway_transaction_id")
  gatewayOrderId       String?  @map("gateway_order_id")
  amountCents          BigInt   @map("amount_cents")
  success              Boolean
  pending              Boolean
  outcome              String
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session PaymentSession? @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, sessionId, createdAt], map: "payment_gateway_events_session_idx")
  @@index([tenantId, createdAt, id], map: "payment_gateway_events_created_idx")
  @@map("payment_gateway_events")
}

// ============================================================================
// Phase G6a — emergencies and gate services (ADR 0047)
// ============================================================================

/// A place of the compound (ADR 0047): where security meets, walks with or
/// looks. The seven defaults carry a `key`; the manager's own carry none.
/// Never deleted: requests point at it.
model Place {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String?
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shifts GuardShift[]

  @@unique([tenantId, id])
  @@index([tenantId, position, id], map: "places_order_idx")
  @@map("places")
}

enum SafetyCounterSeries {
  emergency
  accessibility
  service
  incident
  violation
  field_exception

  @@map("safety_counter_series")
}

/// A compound's E-, A- and S- numbers, taken under the row lock (ADR 0047).
model SafetyCounter {
  tenantId   String              @map("tenant_id") @db.Uuid
  series     SafetyCounterSeries
  lastNumber Int                 @default(0) @map("last_number")

  @@id([tenantId, series])
  @@map("safety_counters")
}

enum EmergencyType {
  medical
  fire
  security
  facilities

  @@map("emergency_type")
}

enum EmergencyStatus {
  reported
  on_the_way
  arrived
  resolved
  cancelled

  @@map("emergency_status")
}

/// An emergency reported from a unit (ADR 0047). Moves forward only (a
/// trigger); one open per unit and type (a partial unique index).
model Emergency {
  id                 String          @id @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  number             Int
  /// The unit it came from; null for a guard's SOS from a post (ADR 0053).
  unitId             String?         @map("unit_id") @db.Uuid
  /// A guard's SOS (ADR 0053): the gate or the zone of their open shift.
  originGateId       String?         @map("origin_gate_id") @db.Uuid
  originPlaceId      String?         @map("origin_place_id") @db.Uuid
  originShiftId      String?         @map("origin_shift_id") @db.Uuid
  type               EmergencyType
  status             EmergencyStatus @default(reported)
  reportedById       String          @map("reported_by_account_id") @db.Uuid
  reportedAt         DateTime        @default(now()) @map("reported_at") @db.Timestamptz(3)
  respondersNotified Int             @map("responders_notified")
  escalatedAt        DateTime?       @map("escalated_at") @db.Timestamptz(3)
  escalationReason   String?         @map("escalation_reason")
  responderId        String?         @map("responder_account_id") @db.Uuid
  responderGateId    String?         @map("responder_gate_id") @db.Uuid
  etaMinutes         Int?            @map("eta_minutes")
  acceptedAt         DateTime?       @map("accepted_at") @db.Timestamptz(3)
  arrivedAt          DateTime?       @map("arrived_at") @db.Timestamptz(3)
  closedAt           DateTime?       @map("closed_at") @db.Timestamptz(3)
  closedById         String?         @map("closed_by_account_id") @db.Uuid
  closeSide          String?         @map("close_side")
  closeReason        String?         @map("close_reason")
  closeNote          String?         @map("close_note")
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "emergencies_number_key")
  @@index([tenantId, status, reportedAt, id], map: "emergencies_status_idx")
  @@map("emergencies")
}

/// One of the others living in the unit, told of an emergency (ADR 0047),
/// and their "on my way" (once).
model EmergencyFamilyAlert {
  tenantId    String    @map("tenant_id") @db.Uuid
  emergencyId String    @map("emergency_id") @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  notifiedAt  DateTime  @default(now()) @map("notified_at") @db.Timestamptz(3)
  onMyWayAt   DateTime? @map("on_my_way_at") @db.Timestamptz(3)

  @@id([tenantId, emergencyId, accountId])
  @@map("emergency_family_alerts")
}

enum GateServiceKind {
  accessibility
  suspicious
  escort
  lane

  @@map("gate_service_kind")
}

enum GateServiceStatus {
  open
  accepted
  in_progress
  closed
  cancelled

  @@map("gate_service_status")
}

/// What a resident asks security for (ADR 0047): accessibility help, a
/// suspicious-activity report, an escort or a lane at a gate. Moves forward
/// only (a trigger); the resident's words and photo go once, at erasure.
model GateServiceRequest {
  id             String            @id @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  number         Int
  kind           GateServiceKind
  status         GateServiceStatus @default(open)
  unitId         String            @map("unit_id") @db.Uuid
  requestedById  String            @map("requested_by_account_id") @db.Uuid
  assistanceKind String?           @map("assistance_kind")
  memberId       String?           @map("member_id") @db.Uuid
  fromPlaceId    String?           @map("from_place_id") @db.Uuid
  toPlaceId      String?           @map("to_place_id") @db.Uuid
  placeId        String?           @map("place_id") @db.Uuid
  whenCode       String?           @map("when_code")
  wantedAt       DateTime?         @map("wanted_at") @db.Timestamptz(3)
  description    String?
  photoFileId    String?           @map("photo_file_id") @db.Uuid
  laneReason     String?           @map("lane_reason")
  gateId         String?           @map("gate_id") @db.Uuid
  notes          String?
  textClearedAt  DateTime?         @map("text_cleared_at") @db.Timestamptz(3)
  handledById    String?           @map("handled_by_account_id") @db.Uuid
  etaMinutes     Int?              @map("eta_minutes")
  acceptedAt     DateTime?         @map("accepted_at") @db.Timestamptz(3)
  startedAt      DateTime?         @map("started_at") @db.Timestamptz(3)
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(3)
  closedById     String?           @map("closed_by_account_id") @db.Uuid
  closeReason    String?           @map("close_reason")
  closeNote      String?           @map("close_note")
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelSide     String?           @map("cancel_side")
  cancelReason   String?           @map("cancel_reason")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt, id], map: "gate_service_requests_status_idx")
  @@map("gate_service_requests")
}

// ============================================================================
// Phase G3 — permits and contractors (ADR 0049)
// ============================================================================

/// A compound's permit rules (ADR 0049): the week days and the hours works
/// and moves may take place in, and dated days off. One row, created with
/// the compound.
model PermitSettings {
  tenantId  String     @id @map("tenant_id") @db.Uuid
  workDays  Int[]      @default([0, 1, 2, 3, 4, 6]) @map("work_days") @db.SmallInt
  workFrom  Int        @default(540) @map("work_from") @db.SmallInt
  workTo    Int        @default(1020) @map("work_to") @db.SmallInt
  daysOff   DateTime[] @default([]) @map("days_off") @db.Date
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("permit_settings")
}

enum UnitPermitKind {
  works
  move
  material_exit
  event

  @@map("unit_permit_kind")
}

enum UnitPermitStatus {
  pending
  approved
  rejected
  cancelled
  revoked
  used

  @@map("unit_permit_status")
}

/// A compound's W-, M-, X- and E- numbers, taken under the row lock (ADR 0049).
model PermitCounter {
  tenantId   String         @map("tenant_id") @db.Uuid
  kind       UnitPermitKind
  lastNumber Int            @default(0) @map("last_number")

  @@id([tenantId, kind])
  @@map("permit_counters")
}

/// What a unit asks the management for (ADR 0049): works by a contractor,
/// a furniture move, taking materials out, a private event. Moves forward
/// only (a trigger); the resident's words and photo go once, at erasure;
/// the plate and the photo once, 30 days after the end.
model UnitPermit {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  number            Int
  kind              UnitPermitKind
  status            UnitPermitStatus @default(pending)
  unitId            String           @map("unit_id") @db.Uuid
  requestedById     String           @map("requested_by_account_id") @db.Uuid
  startsAt          DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime         @map("ends_at") @db.Timestamptz(3)
  workType          String?          @map("work_type")
  dailyFrom         Int?             @map("daily_from") @db.SmallInt
  dailyTo           Int?             @map("daily_to") @db.SmallInt
  contractorCompany String?          @map("contractor_company")
  description       String?
  truckPlate        String?          @map("truck_plate")
  /// Generated by the database from `truck_plate` (ADR 0045, 0047).
  plateKey          String?          @map("plate_key")
  itemsDescription  String?          @map("items_description")
  items             Json?
  photoFileId       String?          @map("photo_file_id") @db.Uuid
  usedAt            DateTime?        @map("used_at") @db.Timestamptz(3)
  usedById          String?          @map("used_by_account_id") @db.Uuid
  usedGateId        String?          @map("used_gate_id") @db.Uuid
  title             String?
  guestLimit        Int?             @map("guest_limit")
  decisionSource    String?          @map("decision_source")
  decidedById       String?          @map("decided_by_account_id") @db.Uuid
  decidedAt         DateTime?        @map("decided_at") @db.Timestamptz(3)
  rejectReason      String?          @map("reject_reason")
  staffNote         String?          @map("staff_note")
  revokedAt         DateTime?        @map("revoked_at") @db.Timestamptz(3)
  revokedById       String?          @map("revoked_by_account_id") @db.Uuid
  revokeReason      String?          @map("revoke_reason")
  revokeNote        String?          @map("revoke_note")
  cancelledAt       DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  cancelledById     String?          @map("cancelled_by_account_id") @db.Uuid
  cancelSide        String?          @map("cancel_side")
  cancelReason      String?          @map("cancel_reason")
  textClearedAt     DateTime?        @map("text_cleared_at") @db.Timestamptz(3)
  purgedAt          DateTime?        @map("purged_at") @db.Timestamptz(3)
  /// A decision appeal against the rejection (ADR 0059): its mark (the
  /// purge waits), its closing, and the overturn that approved it, once.
  decisionAppealAt       DateTime? @map("decision_appeal_at") @db.Timestamptz(3)
  decisionAppealClosedAt DateTime? @map("decision_appeal_closed_at") @db.Timestamptz(3)
  appealOverturnedAt     DateTime? @map("appeal_overturned_at") @db.Timestamptz(3)
  appealOverturnedById   String?   @map("appeal_overturned_by_account_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, id, kind], map: "unit_permits_tenant_id_id_kind_key")
  @@index([tenantId, status, createdAt, id], map: "unit_permits_status_idx")
  @@map("unit_permits")
}

/// A works permit's contractor worker (ADR 0049): a name, a face, the type
/// of their ID and the last four of its number as a keyed hash only.
/// Removed once; purged once, 30 days after the permit ends.
model PermitWorker {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  permitId     String         @map("permit_id") @db.Uuid
  permitKind   UnitPermitKind @default(works) @map("permit_kind")
  fullName     String?        @map("full_name")
  photoFileId  String?        @map("photo_file_id") @db.Uuid
  idType       IdDocumentType @map("id_type")
  idLast4Hash  String?        @map("id_last4_hash") @db.Char(64)
  addedById    String         @map("added_by_account_id") @db.Uuid
  removedAt    DateTime?      @map("removed_at") @db.Timestamptz(3)
  removedById  String?        @map("removed_by_account_id") @db.Uuid
  removedSide  String?        @map("removed_side")
  removeReason String?        @map("remove_reason")
  purgedAt     DateTime?      @map("purged_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  fieldExceptions GateFieldException[]

  @@unique([tenantId, id])
  @@index([tenantId, permitId, createdAt, id], map: "permit_workers_permit_idx")
  @@map("permit_workers")
}

/// An event's guest (ADR 0049): a name and, optionally, a car's plate.
/// Removed once by the host; purged once, 30 days after the event ends.
model PermitGuest {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  permitId     String         @map("permit_id") @db.Uuid
  permitKind   UnitPermitKind @default(event) @map("permit_kind")
  fullName     String?        @map("full_name")
  vehiclePlate String?        @map("vehicle_plate")
  /// Generated by the database from `vehicle_plate`.
  plateKey     String?        @map("plate_key")
  addedById    String         @map("added_by_account_id") @db.Uuid
  removedAt    DateTime?      @map("removed_at") @db.Timestamptz(3)
  purgedAt     DateTime?      @map("purged_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, permitId, createdAt, id], map: "permit_guests_permit_idx")
  @@map("permit_guests")
}

/// Materials brought in, as the guard logs them (ADR 0049): append-only, no
/// foreign keys (like gate_entries). The description is staff text.
model MaterialEntry {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  permitId       String?  @map("permit_id") @db.Uuid
  gateId         String   @map("gate_id") @db.Uuid
  shiftId        String   @map("shift_id") @db.Uuid
  guardAccountId String   @map("guard_account_id") @db.Uuid
  description    String
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)], map: "material_entries_occurred_idx")
  @@map("material_entries")
}

// ============================================================================
// Phase G4 — guard shifts and tasks (ADR 0050)
// ============================================================================

enum GuardSlotStatus {
  scheduled
  cancelled

  @@map("guard_slot_status")
}

/// A guard's weekly roster at one post (a gate or a zone, CHECK): a weekly
/// schedule (src/core/common/slots/weekly-schedule.ts) between two days of
/// the compound. Made into slots ahead of time. What it says never changes;
/// it is ended once (trigger).
model GuardRosterTemplate {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  guardAccountId String    @map("guard_account_id") @db.Uuid
  gateId         String?   @map("gate_id") @db.Uuid
  placeId        String?   @map("place_id") @db.Uuid
  schedule       Json
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  /// The last day it applies, inclusive; null for no end.
  effectiveUntil DateTime? @map("effective_until") @db.Date
  createdById    String    @map("created_by_account_id") @db.Uuid
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  endedById      String?   @map("ended_by_account_id") @db.Uuid
  /// REASON_CODES.guardTemplateEnd.
  endReason      String?   @map("end_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, guardAccountId], map: "guard_roster_templates_guard_idx")
  @@map("guard_roster_templates")
}

/// One scheduled shift of one guard at one post (CHECK), a day at most. A
/// template's slots are made once each (a unique index, cancelled ones
/// included). It keeps its post and times; it is cancelled, filled by a
/// shift and marked absent once each; it changes guard only by a swap,
/// while unopened (trigger).
model GuardRosterSlot {
  id             String          @id @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  guardAccountId String          @map("guard_account_id") @db.Uuid
  gateId         String?         @map("gate_id") @db.Uuid
  placeId        String?         @map("place_id") @db.Uuid
  startsAt       DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime        @map("ends_at") @db.Timestamptz(3)
  templateId     String?         @map("template_id") @db.Uuid
  /// Who added a single slot; null for a template's.
  createdById    String?         @map("created_by_account_id") @db.Uuid
  status         GuardSlotStatus @default(scheduled)
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelledById  String?         @map("cancelled_by_account_id") @db.Uuid
  /// REASON_CODES.guardSlotCancel.
  cancelReason   String?         @map("cancel_reason")
  /// The shift that filled it.
  shiftId        String?         @map("shift_id") @db.Uuid
  /// Minutes after the slot was due (its start, or when it was made if
  /// later) the shift opened (0 when on time or early).
  /// Late is more than ten (ADR 0050).
  lateMinutes    Int?            @map("late_minutes")
  /// Not opened an hour after it was due (the attendance sweep).
  absentAt       DateTime?       @map("absent_at") @db.Timestamptz(3)
  /// When a swap last gave it to its guard.
  swappedAt      DateTime?       @map("swapped_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, shiftId], map: "guard_roster_slots_shift_key")
  @@index([tenantId, guardAccountId, startsAt], map: "guard_roster_slots_guard_idx")
  @@index([tenantId, startsAt, id], map: "guard_roster_slots_start_idx")
  @@map("guard_roster_slots")
}

enum GuardHandoverKind {
  guard
  system

  @@map("guard_handover_kind")
}

/// One item of the compound's handover checklist (ADR 0050): the
/// management's words. Retired, never deleted (trigger).
model GuardHandoverItem {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  label     String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, position, id], map: "guard_handover_items_order_idx")
  @@map("guard_handover_items")
}

/// One per ended shift (ADR 0050): the checklist as the guard ticked it and
/// their notes, or the system's (no checklist) when the system ended the
/// shift. The next guard at that post acknowledges it, once. It keeps what
/// it said; the notes go at their author's erasure (trigger).
model GuardHandover {
  id                  String            @id @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  shiftId             String            @map("shift_id") @db.Uuid
  guardAccountId      String            @map("guard_account_id") @db.Uuid
  gateId              String?           @map("gate_id") @db.Uuid
  placeId             String?           @map("place_id") @db.Uuid
  kind                GuardHandoverKind
  /// `[{ itemId, label }]`, the items as they read when ticked.
  checklist           Json              @default("[]")
  /// Free text, may name people: never in the audit trail or a notification.
  notes               String?
  notesClearedAt      DateTime?         @map("notes_cleared_at") @db.Timestamptz(3)
  acknowledgedById    String?           @map("acknowledged_by_account_id") @db.Uuid
  acknowledgedShiftId String?           @map("acknowledged_shift_id") @db.Uuid
  acknowledgedAt      DateTime?         @map("acknowledged_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, shiftId], map: "guard_handovers_shift_key")
  @@index([tenantId, createdAt, id], map: "guard_handovers_created_idx")
  @@index([tenantId, guardAccountId], map: "guard_handovers_guard_idx")
  @@map("guard_handovers")
}

enum GuardTaskKind {
  closed_unit_inspection
  custom

  @@map("guard_task_kind")
}

enum GuardTaskStatus {
  open
  in_progress
  done
  cancelled

  @@map("guard_task_status")
}

/// Work the management gives guards (ADR 0050): a closed unit to inspect,
/// or a task in its own words, for one guard, a gate or a zone (exactly
/// one, CHECK). A guard takes it and completes it with an outcome. A
/// shift's end moves the tasks its guard had to the shift's post. It keeps
/// what it asks and moves forward only (trigger).
model GuardTask {
  id                 String          @id @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  kind               GuardTaskKind
  /// A custom task's title, the management's words.
  title              String?
  details            String?
  /// The closed unit to inspect.
  unitId             String?         @map("unit_id") @db.Uuid
  assigneeId         String?         @map("assignee_account_id") @db.Uuid
  gateId             String?         @map("gate_id") @db.Uuid
  placeId            String?         @map("place_id") @db.Uuid
  dueAt              DateTime?       @map("due_at") @db.Timestamptz(3)
  createdById        String          @map("created_by_account_id") @db.Uuid
  status             GuardTaskStatus @default(open)
  takenById          String?         @map("taken_by_account_id") @db.Uuid
  takenAt            DateTime?       @map("taken_at") @db.Timestamptz(3)
  doneAt             DateTime?       @map("done_at") @db.Timestamptz(3)
  /// REASON_CODES.guardTaskOutcome.
  outcome            String?
  /// The guard's words: never in the audit trail or a notification.
  resultNote         String?         @map("result_note")
  resultClearedAt    DateTime?       @map("result_cleared_at") @db.Timestamptz(3)
  cancelledAt        DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?         @map("cancelled_by_account_id") @db.Uuid
  /// REASON_CODES.guardTaskCancel or guardTaskCancelSystem.
  cancelReason       String?         @map("cancel_reason")
  /// The shift whose end last moved it to its post.
  carriedFromShiftId String?         @map("carried_from_shift_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id], map: "guard_tasks_created_idx")
  @@index([tenantId, unitId], map: "guard_tasks_unit_idx")
  @@map("guard_tasks")
}

/// A task's photo, attached at its completion (ADR 0050). Never changes.
model GuardTaskPhoto {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  fileId       String   @unique @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, taskId], map: "guard_task_photos_task_idx")
  @@map("guard_task_photos")
}

enum GuardSwapStatus {
  requested
  accepted
  approved
  declined
  rejected
  withdrawn
  cancelled
  expired

  @@map("guard_swap_status")
}

/// A guard asks a colleague to take one of their slots (ADR 0050): in
/// exchange for one of the colleague's, or as a cover. The colleague
/// accepts or declines; the roster's keepers approve or reject an accepted
/// one, and approval gives the slots their new guards. A slot is in one
/// live swap at most. It keeps who asked whom for what and moves forward
/// only (trigger).
model GuardShiftSwap {
  id              String          @id @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  requesterId     String          @map("requester_account_id") @db.Uuid
  requesterSlotId String          @map("requester_slot_id") @db.Uuid
  colleagueId     String          @map("colleague_account_id") @db.Uuid
  /// The colleague's slot in exchange; null for a cover.
  colleagueSlotId String?         @map("colleague_slot_id") @db.Uuid
  /// The requester's words: never in the audit trail or a notification.
  reason          String?
  reasonClearedAt DateTime?       @map("reason_cleared_at") @db.Timestamptz(3)
  status          GuardSwapStatus @default(requested)
  acceptedAt      DateTime?       @map("accepted_at") @db.Timestamptz(3)
  decidedAt       DateTime?       @map("decided_at") @db.Timestamptz(3)
  decidedById     String?         @map("decided_by_account_id") @db.Uuid
  /// REASON_CODES.guardSwapReject.
  rejectReason    String?         @map("reject_reason")
  closedAt        DateTime?       @map("closed_at") @db.Timestamptz(3)
  /// REASON_CODES.guardSwapCancel, for a swap the system cancelled.
  closeReason     String?         @map("close_reason")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, requesterId, createdAt], map: "guard_shift_swaps_requester_idx")
  @@index([tenantId, colleagueId, createdAt], map: "guard_shift_swaps_colleague_idx")
  @@index([tenantId, status, createdAt, id], map: "guard_shift_swaps_status_idx")
  @@map("guard_shift_swaps")
}

enum GuardInstructionAudience {
  all
  gate
  zone

  @@map("guard_instruction_audience")
}

enum GuardInstructionVia {
  send
  shift_start

  @@map("guard_instruction_via")
}

/// An instruction the management sends guards (ADR 0050): to all of them,
/// a gate or a zone (CHECK). Every guard it reaches acknowledges it. What
/// it says never changes; it is archived once (trigger).
model GuardInstruction {
  id           String                   @id @db.Uuid
  tenantId     String                   @map("tenant_id") @db.Uuid
  title        String
  body         String
  /// A critical push; otherwise a normal one.
  urgent       Boolean                  @default(false)
  audience     GuardInstructionAudience
  gateId       String?                  @map("gate_id") @db.Uuid
  placeId      String?                  @map("place_id") @db.Uuid
  createdById  String                   @map("created_by_account_id") @db.Uuid
  archivedAt   DateTime?                @map("archived_at") @db.Timestamptz(3)
  archivedById String?                  @map("archived_by_account_id") @db.Uuid
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// A compound day it holds from, inclusive (ADR 0056); null: from its sending.
  validFrom            DateTime?                @map("valid_from") @db.Date
  /// A compound day it holds until, inclusive; null: until archived.
  validUntil           DateTime?                @map("valid_until") @db.Date

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id], map: "guard_instructions_created_idx")
  @@map("guard_instructions")
}

/// A guard an instruction reaches (ADR 0050): recorded at the send, or
/// when they open a shift where it applies while it is live. Acknowledged
/// once (trigger).
model GuardInstructionRecipient {
  id             String              @id @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  instructionId  String              @map("instruction_id") @db.Uuid
  accountId      String              @map("account_id") @db.Uuid
  addedVia       GuardInstructionVia @map("added_via")
  addedAt        DateTime            @default(now()) @map("added_at") @db.Timestamptz(3)
  acknowledgedAt DateTime?           @map("acknowledged_at") @db.Timestamptz(3)
  /// When the guard was told (ADR 0056): once, on a day it is valid.
  notifiedAt     DateTime?             @map("notified_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, instructionId, accountId], map: "guard_instruction_recipients_once_key")
  @@index([tenantId, accountId, addedAt], map: "guard_instruction_recipients_account_idx")
  @@map("guard_instruction_recipients")
}

enum FoundItemStatus {
  at_gate
  with_management
  claimed

  @@map("found_item_status")
}

/// The gate's lost-and-found register (ADR 0050): what security found or
/// was handed, where, when, photos, who registered it. Claimed at the gate,
/// or received by the management and claimed at the office. A claimant is
/// a unit and/or a name as told; the name goes after 30 days. What was found
/// never changes; it moves forward only (trigger).
model FoundItem {
  id                    String          @id @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  description           String
  /// Where it was found: a place, and/or words.
  placeId               String?         @map("place_id") @db.Uuid
  location              String?
  foundAt               DateTime        @map("found_at") @db.Timestamptz(3)
  registeredById        String          @map("registered_by_account_id") @db.Uuid
  /// The registering guard's shift and its post; null at the office.
  shiftId               String?         @map("shift_id") @db.Uuid
  gateId                String?         @map("gate_id") @db.Uuid
  zoneId                String?         @map("zone_id") @db.Uuid
  status                FoundItemStatus @default(at_gate)
  receivedAt            DateTime?       @map("received_at") @db.Timestamptz(3)
  receivedById          String?         @map("received_by_account_id") @db.Uuid
  claimedAt             DateTime?       @map("claimed_at") @db.Timestamptz(3)
  claimRecordedById     String?         @map("claim_recorded_by_account_id") @db.Uuid
  claimantUnitId        String?         @map("claimant_unit_id") @db.Uuid
  /// As told: personal data, cleared at `claimant_name_expires_at`.
  claimantName          String?         @map("claimant_name")
  claimantNameExpiresAt DateTime?       @map("claimant_name_expires_at") @db.Timestamptz(3)
  claimantNameClearedAt DateTime?       @map("claimant_name_cleared_at") @db.Timestamptz(3)
  claimNote             String?         @map("claim_note")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt, id], map: "found_items_status_idx")
  @@index([tenantId, createdAt, id], map: "found_items_created_idx")
  @@map("found_items")
}

/// A found item's photo (ADR 0050). Never changes.
model FoundItemPhoto {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  fileId       String   @unique @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, itemId], map: "found_item_photos_item_idx")
  @@map("found_item_photos")
}
// Governance (ADR 0051): the owners' board, its polls and elections.
// ============================================================================

enum BoardTermSource {
  appointed
  elected

  @@map("board_term_source")
}

enum BoardRole {
  chair
  secretary
  treasurer
  member

  @@map("board_role")
}

/// A board's term (ADR 0051). At most one open (not ended) per compound; it
/// is current while startsAt <= now < endsAt. Ends once, when the next
/// board takes over (`succeeded`) or is appointed after it lapsed
/// (`replaced`).
model BoardTerm {
  id          String          @id @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  source      BoardTermSource
  electionId  String?         @map("election_id") @db.Uuid
  seats       Int             @db.SmallInt
  startsAt    DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime        @map("ends_at") @db.Timestamptz(3)
  endedAt     DateTime?       @map("ended_at") @db.Timestamptz(3)
  endReason   String?         @map("end_reason")
  createdById String          @map("created_by_account_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, electionId], map: "board_terms_one_per_election")
  @@index([tenantId, startsAt, id], map: "board_terms_history_idx")
  @@map("board_terms")
}

/// An owner's seat on a board (ADR 0051): a role that may change while it
/// lasts, and an end, once.
model BoardMember {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  termId    String    @map("term_id") @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  role      BoardRole
  addedAt   DateTime  @map("added_at") @db.Timestamptz(3)
  addedById String    @map("added_by_account_id") @db.Uuid
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  endReason String?   @map("end_reason")
  endedById String?   @map("ended_by_account_id") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, termId, addedAt, id], map: "board_members_term_idx")
  @@map("board_members")
}

enum GovernanceContestKind {
  poll
  election

  @@map("governance_contest_kind")
}

/// What polls and elections share (ADR 0051): a window, an electorate
/// snapshotted when it opens, a close or a cancel, once. `secret` and
/// `maxChoices` never change.
model GovernanceContest {
  id          String                @id @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  kind        GovernanceContestKind
  secret      Boolean
  maxChoices  Int                   @map("max_choices") @db.SmallInt
  opensAt     DateTime              @map("opens_at") @db.Timestamptz(3)
  closesAt    DateTime              @map("closes_at") @db.Timestamptz(3)
  openedAt    DateTime?             @map("opened_at") @db.Timestamptz(3)
  electorate  Int?
  closedAt    DateTime?             @map("closed_at") @db.Timestamptz(3)
  turnout     Int?
  cancelledAt DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  remindedAt  DateTime?             @map("reminded_at") @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, id, secret], map: "governance_contests_tenant_id_id_secret_key")
  @@map("governance_contests")
}

/// The account that casts a unit's vote in a contest, as it was when the
/// contest opened (ADR 0051). Append-only, written before the open only.
model GovernanceElector {
  tenantId  String @map("tenant_id") @db.Uuid
  contestId String @map("contest_id") @db.Uuid
  unitId    String @map("unit_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  @@id([tenantId, contestId, unitId])
  @@index([tenantId, accountId], map: "governance_electors_account_idx")
  @@map("governance_electors")
}

/// A unit took part in a contest (ADR 0051): by whom and when, once. The
/// choice only when the contest is open (not secret). Append-only.
model GovernanceParticipation {
  tenantId       String   @map("tenant_id") @db.Uuid
  contestId      String   @map("contest_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  voterAccountId String   @map("voter_account_id") @db.Uuid
  votedAt        DateTime @map("voted_at") @db.Timestamptz(3)
  secret         Boolean
  choice         String[] @db.Uuid

  @@id([tenantId, contestId, unitId])
  @@index([tenantId, voterAccountId], map: "governance_participations_voter_idx")
  @@map("governance_participations")
}

/// A secret contest's ballots while voting is open (ADR 0051): one row,
/// `{ <random v4 id>: [choice ids] }`. No unit, no account, no time.
model GovernanceBallotBox {
  tenantId  String  @map("tenant_id") @db.Uuid
  contestId String  @map("contest_id") @db.Uuid
  secret    Boolean @default(true)
  ballots   Json    @default("{}")

  @@id([tenantId, contestId])
  @@map("governance_ballot_boxes")
}

/// A closed secret contest's ballot (ADR 0051): a random v4 id, the contest
/// and the choice; nothing else. Written at the close, in id order.
model GovernanceBallot {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  contestId String   @map("contest_id") @db.Uuid
  choice    String[] @db.Uuid

  @@index([tenantId, contestId], map: "governance_ballots_contest_idx")
  @@map("governance_ballots")
}

enum GovernancePollKind {
  yes_no
  choice

  @@map("governance_poll_kind")
}

/// The last number given per compound and contest kind (ADR 0051).
/// Numbers per compound: polls (P-), elections (E-), approval requests
/// (AR-) and appeals to the board (BA-) (ADR 0051, 0055).
model GovernanceCounter {
  tenantId   String @map("tenant_id") @db.Uuid
  kind       String
  lastNumber Int    @map("last_number")

  @@id([tenantId, kind])
  @@map("governance_counters")
}

/// An owners' poll (ADR 0051): yes / no / abstain or one of 2–10 options, a
/// quorum and a pass threshold; secret or open, fixed at creation (its
/// contest). Changes only until it opens; then a cancel or its result, once.
model GovernancePoll {
  id                   String             @id @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  contestId            String             @map("contest_id") @db.Uuid
  number               Int
  kind                 GovernancePollKind
  titleEn              String?            @map("title_en")
  titleAr              String?            @map("title_ar")
  bodyEn               String?            @map("body_en")
  bodyAr               String?            @map("body_ar")
  quorumPct            Int                @map("quorum_pct") @db.SmallInt
  thresholdPct         Int                @map("threshold_pct") @db.SmallInt
  authorSide           String             @map("author_side")
  createdById          String             @map("created_by_account_id") @db.Uuid
  result               String?
  winningOptionId      String?            @map("winning_option_id") @db.Uuid
  cancelReasonCode     String?            @map("cancel_reason_code")
  cancelledById        String?            @map("cancelled_by_account_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, contestId], map: "governance_polls_contest_key")
  @@unique([tenantId, number], map: "governance_polls_number_key")
  @@index([tenantId, createdAt, id], map: "governance_polls_created_idx")
  @@map("governance_polls")
}

model GovernancePollOption {
  id         String  @id @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  pollId     String  @map("poll_id") @db.Uuid
  position   Int     @db.SmallInt
  key        String?
  labelEn    String? @map("label_en")
  labelAr    String? @map("label_ar")
  finalCount Int?    @map("final_count")

  @@unique([tenantId, id])
  @@unique([tenantId, pollId, position], map: "governance_poll_options_position_key")
  @@map("governance_poll_options")
}

enum GovernanceCandidateStatus {
  nominated
  withdrawn
  disqualified

  @@map("governance_candidate_status")
}

/// An election of the board (ADR 0051): nominations, then a secret vote of
/// up to `seats` candidates per unit (its contest), then a certification
/// that seats the next board for `termMonths`.
model GovernanceElection {
  id                    String    @id @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  contestId             String    @map("contest_id") @db.Uuid
  number                Int
  titleEn               String?   @map("title_en")
  titleAr               String?   @map("title_ar")
  bodyEn                String?   @map("body_en")
  bodyAr                String?   @map("body_ar")
  seats                 Int       @db.SmallInt
  termMonths            Int       @map("term_months") @db.SmallInt
  nominationsOpenAt     DateTime  @map("nominations_open_at") @db.Timestamptz(3)
  nominationsCloseAt    DateTime  @map("nominations_close_at") @db.Timestamptz(3)
  nominationsNotifiedAt DateTime? @map("nominations_notified_at") @db.Timestamptz(3)
  authorSide            String    @map("author_side")
  createdById           String    @map("created_by_account_id") @db.Uuid
  certifiedAt           DateTime? @map("certified_at") @db.Timestamptz(3)
  certifiedById         String?   @map("certified_by_account_id") @db.Uuid
  tieReasonCode         String?   @map("tie_reason_code")
  cancelReasonCode      String?   @map("cancel_reason_code")
  cancelledById         String?   @map("cancelled_by_account_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, contestId], map: "governance_elections_contest_key")
  @@unique([tenantId, number], map: "governance_elections_number_key")
  @@index([tenantId, createdAt, id], map: "governance_elections_created_idx")
  @@map("governance_elections")
}

/// An owner standing in an election (ADR 0051). The statement is theirs:
/// an erasure clears it. Ends once, before voting opens; counted once.
model GovernanceCandidate {
  id                 String                    @id @db.Uuid
  tenantId           String                    @map("tenant_id") @db.Uuid
  electionId         String                    @map("election_id") @db.Uuid
  accountId          String                    @map("account_id") @db.Uuid
  statement          String?
  statementClearedAt DateTime?                 @map("statement_cleared_at") @db.Timestamptz(3)
  status             GovernanceCandidateStatus @default(nominated)
  nominatedAt        DateTime                  @map("nominated_at") @db.Timestamptz(3)
  endedAt            DateTime?                 @map("ended_at") @db.Timestamptz(3)
  reasonCode         String?                   @map("reason_code")
  endedById          String?                   @map("ended_by_account_id") @db.Uuid
  finalCount         Int?                      @map("final_count")
  outcome            String?

  @@unique([tenantId, id])
  @@index([tenantId, electionId, nominatedAt, id], map: "governance_candidates_election_idx")
  @@index([tenantId, accountId], map: "governance_candidates_account_idx")
  @@map("governance_candidates")
}

/// A decision or the minutes of the board (ADR 0051): an announcement of
/// kind `board` to the owners, and the record of who published it, for
/// which board, decided on which day. Archived once.
model BoardPublication {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  kind           String
  termId         String    @map("term_id") @db.Uuid
  announcementId String    @map("announcement_id") @db.Uuid
  decidedOn      DateTime  @map("decided_on") @db.Date
  authorSide     String    @map("author_side")
  publishedById  String    @map("published_by_account_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The approval request a decision published by itself decided (ADR 0059).
  approvalRequestId String? @map("approval_request_id") @db.Uuid

  compoundDocumentVersions CompoundDocumentVersion[]
  @@unique([tenantId, id])
  @@unique([tenantId, announcementId], map: "board_publications_announcement_key")
  @@index([tenantId, createdAt, id], map: "board_publications_created_idx")
  @@map("board_publications")
}

// ============================================================================
// Board matters (ADR 0055)
// ============================================================================

/// A compound's deadline (days) per approval type and for appeals to the
/// board, and the thresholds of the four thresholded types. One row each,
/// created with the compound.
model GovernanceApprovalSetting {
  tenantId     String   @map("tenant_id") @db.Uuid
  type         String
  deadlineDays Int      @map("deadline_days") @db.SmallInt
  threshold    Decimal? @db.Decimal(14, 2)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, type])
  @@map("governance_approval_settings")
}

/// A decision package put to the board (ADR 0055): kept as raised; pending,
/// then approved or rejected by a carried motion, or withdrawn; an approved
/// one implemented once.
model GovernanceApprovalRequest {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  number             Int
  type               String
  subjectId          String?   @map("subject_id") @db.Uuid
  raisedById         String    @map("raised_by_account_id") @db.Uuid
  context            String
  impact             String
  cost               Decimal?  @db.Decimal(14, 2)
  currency           String    @default("EGP")
  deadlineAt         DateTime  @map("deadline_at") @db.Timestamptz(3)
  status             String    @default("pending")
  decidedAt          DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedMotionId    String?   @map("decided_motion_id") @db.Uuid
  withdrawnAt        DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnById      String?   @map("withdrawn_by_account_id") @db.Uuid
  withdrawReasonCode String?   @map("withdraw_reason_code")
  implementedAt      DateTime? @map("implemented_at") @db.Timestamptz(3)
  implementedById    String?   @map("implemented_by_account_id") @db.Uuid
  implementationNote String?   @map("implementation_note")
  overdueNotifiedAt  DateTime? @map("overdue_notified_at") @db.Timestamptz(3)
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "governance_approval_requests_number_key")
  @@index([tenantId, status, createdAt, id], map: "governance_approval_requests_status_idx")
  @@index([tenantId, createdAt, id], map: "governance_approval_requests_created_idx")
  @@map("governance_approval_requests")
}

/// One of a package's alternatives, in order (ADR 0055). Never changed.
model GovernanceApprovalAlternative {
  tenantId  String   @map("tenant_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  position  Int      @db.SmallInt
  text      String
  cost      Decimal? @db.Decimal(14, 2)

  @@id([tenantId, requestId, position])
  @@map("governance_approval_alternatives")
}

/// A package's attached file, in order (ADR 0055). Never changed.
model GovernanceApprovalAttachment {
  tenantId  String @map("tenant_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  position  Int    @db.SmallInt

  @@id([tenantId, requestId, position])
  @@unique([tenantId, fileId], map: "governance_approval_attachments_file_key")
  @@map("governance_approval_attachments")
}

/// A motion of the board on a matter (ADR 0055): the outcome and the
/// reasons, fixed when proposed; closed once (carried, failed, withdrawn,
/// lapsed), with the count for a carried or failed one.
model BoardMotion {
  id                     String    @id @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  approvalRequestId      String?   @map("approval_request_id") @db.Uuid
  boardAppealId          String?   @map("board_appeal_id") @db.Uuid
  /// A representative matter's (ADR 0059).
  representativeMatterId String?   @map("representative_matter_id") @db.Uuid
  termId                 String    @map("term_id") @db.Uuid
  proposedByMemberId     String    @map("proposed_by_member_id") @db.Uuid
  proposedById           String    @map("proposed_by_account_id") @db.Uuid
  outcome                String
  rationale              String
  alternativesNote       String?   @map("alternatives_note")
  openedAt               DateTime  @map("opened_at") @db.Timestamptz(3)
  closedAt               DateTime? @map("closed_at") @db.Timestamptz(3)
  result                 String?
  closedById             String?   @map("closed_by_account_id") @db.Uuid
  votesFor               Int?      @map("votes_for") @db.SmallInt
  votesAgainst           Int?      @map("votes_against") @db.SmallInt
  sitting                Int?      @db.SmallInt

  @@unique([tenantId, id])
  @@index([tenantId, approvalRequestId, openedAt, id], map: "board_motions_request_idx")
  @@index([tenantId, boardAppealId, openedAt, id], map: "board_motions_appeal_idx")
  @@index([tenantId, representativeMatterId, openedAt, id], map: "board_motions_representative_matter_idx")
  @@map("board_motions")
}

/// A member's vote on a motion (ADR 0055): once, while open, never changed.
model BoardVote {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  motionId  String   @map("motion_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  choice    String
  castAt    DateTime @map("cast_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, motionId, memberId], map: "board_votes_once")
  @@index([tenantId, accountId, castAt, id], map: "board_votes_account_idx")
  @@map("board_votes")
}

/// An appeal to the board of a staff decision (ADR 0055): kept as lodged
/// (but its grounds, cleared once on the appellant's erasure); pending, then
/// upheld or overturned by a carried motion, or withdrawn; one per decision.
model GovernanceBoardAppeal {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  number            Int
  kind              String
  subjectId         String    @map("subject_id") @db.Uuid
  unitId            String    @map("unit_id") @db.Uuid
  appellantId       String    @map("appellant_account_id") @db.Uuid
  grounds           String?
  groundsClearedAt  DateTime? @map("grounds_cleared_at") @db.Timestamptz(3)
  decisionAt        DateTime  @map("decision_at") @db.Timestamptz(3)
  lodgedAt          DateTime  @map("lodged_at") @db.Timestamptz(3)
  deadlineAt        DateTime  @map("deadline_at") @db.Timestamptz(3)
  status            String    @default("pending")
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedMotionId   String?   @map("decided_motion_id") @db.Uuid
  withdrawnAt       DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  effect            String?
  followedUpAt      DateTime? @map("followed_up_at") @db.Timestamptz(3)
  followedUpById    String?   @map("followed_up_by_account_id") @db.Uuid
  overdueNotifiedAt DateTime? @map("overdue_notified_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "governance_board_appeals_number_key")
  @@unique([tenantId, kind, subjectId], map: "governance_board_appeals_one_per_decision")
  @@index([tenantId, status, lodgedAt, id], map: "governance_board_appeals_status_idx")
  @@index([tenantId, unitId, lodgedAt, id], map: "governance_board_appeals_unit_idx")
  @@index([tenantId, appellantId], map: "governance_board_appeals_appellant_idx")
  @@map("governance_board_appeals")
}

/// A complaint about the management to the board (ADR 0059): what it is
/// about; its grounds are its board appeal's (`management_complaint`).
/// Never changed.
model ManagementComplaint {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  unitId        String   @map("unit_id") @db.Uuid
  authorId      String   @map("author_account_id") @db.Uuid
  category      String
  /// The management request it is about (its MR- number), if any.
  requestNumber Int?     @map("request_number")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, authorId, createdAt], map: "management_complaints_author_idx")
  @@map("management_complaints")
}

/// A building's representative (ADR 0059): an owner of a unit there, named
/// by the board, one at a time per building; ended once.
model GovernanceRepresentative {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  building            String
  accountId           String    @map("account_id") @db.Uuid
  unitId              String    @map("unit_id") @db.Uuid
  appointedAt         DateTime  @map("appointed_at") @db.Timestamptz(3)
  /// The board's matter that named them.
  appointedByMatterId String    @map("appointed_by_matter_id") @db.Uuid
  endedAt             DateTime? @map("ended_at") @db.Timestamptz(3)
  /// The board's matter that ended or replaced them; null when the system ended it.
  endedByMatterId     String?   @map("ended_by_matter_id") @db.Uuid
  endReason           String?   @map("end_reason")

  @@unique([tenantId, id])
  @@index([tenantId, accountId, appointedAt], map: "governance_representatives_account_idx")
  @@map("governance_representatives")
}

/// A board matter about a building's representative (ADR 0059): name an
/// owner (`appoint`) or end a term (`end`), decided by the board's motions
/// (ADR 0055); an approval applied, or why not.
model GovernanceRepresentativeMatter {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  /// `appoint` or `end`.
  action           String
  building         String
  /// The owner named, or the term's holder.
  accountId        String    @map("account_id") @db.Uuid
  /// The term to end; null for an appointment.
  representativeId String?   @map("representative_id") @db.Uuid
  raisedById       String    @map("raised_by_account_id") @db.Uuid
  raisedAt         DateTime  @map("raised_at") @db.Timestamptz(3)
  deadlineAt       DateTime  @map("deadline_at") @db.Timestamptz(3)
  status           String    @default("pending")
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedMotionId  String?   @map("decided_motion_id") @db.Uuid
  /// `applied` or `not_applied`, once approved.
  effect           String?
  effectReason     String?   @map("effect_reason")
  withdrawnAt      DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnById    String?   @map("withdrawn_by_account_id") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, status, raisedAt, id], map: "governance_representative_matters_status_idx")
  @@map("governance_representative_matters")
}

/// A resident's private thread with a representative (ADR 0059): their
/// unit then, and the last message's time.
model RepresentativeThread {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  representativeId String   @map("representative_id") @db.Uuid
  writerId         String   @map("writer_account_id") @db.Uuid
  unitId           String   @map("unit_id") @db.Uuid
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  lastMessageAt    DateTime @map("last_message_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, representativeId, writerId], map: "representative_threads_once")
  @@index([tenantId, representativeId, lastMessageAt, id], map: "representative_threads_representative_idx")
  @@map("representative_threads")
}

/// A message of a representative's thread (ADR 0059). Append-only; the
/// words cleared once, at their author's erasure.
model RepresentativeMessage {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  threadId      String    @map("thread_id") @db.Uuid
  /// `resident` or `representative`.
  side          String
  authorId      String    @map("author_account_id") @db.Uuid
  body          String?
  bodyClearedAt DateTime? @map("body_cleared_at") @db.Timestamptz(3)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, threadId, createdAt, id], map: "representative_messages_thread_idx")
  @@map("representative_messages")
}

/// An owner's proposal for the board's agenda (ADR 0059): decided once by
/// a sitting member, binding nothing.
model GovernanceAgendaProposal {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  authorId      String    @map("author_account_id") @db.Uuid
  title         String?
  body          String?
  textClearedAt DateTime? @map("text_cleared_at") @db.Timestamptz(3)
  status        String    @default("open")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedById   String?   @map("decided_by_account_id") @db.Uuid
  declineReason String?   @map("decline_reason")
  decisionNote  String?   @map("decision_note")
  withdrawnAt   DateTime? @map("withdrawn_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt, id], map: "governance_agenda_proposals_status_idx")
  @@index([tenantId, authorId, status], map: "governance_agenda_proposals_author_idx")
  @@map("governance_agenda_proposals")
}

/// An owner's objection to a decision the board published (ADR 0059),
/// once per unit; the grounds cleared once, at their erasure.
model GovernanceObjection {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  publicationId    String    @map("publication_id") @db.Uuid
  unitId           String    @map("unit_id") @db.Uuid
  authorId         String    @map("author_account_id") @db.Uuid
  grounds          String?
  groundsClearedAt DateTime? @map("grounds_cleared_at") @db.Timestamptz(3)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, publicationId, unitId], map: "governance_objections_once_per_unit")
  @@index([tenantId, authorId], map: "governance_objections_author_idx")
  @@map("governance_objections")
}

/// The board's one answer to a decision's objections (ADR 0059).
model GovernanceObjectionReply {
  tenantId      String   @map("tenant_id") @db.Uuid
  publicationId String   @map("publication_id") @db.Uuid
  body          String
  repliedById   String   @map("replied_by_account_id") @db.Uuid
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, publicationId])
  @@map("governance_objection_replies")
}

/// How an approved request is followed up (ADR 0059): append-only; the
/// last of `implemented` and `cannot_implement` is final, once.
model GovernanceApprovalProgress {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  status       String
  note         String?
  recordedAt   DateTime @map("recorded_at") @db.Timestamptz(3)
  /// Null when the decision itself implemented it.
  recordedById String?  @map("recorded_by_account_id") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, requestId, recordedAt, id], map: "governance_approval_progress_request_idx")
  @@map("governance_approval_progress")
}

/// An appeal's attached file, in order (ADR 0055). Never changed.
model GovernanceBoardAppealAttachment {
  tenantId String @map("tenant_id") @db.Uuid
  appealId String @map("appeal_id") @db.Uuid
  fileId   String @map("file_id") @db.Uuid
  position Int    @db.SmallInt

  @@id([tenantId, appealId, position])
  @@unique([tenantId, fileId], map: "governance_board_appeal_attachments_file_key")
  @@map("governance_board_appeal_attachments")
}

/// An account recused from a motion on an appeal (ADR 0055): written when
/// it opens. Never changed.
model BoardMotionRecusal {
  tenantId  String @map("tenant_id") @db.Uuid
  motionId  String @map("motion_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  @@id([tenantId, motionId, accountId])
  @@map("board_motion_recusals")
}

// ============================================================================
// Budget and expenses (ADR 0055)
// ============================================================================

/// A fiscal year's budget: drafted by the accountant, submitted as an
/// annual_budget request, active only once the board approves it.
model FinanceBudget {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  fiscalYear        Int       @map("fiscal_year") @db.SmallInt
  startsOn          DateTime  @map("starts_on") @db.Date
  endsOn            DateTime  @map("ends_on") @db.Date
  status            String    @default("draft")
  approvalRequestId String?   @map("approval_request_id") @db.Uuid
  createdById       String    @map("created_by_account_id") @db.Uuid
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(3)
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, fiscalYear, createdAt, id], map: "finance_budgets_year_idx")
  @@map("finance_budgets")
}

/// A budget's line: one expense category, written only while a draft.
model FinanceBudgetLine {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  budgetId String  @map("budget_id") @db.Uuid
  category String
  amount   Decimal @db.Decimal(14, 2)
  note     String?

  @@unique([tenantId, id])
  @@unique([tenantId, budgetId, category], map: "finance_budget_lines_category_key")
  @@map("finance_budget_lines")
}

/// An increase of a line the board approved (a budget_increase). Append-only.
model FinanceBudgetAdjustment {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  lineId            String   @map("line_id") @db.Uuid
  approvalRequestId String   @map("approval_request_id") @db.Uuid
  amount            Decimal  @db.Decimal(14, 2)
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, approvalRequestId], map: "finance_budget_adjustments_request_key")
  @@index([tenantId, lineId], map: "finance_budget_adjustments_line_idx")
  @@map("finance_budget_adjustments")
}

/// A major contract the board approved: what expenses above the manager's
/// limit may spend. Append-only.
model FinanceExpenseAuthorization {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  approvalRequestId String   @map("approval_request_id") @db.Uuid
  amount            Decimal  @db.Decimal(14, 2)
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, approvalRequestId], map: "finance_expense_authorizations_request_key")
  @@map("finance_expense_authorizations")
}

/// What the compound spent, on a line of the active budget (ADR 0055).
/// Keeps its terms; voided once.
model FinanceExpense {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  number          Int
  budgetLineId    String    @map("budget_line_id") @db.Uuid
  authorizationId String?   @map("authorization_id") @db.Uuid
  vendor          String
  amount          Decimal   @db.Decimal(14, 2)
  spentOn         DateTime  @map("spent_on") @db.Date
  invoiceFileId   String    @map("invoice_file_id") @db.Uuid
  reference       String?
  recordedById    String    @map("recorded_by_account_id") @db.Uuid
  recordedAt      DateTime  @map("recorded_at") @db.Timestamptz(3)
  voidedAt        DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById      String?   @map("voided_by_account_id") @db.Uuid
  voidReasonCode  String?   @map("void_reason_code")

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "finance_expenses_number_key")
  @@unique([tenantId, invoiceFileId], map: "finance_expenses_invoice_file_key")
  @@index([tenantId, budgetLineId, spentOn, id], map: "finance_expenses_line_idx")
  @@index([tenantId, recordedAt, id], map: "finance_expenses_recorded_idx")
  @@map("finance_expenses")
}

// ============================================================================
// Patrols (ADR 0052)
// ============================================================================

/// A point a patrol scans (ADR 0052): at a gate or in a zone. Its QR and
/// NFC tag carry `JWK1.<id>.<token>`; only the token's SHA-256 is kept.
/// Retired, never deleted.
model PatrolCheckpoint {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  gateId        String?   @map("gate_id") @db.Uuid
  placeId       String?   @map("place_id") @db.Uuid
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  /// A position, with the radius a scan should fall within; or none.
  lat           Float?
  lng           Float?
  radiusM       Int?      @map("radius_m")
  tokenHash     String    @map("token_hash") @db.Char(64)
  tokenIssuedAt DateTime  @map("token_issued_at") @db.Timestamptz(3)
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredById   String?   @map("retired_by_account_id") @db.Uuid
  createdById   String    @map("created_by_account_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id], map: "patrol_checkpoints_list_idx")
  @@map("patrol_checkpoints")
}

/// A route a patrol walks (ADR 0052), from a post (a gate or a zone).
/// What it asks is its current version. Retired, never deleted.
model PatrolRoute {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  gateId      String?   @map("gate_id") @db.Uuid
  placeId     String?   @map("place_id") @db.Uuid
  nameEn      String    @map("name_en")
  nameAr      String    @map("name_ar")
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredById String?   @map("retired_by_account_id") @db.Uuid
  createdById String    @map("created_by_account_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id], map: "patrol_routes_list_idx")
  @@map("patrol_routes")
}

/// What a route asks (ADR 0052): its checkpoints in order, whether the
/// order is enforced, how long it takes and its weekly start times. Never
/// changes; superseded once by the next.
model PatrolRouteVersion {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  routeId         String    @map("route_id") @db.Uuid
  number          Int
  ordered         Boolean
  expectedMinutes Int       @map("expected_minutes")
  /// `{days, times}`; null: no scheduled runs.
  schedule        Json?
  createdById     String    @map("created_by_account_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  supersededAt    DateTime? @map("superseded_at") @db.Timestamptz(3)
  /// `{circle: {lat, lng, radiusM}}` or `{polygon: [[lat, lng], …]}`; null: none (ADR 0056).
  geofence        Json?

  @@unique([tenantId, id])
  @@unique([tenantId, routeId, number], map: "patrol_route_versions_number_key")
  @@map("patrol_route_versions")
}

/// A version's checkpoint at its position (ADR 0052). Never changes.
model PatrolRouteCheckpoint {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  versionId    String   @map("version_id") @db.Uuid
  position     Int
  checkpointId String   @map("checkpoint_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, versionId, position], map: "patrol_route_checkpoints_position_key")
  @@unique([tenantId, versionId, checkpointId], map: "patrol_route_checkpoints_checkpoint_key")
  @@index([tenantId, checkpointId], map: "patrol_route_checkpoints_used_idx")
  @@map("patrol_route_checkpoints")
}

enum PatrolRunKind {
  scheduled
  adhoc

  @@map("patrol_run_kind")
}

enum PatrolRunStatus {
  scheduled
  in_progress
  completed
  incomplete
  timed_out
  missed
  cancelled

  @@map("patrol_run_status")
}

/// A walk of a route's version (ADR 0052): scheduled 7 days ahead, or
/// started by a guard. Moves forward only; never deleted.
model PatrolRun {
  id               String          @id @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  routeId          String          @map("route_id") @db.Uuid
  versionId        String          @map("version_id") @db.Uuid
  gateId           String?         @map("gate_id") @db.Uuid
  placeId          String?         @map("place_id") @db.Uuid
  kind             PatrolRunKind
  /// When it was meant: the scheduled start, or an unscheduled run's start.
  plannedAt        DateTime        @map("planned_at") @db.Timestamptz(3)
  scheduledStart   DateTime?       @map("scheduled_start") @db.Timestamptz(3)
  windowEndsAt     DateTime?       @map("window_ends_at") @db.Timestamptz(3)
  status           PatrolRunStatus
  guardAccountId   String?         @map("guard_account_id") @db.Uuid
  shiftId          String?         @map("shift_id") @db.Uuid
  startedAt        DateTime?       @map("started_at") @db.Timestamptz(3)
  endedAt          DateTime?       @map("ended_at") @db.Timestamptz(3)
  endReason        String?         @map("end_reason")
  checkpointsTotal Int             @map("checkpoints_total")
  scannedCount     Int             @default(0) @map("scanned_count")
  lateAt           DateTime?       @map("late_at") @db.Timestamptz(3)
  cancelReason     String?         @map("cancel_reason")
  cancelledById    String?         @map("cancelled_by_account_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, plannedAt, id], map: "patrol_runs_planned_idx")
  @@index([tenantId, routeId, status], map: "patrol_runs_route_idx")
  @@index([tenantId, guardAccountId, plannedAt], map: "patrol_runs_guard_idx")
  @@map("patrol_runs")
}

enum PatrolScanMethod {
  qr
  nfc
  manual

  @@map("patrol_scan_method")
}

/// A guard at a checkpoint during a run (ADR 0052). The id is the app's
/// (UUIDv7): a retry records once. Never changes.
model PatrolScan {
  id              String           @id @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  runId           String           @map("run_id") @db.Uuid
  checkpointId    String           @map("checkpoint_id") @db.Uuid
  position        Int
  method          PatrolScanMethod
  manualReason    String?          @map("manual_reason")
  /// The device's time.
  scannedAt       DateTime         @map("scanned_at") @db.Timestamptz(3)
  receivedAt      DateTime         @map("received_at") @db.Timestamptz(3)
  lat             Float?
  lng             Float?
  accuracyM       Float?           @map("accuracy_m")
  distanceM       Int?             @map("distance_m")
  positionSuspect Boolean?         @map("position_suspect")
  guardAccountId  String           @map("guard_account_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, runId, checkpointId], map: "patrol_scans_once_per_checkpoint")
  @@index([tenantId, runId, scannedAt], map: "patrol_scans_run_idx")
  @@index([tenantId, guardAccountId], map: "patrol_scans_guard_idx")
  @@map("patrol_scans")
}

/// What a guard noted at a scanned checkpoint (ADR 0052). Its words go
/// once, at the guard's erasure; its photos stay.
model PatrolNote {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  runId          String    @map("run_id") @db.Uuid
  scanId         String    @map("scan_id") @db.Uuid
  outcome        String
  text           String?
  notedAt        DateTime  @map("noted_at") @db.Timestamptz(3)
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(3)
  guardAccountId String    @map("guard_account_id") @db.Uuid
  textClearedAt  DateTime? @map("text_cleared_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, scanId], map: "patrol_notes_scan_key")
  @@index([tenantId, runId], map: "patrol_notes_run_idx")
  @@map("patrol_notes")
}

/// A patrol note's photo (ADR 0052). Never changes.
model PatrolNotePhoto {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  noteId       String   @map("note_id") @db.Uuid
  fileId       String   @unique @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, noteId], map: "patrol_note_photos_note_idx")
  @@map("patrol_note_photos")
}

/// A patrol note's recording (ADR 0056): its kind and length copied from
/// the file. Only ever added.
model PatrolNoteMedia {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  noteId       String   @map("note_id") @db.Uuid
  fileId       String   @map("file_id") @db.Uuid
  /// audio | video
  kind         String
  durationMs   Int      @map("duration_ms")
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, fileId], map: "patrol_note_media_file_key")
  @@index([tenantId, noteId], map: "patrol_note_media_parent_idx")
  @@map("patrol_note_media")
}

/// Where a guard walked during a run (ADR 0052): personal data, deleted 30
/// days after it was recorded and at the guard's erasure. Never changes.
model PatrolTrackPoint {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  guardAccountId String   @map("guard_account_id") @db.Uuid
  /// The device's time.
  recordedAt     DateTime @map("recorded_at") @db.Timestamptz(3)
  lat            Float
  lng            Float
  accuracyM      Float?   @map("accuracy_m")
  receivedAt     DateTime @map("received_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, runId, recordedAt], map: "patrol_track_points_once_key")
  @@index([tenantId, recordedAt], map: "patrol_track_points_age_idx")
  @@index([tenantId, guardAccountId], map: "patrol_track_points_guard_idx")
  @@map("patrol_track_points")
}

/// Each time a patrol run's guard was outside its route's geofence (ADR
/// 0056): opened by the first point outside, closed by the next inside
/// one; flagged once when it lasted the gate's setting. Times only.
model PatrolGeofenceExit {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  runId          String    @map("run_id") @db.Uuid
  guardAccountId String    @map("guard_account_id") @db.Uuid
  /// The device's time of the first point outside.
  leftAt         DateTime  @map("left_at") @db.Timestamptz(3)
  /// The device's time of the next point inside; null while outside.
  backAt         DateTime? @map("back_at") @db.Timestamptz(3)
  flaggedAt      DateTime? @map("flagged_at") @db.Timestamptz(3)
  /// The threshold it passed, in minutes.
  flaggedMinutes Int?      @map("flagged_minutes") @db.SmallInt
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, runId, leftAt], map: "patrol_geofence_exits_once_key")
  @@map("patrol_geofence_exits")
}

/// One row per compound (ADR 0053): what every lockdown decision locks. A
/// start and an end take it FOR UPDATE; a verify, an entry in, a gate
/// request and a material entry FOR SHARE. Never changed (a trigger).
model GateLockdownState {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("gate_lockdown_states")
}

/// A lockdown of one gate, or of all (`gateId` null), started by a guard on
/// shift and ended by the management (ADR 0053). One live per scope.
model GateLockdown {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  gateId         String?   @map("gate_id") @db.Uuid
  reasonCode     String    @map("reason_code")
  startedById    String    @map("started_by_account_id") @db.Uuid
  startedShiftId String    @map("started_shift_id") @db.Uuid
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  endedById      String?   @map("ended_by_account_id") @db.Uuid
  endReason      String?   @map("end_reason")
  /// The manager's words on ending it: the management's only.
  endNote        String?   @map("end_note")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, startedAt, id], map: "gate_lockdowns_started_idx")
  @@map("gate_lockdowns")
}

/// An emergency vehicle a guard let through a locked gate (ADR 0053), with
/// its code. Append-only.
model GateLockdownOverride {
  id                   String   @id @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  lockdownId           String   @map("lockdown_id") @db.Uuid
  gateId               String   @map("gate_id") @db.Uuid
  shiftId              String   @map("shift_id") @db.Uuid
  guardAccountId       String   @map("guard_account_id") @db.Uuid
  kind                 String
  emergencyId          String?  @map("emergency_id") @db.Uuid
  gateServiceRequestId String?  @map("gate_service_request_id") @db.Uuid
  occurredAt           DateTime @map("occurred_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, lockdownId, occurredAt, id], map: "gate_lockdown_overrides_lockdown_idx")
  @@map("gate_lockdown_overrides")
}

/// A banned or watched plate or person (ADR 0053). A person's full ID number
/// is only ever its peppered HMAC, bound to the compound. One live entry per
/// plate key and per ID hash; lifted once; a person's data purged 30 days
/// after it was lifted. Never deleted.
model BlocklistEntry {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// ban | watch.
  kind        String
  /// plate | person.
  subject     String
  plate       String?
  plateKey    String?   @map("plate_key")
  fullName    String?   @map("full_name")
  idHash      String?   @map("id_hash") @db.Char(64)
  photoFileId String?   @unique(map: "blocklist_entries_photo_key") @map("photo_file_id") @db.Uuid
  reasonCode  String    @map("reason_code")
  /// The management's words.
  note        String?
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  createdById String    @map("created_by_account_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  liftedAt    DateTime? @map("lifted_at") @db.Timestamptz(3)
  liftedById  String?   @map("lifted_by_account_id") @db.Uuid
  liftReason  String?   @map("lift_reason")
  purgedAt    DateTime? @map("purged_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id], map: "blocklist_entries_list_idx")
  @@map("blocklist_entries")
}

/// Where the blocklist met someone at the gate (ADR 0053): append-only, read
/// by `blocklist.manage` only. The subject is a pointer, as on gate entries.
model BlocklistMatch {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  entryId        String   @map("entry_id") @db.Uuid
  /// ban | watch, as the entry was then.
  kind           String
  source         String
  subjectType    String?  @map("subject_type")
  subjectId      String?  @map("subject_id") @db.Uuid
  gateId         String?  @map("gate_id") @db.Uuid
  shiftId        String?  @map("shift_id") @db.Uuid
  actorAccountId String   @map("actor_account_id") @db.Uuid
  /// refused | flagged | noted.
  outcome        String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, entryId, createdAt, id], map: "blocklist_matches_entry_idx")
  @@map("blocklist_matches")
}

/// That a pass, a guest or a move was refused by security (ADR 0053): its
/// household is told once, never why.
model SecurityRefusal {
  tenantId    String   @map("tenant_id") @db.Uuid
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id") @db.Uuid
  firstAt     DateTime @default(now()) @map("first_at") @db.Timestamptz(3)

  @@id([tenantId, subjectType, subjectId])
  @@map("security_refusals")
}

/// Work stopped on an approved works permit (ADR 0053), by a guard on shift
/// or the permits' staff: its workers are refused at the gate until it ends
/// (resumed by the management, or the permit revoked or cancelled). One
/// live per permit.
model PermitWorkStop {
  id             String         @id @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  permitId       String         @map("permit_id") @db.Uuid
  permitKind     UnitPermitKind @default(works) @map("permit_kind")
  stoppedById    String         @map("stopped_by_account_id") @db.Uuid
  stoppedShiftId String?        @map("stopped_shift_id") @db.Uuid
  reasonCode     String         @map("reason_code")
  stoppedAt      DateTime       @map("stopped_at") @db.Timestamptz(3)
  endedAt        DateTime?      @map("ended_at") @db.Timestamptz(3)
  endedById      String?        @map("ended_by_account_id") @db.Uuid
  /// resumed | permit_revoked | permit_cancelled.
  endKind        String?        @map("end_kind")
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, permitId, stoppedAt, id], map: "permit_work_stops_permit_idx")
  @@map("permit_work_stops")
}

/// What a guard or the management reports happened (ADR 0053): never a
/// resident's to see. The report never changes (an erasure may clear its
/// author's words once); it moves open → investigating → closed.
model Incident {
  id                   String    @id @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  number               Int
  type                 String
  severity             String
  placeId              String?   @map("place_id") @db.Uuid
  unitId               String?   @map("unit_id") @db.Uuid
  occurredAt           DateTime  @map("occurred_at") @db.Timestamptz(3)
  description          String?
  reportedById         String    @map("reported_by_account_id") @db.Uuid
  shiftId              String?   @map("shift_id") @db.Uuid
  postGateId           String?   @map("post_gate_id") @db.Uuid
  postPlaceId          String?   @map("post_place_id") @db.Uuid
  emergencyId          String?   @map("emergency_id") @db.Uuid
  gateServiceRequestId String?   @map("gate_service_request_id") @db.Uuid
  patrolNoteId         String?   @map("patrol_note_id") @db.Uuid
  /// open | investigating | closed.
  status               String    @default("open")
  investigatorId       String?   @map("investigator_account_id") @db.Uuid
  assignedAt           DateTime? @map("assigned_at") @db.Timestamptz(3)
  outcome              String?
  closingNote          String?   @map("closing_note")
  closedById           String?   @map("closed_by_account_id") @db.Uuid
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(3)
  textClearedAt        DateTime? @map("text_cleared_at") @db.Timestamptz(3)
  closingNoteClearedAt DateTime? @map("closing_note_cleared_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "incidents_number_key")
  @@index([tenantId, createdAt, id], map: "incidents_list_idx")
  @@map("incidents")
}

/// An incident's photo (ADR 0053), five at most. Append-only.
model IncidentPhoto {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  incidentId   String   @map("incident_id") @db.Uuid
  fileId       String   @unique(map: "incident_photos_file_key") @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, incidentId], map: "incident_photos_incident_idx")
  @@map("incident_photos")
}

/// An incident's recording (ADR 0056), attached at its report: its kind
/// and length copied from the file. Only ever added.
model IncidentMedia {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  incidentId   String   @map("incident_id") @db.Uuid
  fileId       String   @map("file_id") @db.Uuid
  /// audio | video
  kind         String
  durationMs   Int      @map("duration_ms")
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, fileId], map: "incident_media_file_key")
  @@index([tenantId, incidentId], map: "incident_media_parent_idx")
  @@map("incident_media")
}

/// A drawn signature on an incident report (ADR 0056): its signer as
/// author or reviewer, and the SHA-256 of the report's canonical content
/// for that role when signed. Never changes, but its image goes once at
/// its signer's erasure; superseded is computed when read.
model IncidentSignature {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  incidentId       String    @map("incident_id") @db.Uuid
  /// author | reviewer
  role             String
  signerAccountId  String    @map("signer_account_id") @db.Uuid
  fileId           String?   @map("file_id") @db.Uuid
  contentSha256    String    @map("content_sha256") @db.Char(64)
  canonicalVersion Int       @map("canonical_version") @db.SmallInt
  signedAt         DateTime  @map("signed_at") @db.Timestamptz(3)
  imageClearedAt   DateTime? @map("image_cleared_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, incidentId, role, contentSha256], map: "incident_signatures_once_key")
  @@index([tenantId, incidentId, signedAt], map: "incident_signatures_incident_idx")
  @@map("incident_signatures")
}

/// The management's internal note on an incident (ADR 0053).
model IncidentNote {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  incidentId    String    @map("incident_id") @db.Uuid
  authorId      String    @map("author_account_id") @db.Uuid
  body          String?
  textClearedAt DateTime? @map("text_cleared_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, incidentId, createdAt, id], map: "incident_notes_incident_idx")
  @@map("incident_notes")
}

/// The author's and a reviewer's acknowledgement of an incident, once each.
model IncidentAcknowledgement {
  tenantId       String   @map("tenant_id") @db.Uuid
  incidentId     String   @map("incident_id") @db.Uuid
  /// author | reviewer.
  role           String
  accountId      String   @map("account_id") @db.Uuid
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at") @db.Timestamptz(3)

  @@id([tenantId, incidentId, role])
  @@map("incident_acknowledgements")
}

/// A violation issued to a unit (ADR 0053), as a fine is (ADR 0045): noise,
/// waste, pets, contractor hours (a works permit), other; an amount or none
/// (a warning). One appeal within 30 days; paid at the office.
model UnitViolation {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  number            Int
  kind              String
  unitId            String    @map("unit_id") @db.Uuid
  permitId          String?   @map("permit_id") @db.Uuid
  permitKind        UnitPermitKind @default(works) @map("permit_kind")
  placeId           String?   @map("place_id") @db.Uuid
  note              String?
  photoFileId       String?   @unique(map: "unit_violations_photo_key") @map("photo_file_id") @db.Uuid
  amount            Decimal?  @db.Decimal(10, 2)
  currency          String?
  occurredOn        DateTime  @map("occurred_on") @db.Date
  issuedById        String    @map("issued_by_account_id") @db.Uuid
  issuedShiftId     String?   @map("issued_shift_id") @db.Uuid
  postGateId        String?   @map("post_gate_id") @db.Uuid
  postPlaceId       String?   @map("post_place_id") @db.Uuid
  /// open | under_appeal | paid | cancelled.
  status            String    @default("open")
  appealText        String?   @map("appeal_text")
  appealPhotoFileId String?   @unique(map: "unit_violations_appeal_photo_key") @map("appeal_photo_file_id") @db.Uuid
  appealedById      String?   @map("appealed_by_account_id") @db.Uuid
  appealedAt        DateTime? @map("appealed_at") @db.Timestamptz(3)
  appealClearedAt   DateTime? @map("appeal_cleared_at") @db.Timestamptz(3)
  appealDecision    String?   @map("appeal_decision")
  decidedById       String?   @map("decided_by_account_id") @db.Uuid
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(3)
  cancelReason      String?   @map("cancel_reason")
  cancelledById     String?   @map("cancelled_by_account_id") @db.Uuid
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(3)
  boardAppealAt     DateTime? @map("board_appeal_at") @db.Timestamptz(3)
  boardAppealClosedAt DateTime? @map("board_appeal_closed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "unit_violations_number_key")
  @@index([tenantId, status, createdAt, id], map: "unit_violations_status_idx")
  @@map("unit_violations")
}

/// A violation's payment at the office, or a payment's reversal (ADR 0053).
/// Append-only.
model UnitViolationPayment {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  violationId   String    @map("violation_id") @db.Uuid
  /// payment | reversal.
  kind          String
  amount        Decimal?  @db.Decimal(10, 2)
  currency      String?
  receiptNumber String?   @map("receipt_number")
  paidOn        DateTime? @map("paid_on") @db.Date
  reversesId    String?   @map("reverses_id") @db.Uuid
  reasonCode    String?   @map("reason_code")
  recordedById  String    @map("recorded_by_account_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, violationId, createdAt, id], map: "unit_violation_payments_violation_idx")
  @@map("unit_violation_payments")
}

/// A child's exit control (ADR 0054): one period, from its turn-on by the
/// unit's primary or a household delegate to its end, once. The card (only
/// its SHA-256 is kept) and the photo exist exactly while it is live. Names
/// "this minor of this unit"; `memberIsMinor` follows the member row (ON
/// UPDATE CASCADE), and a live control on an adult is refused. Never deleted.
model ChildControl {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  unitId             String    @map("unit_id") @db.Uuid
  memberId           String    @map("member_id") @db.Uuid
  memberIsMinor      Boolean   @default(true) @map("member_is_minor")
  mayLeaveAlone      Boolean   @map("may_leave_alone")
  notifyPickups      Boolean   @map("notify_pickups")
  cardTokenHash      String?   @map("card_token_hash") @db.Char(64)
  cardIssuedAt       DateTime? @map("card_issued_at") @db.Timestamptz(3)
  photoFileId        String?   @map("photo_file_id") @db.Uuid
  turnedOnById       String    @map("turned_on_by_account_id") @db.Uuid
  turnedOnAt         DateTime  @map("turned_on_at") @db.Timestamptz(3)
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(3)
  /// household | left_household | came_of_age
  endReason          String?   @map("end_reason")
  endedById          String?   @map("ended_by_account_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, id, unitId])
  @@index([tenantId, unitId], map: "child_controls_unit_idx")
  @@map("child_controls")
}

/// Who may collect a child (ADR 0054): an adult of the household, one of
/// the unit's domestic workers, or an outside person with a pickup code.
enum ChildEscortKind {
  adult
  worker
  outside

  @@map("child_escort_kind")
}

/// An escort of one control (ADR 0054), with its validity. Revoked once,
/// never deleted. An outside escort's code, QR and link exist exactly while
/// it is live (only their HMACs); their name and phone are cleared 30 days
/// after the revocation.
model ChildEscort {
  id               String          @id @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  controlId        String          @map("control_id") @db.Uuid
  unitId           String          @map("unit_id") @db.Uuid
  kind             ChildEscortKind
  accountId        String?         @map("account_id") @db.Uuid
  engagementId     String?         @map("engagement_id") @db.Uuid
  fullName         String?         @map("full_name")
  phone            String?
  photoFileId      String?         @map("photo_file_id") @db.Uuid
  pickupCodeHash   String?         @map("pickup_code_hash") @db.Char(64)
  pickupQrHash     String?         @map("pickup_qr_hash") @db.Char(64)
  pickupIssuedAt   DateTime?       @map("pickup_issued_at") @db.Timestamptz(3)
  /// The first and last local days it is valid; null: open-ended.
  validFrom        DateTime        @map("valid_from") @db.Date
  validUntil       DateTime?       @map("valid_until") @db.Date
  /// A weekly schedule (days and windows); null: at any time.
  schedule         Json?
  gateId           String?         @map("gate_id") @db.Uuid
  placeId          String?         @map("place_id") @db.Uuid
  revokedAt        DateTime?       @map("revoked_at") @db.Timestamptz(3)
  /// household | left_household | control_off
  revokeReason     String?         @map("revoke_reason")
  revokedById      String?         @map("revoked_by_account_id") @db.Uuid
  piiClearedAt     DateTime?       @map("pii_cleared_at") @db.Timestamptz(3)
  createdById      String          @map("created_by_account_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, controlId], map: "child_escorts_control_idx")
  @@map("child_escorts")
}

/// The global pointer of an outside escort's pickup link (ADR 0054), like
/// visitor_pass_links: HMAC(pepper, "child-pickup-link:<token>") → (compound,
/// escort). No personal data, no RLS.
model ChildPickupLink {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  tenantId  String   @map("tenant_id") @db.Uuid
  escortId  String   @map("escort_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: Restrict)

  @@index([escortId])
  @@map("child_pickup_links")
}

/// How a child's exit ended (ADR 0054).
enum ChildPickupOutcome {
  picked_up
  left_alone
  refused
  alone_refused
  /// Released offline, its escort or leave not verified at sync (ADR 0057).
  left_unverified

  @@map("child_pickup_outcome")
}

/// How the guard knew the escort (ADR 0054).
enum ChildPickupMethod {
  resident_qr
  worker_qr
  worker_code
  pickup_qr
  pickup_code
  alone
  unidentified

  @@map("child_pickup_method")
}

/// A child's exit recorded at the gate (ADR 0054): only for children under
/// exit control, the household's to read, an alert for the management only
/// when refused; deleted 30 days after it was recorded. Never changed.
model ChildPickup {
  id             String             @id @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  controlId      String             @map("control_id") @db.Uuid
  unitId         String             @map("unit_id") @db.Uuid
  escortId       String?            @map("escort_id") @db.Uuid
  escortKind     ChildEscortKind?   @map("escort_kind")
  outcome        ChildPickupOutcome
  method         ChildPickupMethod
  refusalReason  String?            @map("refusal_reason")
  guardAccountId String             @map("guard_account_id") @db.Uuid
  shiftId        String             @map("shift_id") @db.Uuid
  gateId         String?            @map("gate_id") @db.Uuid
  placeId        String?            @map("place_id") @db.Uuid
  at             DateTime           @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, controlId, at], map: "child_pickups_control_idx")
  @@index([tenantId, unitId, at, id], map: "child_pickups_unit_idx")
  @@index([tenantId, at], map: "child_pickups_age_idx")
  @@map("child_pickups")
}

/// A minor registered for an event for children (ADR 0054): a seat. Added
/// and taken back, never changed.
model EventChildRegistration {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  registeredById String   @map("registered_by_account_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, eventId, memberId], map: "event_child_registrations_once")
  @@index([tenantId, memberId], map: "event_child_registrations_member_idx")
  @@index([tenantId, registeredById], map: "event_child_registrations_by_idx")
  @@map("event_child_registrations")
}

// ============================================================================
// PARTNERS (ADR 0060)
// ============================================================================

/// A compound's partner settings (ADR 0060): one row per compound,
/// provisioned with it. Ranges in partner_settings_ranges.
model PartnerSettings {
  tenantId        String   @id @map("tenant_id") @db.Uuid
  /// A partner is "new" this many days after it was listed.
  newDays         Int      @default(30) @map("new_days")
  /// "Open late tonight" means open after this local minute.
  lateFromMinute  Int      @default(1320) @map("late_from_minute")
  maxLiveRequests Int      @default(5) @map("max_live_requests")
  ratingDays      Int      @default(14) @map("rating_days")
  complaintDays   Int      @default(14) @map("complaint_days")
  /// A desk link stops working this many days after it was made.
  deskLinkDays    Int      @default(90) @map("desk_link_days")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("partner_settings")
}

/// A compound's named sub-category under one of the closed categories
/// (PARTNER_CATEGORIES). Its key and category never change (trigger);
/// retired with `active`, never deleted.
model PartnerSubcategory {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  category  String
  key       String
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  services   PartnerService[]
  priceItems PartnerPriceItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, category], map: "partner_subcategories_tenant_id_id_category_key")
  @@unique([tenantId, key], map: "partner_subcategories_key_key")
  @@map("partner_subcategories")
}

/// An external service partner the management lists (ADR 0060). The
/// business phone is the one contact residents see; the notify email is
/// the staff's alone. `serviceBuildings` empty is the whole compound. Never
/// deleted (trigger): suspended with a reason code, reinstated.
model Partner {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  nameEn           String    @map("name_en")
  nameAr           String    @map("name_ar")
  descriptionEn    String?   @map("description_en")
  descriptionAr    String?   @map("description_ar")
  businessPhone    String    @map("business_phone")
  notifyEmail      String?   @map("notify_email")
  serviceBuildings String[]  @default([]) @map("service_buildings")
  homeVisit        Boolean   @default(false) @map("home_visit")
  /// active | suspended
  status           String    @default("active")
  /// REASON_CODES.partnerSuspend
  suspendedReason  String?   @map("suspended_reason")
  suspendedAt      DateTime? @map("suspended_at") @db.Timestamptz(3)
  suspendedById    String?   @map("suspended_by_account_id") @db.Uuid
  listedAt         DateTime  @map("listed_at") @db.Timestamptz(3)
  createdById      String    @map("created_by_account_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  services   PartnerService[]
  hours      PartnerHours[]
  priceItems PartnerPriceItem[]
  favourites PartnerFavourite[]

  @@unique([tenantId, id])
  @@index([tenantId, listedAt(sort: Desc), id], map: "partners_listed_idx")
  @@map("partners")
}

/// What a partner does: a category, and optionally one of its named
/// sub-categories. Replaced as a whole under the partner's row lock. Unique
/// per partner, category and sub-category, NULLS NOT DISTINCT
/// (partner_services_once_key, in the migration).
model PartnerService {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  partnerId     String  @map("partner_id") @db.Uuid
  category      String
  subcategoryId String? @map("subcategory_id") @db.Uuid

  partner     Partner             @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  subcategory PartnerSubcategory? @relation(fields: [tenantId, subcategoryId, category], references: [tenantId, id, category], onDelete: Restrict, onUpdate: Restrict, map: "partner_services_subcategory_fkey")

  @@index([tenantId, category, partnerId], map: "partner_services_category_idx")
  @@map("partner_services")
}

/// A partner's weekly hours in the compound's time zone (weekday 0 is
/// Sunday; minutes after local midnight). Replaced as a whole.
model PartnerHours {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  partnerId   String @map("partner_id") @db.Uuid
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  partner Partner @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, partnerId, weekday, startMinute], map: "partner_hours_window_key")
  @@map("partner_hours")
}

/// A line of a partner's announced price list, in EGP. Replaced as a whole;
/// a request keeps its own copy of what it named.
model PartnerPriceItem {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  partnerId     String  @map("partner_id") @db.Uuid
  subcategoryId String? @map("subcategory_id") @db.Uuid
  nameEn        String  @map("name_en")
  nameAr        String  @map("name_ar")
  price         Decimal @db.Decimal(10, 2)
  /// PARTNER_PRICE_UNITS
  unit          String
  position      Int

  partner     Partner             @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  subcategory PartnerSubcategory? @relation(fields: [tenantId, subcategoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, partnerId, position], map: "partner_price_items_partner_idx")
  @@map("partner_price_items")
}

/// A resident's favourite partner: the account's own.
model PartnerFavourite {
  tenantId  String   @map("tenant_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  partner Partner @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, accountId, partnerId])
  @@index([tenantId, partnerId, accountId], map: "partner_favourites_partner_idx")
  @@map("partner_favourites")
}

/// The compound's counter of partner requests (SR-000123), taken under the
/// row's lock, last in the transaction.
model PartnerRequestCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  @@map("partner_request_counters")
}

/// A resident's request to a partner (ADR 0060): what it asked never
/// changes (trigger); it moves forward only. LIVE = pending, proposed,
/// accepted. The note is the requester's words, cleared by an erasure.
model PartnerRequest {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  number             Int
  partnerId          String    @map("partner_id") @db.Uuid
  unitId             String    @map("unit_id") @db.Uuid
  requesterId        String    @map("requester_account_id") @db.Uuid
  /// PARTNER_CATEGORIES
  category           String
  subcategoryId      String?   @map("subcategory_id") @db.Uuid
  askedStartsAt      DateTime  @map("asked_starts_at") @db.Timestamptz(3)
  askedEndsAt        DateTime  @map("asked_ends_at") @db.Timestamptz(3)
  note               String?
  noteClearedAt      DateTime? @map("note_cleared_at") @db.Timestamptz(3)
  gatePass           Boolean   @map("gate_pass")
  /// pending | proposed | accepted | declined | cancelled | expired | done | partner_no_show | lapsed
  status             String
  proposedStartsAt   DateTime? @map("proposed_starts_at") @db.Timestamptz(3)
  proposedEndsAt     DateTime? @map("proposed_ends_at") @db.Timestamptz(3)
  agreedStartsAt     DateTime? @map("agreed_starts_at") @db.Timestamptz(3)
  agreedEndsAt       DateTime? @map("agreed_ends_at") @db.Timestamptz(3)
  staffCount         Int?      @map("staff_count")
  acceptedAt         DateTime? @map("accepted_at") @db.Timestamptz(3)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(3)
  /// resident | partner | system
  closedBy           String?   @map("closed_by")
  /// REASON_CODES.partnerRequest*
  closeReason        String?   @map("close_reason")
  lastActivityAt     DateTime  @map("last_activity_at") @db.Timestamptz(3)
  /// The gate's one-time pass for the partner's staff (ADR 0060), once.
  passId             String?   @map("pass_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  items  PartnerRequestItem[]
  events PartnerRequestEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "partner_requests_number_key")
  @@unique([tenantId, passId], map: "partner_requests_pass_key")
  @@index([tenantId, requesterId, lastActivityAt(sort: Desc), id], map: "partner_requests_requester_idx")
  @@index([tenantId, partnerId, status, askedStartsAt], map: "partner_requests_partner_idx")
  @@index([tenantId, createdAt(sort: Desc), id], map: "partner_requests_queue_idx")
  @@map("partner_requests")
}

/// An announced price line a request named, copied as it was. Append-only.
model PartnerRequestItem {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  requestId String  @map("request_id") @db.Uuid
  nameEn    String  @map("name_en")
  nameAr    String  @map("name_ar")
  price     Decimal @db.Decimal(10, 2)
  unit      String
  quantity  Int
  position  Int

  request PartnerRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "partner_request_items_request_fkey")

  @@unique([tenantId, requestId, position], map: "partner_request_items_position_key")
  @@map("partner_request_items")
}

/// A step of a request's history: who took it, a reason's code, the
/// window it named. Append-only; codes and times only.
model PartnerRequestEvent {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  requestId      String    @map("request_id") @db.Uuid
  kind           String
  /// resident | partner_desk | relay | system
  actor          String
  actorAccountId String?   @map("actor_account_id") @db.Uuid
  reasonCode     String?   @map("reason_code")
  startsAt       DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime? @map("ends_at") @db.Timestamptz(3)
  at             DateTime  @db.Timestamptz(3)

  request PartnerRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "partner_request_events_request_fkey")

  @@index([tenantId, requestId, at, id], map: "partner_request_events_request_idx")
  @@map("partner_request_events")
}

/// GLOBAL (no RLS): a partner's desk link (ADR 0060), resolved before any
/// compound is known. SHA-256 of the token with a domain label, never the
/// token; one live per partner; revoked once; stops at `expiresAt`.
model PartnerDeskLink {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  partnerId     String    @map("partner_id") @db.Uuid
  tokenHash     String    @unique(map: "partner_desk_links_token_hash_key") @map("token_hash") @db.Char(64)
  createdById   String    @map("created_by_account_id") @db.Uuid
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById   String?   @map("revoked_by_account_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, partnerId, createdAt(sort: Desc)], map: "partner_desk_links_partner_idx")
  @@map("partner_desk_links")
}

/// A requester's rating of a request done (ADR 0060): once (the key),
/// never changed but for its comment cleared by an erasure.
model PartnerRating {
  tenantId         String    @map("tenant_id") @db.Uuid
  requestId        String    @map("request_id") @db.Uuid
  partnerId        String    @map("partner_id") @db.Uuid
  raterAccountId   String    @map("rater_account_id") @db.Uuid
  stars            Int
  comment          String?
  commentClearedAt DateTime? @map("comment_cleared_at") @db.Timestamptz(3)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, requestId])
  @@index([tenantId, partnerId, createdAt(sort: Desc), requestId], map: "partner_ratings_partner_idx")
  @@map("partner_ratings")
}

/// A complaint against a partner about one request (ADR 0060): a
/// management request on `partner_service`, linked here with what it asks
/// and the management's decision, once. No money moves here.
model PartnerComplaint {
  id                   String    @id @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  requestId            String    @map("request_id") @db.Uuid
  partnerId            String    @map("partner_id") @db.Uuid
  complainantId        String    @map("complainant_account_id") @db.Uuid
  managementRequestId  String    @map("management_request_id") @db.Uuid
  /// REASON_CODES.partnerComplaint
  reason               String
  /// REASON_CODES.partnerCompensationAsk
  compensationAsk      String    @map("compensation_ask")
  requestedAmount      Decimal?  @map("requested_amount") @db.Decimal(10, 2)
  /// upheld | not_upheld
  outcome              String?
  /// REASON_CODES.partnerCompensationDecision
  compensation         String?
  decidedById          String?   @map("decided_by_account_id") @db.Uuid
  decidedAt            DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, requestId], map: "partner_complaints_request_key")
  @@unique([tenantId, managementRequestId], map: "partner_complaints_management_request_key")
  @@index([tenantId, createdAt(sort: Desc), id], map: "partner_complaints_queue_idx")
  @@index([tenantId, partnerId, createdAt(sort: Desc)], map: "partner_complaints_partner_idx")
  @@map("partner_complaints")
}

// ============================================================================
// Assets, plans and inspections (ADR 0064)
// ============================================================================

/// A place of the compound that is not a unit (ADR 0064): a building as a
/// whole (`building` is the units' building text, one row each), any other
/// area (a garden, a roof, a pump room), or one of the facilities (at most
/// one row each). Never deleted: `active = false` retires one. Its QR tag
/// is kept as the token's hash only.
model CommonArea {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// building, area, facility.
  kind        String
  /// The compound's own short code, unique: `^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$`.
  code        String
  nameAr      String    @map("name_ar")
  nameEn      String    @map("name_en")
  /// A building's own name (kind building), or where an area is.
  building    String?
  facilityId  String?   @map("facility_id") @db.Uuid
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  active      Boolean   @default(true)
  tagHash     String?   @map("tag_hash")
  tagIssuedAt DateTime? @map("tag_issued_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, kind, code], map: "common_areas_list_idx")
  @@map("common_areas")
}

/// A kind of asset of the compound (ADR 0064), seeded with defaults. Its
/// category says whose technicians work on it. Never deleted.
model AssetType {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  key               String
  nameAr            String   @map("name_ar")
  nameEn            String   @map("name_en")
  categoryId        String   @map("category_id") @db.Uuid
  /// What an asset of the type lasts, unless the asset says otherwise.
  expectedLifeYears Int?     @map("expected_life_years") @db.SmallInt
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("asset_types")
}

/// One asset of the compound (ADR 0064): in a unit or a common area, under
/// a parent four levels deep at most (where its parent is). The vendor,
/// the warranty and the values are plain data. Retired, never deleted.
model Asset {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  code               String
  typeId             String    @map("type_id") @db.Uuid
  parentId           String?   @map("parent_id") @db.Uuid
  /// 1 for a root, its parent's + 1 below.
  depth              Int       @db.SmallInt
  unitId             String?   @map("unit_id") @db.Uuid
  commonAreaId       String?   @map("common_area_id") @db.Uuid
  nameAr             String    @map("name_ar")
  nameEn             String    @map("name_en")
  manufacturer       String?
  model              String?
  serialNumber       String?   @map("serial_number")
  commissionedOn     DateTime? @map("commissioned_on") @db.Date
  purchaseValue      Decimal?  @map("purchase_value") @db.Decimal(12, 2)
  replacementCost    Decimal?  @map("replacement_cost") @db.Decimal(12, 2)
  downtimeCostPerDay Decimal?  @map("downtime_cost_per_day") @db.Decimal(12, 2)
  expectedLifeYears  Int?      @map("expected_life_years") @db.SmallInt
  vendorName         String?   @map("vendor_name")
  vendorPhone        String?   @map("vendor_phone")
  warrantyEndsOn     DateTime? @map("warranty_ends_on") @db.Date
  /// The warranty end the managers were told of (once per date).
  warrantyAlertedFor DateTime? @map("warranty_alerted_for") @db.Date
  /// low, medium, high, critical.
  criticality        String    @default("medium")
  /// in_service, out_of_service, retired.
  status             String    @default("in_service")
  /// REASON_CODES.assetOutOfService or assetRetire; null in service.
  statusReason       String?   @map("status_reason")
  /// good, fair, poor, critical.
  condition          String    @default("good")
  servesBuildings    String[]  @default([]) @map("serves_buildings")
  retiredAt          DateTime? @map("retired_at") @db.Timestamptz(3)
  tagHash            String?   @map("tag_hash")
  tagIssuedAt        DateTime? @map("tag_issued_at") @db.Timestamptz(3)
  createdById        String?   @map("created_by_account_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "assets_list_idx")
  @@index([tenantId, parentId], map: "assets_parent_idx")
  @@index([tenantId, unitId], map: "assets_unit_idx")
  @@index([tenantId, commonAreaId], map: "assets_common_area_idx")
  @@map("assets")
}

/// An asset's own history (ADR 0064): codes only, append-only.
model AssetEvent {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  assetId    String   @map("asset_id") @db.Uuid
  /// created, imported, updated, condition_changed, status_changed, moved, retired, tag_issued.
  kind       String
  fromValue  String?  @map("from_value")
  toValue    String?  @map("to_value")
  reasonCode String?  @map("reason_code")
  actorId    String?  @map("actor_account_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)

  @@index([tenantId, assetId, occurredAt(sort: Desc), id(sort: Desc)], map: "asset_events_asset_idx")
  @@map("asset_events")
}

/// A plan, a manual, a warranty card (ADR 0064): of one asset, asset type
/// or common area. Removed once, never changed.
model MaintenanceDocument {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  assetId      String?   @map("asset_id") @db.Uuid
  assetTypeId  String?   @map("asset_type_id") @db.Uuid
  commonAreaId String?   @map("common_area_id") @db.Uuid
  fileId       String    @unique @map("file_id") @db.Uuid
  /// plan, manual, warranty, certificate, photo, other.
  kind         String
  title        String
  addedById    String?   @map("added_by_account_id") @db.Uuid
  addedAt      DateTime  @map("added_at") @db.Timestamptz(3)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(3)
  removedById  String?   @map("removed_by_account_id") @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId, assetId, addedAt], map: "maintenance_documents_asset_idx")
  @@index([tenantId, assetTypeId, addedAt], map: "maintenance_documents_type_idx")
  @@index([tenantId, commonAreaId, addedAt], map: "maintenance_documents_area_idx")
  @@map("maintenance_documents")
}

/// A sheet of assets (ADR 0064): validated whole, then applied once.
model AssetImport {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  fileId      String    @unique @map("file_id") @db.Uuid
  /// valid, invalid, applied.
  status      String
  rowCount    Int       @map("row_count")
  errorCount  Int       @map("error_count")
  /// The first 100 problems: `{ line, field, code }`, never a cell's text.
  errors      Json      @default("[]")
  createdById String?   @map("created_by_account_id") @db.Uuid
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  appliedAt   DateTime? @map("applied_at") @db.Timestamptz(3)
  appliedById String?   @map("applied_by_account_id") @db.Uuid
  appliedCount Int?     @map("applied_count")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "asset_imports_list_idx")
  @@map("asset_imports")
}

/// A checklist of the compound's (ADR 0064): a planned job's or an
/// inspection's, by purpose. Each edit of its items is a new version.
model ChecklistTemplate {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  nameAr         String   @map("name_ar")
  nameEn         String   @map("name_en")
  /// pm, inspection, any.
  purpose        String
  /// The tag of the asset or area must be scanned before it is submitted.
  requireScan    Boolean  @default(false) @map("require_scan")
  currentVersion Int      @default(1) @map("current_version")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("checklist_templates")
}

/// One version's item (ADR 0064): a check, a reading, a photo or a note.
/// Never changed.
model ChecklistTemplateItem {
  id                  String          @id @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  templateId          String          @map("template_id") @db.Uuid
  version             Int
  position            Int             @db.SmallInt
  /// check, reading, photo, text.
  kind                String
  labelAr             String          @map("label_ar")
  labelEn             String          @map("label_en")
  required            Boolean         @default(true)
  metricKey           String?         @map("metric_key")
  unit                String?
  minValue            Decimal?        @map("min_value") @db.Decimal(14, 4)
  maxValue            Decimal?        @map("max_value") @db.Decimal(14, 4)
  failCreatesTicket   Boolean         @default(false) @map("fail_creates_ticket")
  followUpCategoryId  String?         @map("follow_up_category_id") @db.Uuid
  followUpPriority    TicketPriority? @map("follow_up_priority")

  @@unique([tenantId, id])
  @@unique([templateId, version, position], map: "checklist_template_items_position_key")
  @@map("checklist_template_items")
}

/// A checklist being filled (ADR 0064): of a ticket's cycle or an
/// inspection; submitted once, with the SHA-256 of its answers.
model ChecklistRun {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  templateId        String    @map("template_id") @db.Uuid
  version           Int
  ticketId          String?   @map("ticket_id") @db.Uuid
  cycle             Int?
  /// The asset whose readings it records.
  assetId           String?   @map("asset_id") @db.Uuid
  /// open, submitted.
  status            String    @default("open")
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(3)
  submittedById     String?   @map("submitted_by_account_id") @db.Uuid
  attestationSha256 String?   @map("attestation_sha256")

  @@unique([tenantId, id])
  @@index([tenantId, assetId, submittedAt], map: "checklist_runs_asset_idx")
  @@map("checklist_runs")
}

/// One item's answer in a run (ADR 0064); frozen once the run is submitted.
model ChecklistAnswer {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  runId        String   @map("run_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  /// pass, fail, na (a check; a reading out of its range fails).
  result       String?
  value        Decimal? @db.Decimal(14, 4)
  note         String?
  answeredById String?  @map("answered_by_account_id") @db.Uuid
  answeredAt   DateTime @map("answered_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([runId, itemId], map: "checklist_answers_run_item_key")
  @@map("checklist_answers")
}

/// A photo of an answer (ADR 0064), three at most. Never changed.
model ChecklistAnswerPhoto {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  answerId  String   @map("answer_id") @db.Uuid
  fileId    String   @unique @map("file_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, answerId, createdAt], map: "checklist_answer_photos_answer_idx")
  @@map("checklist_answer_photos")
}

/// What an asset measured (ADR 0064): from a run, or entered by hand.
model AssetReading {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  metricKey    String   @map("metric_key")
  value        Decimal  @db.Decimal(14, 4)
  unit         String?
  /// run, manual.
  source       String
  runId        String?  @map("run_id") @db.Uuid
  recordedById String?  @map("recorded_by_account_id") @db.Uuid
  /// When it was read, as the reader says (with its offset).
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)
  recordedAt   DateTime @map("recorded_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, assetId, metricKey, occurredAt(sort: Desc), id(sort: Desc)], map: "asset_readings_metric_idx")
  @@map("asset_readings")
}

/// An asset's planned work (ADR 0064): on the compound's calendar or by
/// usage. Its work orders go to its category, with its checklist.
model MaintenancePlan {
  id             String         @id @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  assetId        String         @map("asset_id") @db.Uuid
  checklistId    String?        @map("checklist_id") @db.Uuid
  /// Staff's words: what is done (its work orders' description).
  title          String
  categoryId     String         @map("category_id") @db.Uuid
  priority       TicketPriority @default(normal)
  /// calendar, usage.
  trigger        String
  every          Int?           @db.SmallInt
  /// day, week, month, year.
  unit           String?
  anchorOn       DateTime?      @map("anchor_on") @db.Date
  /// fixed, floating.
  basis          String?
  /// A calendar plan's next due date; null while a floating one's is open.
  nextDueOn      DateTime?      @map("next_due_on") @db.Date
  metricKey      String?        @map("metric_key")
  usageInterval  Decimal?       @map("usage_interval") @db.Decimal(14, 4)
  /// The reading at the last service a usage plan counts from.
  usageLastValue Decimal?       @map("usage_last_value") @db.Decimal(14, 4)
  leadDays       Int            @default(7) @map("lead_days") @db.SmallInt
  graceDays      Int            @default(3) @map("grace_days") @db.SmallInt
  ownerId        String         @map("owner_account_id") @db.Uuid
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, assetId], map: "maintenance_plans_asset_idx")
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "maintenance_plans_list_idx")
  @@map("maintenance_plans")
}

/// One due date of a plan (ADR 0064): its work order, and how it ended.
model MaintenancePlanOccurrence {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  planId           String    @map("plan_id") @db.Uuid
  originalDueOn    DateTime  @map("original_due_on") @db.Date
  dueOn            DateTime  @map("due_on") @db.Date
  /// open, done, skipped, cancelled.
  status           String
  ticketId         String?   @map("ticket_id") @db.Uuid
  generatedAt      DateTime  @map("generated_at") @db.Timestamptz(3)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  doneOn           DateTime? @map("done_on") @db.Date
  onTime           Boolean?  @map("on_time")
  reasonCode       String?   @map("reason_code")
  overdueAlertedAt DateTime? @map("overdue_alerted_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([planId, originalDueOn], map: "maintenance_plan_occurrences_once")
  @@index([tenantId, planId, dueOn(sort: Desc)], map: "maintenance_plan_occurrences_plan_idx")
  @@map("maintenance_plan_occurrences")
}

/// What happened to a plan (ADR 0064), append-only.
model MaintenancePlanEvent {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  planId       String   @map("plan_id") @db.Uuid
  occurrenceId String?  @map("occurrence_id") @db.Uuid
  /// created, updated, deactivated, reactivated, deferred, skipped, generated, done, cancelled, overdue.
  kind         String
  fromValue    String?  @map("from_value")
  toValue      String?  @map("to_value")
  reasonCode   String?  @map("reason_code")
  actorId      String?  @map("actor_account_id") @db.Uuid
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)

  @@index([tenantId, planId, occurredAt(sort: Desc), id(sort: Desc)], map: "maintenance_plan_events_plan_idx")
  @@map("maintenance_plan_events")
}
