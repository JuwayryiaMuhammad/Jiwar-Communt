// ============================================================================
// Phase R6a — finance: invoices and payments (ADR 0046)
// ============================================================================

enum FinanceGatewayMode {
  sandbox
  live

  @@map("finance_gateway_mode")
}

/// One per compound (ADR 0046): online payment on or off. The platform's
/// switch wins over the manager's.
model FinanceSettings {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  onlineEnabled    Boolean  @default(false) @map("online_enabled")
  platformDisabled Boolean  @default(false) @map("platform_disabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("finance_settings")
}

/// A compound's own Paymob account (ADR 0046), sealed by the credential
/// vault: each *Enc is iv ‖ tag ‖ ciphertext under `keyVersion`. Only the
/// last four characters are ever shown. Replaced as a whole; never deleted.
model FinanceGateway {
  tenantId               String             @id @map("tenant_id") @db.Uuid
  provider               String             @default("paymob")
  mode                   FinanceGatewayMode
  keyVersion             Int                @map("key_version")
  secretKeyEnc           Bytes              @map("secret_key_enc")
  publicKeyEnc           Bytes              @map("public_key_enc")
  hmacSecretEnc          Bytes              @map("hmac_secret_enc")
  cardIntegrationEnc     Bytes              @map("card_integration_enc")
  walletIntegrationEnc   Bytes?             @map("wallet_integration_enc")
  secretKeyLast4         String             @map("secret_key_last4")
  publicKeyLast4         String             @map("public_key_last4")
  hmacSecretLast4        String             @map("hmac_secret_last4")
  cardIntegrationLast4   String             @map("card_integration_last4")
  walletIntegrationLast4 String?            @map("wallet_integration_last4")
  updatedById            String?            @map("updated_by_account_id") @db.Uuid
  updatedByPlatform      Boolean            @map("updated_by_platform")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy Account? @relation("FinanceGatewayUpdater", fields: [tenantId, updatedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_gateways_tenant_id_updated_by_fkey")

  @@map("finance_gateways")
}

enum InvoiceKind {
  service_charge
  maintenance
  other

  @@map("invoice_kind")
}

enum InvoiceBatchTarget {
  unit
  building
  all

  @@map("invoice_batch_target")
}

/// Gapless numbers per compound and kind (`invoice`, `credit_note`,
/// `receipt`), taken in the creating transaction (ADR 0046).
model FinanceCounter {
  tenantId   String @map("tenant_id") @db.Uuid
  kind       String
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, kind])
  @@map("finance_counters")
}

/// One issue of invoices by the staff (ADR 0046): one unit, a building, or
/// every unit. Append-only.
model InvoiceBatch {
  id          String             @id @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  target      InvoiceBatchTarget
  unitId      String?            @map("unit_id") @db.Uuid
  building    String?
  kind        InvoiceKind
  unitCount   Int                @map("unit_count")
  issuedOn    DateTime           @map("issued_on") @db.Date
  dueOn       DateTime           @map("due_on") @db.Date
  createdById String?            @map("created_by_account_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  /// A plan's issue: the plan and the period it bills.
  planId         String?   @map("plan_id") @db.Uuid
  periodStartsOn DateTime? @map("period_starts_on") @db.Date

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit?     @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  plan      BillingPlan? @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_batches_tenant_id_plan_id_fkey")
  createdBy Account?  @relation("InvoiceBatchCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_batches_tenant_id_created_by_fkey")
  invoices  Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id], map: "invoice_batches_created_idx")
  @@map("invoice_batches")
}

/// A unit's invoice (ADR 0046): immutable once issued; corrected by credit
/// notes. What it still asks for is computed, never stored.
model Invoice {
  id          String      @id @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  number      Int
  batchId     String      @map("batch_id") @db.Uuid
  unitId      String      @map("unit_id") @db.Uuid
  kind        InvoiceKind
  total       Decimal     @db.Decimal(12, 2)
  currency    String
  issuedOn    DateTime    @map("issued_on") @db.Date
  dueOn       DateTime    @map("due_on") @db.Date
  createdById String?     @map("created_by_account_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  /// A plan's invoice: the plan and the period it bills, the end excluded.
  planId         String?   @map("plan_id") @db.Uuid
  periodStartsOn DateTime? @map("period_starts_on") @db.Date
  periodEndsOn   DateTime? @map("period_ends_on") @db.Date
  /// An instalment (ADR 0048): its plan and its place in it, from 1.
  instalmentPlanId   String? @map("instalment_plan_id") @db.Uuid
  instalmentPosition Int?    @map("instalment_position")

  plan        BillingPlan?  @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoices_tenant_id_plan_id_fkey")
  instalmentPlan InstalmentPlan? @relation("InstalmentPlanInstalments", fields: [tenantId, instalmentPlanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  rescheduledBy  InstalmentPlan? @relation("InstalmentPlanOriginal")
  remainderOf    InstalmentPlan? @relation("InstalmentPlanRemainder")
  disputes       InvoiceDispute[]
  batch       InvoiceBatch  @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit        Unit          @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy   Account?      @relation("InvoiceCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoices_tenant_id_created_by_fkey")
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines       InvoiceLine[]
  creditNotes CreditNote[]
  notices     InvoiceNotice[]
  allocations FinanceAllocation[]
  sessionInvoices PaymentSessionInvoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, batchId, unitId], map: "invoices_one_per_batch_unit")
  @@unique([tenantId, instalmentPlanId, instalmentPosition], map: "invoices_instalment_position_key")
  @@index([tenantId, unitId, dueOn, number], map: "invoices_unit_idx")
  @@index([tenantId, createdAt, id], map: "invoices_created_idx")
  @@index([tenantId, dueOn], map: "invoices_due_idx")
  @@map("invoices")
}

/// What an invoice is for, in both languages (staff text). Append-only.
model InvoiceLine {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  invoiceId     String  @map("invoice_id") @db.Uuid
  position      Int
  descriptionEn String  @map("description_en")
  descriptionAr String  @map("description_ar")
  amount        Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, position], map: "invoice_lines_position_key")
  @@map("invoice_lines")
}

/// Reduces what one invoice asks for (ADR 0046), by a reason's code.
/// Append-only; no free text.
model CreditNote {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  number      Int
  invoiceId   String   @map("invoice_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  reasonCode  String   @map("reason_code")
  createdById String   @map("created_by_account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Reason `instalment_plan` (ADR 0048): the plan it opened or cancelled.
  instalmentPlanId String? @map("instalment_plan_id") @db.Uuid
  /// Reason `dispute` (ADR 0048): the dispute whose acceptance wrote it.
  disputeId        String? @map("dispute_id") @db.Uuid

  invoice        Invoice         @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      Account         @relation("CreditNoteCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "credit_notes_tenant_id_created_by_fkey")
  instalmentPlan InstalmentPlan? @relation(fields: [tenantId, instalmentPlanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  dispute        InvoiceDispute? @relation(fields: [tenantId, disputeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, disputeId], map: "credit_notes_one_per_dispute")
  @@index([tenantId, invoiceId, createdAt], map: "credit_notes_invoice_idx")
  @@index([tenantId, instalmentPlanId], map: "credit_notes_instalment_plan_idx")
  @@map("credit_notes")
}

enum InvoiceDisputeStatus {
  open
  accepted
  rejected

  @@map("invoice_dispute_status")
}

/// A resident's dispute of an invoice (ADR 0048): a reason's code, optional
/// words and photo (cleared on the opener's erasure), and the staff's
/// decision, made once. One open dispute per invoice.
model InvoiceDispute {
  id                 String               @id @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  invoiceId          String               @map("invoice_id") @db.Uuid
  unitId             String               @map("unit_id") @db.Uuid
  openedById         String               @map("opened_by_account_id") @db.Uuid
  reasonCode         String               @map("reason_code")
  text               String?
  photoFileId        String?              @map("photo_file_id") @db.Uuid
  textClearedAt      DateTime?            @map("text_cleared_at") @db.Timestamptz(3)
  status             InvoiceDisputeStatus @default(open)
  decidedById        String?              @map("decided_by_account_id") @db.Uuid
  decidedAt          DateTime?            @map("decided_at") @db.Timestamptz(3)
  decisionReasonCode String?              @map("decision_reason_code")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice    Invoice     @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit       Unit        @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  openedBy   Account     @relation("InvoiceDisputeOpener", fields: [tenantId, openedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_disputes_tenant_id_opened_by_fkey")
  decidedBy  Account?    @relation("InvoiceDisputeDecider", fields: [tenantId, decidedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_disputes_tenant_id_decided_by_fkey")
  creditNote CreditNote?

  @@unique([tenantId, id])
  @@index([tenantId, invoiceId, createdAt], map: "invoice_disputes_invoice_idx")
  @@index([tenantId, createdAt, id], map: "invoice_disputes_created_idx")
  @@index([tenantId, openedById], map: "invoice_disputes_opened_by_idx")
  @@map("invoice_disputes")
}

/// An open invoice's outstanding turned into instalment invoices (ADR
/// 0048). Immutable but for its cancellation, set once with the remainder
/// invoice that cancellation issued.
model InstalmentPlan {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  number             Int
  unitId             String    @map("unit_id") @db.Uuid
  invoiceId          String    @map("invoice_id") @db.Uuid
  instalmentCount    Int       @map("instalment_count")
  total              Decimal   @db.Decimal(12, 2)
  createdById        String    @map("created_by_account_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?   @map("cancelled_by_account_id") @db.Uuid
  remainderInvoiceId String?   @map("remainder_invoice_id") @db.Uuid

  unit             Unit         @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice          Invoice      @relation("InstalmentPlanOriginal", fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  remainderInvoice Invoice?     @relation("InstalmentPlanRemainder", fields: [tenantId, remainderInvoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy        Account      @relation("InstalmentPlanCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "instalment_plans_tenant_id_created_by_fkey")
  cancelledBy      Account?     @relation("InstalmentPlanCanceller", fields: [tenantId, cancelledById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "instalment_plans_tenant_id_cancelled_by_fkey")
  instalments      Invoice[]    @relation("InstalmentPlanInstalments")
  creditNotes      CreditNote[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, invoiceId], map: "instalment_plans_one_per_invoice")
  @@unique([tenantId, remainderInvoiceId], map: "instalment_plans_remainder_key")
  @@index([tenantId, unitId, createdAt, id], map: "instalment_plans_unit_idx")
  @@index([tenantId, createdAt, id], map: "instalment_plans_created_idx")
  @@map("instalment_plans")
}

/// What a unit's people were told about an invoice (ADR 0046): `issued`,
/// `due_soon`, `overdue`, each once. Append-only.
model InvoiceNotice {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  kind      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, invoiceId, kind], map: "invoice_notices_once")
  @@map("invoice_notices")
}

enum BillingFrequency {
  monthly
  quarterly
  annual

  @@map("billing_frequency")
}

/// Recurring billing (ADR 0046): every unit, a fixed amount each period,
/// with per-unit overrides. What it bills and when is fixed; names, amount
/// and days apply to periods issued afterwards. Never deleted.
model BillingPlan {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  nameEn            String           @map("name_en")
  nameAr            String           @map("name_ar")
  kind              InvoiceKind
  frequency         BillingFrequency
  amount            Decimal          @db.Decimal(12, 2)
  /// The first day of the first period: the first of a month.
  startsOn          DateTime         @map("starts_on") @db.Date
  issueDaysBefore   Int              @map("issue_days_before")
  dueDaysAfterIssue Int              @map("due_days_after_issue")
  active            Boolean          @default(true)
  createdById       String           @map("created_by_account_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy Account               @relation("BillingPlanCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "billing_plans_tenant_id_created_by_fkey")
  overrides BillingPlanOverride[]
  batches   InvoiceBatch[]
  invoices  Invoice[]

  @@unique([tenantId, id])
  @@map("billing_plans")
}

/// A unit's own terms in a plan (ADR 0046): another amount, or excluded.
model BillingPlanOverride {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  amount      Decimal? @db.Decimal(12, 2)
  excluded    Boolean
  updatedById String   @map("updated_by_account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan      BillingPlan @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit        @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy Account     @relation("BillingPlanOverrideUpdater", fields: [tenantId, updatedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "billing_plan_overrides_tenant_id_updated_by_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, planId, unitId], map: "billing_plan_overrides_one_per_unit")
  @@map("billing_plan_overrides")
}

enum PaymentKind {
  payment
  reversal

  @@map("payment_kind")
}

enum PaymentChannel {
  office
  online

  @@map("payment_channel")
}

enum PaymentMethod {
  cash
  bank_transfer
  cheque
  card
  wallet

  @@map("payment_method")
}

/// A unit's payment, or the reversal of one made at the office (ADR 0046).
/// Append-only. Each payment has a receipt: a number and a random code the
/// public page verifies.
model FinancePayment {
  id            String          @id @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  kind          PaymentKind
  unitId        String          @map("unit_id") @db.Uuid
  channel       PaymentChannel?
  method        PaymentMethod?
  amount        Decimal?        @db.Decimal(12, 2)
  currency      String?
  /// The local day it was paid.
  paidOn        DateTime?       @map("paid_on") @db.Date
  receiptNumber Int?            @map("receipt_number")
  receiptCode   String?         @map("receipt_code")
  /// A transfer's or cheque's reference, as written on it.
  reference     String?
  recordedById  String?         @map("recorded_by_account_id") @db.Uuid
  reversesId    String?         @map("reverses_id") @db.Uuid
  reasonCode    String?         @map("reason_code")
  /// Online only: the checkout, Paymob's transaction (once per compound)
  /// and who paid.
  sessionId            String?  @map("session_id") @db.Uuid
  gatewayTransactionId String?  @map("gateway_transaction_id")
  payerId              String?  @map("payer_account_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  session     PaymentSession?     @relation("PaymentSessionPayments", fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_payments_tenant_id_session_id_fkey")
  payer       Account?            @relation("FinancePaymentPayer", fields: [tenantId, payerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_payments_tenant_id_payer_fkey")
  settles     PaymentSession?     @relation("PaymentSessionPayment")
  unit        Unit                @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy  Account?            @relation("FinancePaymentRecorder", fields: [tenantId, recordedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_payments_tenant_id_recorded_by_fkey")
  reverses    FinancePayment?     @relation("FinancePaymentReversal", fields: [tenantId, reversesId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_payments_tenant_id_reverses_id_fkey")
  reversedBy  FinancePayment?     @relation("FinancePaymentReversal")
  allocations FinanceAllocation[]
  refundSources FinanceRefundSource[]

  @@unique([tenantId, id])
  @@unique([tenantId, reversesId], map: "finance_payments_one_reversal")
  @@index([tenantId, unitId, createdAt, id], map: "finance_payments_unit_idx")
  @@index([tenantId, createdAt, id], map: "finance_payments_created_idx")
  @@map("finance_payments")
}

enum RefundKind {
  refund
  reversal

  @@map("refund_kind")
}

enum RefundChannel {
  cash
  bank_transfer
  gateway_manual

  @@map("refund_channel")
}

/// A refund of a unit's credit, recorded by hand (ADR 0048), or the reversal
/// of one. Append-only.
model FinanceRefund {
  id           String         @id @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  kind         RefundKind
  unitId       String         @map("unit_id") @db.Uuid
  number       Int?
  amount       Decimal?       @db.Decimal(12, 2)
  currency     String?
  channel      RefundChannel?
  /// The transfer's or the gateway's own reference, as given.
  reference    String?
  /// The local day the money was paid back.
  refundedOn   DateTime?      @map("refunded_on") @db.Date
  reversesId   String?        @map("reverses_id") @db.Uuid
  reasonCode   String?        @map("reason_code")
  recordedById String         @map("recorded_by_account_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  unit       Unit                  @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy Account               @relation("FinanceRefundRecorder", fields: [tenantId, recordedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_refunds_tenant_id_recorded_by_fkey")
  reverses   FinanceRefund?        @relation("FinanceRefundReversal", fields: [tenantId, reversesId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "finance_refunds_tenant_id_reverses_id_fkey")
  reversedBy FinanceRefund?        @relation("FinanceRefundReversal")
  sources    FinanceRefundSource[]

  @@unique([tenantId, id])
  @@unique([tenantId, reversesId], map: "finance_refunds_one_reversal")
  @@index([tenantId, unitId, createdAt, id], map: "finance_refunds_unit_idx")
  @@index([tenantId, createdAt, id], map: "finance_refunds_created_idx")
  @@map("finance_refunds")
}

/// Which live payment's free money a refund took, and how much (ADR 0048).
/// Append-only; it stops counting when its refund is reversed.
model FinanceRefundSource {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  refundId  String   @map("refund_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  refund  FinanceRefund  @relation(fields: [tenantId, refundId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  payment FinancePayment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, refundId, paymentId], map: "finance_refund_sources_once")
  @@index([tenantId, paymentId], map: "finance_refund_sources_payment_idx")
  @@map("finance_refund_sources")
}

/// Which invoice a payment paid, and how much (ADR 0046). Append-only; it
/// stops counting when its payment is reversed.
model FinanceAllocation {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  invoiceId  String   @map("invoice_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  /// Poured from money the unit already held as credit, not in the
  /// payment's own transaction (ADR 0048; false before R6b).
  fromCredit Boolean  @default(false) @map("from_credit")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment FinancePayment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice Invoice        @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, invoiceId], map: "finance_allocations_invoice_idx")
  @@index([tenantId, paymentId], map: "finance_allocations_payment_idx")
  @@map("finance_allocations")
}

/// Global pointer from a receipt's code to its compound (ADR 0046), read by
/// the public page before any tenant is known. Only the code's SHA-256.
model ReceiptLink {
  codeHash  String   @id @map("code_hash") @db.Char(64)
  tenantId  String   @map("tenant_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([paymentId], map: "receipt_links_payment_idx")
  @@map("receipt_links")
}

enum PaymentSessionStatus {
  opening
  open
  succeeded
  failed
  expired
  superseded

  @@map("payment_session_status")
}

/// A hosted checkout for some of a unit's invoices (ADR 0046): one live
/// per unit; the Paymob client secret sealed by the vault. Only the status
/// moves (trigger), and only the webhook makes it a payment.
model PaymentSession {
  id               String               @id @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  unitId           String               @map("unit_id") @db.Uuid
  accountId        String               @map("account_id") @db.Uuid
  amount           Decimal              @db.Decimal(12, 2)
  currency         String
  status           PaymentSessionStatus
  dedupeKey        String               @map("dedupe_key") @db.Char(64)
  specialReference String               @unique(map: "payment_sessions_special_reference_key") @map("special_reference")
  intentionId      String?              @map("intention_id")
  gatewayOrderId   String?              @map("gateway_order_id")
  clientSecretEnc  Bytes?               @map("client_secret_enc")
  keyVersion       Int?                 @map("key_version")
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(3)
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(3)
  paymentId        String?              @map("payment_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit     Unit                    @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account  Account                 @relation("PaymentSessionPayer", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  payment  FinancePayment?         @relation("PaymentSessionPayment", fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "payment_sessions_tenant_id_payment_id_fkey")
  payments FinancePayment[]        @relation("PaymentSessionPayments")
  invoices PaymentSessionInvoice[]
  events   PaymentGatewayEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, paymentId], map: "payment_sessions_payment_id_key")
  @@index([tenantId, unitId, createdAt], map: "payment_sessions_unit_idx")
  @@map("payment_sessions")
}

/// What a checkout pays: its invoices and what each owed when it opened.
model PaymentSessionInvoice {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  sessionId String  @map("session_id") @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  amount    Decimal @db.Decimal(12, 2)

  session PaymentSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice Invoice        @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId, invoiceId], map: "payment_session_invoices_once")
  @@map("payment_session_invoices")
}

/// A Paymob callback that passed the HMAC, and what came of it (ADR 0046).
/// Signed scalar fields only. Append-only.
model PaymentGatewayEvent {
  id                   String   @id @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  sessionId            String?  @map("session_id") @db.Uuid
  gatewayTransactionId String   @map("gateway_transaction_id")
  gatewayOrderId       String?  @map("gateway_order_id")
  amountCents          BigInt   @map("amount_cents")
  success              Boolean
  pending              Boolean
  outcome              String
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session PaymentSession? @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, sessionId, createdAt], map: "payment_gateway_events_session_idx")
  @@index([tenantId, createdAt, id], map: "payment_gateway_events_created_idx")
  @@map("payment_gateway_events")
}

// ============================================================================
// Phase G6a — emergencies and gate services (ADR 0047)
// ============================================================================

/// A place of the compound (ADR 0047): where security meets, walks with or
/// looks. The seven defaults carry a `key`; the manager's own carry none.
/// Never deleted: requests point at it.
model Place {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String?
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, position, id], map: "places_order_idx")
  @@map("places")
}

enum SafetyCounterSeries {
  emergency
  accessibility
  service

  @@map("safety_counter_series")
}

/// A compound's E-, A- and S- numbers, taken under the row lock (ADR 0047).
model SafetyCounter {
  tenantId   String              @map("tenant_id") @db.Uuid
  series     SafetyCounterSeries
  lastNumber Int                 @default(0) @map("last_number")

  @@id([tenantId, series])
  @@map("safety_counters")
}

enum EmergencyType {
  medical
  fire
  security
  facilities

  @@map("emergency_type")
}

enum EmergencyStatus {
  reported
  on_the_way
  arrived
  resolved
  cancelled

  @@map("emergency_status")
}

/// An emergency reported from a unit (ADR 0047). Moves forward only (a
/// trigger); one open per unit and type (a partial unique index).
model Emergency {
  id                  String          @id @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  number              Int
  unitId              String          @map("unit_id") @db.Uuid
  type                EmergencyType
  status              EmergencyStatus @default(reported)
  reportedById        String          @map("reported_by_account_id") @db.Uuid
  reportedAt          DateTime        @default(now()) @map("reported_at") @db.Timestamptz(3)
  respondersNotified  Int             @map("responders_notified")
  escalatedAt         DateTime?       @map("escalated_at") @db.Timestamptz(3)
  escalationReason    String?         @map("escalation_reason")
  responderId         String?         @map("responder_account_id") @db.Uuid
  responderGateId     String?         @map("responder_gate_id") @db.Uuid
  etaMinutes          Int?            @map("eta_minutes")
  acceptedAt          DateTime?       @map("accepted_at") @db.Timestamptz(3)
  arrivedAt           DateTime?       @map("arrived_at") @db.Timestamptz(3)
  closedAt            DateTime?       @map("closed_at") @db.Timestamptz(3)
  closedById          String?         @map("closed_by_account_id") @db.Uuid
  closeSide           String?         @map("close_side")
  closeReason         String?         @map("close_reason")
  closeNote           String?         @map("close_note")
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "emergencies_number_key")
  @@index([tenantId, status, reportedAt, id], map: "emergencies_status_idx")
  @@map("emergencies")
}

/// One of the others living in the unit, told of an emergency (ADR 0047),
/// and their "on my way" (once).
model EmergencyFamilyAlert {
  tenantId    String    @map("tenant_id") @db.Uuid
  emergencyId String    @map("emergency_id") @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  notifiedAt  DateTime  @default(now()) @map("notified_at") @db.Timestamptz(3)
  onMyWayAt   DateTime? @map("on_my_way_at") @db.Timestamptz(3)

  @@id([tenantId, emergencyId, accountId])
  @@map("emergency_family_alerts")
}

enum GateServiceKind {
  accessibility
  suspicious
  escort
  lane

  @@map("gate_service_kind")
}

enum GateServiceStatus {
  open
  accepted
  in_progress
  closed
  cancelled

  @@map("gate_service_status")
}

/// What a resident asks security for (ADR 0047): accessibility help, a
/// suspicious-activity report, an escort or a lane at a gate. Moves forward
/// only (a trigger); the resident's words and photo go once, at erasure.
model GateServiceRequest {
  id             String            @id @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  number         Int
  kind           GateServiceKind
  status         GateServiceStatus @default(open)
  unitId         String            @map("unit_id") @db.Uuid
  requestedById  String            @map("requested_by_account_id") @db.Uuid
  assistanceKind String?           @map("assistance_kind")
  memberId       String?           @map("member_id") @db.Uuid
  fromPlaceId    String?           @map("from_place_id") @db.Uuid
  toPlaceId      String?           @map("to_place_id") @db.Uuid
  placeId        String?           @map("place_id") @db.Uuid
  whenCode       String?           @map("when_code")
  wantedAt       DateTime?         @map("wanted_at") @db.Timestamptz(3)
  description    String?
  photoFileId    String?           @map("photo_file_id") @db.Uuid
  laneReason     String?           @map("lane_reason")
  gateId         String?           @map("gate_id") @db.Uuid
  notes          String?
  textClearedAt  DateTime?         @map("text_cleared_at") @db.Timestamptz(3)
  handledById    String?           @map("handled_by_account_id") @db.Uuid
  etaMinutes     Int?              @map("eta_minutes")
  acceptedAt     DateTime?         @map("accepted_at") @db.Timestamptz(3)
  startedAt      DateTime?         @map("started_at") @db.Timestamptz(3)
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(3)
  closedById     String?           @map("closed_by_account_id") @db.Uuid
  closeReason    String?           @map("close_reason")
  closeNote      String?           @map("close_note")
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelSide     String?           @map("cancel_side")
  cancelReason   String?           @map("cancel_reason")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt, id], map: "gate_service_requests_status_idx")
  @@map("gate_service_requests")
}

