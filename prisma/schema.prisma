  neighbourBlocksMade            NeighbourBlock[]                    @relation("NeighbourBlocker")
  neighbourBlocksReceived        NeighbourBlock[]                    @relation("NeighbourBlocked")
  neighbourReportsMade           NeighbourConversationReport[]       @relation("NeighbourReporter")
  neighbourReportsClosed         NeighbourConversationReport[]       @relation("NeighbourReportCloser")
  neighbourWelcomes              NeighbourWelcome[]
  managementAppointments         ManagementAppointment[]             @relation("ManagementAppointmentProposer")
  fieldExceptionsRaised  GateFieldException[] @relation("FieldExceptionRaisedBy")
  fieldExceptionsDecided GateFieldException[] @relation("FieldExceptionDecidedBy")
  serviceVehiclesIn      ServiceVehicleVisit[] @relation("ServiceVehicleEnteredBy")
  serviceVehiclesOut     ServiceVehicleVisit[] @relation("ServiceVehicleExitedBy")

  @@unique([tenantId, type, email])
  @@unique([tenantId, type, phone])
  @@unique([tenantId, id])
  @@index([tenantId, roleId])
  @@map("accounts")
