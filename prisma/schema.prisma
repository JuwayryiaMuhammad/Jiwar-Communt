generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// Conventions (ADR 0005, 0006):
// - ids are UUIDv7 generated by the app: no @default on `id`.
// - timestamps are timestamptz.
// - GLOBAL tables have no RLS and are reached only through GlobalDbService.
// - TENANT tables carry tenant_id and are protected by RLS + FORCE; the
//   policies live in the migration SQL because Prisma cannot express them.

// ============================================================================
// ENUMS
// ============================================================================

enum NotificationPriority {
  normal
  critical

  @@map("notification_priority")
}

enum GateKind {
  pedestrian
  vehicle
  mixed

  @@map("gate_kind")
}

enum GateStatus {
  active
  inactive

  @@map("gate_status")
}

enum VisitorPassKind {
  one_time
  recurring

  @@map("visitor_pass_kind")
}

enum VisitorPassStatus {
  active
  used
  cancelled
  expired

  @@map("visitor_pass_status")
}

/// What the guard does with an uninvited visitor when nobody answers.
enum VisitorInstruction {
  ask
  allow
  deny

  @@map("visitor_instruction")
}

/// What the guard does with someone a standing instruction describes (ADR 0043).
enum StandingInstructionAction {
  always_allow
  never_allow
  call_first
  leave_at_gate

  @@map("standing_instruction_action")
}

enum DeliveryInstruction {
  ask
  allow
  leave_at_gate
  deny

  @@map("delivery_instruction")
}

enum GateSubjectType {
  visitor_pass
  worker_engagement
  gate_request
  /// A works permit's contractor worker (ADR 0049).
  permit_worker
  /// An event's guest (ADR 0049).
  event_guest
  /// A move's truck (ADR 0049).
  move_permit
  /// A visitor or a vehicle let in on a field exception (ADR 0056).
  field_exception

  @@map("gate_subject_type")
}

enum GateDirection {
  in
  out

  @@map("gate_direction")
}

enum GateEntryMethod {
  code
  qr
  approval
  guard
  system
  /// Let in against a permit (ADR 0049): a face and an ID's last four, a
  /// name on a guest list, a truck's plate.
  permit
  /// Let in on a field exception the management approved (ADR 0056).
  exception

  @@map("gate_entry_method")
}

enum GateRequestKind {
  uninvited_visitor
  delivery
  worker_off_schedule

  @@map("gate_request_kind")
}

enum GateRequestStatus {
  pending
  approved
  denied
  timed_out
  leave_at_gate
  withdrawn

  @@map("gate_request_status")
}

enum GateDecisionSource {
  household
  standing_instruction
  timeout
  guard

  @@map("gate_decision_source")
}

enum TenantStatus {
  active
  suspended

  @@map("tenant_status")
}

enum AccountType {
  resident
  staff
  manager
  /// A household member with a login (ADR 0016). Minors have no account.
  family

  @@map("account_type")
}

enum AccountStatus {
  active
  inactive
  /// "Not me" (ADR 0023): no login, no phone; only reactivate() reopens it.
  frozen
  /// A tombstone (ADR 0023): the row stays, every personal field is NULL.
  erased

  @@map("account_status")
}

enum IdentifierType {
  email
  phone

  @@map("identifier_type")
}

/// ADR 0013
enum Locale {
  ar
  en

  @@map("locale")
}

enum OccupancyType {
  owner
  tenant

  @@map("occupancy_type")
}

enum OccupancyStatus {
  active
  ended

  @@map("occupancy_status")
}

/// Why an occupancy ended (ADR 0020). The first four are the manager's
/// reason codes; the rest are set by the flows that end it.
enum OccupancyEndReason {
  moved_out
  contract_ended
  data_correction
  other
  converted_to_owner
  ownership_transferred
  household_ended
  account_erased

  @@map("occupancy_end_reason")
}

enum AccountFreezeReason {
  phone_reassigned
  /// "Not me" on an unusual login (ADR 0036): the phone stays.
  login_not_me

  @@map("account_freeze_reason")
}

/// The activation card's unit type (ADR 0024).
enum UnitType {
  apartment
  villa
  townhouse
  duplex
  penthouse
  studio
  commercial
  other

  @@map("unit_type")
}

enum RegistrationStatus {
  pending
  /// Sent back to the registrant for a correction (ADR 0062); still undecided.
  needs_correction
  approved
  rejected
  expired

  @@map("registration_status")
}

enum DeletionRequestStatus {
  pending
  cancelled
  completed
  /// Past its cooling-off with blockers: a manager's to act on (ADR 0036).
  queued
  /// A manager closed a queued request (ADR 0036).
  closed

  @@map("deletion_request_status")
}

enum PlatformAdminStatus {
  active
  disabled

  @@map("platform_admin_status")
}

/// ADR 0018: every identity document has a type. A national ID carries the
/// birth date; a passport needs it entered (and, for a worker, attested).
enum IdDocumentType {
  national_id
  passport

  @@map("id_document_type")
}

enum OutboxChannel {
  email

  @@map("outbox_channel")
}

enum OutboxStatus {
  pending
  processing
  sent
  dead
  /// Held by a pause "until resumed" (ADR 0036): never claimed until the
  /// account's preferences change.
  held

  @@map("outbox_status")
}

enum PushPlatform {
  android
  ios

  @@map("push_platform")
}

enum PushStatus {
  pending
  processing
  sent
  dead

  @@map("push_status")
}

/// Separates login codes from invite codes (ADR 0004, 0016): a code issued
/// for one purpose can never be consumed for the other.
enum OtpPurpose {
  login
  invite_accept
  registration
  /// A fresh code for a sensitive action (ADR 0036): bound to a session, or
  /// to an email action token.
  step_up
  /// Proves an account's new email (ADR 0062), sent to that address.
  contact_change

  @@map("otp_purpose")
}

enum HouseholdRelation {
  spouse
  child
  parent
  sibling
  other

  @@map("household_relation")
}

enum HouseholdMemberStatus {
  pending_approval
  active
  removed

  @@map("household_member_status")
}

enum HouseholdInviteStatus {
  pending
  accepted
  revoked
  expired

  @@map("household_invite_status")
}

/// What a primary resident may delegate (ADR 0016). Never money, contracts,
/// governance or ownership: a unit test pins this list.
enum DelegationScope {
  household
  workers
  /// Works, moves and material exits for the unit (ADR 0062).
  permits
  /// The unit's shared documents: read and add (ADR 0062). Never contracts.
  documents

  @@map("delegation_scope")
}

enum DelegationEndReason {
  revoked
  expired
  member_removed
  primary_changed
  account_deactivated
  household_ended

  @@map("delegation_end_reason")
}

enum WorkerCapacity {
  live_in
  hourly
  driver
  nanny
  temporary

  @@map("worker_capacity")
}

enum WorkerEngagementStatus {
  pending_review
  active
  suspended
  ended
  rejected

  @@map("worker_engagement_status")
}

/// Why a unit is under review (ADR 0021). Several can be open at once.
enum UnitReviewReason {
  primary_left
  primary_frozen
  primary_deceased
  separation

  @@map("unit_review_reason")
}

/// What payroll owes a worker, recorded by the community side (ADR 0017).
enum WageObligationKind {
  /// Found to be under 18: every day worked is paid.
  pay_in_full
  /// The file is not closed before the wage is settled.
  settle_before_close

  @@map("wage_obligation_kind")
}

/// What a household member may use (ADR 0021). Never money for a minor.
enum MemberPermission {
  visitors_invite
  bookings
  tickets
  finance
  unit_security
  /// Casting the unit's vote in a consultative poll (ADR 0040).
  polls_vote

  @@map("member_permission")
}

enum DeferredActionStatus {
  pending
  approved
  declined
  withdrawn

  @@map("deferred_action_status")
}

enum ComplianceCaseKind {
  underage

  @@map("compliance_case_kind")
}

enum ComplianceCaseStatus {
  open
  closed

  @@map("compliance_case_status")
}

enum ComplianceCaseSource {
  review
  birth_date_correction
  report

  @@map("compliance_case_source")
}

enum CardIncidentType {
  lost
  confiscated

  @@map("card_incident_type")
}

enum CardIncidentStatus {
  open
  closed

  @@map("card_incident_status")
}

enum CardIncidentReporter {
  manager
  resident

  @@map("card_incident_reporter")
}

enum WorkerNoticeStatus {
  pending
  sent

  @@map("worker_notice_status")
}

// ============================================================================
// GLOBAL — no RLS
// ============================================================================

/// One tenant = one compound (ADR 0001).
model Tenant {
  id        String       @id @db.Uuid
  name      String
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  accounts                     Account[]
  units                        Unit[]
  loginIdentifiers             LoginIdentifier[]
  roles                        Role[]
  permissionCatalog            TenantPermissionCatalog[]
  inviteTokens                 InviteToken[]
  settings                     TenantSettings?
  registrationLinks            RegistrationLink[]
  visitorPassLinks             VisitorPassLink[]
  partnerDeskLinks             PartnerDeskLink[]
  childPickupLinks             ChildPickupLink[]
  registrationStatusLinks      RegistrationStatusLink[]
  registrationDocuments        RegistrationDocument[]
  accountIdentityChanges       AccountIdentityChange[]
  householdInviteDocuments     HouseholdInviteDocument[]
  unitDocuments                UnitDocument[]
  compoundDocumentVersions     CompoundDocumentVersion[]
  unitContracts                UnitContract[]
  unitContractParties          UnitContractParty[]
  contractRenewals             ContractRenewal[]
  financeClearances            FinanceClearance[]
  clearanceLinks               ClearanceLink[]
  financeDeposits              FinanceDeposit[]
  financeDepositEvents         FinanceDepositEvent[]
  actionTokens                 ActionToken[]
  ticketCategories             TicketCategory[]
  preventiveServices           PreventiveService[]
  maintenance                  MaintenanceSettings?
  ticketCounter                TicketCounter?
  parcelSettings               ParcelSettings?
  parcelCounter                ParcelCounter?
  managementTopics             ManagementRequestTopic[]
  managementSettings           ManagementRequestSettings?
  managementOfficeHours        ManagementOfficeHours[]
  managementCounter            ManagementRequestCounter?
  managementSlots              ManagementAppointmentSlot[]
  engagementSettings           EngagementSettings?
  suggestionTopics             SuggestionTopic[]
  neighbourSettings            NeighbourSettings?
  neighbourComplaintCategories NeighbourComplaintCategory[]
  neighbourComplaintCounter    NeighbourComplaintCounter?
  neighbourComplaints          NeighbourComplaint[]
  neighbourPosts               NeighbourPost[]
  neighbourConversations       NeighbourConversation[]
  neighbourWelcomeTemplate     NeighbourWelcomeTemplate?
  facilities                   Facility[]
  bookings                     Booking[]
  facilitySettings             FacilitySettings?
  vehicleSettings              VehicleSettings?
  vehicleCounters              VehicleCounter[]
  bookingSuspensions           BookingSuspension[]
  clubPlans                    ClubPlan[]
  clubMemberships              ClubMembership[]
  financeSettings              FinanceSettings?
  financeGateway               FinanceGateway?
  financeCounters              FinanceCounter[]
  invoiceBatches               InvoiceBatch[]
  invoices                     Invoice[]
  billingPlans                 BillingPlan[]
  financePayments              FinancePayment[]
  receiptLinks                 ReceiptLink[]
  paymentSessions              PaymentSession[]
  announcements                Announcement[]
  communityEvents              CommunityEvent[]
  polls                        Poll[]
  suggestions                  Suggestion[]
  specialties                  Specialty[]
  dispatchSettings             MaintenanceDispatchSettings?
  slaSettings                  MaintenanceSlaSettings?
  standingInstructions         UnitStandingInstruction[]
  gateSettings           GateSettings?

  @@map("tenants")
}

/// Global login lookup: identifier → accounts, across tenants. No PII: the
/// identifier is stored only as HMAC-SHA256(IDENTIFIER_PEPPER, "<type>:<value>").
/// `status` and `account_type` mirror the account so the login bootstrap never
/// has to read tenant data to decide what to offer.
model LoginIdentifier {
  identifierHash String         @map("identifier_hash") @db.Char(64)
  identifierType IdentifierType @map("identifier_type")
  accountId      String         @map("account_id") @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  accountType    AccountType    @map("account_type")
  status         AccountStatus
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@id([identifierHash, accountId])
  @@index([accountId])
  @@map("login_identifiers")
}

/// One row per (request, destination email). A code unlocks only the
/// accounts in `account_ids` — the ones behind the email it was sent to.
model OtpChallenge {
  id             String     @id @db.Uuid
  purpose        OtpPurpose @default(login)
  /// Login: the identifier HMAC. Invite acceptance: the invite token HMAC.
  identifierHash String     @map("identifier_hash") @db.Char(64)
  accountIds     String[]   @map("account_ids") @db.Uuid
  codeHash       String     @map("code_hash") @db.Char(64)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(3)
  attempts       Int        @default(0)
  consumedAt     DateTime?  @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt  DateTime?  @map("invalidated_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifierHash])
  @@map("otp_challenges")
}

model Session {
  id               String    @id @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  /// Origin at creation and at each refresh (ADR 0004). Never shown back
  /// to the account holder (the session list omits the IP).
  userAgent        String?   @map("user_agent")
  ip               String?   @db.Inet
  /// A step-up code was verified on this session (ADR 0036): the next
  /// sensitive action may run until then, and consumes it.
  stepUpUntil      DateTime? @map("step_up_until") @db.Timestamptz(3)
  /// The known device it was started on (ADR 0058); null before R11b.
  knownDeviceId    String?   @map("known_device_id") @db.Uuid

  pushDevices PushDevice[]
  knownDevice KnownDevice?   @relation(fields: [tenantId, knownDeviceId], references: [tenantId, id], onDelete: SetNull, onUpdate: Restrict, map: "sessions_known_device_fkey")
  logins      AccountLogin[]

  @@unique([tenantId, id])
  @@index([accountId])
  @@map("sessions")
}

/// The platform owner (ADR 0011). Not a tenant account.
model PlatformAdmin {
  id                 String              @id @db.Uuid
  /// trimmed + lowercased
  email              String              @unique
  /// argon2id
  passwordHash       String              @map("password_hash")
  mustChangePassword Boolean             @default(true) @map("must_change_password")
  status             PlatformAdminStatus @default(active)
  preferredLocale    Locale              @default(ar) @map("preferred_locale")
  failedAttempts     Int                 @default(0) @map("failed_attempts")
  lockedUntil        DateTime?           @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?           @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions PlatformSession[]

  @@map("platform_admins")
}

/// Same rotation / reuse-detection rules as `sessions`.
model PlatformSession {
  id               String    @id @db.Uuid
  adminId          String    @map("admin_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  /// Platform step-up (ADR 0046): until then, the session's next sensitive
  /// action may run once.
  stepUpUntil      DateTime? @map("step_up_until") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@map("platform_sessions")
}

/// Global pointer from an invite link to its compound (ADR 0016), read
/// before any tenant is known — like `login_identifiers`. No PII: only the
/// token HMAC. Deleted when the invite is accepted or revoked.
model InviteToken {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  tenantId  String   @map("tenant_id") @db.Uuid
  inviteId  String   @map("invite_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("invite_tokens")
}

/// Global pointer from a registration link to its compound (ADR 0024), read
/// before anyone is logged in — like `invite_tokens`. No PII.
/// Global pointer from a registrant's status link to their request (ADR
/// 0062): the HMAC of the link's token (derived when an email is sent,
/// never stored). One per request; a newer link replaces it, the decision
/// deletes it.
model RegistrationStatusLink {
  tokenHash      String   @id @map("token_hash") @db.Char(64)
  tenantId       String   @map("tenant_id") @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  seq            Int
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  registration ResidentRegistration @relation(fields: [tenantId, registrationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, registrationId], map: "registration_status_links_one_per_registration")
  @@map("registration_status_links")
}

model RegistrationLink {
  tokenHash String    @id @map("token_hash") @db.Char(64)
  /// Listed and revoked by this id; the token itself is shown once (ADR 0025).
  id        String    @unique @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("registration_links")
}

/// Global pointer from a visitor's link to its pass (ADR 0030), read by the
/// public page before any compound is known — like `invite_tokens`. No PII:
/// HMAC(IDENTIFIER_PEPPER, "visitor-link:<token>"). Outlives the code so the
/// page can say what became of the pass; deleted 30 days after its end.
model VisitorPassLink {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  tenantId  String   @map("tenant_id") @db.Uuid
  passId    String   @map("pass_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: Restrict)

  @@index([passId])
  @@index([expiresAt])
  @@map("visitor_pass_links")
}

/// What an email action token is for (ADR 0036).
enum ActionTokenPurpose {
  /// "Not me" on an unusual-login alert: single use.
  not_me
  /// An assisted personal-data export's download link.
  export_download

  @@map("action_token_purpose")
}

/// Global pointer from a link in an email to what it acts on (ADR 0036),
/// read before any compound is known — like `invite_tokens`. Stores NO
/// secret and no hash of one: the token is `<id>.<mac>`, the mac derived
/// from the id with IDENTIFIER_PEPPER, so only the server can make or check
/// it. Ids only, no personal data.
model ActionToken {
  id         String             @id @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  accountId  String             @map("account_id") @db.Uuid
  purpose    ActionTokenPurpose
  /// The device (not_me) or the export (export_download).
  subjectId  String             @map("subject_id") @db.Uuid
  expiresAt  DateTime           @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?          @map("consumed_at") @db.Timestamptz(3)
  /// Successful uses (an export's link allows a few, ADR 0036).
  uses       Int                @default(0)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: Restrict)

  @@index([accountId])
  @@index([expiresAt])
  @@map("action_tokens")
}

/// Transactional outbox (ADR 0019): written in the transaction of the action
/// that causes the message, delivered at least once by OutboxProcessor.
/// Global, like security_events: tenant_id is a pointer. Sent rows are
/// deleted after retention; dead rows are kept with their personal data
/// stripped, as evidence that a notice never arrived.
model OutboxMessage {
  id                      String        @id @db.Uuid
  tenantId                String?       @map("tenant_id") @db.Uuid
  channel                 OutboxChannel
  templateKey             String        @map("template_key")
  locale                  Locale
  /// Null once stripped (dead rows past retention).
  recipient               String?
  params                  Json?
  status                  OutboxStatus  @default(pending)
  attempts                Int           @default(0)
  nextAttemptAt           DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil             DateTime?     @map("locked_until") @db.Timestamptz(3)
  lastErrorCode           String?       @map("last_error_code")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt                  DateTime?     @map("sent_at") @db.Timestamptz(3)
  /// When recipient and params were removed (dead rows past retention).
  strippedAt              DateTime?     @map("stripped_at") @db.Timestamptz(3)
  /// The account a message is for (a pointer, no FK): erasure strips that
  /// account's pending messages without touching others sharing the address.
  recipientAccountId      String?       @map("recipient_account_id") @db.Uuid
  /// When the account's preferences held it (quiet hours, a pause; ADR 0036).
  /// A held message is re-decided whenever those preferences change.
  heldAt                  DateTime?     @map("held_at") @db.Timestamptz(3)
  /// The formal notice recipient whose email this is (ADR 0058, a pointer):
  /// marking it sent records the email's proof.
  formalNoticeRecipientId String?       @map("formal_notice_recipient_id") @db.Uuid

  @@index([status, nextAttemptAt])
  @@index([status, sentAt])
  @@index([recipientAccountId])
  @@map("outbox_messages")
}

/// A phone registered for push (ADR 0041): one FCM token per account and
/// install. Global, like sessions: the row lives and dies with the session
/// that registered it, and a token belongs to one row across every compound.
/// The token is a secret in practice: never logged, audited or returned.
model PushDevice {
  id          String       @id @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  accountId   String       @map("account_id") @db.Uuid
  /// The session that registered it: when that session ends, so does this.
  sessionId   String       @map("session_id") @db.Uuid
  /// The keyed hash known_devices uses (account + install id), never the id.
  installHash String       @map("install_hash") @db.Char(64)
  platform    PushPlatform
  token       String
  /// SHA-256 of the token: what "the same token" is compared by.
  tokenHash   String       @map("token_hash") @db.Char(64)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The last registration or successful push.
  lastUsedAt  DateTime     @default(now()) @map("last_used_at") @db.Timestamptz(3)

  session    Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  deliveries PushDelivery[]

  @@unique([accountId, installHash])
  @@unique([tokenHash])
  @@index([sessionId])
  @@index([tenantId])
  @@map("push_devices")
}

/// The push outbox (ADR 0041): one row per notification and device, written
/// in the transaction that writes the notification and sent at most once by
/// PushProcessor. Global, like outbox_messages: tenant_id and
/// notification_id are pointers. It never holds a token or any text.
model PushDelivery {
  id             String     @id @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  notificationId String     @map("notification_id") @db.Uuid
  deviceId       String     @map("device_id") @db.Uuid
  status         PushStatus @default(pending)
  attempts       Int        @default(0)
  nextAttemptAt  DateTime   @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil    DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastErrorCode  String?    @map("last_error_code")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime?  @map("sent_at") @db.Timestamptz(3)

  device PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([notificationId, deviceId])
  @@index([status, nextAttemptAt])
  @@index([deviceId])
  @@map("push_deliveries")
}

// ============================================================================
// TENANT-SCOPED — RLS + FORCE (policy in the migration)
// ============================================================================

/// Separate per capacity (ADR 0002): the same phone/email may exist once per
/// account type within a tenant, and freely across tenants.
///
/// Exactly one role (ADR 0010). The composite key (tenant_id, role_id, type)
/// makes both a role of another tenant and a role of another kind impossible
/// at the database level — foreign-key checks bypass RLS.
model Account {
  id               String          @id @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  type             AccountType
  roleId           String          @map("role_id") @db.Uuid
  /// Personal fields are NULL only on an erased account (CHECK accounts_erased_shape).
  fullName         String?         @map("full_name")
  /// A national ID (14 digits) or a passport number (ADR 0018).
  idDocumentNumber String?         @map("id_document_number")
  idDocumentType   IdDocumentType? @default(national_id) @map("id_document_type")
  /// ISO 3166-1 alpha-2; EG for a national ID.
  nationality      String?         @default("EG") @db.Char(2)
  /// Stored, never derived at read time. Null only on legacy rows whose ID did not parse.
  birthDate        DateTime?       @map("birth_date") @db.Date
  /// E.164. Null only while frozen (the number went to someone else).
  phone            String?
  /// trimmed + lowercased
  email            String?
  status           AccountStatus   @default(active)
  preferredLocale  Locale          @default(ar) @map("preferred_locale")
  /// The account's own photo (ADR 0031): a file attached to this record.
  photoFileId      String?         @map("photo_file_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  photo              StoredFile?       @relation("AccountPhoto", fields: [tenantId, photoFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  role               Role              @relation(fields: [tenantId, roleId, type], references: [tenantId, id, kind], onUpdate: Restrict)
  loginIdentifiers   LoginIdentifier[]
  occupancies        UnitOccupancy[]   @relation("OccupancyAccount")
  createdOccupancies UnitOccupancy[]   @relation("OccupancyCreatedBy")

  memberships                    HouseholdMember[]                   @relation("MemberAccount")
  addedMembers                   HouseholdMember[]                   @relation("MemberAddedBy")
  removedMembers                 HouseholdMember[]                   @relation("MemberRemovedBy")
  sentInvites                    HouseholdInvite[]                   @relation("InviteInvitedBy")
  acceptedInvites                HouseholdInvite[]                   @relation("InviteAcceptedAccount")
  delegationsGiven               HouseholdDelegation[]               @relation("DelegationDelegator")
  delegationsHeld                HouseholdDelegation[]               @relation("DelegationDelegate")
  delegationsRevoked             HouseholdDelegation[]               @relation("DelegationRevokedBy")
  bannedWorkers                  DomesticWorker[]                    @relation("WorkerBannedBy")
  verifiedWorkers                DomesticWorker[]                    @relation("WorkerBirthDateVerifiedBy")
  requestedWorkers               WorkerEngagement[]                  @relation("EngagementRequestedBy")
  reviewedWorkers                WorkerEngagement[]                  @relation("EngagementReviewedBy")
  flagsRaised                    UnitReviewFlag[]                    @relation("ReviewFlaggedBy")
  flagsCleared                   UnitReviewFlag[]                    @relation("ReviewClearedBy")
  wagesSettled                   WorkerWageObligation[]              @relation("WageSettledBy")
  grantsGiven                    HouseholdMemberGrant[]              @relation("GrantGrantedBy")
  grantsRevoked                  HouseholdMemberGrant[]              @relation("GrantRevokedBy")
  deferredDecided                HouseholdDeferredAction[]           @relation("DeferredDecidedBy")
  casesOpened                    WorkerComplianceCase[]              @relation("CaseOpenedBy")
  casesClosed                    WorkerComplianceCase[]              @relation("CaseClosedBy")
  incidentsReported              WorkerCardIncident[]                @relation("IncidentReportedBy")
  incidentsClosed                WorkerCardIncident[]                @relation("IncidentClosedBy")
  freezes                        AccountFreeze[]                     @relation("FreezeAccount")
  freezesMade                    AccountFreeze[]                     @relation("FreezeFrozenBy")
  freezesLifted                  AccountFreeze[]                     @relation("FreezeReactivatedBy")
  registrationsDecided           ResidentRegistration[]              @relation("RegistrationDecidedBy")
  identityChanges                AccountIdentityChange[]             @relation("IdentityChangeAccount")
  identityChangesDecided         AccountIdentityChange[]             @relation("IdentityChangeDecider")
  unitDocumentsUploaded          UnitDocument[]                      @relation("UnitDocumentUploader")
  compoundDocumentsPublished     CompoundDocumentVersion[]           @relation("CompoundDocumentPublisher")
  contractsCreated               UnitContract[]                      @relation("ContractCreator")
  renewalsRequested              ContractRenewal[]                   @relation("RenewalRequester")
  renewalsClosed                 ContractRenewal[]                   @relation("RenewalCloser")
  clearancesRequested            FinanceClearance[]                  @relation("ClearanceRequester")
  depositsRecorded               FinanceDeposit[]                    @relation("DepositRecorder")
  depositEvents                  FinanceDepositEvent[]               @relation("DepositEventBy")
  registrationsApproved          ResidentRegistration[]              @relation("RegistrationAccount")
  deletionRequests               AccountDeletionRequest[]            @relation("DeletionAccount")
  deletionsCompleted             AccountDeletionRequest[]            @relation("DeletionCompletedBy")
  legalHolds                     LegalHold[]                         @relation("HoldAccount")
  holdsPlaced                    LegalHold[]                         @relation("HoldPlacedBy")
  holdsReleased                  LegalHold[]                         @relation("HoldReleasedBy")
  notifications                  Notification[]                      @relation("NotificationAccount")
  notificationSettings           NotificationSettings?               @relation("NotificationSettingsAccount")
  channelPrefs                   NotificationChannelPref[]           @relation("ChannelPrefAccount")
  consents                       AccountConsent[]                    @relation("ConsentAccount")
  knownDevices                   KnownDevice[]                       @relation("KnownDeviceAccount")
  accountLogins                  AccountLogin[]                      @relation("AccountLoginAccount")
  dataExports                    DataExport[]                        @relation("DataExportAccount")
  idempotencyKeys                IdempotencyKey[]                    @relation("IdempotencyAccount")
  technicianSpecialties          TechnicianSpecialty[]               @relation("TechnicianSpecialtyAccount")
  availability                   TechnicianAvailability?             @relation("TechnicianAvailabilityAccount")
  visitsAsTechnician             TicketVisit[]                       @relation("VisitTechnician")
  visitsAsReceiver               TicketVisit[]                       @relation("VisitReceiver")
  guardShifts                    GuardShift[]                        @relation("ShiftGuard")
  hostedPasses                   VisitorPass[]                       @relation("PassHost")
  cancelledPasses                VisitorPass[]                       @relation("PassCancelledBy")
  gateInstructions               UnitGateInstruction[]               @relation("InstructionsUpdatedBy")
  standingInstructions           UnitStandingInstruction[]           @relation("StandingInstructionAuthor")
  gateRequestsMade               GateApprovalRequest[]               @relation("RequestRequestedBy")
  gateRequestsDecided            GateApprovalRequest[]               @relation("RequestDecidedBy")
  files                          StoredFile[]                        @relation("FileOwner")
  entryCredentials               EntryCredential[]                   @relation("CredentialAccount")
  ticketsCreated                 Ticket[]                            @relation("TicketCreatedBy")
  ticketsReported                Ticket[]                            @relation("TicketReporter")
  ticketsWorked                  Ticket[]                            @relation("TicketTechnician")
  ticketFeedback                 TicketFeedback[]                    @relation("FeedbackAuthor")
  ticketMessages                 TicketMessage[]                     @relation("MessageSender")
  ticketAttachments              TicketAttachment[]                  @relation("AttachmentUploader")
  managementRequestsAuthored     ManagementRequest[]                 @relation("ManagementRequestAuthor")
  managementRequestsOpened       ManagementRequest[]                 @relation("ManagementRequestOpenedBy")
  managementRequestsAssigned     ManagementRequest[]                 @relation("ManagementRequestAssignee")
  managementMessages             ManagementRequestMessage[]          @relation("ManagementMessageSender")
  managementAttachments          ManagementRequestAttachment[]       @relation("ManagementAttachmentUploader")
  managementRatings              ManagementRequestRating[]           @relation("ManagementRatingAuthor")
  announcementsCreated           Announcement[]                      @relation("AnnouncementCreator")
  announcementVersions           AnnouncementVersion[]               @relation("AnnouncementVersionEditor")
  announcementAttachments        AnnouncementAttachment[]            @relation("AnnouncementAttachmentUploader")
  communityEventsCreated         CommunityEvent[]                    @relation("CommunityEventCreator")
  eventAttachments               EventAttachment[]                   @relation("EventAttachmentUploader")
  eventRsvps                     EventRsvp[]                         @relation("EventRsvpAccount")
  pollsCreated                   Poll[]                              @relation("PollCreator")
  suggestionsAuthored            Suggestion[]                        @relation("SuggestionAuthor")
  suggestionUpdates              SuggestionUpdate[]                  @relation("SuggestionUpdateBy")
  suggestionAttachments          SuggestionAttachment[]              @relation("SuggestionAttachmentUploader")
  suggestionSupports             SuggestionSupport[]                 @relation("SuggestionSupporter")
  neighbourComplaintsAuthored    NeighbourComplaint[]                @relation("NeighbourComplaintAuthor")
  neighbourComplaintMoves        NeighbourComplaintStatusChange[]    @relation("NeighbourComplaintStatusActor")
  neighbourComplaintMessages     NeighbourComplaintMessage[]         @relation("NeighbourComplaintMessageSender")
  neighbourComplaintAttachments  NeighbourComplaintAttachment[]      @relation("NeighbourComplaintAttachmentUploader")
  neighbourNoticesSent           NeighbourComplaintNotice[]          @relation("NeighbourNoticeSender")
  neighbourNoticesReceived       NeighbourComplaintNoticeRecipient[] @relation("NeighbourNoticeRecipient")
  neighbourPosts                 NeighbourPost[]                     @relation("NeighbourPostAuthor")
  neighbourClaims                NeighbourItemClaim[]                @relation("NeighbourClaimant")
  neighbourItemsReceived         NeighbourItemHandover[]             @relation("NeighbourHandoverRecipient")
  neighbourItemsHandedOver       NeighbourItemHandover[]             @relation("NeighbourHandoverStaff")
  bookingsMade                   Booking[]                           @relation("BookingBooker")
  bookingsDecided                Booking[]                           @relation("BookingDecider")
  bookingsCancelled              Booking[]                           @relation("BookingCanceller")
  bookingsMarkedNoShow           Booking[]                           @relation("BookingNoShowMarker")
  facilityClosuresMade           FacilityClosure[]                   @relation("FacilityClosureCreator")
  facilityClosuresLifted         FacilityClosure[]                   @relation("FacilityClosureLifter")
  bookingSuspensionsLifted       BookingSuspension[]                 @relation("BookingSuspensionLifter")
  clubMembershipsCreated         ClubMembership[]                    @relation("ClubMembershipCreator")
  clubPeopleAdded                ClubMembershipPerson[]              @relation("ClubPersonAdder")
  clubPeopleRemoved              ClubMembershipPerson[]              @relation("ClubPersonRemover")
  clubPaymentsRecorded           ClubPaymentRecord[]                 @relation("ClubPaymentRecorder")
  financeGatewaysUpdated         FinanceGateway[]                    @relation("FinanceGatewayUpdater")
  invoiceBatchesCreated          InvoiceBatch[]                      @relation("InvoiceBatchCreator")
  invoicesCreated                Invoice[]                           @relation("InvoiceCreator")
  creditNotesCreated             CreditNote[]                        @relation("CreditNoteCreator")
  instalmentPlansCreated         InstalmentPlan[]                    @relation("InstalmentPlanCreator")
  instalmentPlansCancelled       InstalmentPlan[]                    @relation("InstalmentPlanCanceller")
  invoiceDisputesOpened          InvoiceDispute[]                    @relation("InvoiceDisputeOpener")
  invoiceDisputesDecided         InvoiceDispute[]                    @relation("InvoiceDisputeDecider")
  financeRefundsRecorded         FinanceRefund[]                     @relation("FinanceRefundRecorder")
  billingPlansCreated            BillingPlan[]                       @relation("BillingPlanCreator")
  billingPlanOverridesUpdated    BillingPlanOverride[]               @relation("BillingPlanOverrideUpdater")
  financePaymentsRecorded        FinancePayment[]                    @relation("FinancePaymentRecorder")
  financePaymentsPaid            FinancePayment[]                    @relation("FinancePaymentPayer")
  paymentSessions                PaymentSession[]                    @relation("PaymentSessionPayer")
  neighbourConversationsAuthored NeighbourConversation[]             @relation("NeighbourConversationAuthor")
  neighbourConversationsStarted  NeighbourConversation[]             @relation("NeighbourConversationResponder")
