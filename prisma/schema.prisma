/// Per-tenant copy of a role (ADR 0010). System roles are identified by `key`
/// and have no `name` (ADR 0013); `name` is for future custom roles.
model Role {
  id                 String      @id @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  key                String
  name               String?
  kind               AccountType
  isSystem           Boolean     @default(false) @map("is_system")
  /// Bumped in the same transaction as every permission change; part of the
  /// permission cache key, so a stale cache entry is never read again.
  permissionsVersion Int         @default(1) @map("permissions_version")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  accounts    Account[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@unique([tenantId, id, kind])
  @@map("roles")
}

model RolePermission {
  tenantId   String @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onUpdate: Restrict)

  @@id([roleId, permission])
  @@index([tenantId])
  @@map("role_permissions")
}

/// Which code permissions this tenant has already been offered (ADR 0010).
/// A permission listed here is never re-added by `access:sync`.
model TenantPermissionCatalog {
  tenantId    String   @map("tenant_id") @db.Uuid
  permission  String
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, permission])
  @@map("tenant_permission_catalog")
}

model Unit {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  code        String
  building    String?
  floor       Int?
  /// Closed-unit mode (ADR 0020), set by the owner-resident primary.
  closedSince DateTime? @map("closed_since") @db.Timestamptz(3)
  /// Filled progressively (activation card); the manager's value wins.
  unitType    UnitType? @map("unit_type")
  areaSqm     Decimal?  @map("area_sqm") @db.Decimal(8, 2)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant                    @relation(fields: [tenantId], references: [id])
  occupancies       UnitOccupancy[]
  householdMembers  HouseholdMember[]
  householdInvites  HouseholdInvite[]
  delegations       HouseholdDelegation[]
  workerEngagements WorkerEngagement[]
  reviewFlags       UnitReviewFlag[]
  deferredActions   HouseholdDeferredAction[]
  visitorPasses     VisitorPass[]
  gateInstructions  UnitGateInstruction[]
  standingInstructions UnitStandingInstruction[]
  gateRequests      GateApprovalRequest[]
  tickets           Ticket[]
  parcels           Parcel[]
  managementRequests ManagementRequest[]
  eventRsvps         EventRsvp[]
  pollParticipations PollParticipation[]
  suggestions        Suggestion[]
  neighbourComplaintsFrom    NeighbourComplaint[] @relation("NeighbourComplaintAuthorUnit")
  neighbourComplaintsAgainst NeighbourComplaint[] @relation("NeighbourComplaintTargetUnit")
  neighbourPosts             NeighbourPost[]
  neighbourConversations     NeighbourConversation[]
  neighbourWelcomes          NeighbourWelcome[]
  bookings                   Booking[]
  bookingSuspensions         BookingSuspension[]
  clubMembership             ClubMembership?
  invoiceBatches             InvoiceBatch[]
  invoices                   Invoice[]
  instalmentPlans            InstalmentPlan[]
  invoiceDisputes            InvoiceDispute[]
  financeRefunds             FinanceRefund[]
  billingPlanOverrides       BillingPlanOverride[]
  financePayments            FinancePayment[]
  paymentSessions            PaymentSession[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("units")
}

/// Resident ↔ unit (ADR 0012). Never deleted: ending sets status + ended_at.
/// One active occupancy per (unit, account): partial unique index in SQL.
model UnitOccupancy {
  id              String              @id @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  unitId          String              @map("unit_id") @db.Uuid
  accountId       String              @map("account_id") @db.Uuid
  occupancyType   OccupancyType       @map("occupancy_type")
  status          OccupancyStatus     @default(active)
  /// One per unit among active occupancies (partial unique index in SQL).
  isPrimary       Boolean             @default(false) @map("is_primary")
  startedAt       DateTime            @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime?           @map("ended_at") @db.Timestamptz(3)
  createdById     String              @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Capacity (ADR 0020): an owner who does not live there is a landlord.
  /// A tenant always resides; a landlord is never primary (CHECKs).
  resides         Boolean             @default(true)
  endReason       OccupancyEndReason? @map("end_reason")
  /// Shown to the person; erasable, never in the audit trail.
  endNote         String?             @map("end_note")
  /// Tenant → owner conversion keeps the history as two rows.
  convertedFromId String?             @map("converted_from_id") @db.Uuid
  /// Set while primary; the new primary reviews members added before it.
  primarySince    DateTime?           @map("primary_since") @db.Timestamptz(3)
  /// After leaving: emergency stays visible until the unit is handed over.
  handedOverAt    DateTime?           @map("handed_over_at") @db.Timestamptz(3)

  unit          Unit                   @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  account       Account                @relation("OccupancyAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  createdBy     Account                @relation("OccupancyCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onUpdate: Restrict)
  convertedFrom UnitOccupancy?         @relation("OccupancyConversion", fields: [tenantId, convertedFromId], references: [tenantId, id], onUpdate: Restrict)
  convertedTo   UnitOccupancy[]        @relation("OccupancyConversion")
  registration  ResidentRegistration[]

  neighbourWelcome NeighbourWelcome?
  clubCoverage ClubMembershipPerson[]

  @@unique([tenantId, id])
  @@index([tenantId, accountId])
  @@index([tenantId, unitId])
  @@map("unit_occupancies")
}

/// One row per compound (ADR 0016), created with the compound.
model TenantSettings {
  tenantId                   String   @id @map("tenant_id") @db.Uuid
  familyJoinRequiresApproval Boolean  @default(false) @map("family_join_requires_approval")
  maxHouseholdMembers        Int      @default(10) @map("max_household_members")
  /// IANA time zone for schedules (ADR 0017).
  timezone                   String   @default("Africa/Cairo")
  /// Active visitor passes per unit (ADR 0028).
  maxActiveVisitorPasses     Int      @default(50) @map("max_active_visitor_passes")
  /// How long a household has to answer the gate before its instruction applies.
  gateRequestTimeoutSeconds  Int      @default(180) @map("gate_request_timeout_seconds")
  /// Free text the compound writes for its visitors (the public page, ADR 0030).
  visitorDirections          String?  @map("visitor_directions")
  /// E.164; on the visitor page and the worker card.
  emergencyPhone             String?  @map("emergency_phone")
  /// E.164 (ADR 0047): the community office, in a unit's emergency contacts.
  officePhone                String?  @map("office_phone")
  /// E.164 (ADR 0047): the duty manager; also a staff responder's phone.
  dutyPhone                  String?  @map("duty_phone")
  /// Whether households may write `always_allow` instructions (ADR 0043).
  allowAlwaysAllow           Boolean  @default(true) @map("allow_always_allow")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

/// A unit's household (ADR 0016). Adults have a `family` account and their
/// personal data lives there; minors have no account, so their name and
/// national ID live here (CHECK in SQL). Never deleted: removal is a status.
model HouseholdMember {
  id                    String                @id @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  unitId                String                @map("unit_id") @db.Uuid
  accountId             String?               @map("account_id") @db.Uuid
  relation              HouseholdRelation
  isMinor               Boolean               @map("is_minor")
  fullName              String?               @map("full_name")
  idDocumentNumber      String?               @map("id_document_number")
  idDocumentType        IdDocumentType?       @map("id_document_type")
  nationality           String?               @db.Char(2)
  birthDate             DateTime              @map("birth_date") @db.Date
  status                HouseholdMemberStatus
  addedById             String                @map("added_by") @db.Uuid
  removedById           String?               @map("removed_by") @db.Uuid
  removedReason         String?               @map("removed_reason")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt             DateTime?             @map("removed_at") @db.Timestamptz(3)
  /// The primary confirmed this member's permissions (ADR 0021); earlier
  /// than the primary's `primary_since` means "to review".
  permissionsReviewedAt DateTime?             @map("permissions_reviewed_at") @db.Timestamptz(3)
  /// The sweep told the primary this minor reached 18 (once).
  majorityNotifiedAt    DateTime?             @map("majority_notified_at") @db.Timestamptz(3)

  unit      Unit     @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  account   Account? @relation("MemberAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  addedBy   Account  @relation("MemberAddedBy", fields: [tenantId, addedById], references: [tenantId, id], onUpdate: Restrict)
  removedBy Account? @relation("MemberRemovedBy", fields: [tenantId, removedById], references: [tenantId, id], onUpdate: Restrict)

  grants          HouseholdMemberGrant[]
  majorityInvites HouseholdInvite[]
  deferredActions HouseholdDeferredAction[]
  clubCoverage ClubMembershipPerson[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, isMinor])
  @@index([tenantId, unitId])
  @@index([tenantId, accountId])
  @@map("household_members")
}

/// An invitation for an adult to join a unit's household (ADR 0016). The raw
/// token is shown once to the inviter; only its HMAC is stored.
model HouseholdInvite {
  id                String                @id @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  unitId            String                @map("unit_id") @db.Uuid
  invitedById       String                @map("invited_by") @db.Uuid
  /// Personal fields are NULL only once stripped (the invitee was erased).
  fullName          String?               @map("full_name")
  /// E.164
  phone             String?
  /// trimmed + lowercased; the acceptance code goes here and nowhere else
  email             String?
  idDocumentNumber  String?               @map("id_document_number")
  idDocumentType    IdDocumentType?       @default(national_id) @map("id_document_type")
  nationality       String?               @default("EG") @db.Char(2)
  birthDate         DateTime?             @map("birth_date") @db.Date
  relation          HouseholdRelation
  tokenHash         String                @unique @map("token_hash") @db.Char(64)
  expiresAt         DateTime              @map("expires_at") @db.Timestamptz(3)
  status            HouseholdInviteStatus @default(pending)
  acceptedAccountId String?               @map("accepted_account_id") @db.Uuid
  /// A majority invite: the minor member this invite turns into an adult.
  memberId          String?               @map("member_id") @db.Uuid
  strippedAt        DateTime?             @map("stripped_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  unit            Unit             @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  invitedBy       Account          @relation("InviteInvitedBy", fields: [tenantId, invitedById], references: [tenantId, id], onUpdate: Restrict)
  acceptedAccount Account?         @relation("InviteAcceptedAccount", fields: [tenantId, acceptedAccountId], references: [tenantId, id], onUpdate: Restrict)
  member          HouseholdMember? @relation(fields: [tenantId, memberId], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, unitId])
  @@map("household_invites")
}

/// Primary resident → adult household member, for a limited time and scope
/// (ADR 0016). Ended by revocation or automatically; never deleted.
model HouseholdDelegation {
  id                 String               @id @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  unitId             String               @map("unit_id") @db.Uuid
  delegatorAccountId String               @map("delegator_account_id") @db.Uuid
  delegateAccountId  String               @map("delegate_account_id") @db.Uuid
  scopes             DelegationScope[]
  expiresAt          DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt          DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokedById        String?              @map("revoked_by") @db.Uuid
  endReason          DelegationEndReason? @map("end_reason")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  unit      Unit     @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  delegator Account  @relation("DelegationDelegator", fields: [tenantId, delegatorAccountId], references: [tenantId, id], onUpdate: Restrict)
  delegate  Account  @relation("DelegationDelegate", fields: [tenantId, delegateAccountId], references: [tenantId, id], onUpdate: Restrict)
  revokedBy Account? @relation("DelegationRevokedBy", fields: [tenantId, revokedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, unitId])
  @@index([tenantId, delegateAccountId])
  @@map("household_delegations")
}

/// A domestic worker known to the compound (ADR 0017). No account, no login.
/// One record per person per compound, found by the national-ID HMAC.
model DomesticWorker {
  id                    String         @id @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  /// National ID: HMAC(pepper, "worker-national-id:<id>");
  /// passport: HMAC(pepper, "passport:<nationality>:<number>") (ADR 0018).
  idDocumentHash        String         @map("id_document_hash") @db.Char(64)
  idDocumentNumber      String         @map("id_document_number")
  idDocumentType        IdDocumentType @default(national_id) @map("id_document_type")
  nationality           String         @default("EG") @db.Char(2)
  fullName              String         @map("full_name")
  /// E.164
  phone                 String
  birthDate             DateTime       @map("birth_date") @db.Date
  /// Passport workers: a manager attests the entered birth date once
  /// (ADR 0018). Cleared when the date is corrected.
  birthDateVerifiedById String?        @map("birth_date_verified_by") @db.Uuid
  birthDateVerifiedAt   DateTime?      @map("birth_date_verified_at") @db.Timestamptz(3)
  preferredLanguage     String         @default("ar") @map("preferred_language")
  /// The worker's photo (ADR 0029): a file attached to this record.
  photoFileId           String?        @map("photo_file_id") @db.Uuid
  bannedAt              DateTime?      @map("banned_at") @db.Timestamptz(3)
  bannedById            String?        @map("banned_by") @db.Uuid
  banReason             String?        @map("ban_reason")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  bannedBy            Account?               @relation("WorkerBannedBy", fields: [tenantId, bannedById], references: [tenantId, id], onUpdate: Restrict)
  birthDateVerifiedBy Account?               @relation("WorkerBirthDateVerifiedBy", fields: [tenantId, birthDateVerifiedById], references: [tenantId, id], onUpdate: Restrict)
  photo               StoredFile?            @relation("WorkerPhoto", fields: [tenantId, photoFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  engagements         WorkerEngagement[]
  notices             WorkerNotice[]
  obligations         WorkerWageObligation[]
  complianceCases     WorkerComplianceCase[]
  cardIncidents       WorkerCardIncident[]

  @@unique([tenantId, idDocumentHash])
  @@unique([tenantId, id])
  @@map("domestic_workers")
}

/// A worker serving one unit (ADR 0017). The access code is stored only as
/// an HMAC; it works only while the engagement is `active`.
model WorkerEngagement {
  id                    String                 @id @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  workerId              String                 @map("worker_id") @db.Uuid
  unitId                String                 @map("unit_id") @db.Uuid
  requestedById         String                 @map("requested_by") @db.Uuid
  capacity              WorkerCapacity
  /// { days: (0–6)[], windows: [{ from: "HH:MM", to: "HH:MM" }] }; empty for live-in
  schedule              Json
  validUntil            DateTime?              @map("valid_until") @db.Timestamptz(3)
  status                WorkerEngagementStatus @default(pending_review)
  statusReason          String?                @map("status_reason")
  suspendedByManagement Boolean                @default(false) @map("suspended_by_management")
  /// HMAC(IDENTIFIER_PEPPER, "worker-code:<tenantId>:<code>")
  accessCodeHash        String?                @map("access_code_hash") @db.Char(64)
  /// HMAC(IDENTIFIER_PEPPER, "qr:<tenantId>:<token>"): the card's QR (ADR 0030).
  /// NULL on engagements whose code predates 4.1.
  qrTokenHash           String?                @map("qr_token_hash") @db.Char(64)
  codeIssuedAt          DateTime?              @map("code_issued_at") @db.Timestamptz(3)
  reviewedById          String?                @map("reviewed_by") @db.Uuid
  /// What the household agreed to pay a month (ADR 0037); null until set.
  monthlyWage           Decimal?               @map("monthly_wage") @db.Decimal(10, 2)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  worker          DomesticWorker         @relation(fields: [tenantId, workerId], references: [tenantId, id], onUpdate: Restrict)
  unit            Unit                   @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  requestedBy     Account                @relation("EngagementRequestedBy", fields: [tenantId, requestedById], references: [tenantId, id], onUpdate: Restrict)
  reviewedBy      Account?               @relation("EngagementReviewedBy", fields: [tenantId, reviewedById], references: [tenantId, id], onUpdate: Restrict)
  notices         WorkerNotice[]
  obligations     WorkerWageObligation[]
  cardIncidents   WorkerCardIncident[]
  gateRequests    GateApprovalRequest[]
  visitReceptions TicketVisit[]

  @@unique([tenantId, id])
  @@index([tenantId, unitId])
  @@index([tenantId, workerId])
  @@map("worker_engagements")
}

/// What a worker must be told (ADR 0017). Written in the transaction of the
/// change that causes it; a future SMS/WhatsApp channel sends them.
model WorkerNotice {
  id           String             @id @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  workerId     String             @map("worker_id") @db.Uuid
  engagementId String             @map("engagement_id") @db.Uuid
  noticeKey    String             @map("notice_key")
  params       Json
  status       WorkerNoticeStatus @default(pending)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  worker     DomesticWorker   @relation(fields: [tenantId, workerId], references: [tenantId, id], onUpdate: Restrict)
  engagement WorkerEngagement @relation(fields: [tenantId, engagementId], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, engagementId])
  @@map("worker_notices")
}

/// A reason a unit is under review (ADR 0021). One open row per reason
/// (partial unique index); cleared rows stay as history. Never deleted.
model UnitReviewFlag {
  id              String           @id @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  unitId          String           @map("unit_id") @db.Uuid
  reason          UnitReviewReason
  reasonCode      String?          @map("reason_code")
  /// Managers only: never shown to members, never audited.
  note            String?
  flaggedAt       DateTime         @default(now()) @map("flagged_at") @db.Timestamptz(3)
  flaggedById     String?          @map("flagged_by") @db.Uuid
  clearedAt       DateTime?        @map("cleared_at") @db.Timestamptz(3)
  clearedById     String?          @map("cleared_by") @db.Uuid
  clearReasonCode String?          @map("clear_reason_code")

  unit      Unit     @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  flaggedBy Account? @relation("ReviewFlaggedBy", fields: [tenantId, flaggedById], references: [tenantId, id], onUpdate: Restrict)
  clearedBy Account? @relation("ReviewClearedBy", fields: [tenantId, clearedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, flaggedAt(sort: Desc), id(sort: Desc)])
  @@map("unit_review_flags")
}

/// A wage obligation (ADR 0017, 0022): recorded here, never paid here; a
/// manager closes it (ADR 0037).
model WorkerWageObligation {
  id           String             @id @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  engagementId String             @map("engagement_id") @db.Uuid
  workerId     String             @map("worker_id") @db.Uuid
  kind         WageObligationKind
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt    DateTime?          @map("settled_at") @db.Timestamptz(3)
  settledById  String?            @map("settled_by") @db.Uuid
  /// Why a manager closed it (ADR 0037); set with the two above, or none.
  settleReasonCode String?        @map("settle_reason_code")

  engagement WorkerEngagement @relation(fields: [tenantId, engagementId], references: [tenantId, id], onUpdate: Restrict)
  worker     DomesticWorker   @relation(fields: [tenantId, workerId], references: [tenantId, id], onUpdate: Restrict)
  settledBy  Account?         @relation("WageSettledBy", fields: [tenantId, settledById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, workerId])
  @@map("worker_wage_obligations")
}

/// One month's wage, paid by the household (ADR 0037): recorded, not
/// processed. Append-only, no foreign keys: ids only, like gate_entries.
model WorkerWagePayment {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  engagementId String   @map("engagement_id") @db.Uuid
  workerId     String   @map("worker_id") @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  /// The month paid for: its first day.
  period       DateTime @db.Date
  amount       Decimal  @db.Decimal(10, 2)
  paidById     String   @map("paid_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, engagementId, period], map: "worker_wage_payments_one_per_period")
  @@index([tenantId, engagementId, createdAt, id], map: "worker_wage_payments_engagement_idx")
  @@map("worker_wage_payments")
}

/// A permission a household member holds (ADR 0021). Revoked, never
/// deleted. `member_is_minor` follows the member (ON UPDATE CASCADE) so a
/// CHECK refuses finance to a minor at the database level.
model HouseholdMemberGrant {
  id               String           @id @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  memberId         String           @map("member_id") @db.Uuid
  memberIsMinor    Boolean          @map("member_is_minor")
  permission       MemberPermission
  capPerOperation  Decimal?         @map("cap_per_operation") @db.Decimal(12, 2)
  grantedById      String?          @map("granted_by") @db.Uuid
  grantedAt        DateTime         @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(3)
  revokedById      String?          @map("revoked_by") @db.Uuid
  revokeReasonCode String?          @map("revoke_reason_code")
  /// What the member was told; erasable, never audited.
  revokeNote       String?          @map("revoke_note")

  member    HouseholdMember @relation(fields: [tenantId, memberId, memberIsMinor], references: [tenantId, id, isMinor], onUpdate: Cascade, map: "household_member_grants_member_fkey")
  grantedBy Account?        @relation("GrantGrantedBy", fields: [tenantId, grantedById], references: [tenantId, id], onUpdate: Restrict)
  revokedBy Account?        @relation("GrantRevokedBy", fields: [tenantId, revokedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, memberId])
  @@map("household_member_grants")
}

/// An action a member had started when the permission it needed was
/// revoked: saved, and sent to the primary as a request (05 §7).
model HouseholdDeferredAction {
  id                 String               @id @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  unitId             String               @map("unit_id") @db.Uuid
  memberId           String               @map("member_id") @db.Uuid
  permission         MemberPermission
  payload            Json?
  status             DeferredActionStatus @default(pending)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt          DateTime?            @map("decided_at") @db.Timestamptz(3)
  decidedById        String?              @map("decided_by") @db.Uuid
  decisionReasonCode String?              @map("decision_reason_code")
  decisionNote       String?              @map("decision_note")

  unit      Unit            @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  member    HouseholdMember @relation(fields: [tenantId, memberId], references: [tenantId, id], onUpdate: Restrict)
  decidedBy Account?        @relation("DeferredDecidedBy", fields: [tenantId, decidedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, unitId])
  @@map("household_deferred_actions")
}

/// A compliance file on a worker (ADR 0022): kept in the compliance record,
/// one open per (worker, kind), closed with a reason, never deleted.
model WorkerComplianceCase {
  id              String               @id @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  workerId        String               @map("worker_id") @db.Uuid
  kind            ComplianceCaseKind
  status          ComplianceCaseStatus @default(open)
  source          ComplianceCaseSource
  reasonCode      String?              @map("reason_code")
  note            String?
  openedAt        DateTime             @default(now()) @map("opened_at") @db.Timestamptz(3)
  openedById      String?              @map("opened_by") @db.Uuid
  closedAt        DateTime?            @map("closed_at") @db.Timestamptz(3)
  closedById      String?              @map("closed_by") @db.Uuid
  closeReasonCode String?              @map("close_reason_code")
  closeNote       String?              @map("close_note")

  worker   DomesticWorker @relation(fields: [tenantId, workerId], references: [tenantId, id], onUpdate: Restrict)
  openedBy Account?       @relation("CaseOpenedBy", fields: [tenantId, openedById], references: [tenantId, id], onUpdate: Restrict)
  closedBy Account?       @relation("CaseClosedBy", fields: [tenantId, closedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, openedAt(sort: Desc)])
  @@map("worker_compliance_cases")
}

/// A lost or confiscated card (ADR 0022). Management and security see it;
/// the resident only ever sees that the code was reissued.
model WorkerCardIncident {
  id           String               @id @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  engagementId String               @map("engagement_id") @db.Uuid
  workerId     String               @map("worker_id") @db.Uuid
  type         CardIncidentType
  reportedVia  CardIncidentReporter @map("reported_via")
  reportedById String               @map("reported_by") @db.Uuid
  reportedAt   DateTime             @default(now()) @map("reported_at") @db.Timestamptz(3)
  note         String?
  status       CardIncidentStatus   @default(open)
  closedAt     DateTime?            @map("closed_at") @db.Timestamptz(3)
  closedById   String?              @map("closed_by") @db.Uuid

  engagement WorkerEngagement @relation(fields: [tenantId, engagementId], references: [tenantId, id], onUpdate: Restrict)
  worker     DomesticWorker   @relation(fields: [tenantId, workerId], references: [tenantId, id], onUpdate: Restrict)
  reportedBy Account          @relation("IncidentReportedBy", fields: [tenantId, reportedById], references: [tenantId, id], onUpdate: Restrict)
  closedBy   Account?         @relation("IncidentClosedBy", fields: [tenantId, closedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, reportedAt(sort: Desc)])
  @@map("worker_card_incidents")
}

/// A frozen account (ADR 0023). The released phone's HMAC stays here so the
/// number is never put back on this account. Never deleted.
model AccountFreeze {
  id                String              @id @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  accountId         String              @map("account_id") @db.Uuid
  reason            AccountFreezeReason
  /// The released number's HMAC; only when the phone went to someone else.
  releasedPhoneHash String?             @map("released_phone_hash") @db.Char(64)
  note              String?
  frozenAt          DateTime            @default(now()) @map("frozen_at") @db.Timestamptz(3)
  frozenById        String?             @map("frozen_by") @db.Uuid
  reactivatedAt     DateTime?           @map("reactivated_at") @db.Timestamptz(3)
  reactivatedById   String?             @map("reactivated_by") @db.Uuid

  account       Account  @relation("FreezeAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  frozenBy      Account? @relation("FreezeFrozenBy", fields: [tenantId, frozenById], references: [tenantId, id], onUpdate: Restrict)
  reactivatedBy Account? @relation("FreezeReactivatedBy", fields: [tenantId, reactivatedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, accountId])
  @@map("account_freezes")
}

/// A self-registration request (ADR 0024). Personal data only while
/// pending (CHECK); an account exists only after a manager approves.
model ResidentRegistration {
  id                  String             @id @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  status              RegistrationStatus @default(pending)
  fullName            String?            @map("full_name")
  phone               String?
  email               String?
  idDocumentType      IdDocumentType?    @map("id_document_type")
  idDocumentNumber    String?            @map("id_document_number")
  nationality         String?            @db.Char(2)
  birthDate           DateTime?          @map("birth_date") @db.Date
  preferredLocale     Locale             @default(ar) @map("preferred_locale")
  unitCode            String             @map("unit_code")
  occupancyType       OccupancyType      @map("occupancy_type")
  resides             Boolean            @default(true)
  unitType            UnitType?          @map("unit_type")
  areaSqm             Decimal?           @map("area_sqm") @db.Decimal(8, 2)
  building            String?
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  decidedAt           DateTime?          @map("decided_at") @db.Timestamptz(3)
  decidedById         String?            @map("decided_by") @db.Uuid
  decisionReasonCode  String?            @map("decision_reason_code")
  approvedAccountId   String?            @map("approved_account_id") @db.Uuid
  approvedOccupancyId String?            @map("approved_occupancy_id") @db.Uuid

  decidedBy         Account?       @relation("RegistrationDecidedBy", fields: [tenantId, decidedById], references: [tenantId, id], onUpdate: Restrict)
  approvedAccount   Account?       @relation("RegistrationAccount", fields: [tenantId, approvedAccountId], references: [tenantId, id], onUpdate: Restrict)
  approvedOccupancy UnitOccupancy? @relation(fields: [tenantId, approvedOccupancyId], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, status, createdAt])
  @@map("resident_registrations")
}

/// "Delete my account" (ADR 0023, 0036): undo until `effective_at`; then
/// the sweep erases it, or queues it for the managers when something blocks
/// it. One open (pending or queued) per account. Never deleted.
model AccountDeletionRequest {
  id                String                @id @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  accountId         String                @map("account_id") @db.Uuid
  status            DeletionRequestStatus @default(pending)
  requestedAt       DateTime              @default(now()) @map("requested_at") @db.Timestamptz(3)
  effectiveAt       DateTime              @map("effective_at") @db.Timestamptz(3)
  cancelledAt       DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  completedAt       DateTime?             @map("completed_at") @db.Timestamptz(3)
  completedById     String?               @map("completed_by") @db.Uuid
  overdueNotifiedAt DateTime?             @map("overdue_notified_at") @db.Timestamptz(3)
  /// The account itself, or the manager who filed it for it (ADR 0036).
  requestedById     String                @map("requested_by") @db.Uuid
  assisted          Boolean               @default(false)
  assistReasonCode  String?               @map("assist_reason_code")
  /// The account was told the execution is two days away.
  remindedAt        DateTime?             @map("reminded_at") @db.Timestamptz(3)
  /// Moved to the managers' queue, with what blocked it.
  queuedAt          DateTime?             @map("queued_at") @db.Timestamptz(3)
  blockerCodes      String[]              @default([]) @map("blocker_codes")
  closedAt          DateTime?             @map("closed_at") @db.Timestamptz(3)
  closedById        String?               @map("closed_by") @db.Uuid
  closeReasonCode   String?               @map("close_reason_code")

  account     Account  @relation("DeletionAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  completedBy Account? @relation("DeletionCompletedBy", fields: [tenantId, completedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, status, effectiveAt])
  @@map("account_deletion_requests")
}

/// A legal obligation to keep an account's data (ADR 0023): blocks erasure.
model LegalHold {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  reasonCode        String    @map("reason_code")
  note              String?
  placedAt          DateTime  @default(now()) @map("placed_at") @db.Timestamptz(3)
  placedById        String    @map("placed_by") @db.Uuid
  releasedAt        DateTime? @map("released_at") @db.Timestamptz(3)
  releasedById      String?   @map("released_by") @db.Uuid
  releaseReasonCode String?   @map("release_reason_code")

  account    Account  @relation("HoldAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  placedBy   Account  @relation("HoldPlacedBy", fields: [tenantId, placedById], references: [tenantId, id], onUpdate: Restrict)
  releasedBy Account? @relation("HoldReleasedBy", fields: [tenantId, releasedById], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, accountId])
  @@map("legal_holds")
}

/// The in-app inbox (ADR 0027): one row per recipient, a catalog code and
/// params, never text. Read rows are purged by the retention sweep.
model Notification {
  id         String               @id @db.Uuid
  tenantId   String               @map("tenant_id") @db.Uuid
  accountId  String               @map("account_id") @db.Uuid
  kind       String
  priority   NotificationPriority
  params     Json                 @default("{}")
  targetType String?              @map("target_type")
  targetId   String?              @map("target_id") @db.Uuid
  readAt     DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation("NotificationAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)

  @@index([tenantId, accountId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, targetId])
  @@map("notifications")
}

/// Delivery preference categories (ADR 0036).
enum NotificationCategory {
  maintenance
  gate_visitors
  parcels
  household
  account_security
  /// Management requests and their appointments (ADR 0039).
  management
  /// Important announcements, cancelled events, a suggestion's answer (ADR 0040).
  community
  /// Complaints between units, the boards and masked contact (ADR 0042).
  neighbours
  /// A resident's bookings of the facilities, and the club (ADR 0044).
  bookings
  /// A unit's vehicles, their permits and fines (ADR 0045).
  vehicles
  /// A unit's invoices and payments (ADR 0046).
  finance

  @@map("notification_category")
  /// Emergencies and the services security gives at the gate (ADR 0047).
  safety
}

/// `push`: whether a notification is also pushed to the phone (ADR 0041).
enum DeliveryChannel {
  email
  push

  @@map("delivery_channel")
}

/// An account's quiet hours and pause (ADR 0036). No row: the defaults (no
/// quiet hours, no pause). Locked by every preference change.
model NotificationSettings {
  tenantId           String    @map("tenant_id") @db.Uuid
  accountId          String    @map("account_id") @db.Uuid
  /// Minutes after local midnight in the compound's time zone; both or neither.
  quietStartMinute   Int?      @map("quiet_start_minute") @db.SmallInt
  quietEndMinute     Int?      @map("quiet_end_minute") @db.SmallInt
  /// A timed pause (1 h, 8 h) ends at this instant.
  pausedUntil        DateTime? @map("paused_until") @db.Timestamptz(3)
  /// A pause "until turned back on".
  pausedIndefinitely Boolean   @default(false) @map("paused_indefinitely")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation("NotificationSettingsAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)

  @@id([tenantId, accountId])
  @@map("notification_settings")
}

/// One category × channel switch (ADR 0036). No row: on.
model NotificationChannelPref {
  tenantId  String               @map("tenant_id") @db.Uuid
  accountId String               @map("account_id") @db.Uuid
  category  NotificationCategory
  channel   DeliveryChannel
  enabled   Boolean
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation("ChannelPrefAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)

  @@id([tenantId, accountId, category, channel])
  @@map("notification_channel_prefs")
}

/// Consents (ADR 0036): a grant or a revocation.
enum ConsentAction {
  grant
  revoke

  @@map("consent_action")
}

/// Who wrote a consent event: the account, a manager for it (`assisted`),
/// or the system (an erasure revokes what was granted).
enum ConsentActorType {
  account
  system

  @@map("consent_actor_type")
}

/// Append-only (ADR 0036): every grant and revocation, with the version of
/// the text it answered. SELECT and INSERT only; triggers refuse UPDATE,
/// DELETE and TRUNCATE for every role. No foreign keys, like the histories.
model ConsentEvent {
  id               String           @id @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  accountId        String           @map("account_id") @db.Uuid
  /// CONSENT_CATALOG in src/core/consents/consent-catalog.ts.
  code             String
  version          Int
  action           ConsentAction
  actorType        ConsentActorType @map("actor_type")
  actorAccountId   String?          @map("actor_account_id") @db.Uuid
  /// A manager acted for the account (`residents.assist`), for this reason.
  assisted         Boolean          @default(false)
  assistReasonCode String?          @map("assist_reason_code")
  occurredAt       DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([tenantId, accountId, occurredAt, id])
  @@map("consent_events")
}

/// The current state of each consent (ADR 0036), written with every event
/// and rebuildable from them. Counts only while `granted_version` is the
/// catalog's current version.
model AccountConsent {
  tenantId       String    @map("tenant_id") @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  code           String
  grantedVersion Int?      @map("granted_version")
  grantedAt      DateTime? @map("granted_at") @db.Timestamptz(3)
  lastEventId    String?   @map("last_event_id") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation("ConsentAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)

  @@id([tenantId, accountId, code])
  @@map("account_consents")
}

/// Where an account logs in from (ADR 0036): a device never seen on the
/// account raises an alert. Only a keyed hash and a coarse type: no user
/// agent, no IP. The first device recorded is the baseline and raises none.
enum KnownDeviceSource {
  /// The app's install id (`X-Jiwar-Install-Id`).
  app
  /// A browser: family and OS from the user agent.
  web

  @@map("known_device_source")
}

model KnownDevice {
  id          String            @id @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  accountId   String            @map("account_id") @db.Uuid
  /// IdentifierHasher.hashDevice: bound to the account.
  deviceHash  String            @map("device_hash") @db.Char(64)
  source      KnownDeviceSource
  /// ios, android, desktop_web, mobile_web or unknown.
  deviceType  String            @map("device_type")
  firstSeenAt DateTime          @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// The account said "not me" about it.
  disownedAt  DateTime?         @map("disowned_at") @db.Timestamptz(3)

  account Account @relation("KnownDeviceAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)

  @@unique([tenantId, accountId, deviceHash])
  @@unique([tenantId, id])
  @@map("known_devices")
}

/// A personal-data export (ADR 0036).
enum DataExportStatus {
  pending
  building
  ready
  expired
  failed

  @@map("data_export_status")
}

/// Where a ready export goes: the account's own app, or (assisted) only
/// the account's own email.
enum DataExportDelivery {
  in_app
  email

  @@map("data_export_delivery")
}

/// A personal-data export (ADR 0036): built in the background into the
/// private bucket, downloadable for 7 days, then deleted. One active
/// (pending or building) per account; at most one request a day.
model DataExport {
  id                   String             @id @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  accountId            String             @map("account_id") @db.Uuid
  status               DataExportStatus   @default(pending)
  requestedAt          DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  /// The account itself, or the manager who filed it (assisted).
  requestedByAccountId String             @map("requested_by") @db.Uuid
  assisted             Boolean            @default(false)
  assistReasonCode     String?            @map("assist_reason_code")
  delivery             DataExportDelivery
  attempts             Int                @default(0)
  /// While building: the build's lease.
  lockedUntil          DateTime?          @map("locked_until") @db.Timestamptz(3)
  /// The object being built (`t/<tenant>/<object_id>`): named here until the
  /// file row exists, so it never outlives what names it.
  objectId             String?            @map("object_id") @db.Uuid
  fileId               String?            @map("file_id") @db.Uuid
  readyAt              DateTime?          @map("ready_at") @db.Timestamptz(3)
  expiresAt            DateTime?          @map("expires_at") @db.Timestamptz(3)
  endedAt              DateTime?          @map("ended_at") @db.Timestamptz(3)
  failureCode          String?            @map("failure_code")

  account Account     @relation("DataExportAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)
  file    StoredFile? @relation("DataExportFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, accountId, requestedAt])
  @@index([tenantId, status])
  @@map("data_exports")
}

/// Idempotent writes (ADR 0028): claimed inside the action's transaction;
/// the body is stored after the response and re-rendered from the
/// resource when lost. Purged after `expires_at` (24 h).
model IdempotencyKey {
  tenantId       String   @map("tenant_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  route          String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id") @db.Uuid
  responseStatus Int      @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  account Account @relation("IdempotencyAccount", fields: [tenantId, accountId], references: [tenantId, id], onUpdate: Restrict)

  @@id([tenantId, accountId, key])
  @@index([tenantId, expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// GATE (ADR 0028)
// ============================================================================

/// A gate of the compound. Never deleted: entries point at it.
model Gate {
  id        String     @id @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  name      String
  kind      GateKind
  status    GateStatus @default(active)
  /// E.164 (ADR 0043): the household calls the gate from a request.
  phone     String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  shifts   GuardShift[]
  requests GateApprovalRequest[]
  works    Announcement[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("gates")
}

/// A guard on duty at one gate; at most one open per guard (partial unique
/// index in SQL). Every gate action records its shift.
model GuardShift {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  guardAccountId String    @map("guard_account_id") @db.Uuid
  gateId         String    @map("gate_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  endReason      String?   @map("end_reason")

  guard    Account               @relation("ShiftGuard", fields: [tenantId, guardAccountId], references: [tenantId, id], onUpdate: Restrict)
  gate     Gate                  @relation(fields: [tenantId, gateId], references: [tenantId, id], onUpdate: Restrict)
  requests GateApprovalRequest[]

  @@unique([tenantId, id])
  @@index([tenantId, gateId])
  @@map("guard_shifts")
}

/// A visitor's name and phone (ADR 0028): personal data, deleted by the
/// retention sweep at `expires_at`; what pointed at it stays.
model VisitorDetails {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  fullName  String?  @map("full_name")
  phone     String?
  /// Optional (ADR 0043): letters (Arabic or Latin), digits and spaces.
  vehiclePlate String? @map("vehicle_plate")
  /// Generated by the database from the plate (ADR 0045); never written.
  plateKey     String? @map("plate_key")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  passes   VisitorPass[]
  requests GateApprovalRequest[]

  @@unique([tenantId, id])
  @@index([tenantId, expiresAt])
  @@map("visitor_details")
}

/// A host's pass for visitors (ADR 0028). The code is an HMAC, present only
/// while the pass is active (CHECK); the key makes creation idempotent.
model VisitorPass {
  id               String            @id @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  unitId           String            @map("unit_id") @db.Uuid
  hostAccountId    String            @map("host_account_id") @db.Uuid
  kind             VisitorPassKind
  partySize        Int               @map("party_size")
  validFrom        DateTime          @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime          @map("valid_until") @db.Timestamptz(3)
  /// Recurring passes only: { days, windows } in the compound's time zone.
  schedule         Json?
  status           VisitorPassStatus @default(active)
  codeHash         String?           @map("code_hash") @db.Char(64)
  /// HMAC(IDENTIFIER_PEPPER, "qr:<tenantId>:<token>"); with the code, never
  /// alone (ADR 0030). NULL on passes issued before 4.1.
  qrTokenHash      String?           @map("qr_token_hash") @db.Char(64)
  /// The live token's sequence number (ADR 0043): the token is derived from
  /// VISITOR_PASS_TOKEN_KEY, the pass and this. NULL on passes issued before.
  tokenSeq         Int?              @map("token_seq")
  /// One-time passes (ADR 0043): people who came in; `used` at `partySize`.
  entriesUsed      Int               @default(0) @map("entries_used")
  visitorDetailsId String?           @map("visitor_details_id") @db.Uuid
  usedAt           DateTime?         @map("used_at") @db.Timestamptz(3)
  cancelledAt      DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledById    String?           @map("cancelled_by") @db.Uuid
  cancelReasonCode String?           @map("cancel_reason_code")
  idempotencyKey   String?           @map("idempotency_key")
  requestHash      String?           @map("request_hash")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  unit           Unit            @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  host           Account         @relation("PassHost", fields: [tenantId, hostAccountId], references: [tenantId, id], onUpdate: Restrict)
  cancelledBy    Account?        @relation("PassCancelledBy", fields: [tenantId, cancelledById], references: [tenantId, id], onUpdate: Restrict)
  visitorDetails VisitorDetails? @relation(fields: [tenantId, visitorDetailsId], references: [tenantId, id], onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, hostAccountId, idempotencyKey])
  @@index([tenantId, unitId, createdAt(sort: Desc)])
  @@index([tenantId, hostAccountId, status])
  @@map("visitor_passes")
}

/// A household's standing instructions for the gate (ADR 0028).
model UnitGateInstruction {
  tenantId         String              @map("tenant_id") @db.Uuid
  unitId           String              @map("unit_id") @db.Uuid
  uninvitedVisitor VisitorInstruction  @default(ask) @map("uninvited_visitor")
  delivery         DeliveryInstruction @default(ask)
  updatedById      String              @map("updated_by") @db.Uuid
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit      Unit    @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  updatedBy Account @relation("InstructionsUpdatedBy", fields: [tenantId, updatedById], references: [tenantId, id], onUpdate: Restrict)

  @@id([tenantId, unitId])
  @@map("unit_gate_instructions")
}

/// The gate log (ADR 0028): append-only, like the audit tables. SELECT and
/// INSERT only for jiwar_app; triggers reject UPDATE, DELETE and TRUNCATE.
/// No foreign keys on purpose (see the migration): ids are resolved by the
/// service in its tenant transaction.
/// A household's standing instruction for the gate (ADR 0043): a few words
/// about someone who may come uninvited and what the guard does then.
/// Created and deleted, never updated; the author's erasure deletes it.
model UnitStandingInstruction {
  id          String                    @id @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  unitId      String                    @map("unit_id") @db.Uuid
  /// Personal free text: never audited, never in a notification.
  description String
  action      StandingInstructionAction
  createdById String                    @map("created_by") @db.Uuid
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit    @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "unit_standing_instructions_tenant_id_unit_fkey")
  createdBy Account @relation("StandingInstructionAuthor", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "unit_standing_instructions_tenant_id_created_by_fkey")

  @@unique([tenantId, id])
  @@index([tenantId, unitId, createdAt, id], map: "unit_standing_instructions_unit_idx")
  @@index([tenantId, createdById], map: "unit_standing_instructions_author_idx")
  @@map("unit_standing_instructions")
}

model GateEntry {
  id                String          @id @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  gateId            String          @map("gate_id") @db.Uuid
  shiftId           String?         @map("shift_id") @db.Uuid
  guardAccountId    String?         @map("guard_account_id") @db.Uuid
  subjectType       GateSubjectType @map("subject_type")
  subjectId         String          @map("subject_id") @db.Uuid
  unitId            String          @map("unit_id") @db.Uuid
  direction         GateDirection
  method            GateEntryMethod
  approvalRequestId String?         @map("approval_request_id") @db.Uuid
  occurredAt        DateTime        @map("occurred_at") @db.Timestamptz(3)
  recordedAt        DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(3)
  unconfirmed       Boolean         @default(false)
  /// A pointer: the details are deleted when they expire.
  visitorDetailsId  String?         @map("visitor_details_id") @db.Uuid

  @@index([tenantId, subjectType, subjectId, occurredAt(sort: Desc)], map: "gate_entries_tenant_id_subject_idx")
  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, unitId, occurredAt(sort: Desc)])
  @@map("gate_entries")
}

/// A guard asks a household (ADR 0028). The first decision wins; a deny
/// wins over an approval until the entry; a timeout applies the unit's
/// standing instruction. Never deleted: entries point at it.
model GateApprovalRequest {
  id               String              @id @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  unitId           String              @map("unit_id") @db.Uuid
  gateId           String              @map("gate_id") @db.Uuid
  shiftId          String              @map("shift_id") @db.Uuid
  requestedById    String              @map("requested_by") @db.Uuid
  kind             GateRequestKind
  partySize        Int                 @map("party_size")
  engagementId     String?             @map("engagement_id") @db.Uuid
  visitorDetailsId String?             @map("visitor_details_id") @db.Uuid
  status           GateRequestStatus   @default(pending)
  decidedById      String?             @map("decided_by") @db.Uuid
  decidedAt        DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionSource   GateDecisionSource? @map("decision_source")
  expiresAt        DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The guard's photo of the visitor (ADR 0043); gone 7 days after the decision.
  photoFileId      String?             @map("photo_file_id") @db.Uuid

  unit           Unit              @relation(fields: [tenantId, unitId], references: [tenantId, id], onUpdate: Restrict)
  gate           Gate              @relation(fields: [tenantId, gateId], references: [tenantId, id], onUpdate: Restrict)
  photo          StoredFile?       @relation("GateRequestPhoto", fields: [tenantId, photoFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "gate_approval_requests_tenant_id_photo_file_fkey")
  shift          GuardShift        @relation(fields: [tenantId, shiftId], references: [tenantId, id], onUpdate: Restrict)
  requestedBy    Account           @relation("RequestRequestedBy", fields: [tenantId, requestedById], references: [tenantId, id], onUpdate: Restrict)
  decidedBy      Account?          @relation("RequestDecidedBy", fields: [tenantId, decidedById], references: [tenantId, id], onUpdate: Restrict)
  engagement     WorkerEngagement? @relation(fields: [tenantId, engagementId], references: [tenantId, id], onUpdate: Restrict)
  visitorDetails VisitorDetails?   @relation(fields: [tenantId, visitorDetailsId], references: [tenantId, id], onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, unitId, status])
  @@map("gate_approval_requests")
}

// ============================================================================
// AUDIT (ADR 0014) — immutable: SELECT/INSERT only for jiwar_app, triggers
// reject UPDATE/DELETE/TRUNCATE for every role. No foreign keys on purpose:
// entries must survive anything that happens to what they reference.
// ============================================================================

enum FilePurpose {
  worker_photo
  document
  resident_photo
  ticket_photo
  parcel_photo
  /// A personal-data export's archive (ADR 0036): written by the server.
  data_export
  /// A management request message's attachment (ADR 0039): image or PDF.
  request_attachment
  /// An announcement's, an event's or a "we did" note's attachment (ADR 0040): image or PDF.
  community_attachment
  /// A complaint's evidence (ADR 0042): image or PDF, never a video.
  complaint_evidence
  /// A lost-and-found or lending post's photo (ADR 0042).
  neighbour_post_photo
  gate_request_photo
  /// A vehicle's licence (ADR 0045): image or PDF, the resident's.
  vehicle_licence
  /// A resident's photo of a parking report or a fine's appeal (ADR 0045).
  parking_photo
  /// A vehicle fine's photo (ADR 0045): the staff's.
  vehicle_fine_photo
  /// A suspicious-activity report's photo (ADR 0047), the resident's.
  gate_service_photo
  /// A resident's photo backing an invoice dispute (ADR 0048).
  dispute_photo

  @@map("file_purpose")
}

enum FileStatus {
  pending
  ready

  @@map("file_status")
}

/// An object in the private bucket (ADR 0029), at `t/<tenantId>/<id>`.
/// `pending` until finalize has checked the bytes; a deleted row stays until
/// the sweep has deleted the object. The uploader's file name is not kept.
/// An attached file (a worker's photo) has no owner: its record decides.
model StoredFile {
  id              String      @id @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  ownerAccountId  String?     @map("owner_account_id") @db.Uuid
  purpose         FilePurpose
  contentType     String      @map("content_type")
  sizeBytes       Int         @map("size_bytes")
  status          FileStatus  @default(pending)
  uploadExpiresAt DateTime    @map("upload_expires_at") @db.Timestamptz(3)
  finalizedAt     DateTime?   @map("finalized_at") @db.Timestamptz(3)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)
  attachedAt      DateTime?   @map("attached_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  workers  DomesticWorker[]   @relation("WorkerPhoto")
  accounts Account[]          @relation("AccountPhoto")
  exports  DataExport[]       @relation("DataExportFile")
  tickets  TicketAttachment[] @relation("AttachmentFile")
  parcelPhotos         Parcel[]           @relation("ParcelPhoto")
  gateRequestPhotos    GateApprovalRequest[] @relation("GateRequestPhoto")
  parcelHandoverPhotos Parcel[]           @relation("ParcelHandoverPhoto")
  managementAttachments ManagementRequestAttachment[] @relation("ManagementAttachmentFile")
  announcementAttachments AnnouncementAttachment[] @relation("AnnouncementAttachmentFile")
  eventAttachments EventAttachment[] @relation("EventAttachmentFile")
  suggestionAttachments SuggestionAttachment[] @relation("SuggestionAttachmentFile")
  neighbourComplaintAttachments NeighbourComplaintAttachment[] @relation("NeighbourComplaintAttachmentFile")
  neighbourPostPhotos           NeighbourPostPhoto[]           @relation("NeighbourPostPhotoFile")
  owner    Account?           @relation("FileOwner", fields: [tenantId, ownerAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("files")
}

enum AuditActorType {
  account
  platform_admin
  system

  @@map("audit_actor_type")
}

/// Tenant table (RLS + FORCE). Written in the transaction of the action.
model AuditLog {
  id         String         @id @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  targetType String         @map("target_type")
  targetId   String?        @map("target_id") @db.Uuid
  changes    Json?
  requestId  String?        @map("request_id")
  ip         String?        @db.Inet
  userAgent  String?        @map("user_agent")
  metadata   Json?

  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, actorId])
  @@map("audit_log")
}

/// Global: the platform owner's actions. `target_tenant_id` is a pointer.
model PlatformAuditLog {
  id             String         @id @db.Uuid
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.Uuid
  action         String
  targetType     String         @map("target_type")
  targetId       String?        @map("target_id") @db.Uuid
  targetTenantId String?        @map("target_tenant_id") @db.Uuid
  changes        Json?
  requestId      String?        @map("request_id")
  ip             String?        @db.Inet
  userAgent      String?        @map("user_agent")
  metadata       Json?

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([targetTenantId])
  @@index([targetType, targetId])
  @@map("platform_audit_log")
}

/// Global, fail-open. Never a raw email or phone: only the identifier HMAC.
model SecurityEvent {
  id              String   @id @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  event           String
  identifierHash  String?  @map("identifier_hash") @db.Char(64)
  accountId       String?  @map("account_id") @db.Uuid
  tenantId        String?  @map("tenant_id") @db.Uuid
  platformAdminId String?  @map("platform_admin_id") @db.Uuid
  ip              String?  @db.Inet
  userAgent       String?  @map("user_agent")
  requestId       String?  @map("request_id")
  metadata        Json?

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([event])
  @@index([identifierHash])
  @@map("security_events")
}

/// A phone registered for the rotating entry QR (ADR 0031). The secret is
/// derived from ENTRY_CREDENTIAL_KEY and never stored; there is no last-used
/// time, because a resident's scan leaves no trace. Never deleted.
model EntryCredential {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  /// Personal: kept only while the credential is live (CHECK).
  deviceName   String?   @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// ENTRY_REVOKE_REASONS in src/gate/entry/entry-credentials.service.ts.
  revokeReason String?   @map("revoke_reason")

  account Account @relation("CredentialAccount", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("entry_credentials")
}

// ============================================================================
// MAINTENANCE (ADR 0032)
// ============================================================================

enum TicketPriority {
  normal
  urgent
  emergency

  @@map("ticket_priority")
}

enum TicketStatus {
  new
  assigned
  /// The technician is on the way (ADR 0038); in their hands like assigned.
  en_route
  in_progress
  on_hold
  completed
  closed
  cancelled

  @@map("ticket_status")
}

enum TicketConfirmationStatus {
  pending
  confirmed
  rejected
  auto_closed

  @@map("ticket_confirmation_status")
}

enum TicketHoldReason {
  awaiting_resident
  awaiting_parts
  other

  @@map("ticket_hold_reason")
}

enum TicketAssignmentType {
  manual
  reassignment
  declined
  /// Written by the dispatch engine (ADR 0033), with no actor.
  automatic
  /// A system unassignment: escalated to the queue, or the technician left.
  released

  @@map("ticket_assignment_type")
}

enum TicketAttachmentKind {
  report
  before
  after

  @@map("ticket_attachment_kind")
}

/// What a ticket is for (ADR 0038): something broke, or a check-up booked
/// before something does.
enum TicketKind {
  repair
  preventive

  @@map("ticket_kind")
}

/// Where in the unit (ADR 0038): the room, for whoever comes to fix it.
enum TicketUnitLocation {
  kitchen
  bathroom
  living_room
  bedroom
  balcony
  other

  @@map("ticket_unit_location")
}

enum TicketFeedbackKind {
  confirmed
  rejected
  reopened

  @@map("ticket_feedback_kind")
}

/// The compound's own categories, seeded with five defaults. Never deleted:
/// tickets point at them; `active = false` retires one.
model TicketCategory {
  id                String         @id @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  key               String
  nameAr            String         @map("name_ar")
  nameEn            String         @map("name_en")
  defaultPriority   TicketPriority @default(normal) @map("default_priority")
  commonAreaAllowed Boolean        @default(true) @map("common_area_allowed")
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tickets     Ticket[]
  specialties CategorySpecialty[]
  slaTargets  SlaTarget[]
  preventiveServices PreventiveService[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("ticket_categories")
}

/// What a resident may book a check-up for (ADR 0038): the compound's own
/// list, seeded with four defaults. Never deleted: preventive tickets point
/// at them; `active = false` retires one. The category says who can do it.
model PreventiveService {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  key        String
  nameAr     String   @map("name_ar")
  nameEn     String   @map("name_en")
  categoryId String   @map("category_id") @db.Uuid
  /// The order the residents see; ties by key.
  position   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category TicketCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "preventive_services_tenant_id_category_id_fkey")
  tickets  Ticket[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("preventive_services")
}

/// One row per compound, created with it.
model MaintenanceSettings {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  autoCloseHours   Int      @default(72) @map("auto_close_hours")
  reopenDays       Int      @default(7) @map("reopen_days")
  maxReportPhotos  Int      @default(5) @map("max_report_photos")
  /// Visiting hours (ADR 0038): minutes after local midnight, and the slot.
  visitHoursStart  Int      @default(480) @map("visit_hours_start")
  visitHoursEnd    Int      @default(1080) @map("visit_hours_end")
  visitSlotMinutes Int      @default(60) @map("visit_slot_minutes")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("maintenance_settings")
}

/// The last ticket number of a compound, taken under its row lock.
model TicketCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("ticket_counters")
}

/// A maintenance ticket (ADR 0032): a unit's or a common area's record.
/// Never deleted. `status` is the work, `confirmationStatus` the reporter's
/// verdict on the last completion; CHECKs tie them together.
model Ticket {
  id                 String                    @id @db.Uuid
  tenantId           String                    @map("tenant_id") @db.Uuid
  number             Int
  unitId             String?                   @map("unit_id") @db.Uuid
  /// A short label until common areas have a table. Free text: never in
  /// the audit trail or a notification.
  commonArea         String?                   @map("common_area")
  /// The room (ADR 0038); a unit's ticket only, optional.
  unitLocation       TicketUnitLocation?       @map("unit_location")
  categoryId         String                    @map("category_id") @db.Uuid
  createdById        String                    @map("created_by_account_id") @db.Uuid
  reporterId         String                    @map("reporter_account_id") @db.Uuid
  priority           TicketPriority
  status             TicketStatus              @default(new)
  holdReason         TicketHoldReason?         @map("hold_reason")
  confirmationStatus TicketConfirmationStatus? @map("confirmation_status")
  technicianId       String?                   @map("technician_account_id") @db.Uuid
  cycle              Int                       @default(1)
  rejectionCount     Int                       @default(0) @map("rejection_count")
  /// Free text, may name people: never in the audit trail or a notification.
  /// Null only for a preventive ticket without a note (ADR 0038).
  description        String?
  /// ADR 0038. A preventive ticket names its service and the window the
  /// resident asked for; a trigger refuses any later change to the four.
  kind               TicketKind                @default(repair)
  preventiveServiceId String?                  @map("preventive_service_id") @db.Uuid
  requestedStartsAt  DateTime?                 @map("requested_starts_at") @db.Timestamptz(3)
  requestedEndsAt    DateTime?                 @map("requested_ends_at") @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignedAt         DateTime?                 @map("assigned_at") @db.Timestamptz(3)
  completedAt        DateTime?                 @map("completed_at") @db.Timestamptz(3)
  closedAt           DateTime?                 @map("closed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  /// ADR 0039: the last thing a resident on the ticket could see happen (a
  /// status or cycle change, a non-internal message, a photo). Kept by
  /// triggers; nothing in the app writes it.
  lastActivityAt     DateTime                  @default(now()) @map("last_activity_at") @db.Timestamptz(3)

  unit        Unit?              @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  category    TicketCategory     @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy   Account            @relation("TicketCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tickets_tenant_id_created_by_fkey")
  reporter    Account            @relation("TicketReporter", fields: [tenantId, reporterId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tickets_tenant_id_reporter_fkey")
  technician  Account?           @relation("TicketTechnician", fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tickets_tenant_id_technician_fkey")
  preventiveService PreventiveService? @relation(fields: [tenantId, preventiveServiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "tickets_tenant_id_preventive_service_id_fkey")
  feedback    TicketFeedback[]
  messages    TicketMessage[]
  attachments TicketAttachment[]
  visits      TicketVisit[]
  slaClocks   TicketSlaClock[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt(sort: Desc), id(sort: Desc)], map: "tickets_tenant_id_status_created_at_idx")
  @@index([tenantId, technicianId, status], map: "tickets_tenant_id_technician_idx")
  @@index([tenantId, reporterId], map: "tickets_tenant_id_reporter_idx")
  @@index([tenantId, createdById], map: "tickets_tenant_id_created_by_idx")
  @@index([tenantId, unitId])
  @@index([tenantId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "tickets_tenant_id_last_activity_idx")
  @@map("tickets")
}

/// Append-only (ADR 0032): SELECT and INSERT for jiwar_app, triggers refuse
/// the rest for every role. No foreign keys, like gate_entries.
model TicketStatusHistory {
  id         String        @id @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus  @map("to_status")
  /// NULL for the system (the sweep, an escalation).
  actorId    String?       @map("actor_account_id") @db.Uuid
  /// A reason from a closed list; for a hold, the hold reason.
  reasonCode String?       @map("reason_code")
  cycle      Int
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, ticketId, createdAt, id], map: "ticket_status_history_ticket_idx")
  @@map("ticket_status_history")
}

/// A resident asked for attention on an overdue ticket (ADR 0038): once per
/// SLA cycle. Append-only, like the status history; no foreign keys.
model TicketEscalation {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  /// The SLA's cycle (ADR 0034), not the ticket's.
  slaCycle  Int      @map("sla_cycle")
  accountId String   @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, ticketId, slaCycle], map: "ticket_escalations_once_per_cycle")
  @@map("ticket_escalations")
}

/// Append-only, like the status history. A decline or a release has no `to`.
model TicketAssignment {
  id             String               @id @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  ticketId       String               @map("ticket_id") @db.Uuid
  fromId         String?              @map("from_account_id") @db.Uuid
  toId           String?              @map("to_account_id") @db.Uuid
  /// Who acted: a dispatcher, the technician on a decline, NULL for system.
  assignedById   String?              @map("assigned_by_account_id") @db.Uuid
  assignmentType TicketAssignmentType @map("assignment_type")
  reasonCode     String?              @map("reason_code")
  cycle          Int
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, ticketId, createdAt, id], map: "ticket_assignments_ticket_idx")
  /// What the dispatch engine's tie-break reads (ADR 0033): when a technician
  /// was last given a ticket. The only 5.2 change to a 5.1 table, and only an index.
  @@index([tenantId, toId, createdAt], map: "ticket_assignments_to_account_idx")
  @@map("ticket_assignments")
}

/// The reporter's verdict on a cycle: a confirmation (rating, comment), a
/// rejection or a reopen (a reason code; the note is a message).
model TicketFeedback {
  id                String             @id @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  ticketId          String             @map("ticket_id") @db.Uuid
  cycle             Int
  kind              TicketFeedbackKind
  authorId          String             @map("author_account_id") @db.Uuid
  rating            Int?
  reasonCode        String?            @map("reason_code")
  /// Content: erased with its author, never audited.
  comment           String?
  /// ADR 0038: the technician who did the work, rated on its own; optional.
  technicianRating  Int?               @map("technician_rating")
  ratedTechnicianId String?            @map("rated_technician_account_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket Ticket  @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  author Account @relation("FeedbackAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_feedback_tenant_id_author_fkey")

  @@unique([tenantId, ticketId, cycle, kind])
  @@map("ticket_feedback")
}

/// A ticket's thread. An erasure nulls the body and sets `deletedAt`; the
/// sender stays, pointing at the tombstone.
model TicketMessage {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  ticketId  String    @map("ticket_id") @db.Uuid
  senderId  String    @map("sender_account_id") @db.Uuid
  body      String?
  /// Staff only: never shown to a resident.
  internal  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  ticket Ticket  @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sender Account @relation("MessageSender", fields: [tenantId, senderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_messages_tenant_id_sender_fkey")

  @@index([tenantId, ticketId, createdAt, id], map: "ticket_messages_ticket_idx")
  @@index([tenantId, senderId], map: "ticket_messages_sender_idx")
  @@map("ticket_messages")
}

/// A photo attached to a ticket. The file belongs to the ticket (no owner).
model TicketAttachment {
  id           String               @id @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  ticketId     String               @map("ticket_id") @db.Uuid
  fileId       String               @unique @map("file_id") @db.Uuid
  kind         TicketAttachmentKind
  uploadedById String               @map("uploaded_by_account_id") @db.Uuid
  cycle        Int
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket     Ticket     @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file       StoredFile @relation("AttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy Account    @relation("AttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, ticketId, createdAt, id], map: "ticket_attachments_ticket_idx")
  @@map("ticket_attachments")
}

enum TechnicianAvailabilityState {
  available
  unavailable

  @@map("technician_availability_state")
}

enum DispatchTrigger {
  created
  declined
  available
  manual
  sweep
  role_lost
  released
  /// A manager turned automatic dispatch on: the bounded pass over the queue.
  enabled

  @@map("dispatch_trigger")
}

enum DispatchOutcome {
  assigned
  no_candidate
  skipped

  @@map("dispatch_outcome")
}

/// What a technician can do (ADR 0033): the compound's own data, never
/// deleted; a retired one is `active: false`.
model Specialty {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categories  CategorySpecialty[]
  technicians TechnicianSpecialty[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("specialties")
}

/// Which specialties can handle a category. A category with none can go to
/// any technician.
model CategorySpecialty {
  tenantId    String   @map("tenant_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  specialtyId String   @map("specialty_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  category  TicketCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "category_specialties_tenant_id_category_id_fkey")
  specialty Specialty      @relation(fields: [tenantId, specialtyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "category_specialties_tenant_id_specialty_id_fkey")

  @@id([tenantId, categoryId, specialtyId])
  @@index([tenantId, specialtyId], map: "category_specialties_specialty_idx")
  @@map("category_specialties")
}

/// Set by dispatchers. A row switched off is kept (`active: false`).
model TechnicianSpecialty {
  tenantId    String   @map("tenant_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  specialtyId String   @map("specialty_id") @db.Uuid
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account   Account   @relation("TechnicianSpecialtyAccount", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "technician_specialties_tenant_id_account_id_fkey")
  specialty Specialty @relation(fields: [tenantId, specialtyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "technician_specialties_tenant_id_specialty_id_fkey")

  @@id([tenantId, accountId, specialtyId])
  @@index([tenantId, specialtyId], map: "technician_specialties_specialty_idx")
  @@map("technician_specialties")
}

/// A technician's current state; no row means unavailable (opt-in).
model TechnicianAvailability {
  tenantId  String                      @map("tenant_id") @db.Uuid
  accountId String                      @map("account_id") @db.Uuid
  state     TechnicianAvailabilityState
  changedAt DateTime                    @default(now()) @map("changed_at") @db.Timestamptz(3)

  account Account @relation("TechnicianAvailabilityAccount", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "technician_availability_tenant_id_account_id_fkey")

  @@id([tenantId, accountId])
  @@map("technician_availability")
}

/// Append-only (ADR 0033), like ticket_assignments: SELECT and INSERT for
/// jiwar_app, triggers refuse the rest, no foreign keys.
model TechnicianAvailabilityHistory {
  id          String                       @id @db.Uuid
  tenantId    String                       @map("tenant_id") @db.Uuid
  accountId   String                       @map("account_id") @db.Uuid
  fromState   TechnicianAvailabilityState? @map("from_state")
  toState     TechnicianAvailabilityState  @map("to_state")
  /// The technician, a dispatcher, or NULL for the system.
  changedById String?                      @map("changed_by_account_id") @db.Uuid
  reasonCode  String?                      @map("reason_code")
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, accountId, createdAt, id], map: "technician_availability_history_account_idx")
  @@map("technician_availability_history")
}

/// One row per compound (ADR 0033). Automatic dispatch starts off.
model MaintenanceDispatchSettings {
  tenantId            String   @id @map("tenant_id") @db.Uuid
  autoDispatchEnabled Boolean  @default(false) @map("auto_dispatch_enabled")
  weightAssigned      Decimal  @default(1) @map("weight_assigned") @db.Decimal(5, 2)
  weightInProgress    Decimal  @default(2) @map("weight_in_progress") @db.Decimal(5, 2)
  weightOnHold        Decimal  @default(0) @map("weight_on_hold") @db.Decimal(5, 2)
  multiplierNormal    Decimal  @default(1) @map("multiplier_normal") @db.Decimal(5, 2)
  multiplierUrgent    Decimal  @default(1.5) @map("multiplier_urgent") @db.Decimal(5, 2)
  multiplierEmergency Decimal  @default(3) @map("multiplier_emergency") @db.Decimal(5, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("maintenance_dispatch_settings")
}

/// Every run of the dispatch engine on a ticket (ADR 0033). Append-only,
/// no foreign keys. `notified` marks the row that told the dispatchers the
/// ticket is unassignable: at most one per ticket and cycle.
model TicketDispatchAttempt {
  id             String          @id @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  ticketId       String          @map("ticket_id") @db.Uuid
  cycle          Int
  trigger        DispatchTrigger
  outcome        DispatchOutcome
  candidateCount Int             @map("candidate_count")
  technicianId   String?         @map("technician_account_id") @db.Uuid
  /// Only for `skipped`.
  reasonCode     String?         @map("reason_code")
  notified       Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, ticketId, createdAt, id], map: "ticket_dispatch_attempts_ticket_idx")
  @@map("ticket_dispatch_attempts")
}

// ============================================================================
// Phase 5.3 — visits and the SLA (ADR 0034)
// ============================================================================
enum VisitStatus {
  proposed
  confirmed
  arrived
  done
  no_access
  cancelled
  rescheduled

  @@map("visit_status")
}

/// Which side acted. A dispatcher acts on the technician's side.
enum VisitSide {
  technician
  resident
  system

  @@map("visit_side")
}

enum VisitReceiverKind {
  household
  worker

  @@map("visit_receiver_kind")
}

enum VisitEventKind {
  proposed
  countered
  confirmed
  rescheduled
  cancelled
  consent_granted
  consent_revoked
  consent_voided
  receiver_set
  receiver_cleared
  arrived
  done
  no_access
  late_notified
  /// The residents' side says the technician is really there (ADR 0038).
  arrival_confirmed

  @@map("visit_event_kind")
}

enum SlaClock {
  response
  resolution

  @@map("sla_clock")
}

enum SlaEventKind {
  started
  paused
  resumed
  met
  breached
  retargeted
  stopped

  @@map("sla_event_kind")
}

enum SlaClockState {
  running
  paused
  met
  breached
  stopped

  @@map("sla_clock_state")
}

/// A window in which the technician comes. Its window, consent and receiver
/// tell when a home is empty: never in the audit trail, and notifications
/// carry the window only.
model TicketVisit {
  id                   String             @id @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  ticketId             String             @map("ticket_id") @db.Uuid
  cycle                Int
  technicianId         String             @map("technician_account_id") @db.Uuid
  status               VisitStatus        @default(proposed)
  startsAt             DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime           @map("ends_at") @db.Timestamptz(3)
  proposedBySide       VisitSide          @map("proposed_by_side")
  proposedById         String             @map("proposed_by_account_id") @db.Uuid
  previousVisitId      String?            @map("previous_visit_id") @db.Uuid
  confirmedAt          DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  confirmedById        String?            @map("confirmed_by_account_id") @db.Uuid
  absenceEntryApproved Boolean            @default(false) @map("absence_entry_approved")
  consentById          String?            @map("consent_by_account_id") @db.Uuid
  consentAt            DateTime?          @map("consent_at") @db.Timestamptz(3)
  receiverKind         VisitReceiverKind? @map("receiver_kind")
  receiverAccountId    String?            @map("receiver_account_id") @db.Uuid
  receiverEngagementId String?            @map("receiver_engagement_id") @db.Uuid
  arrivedAt            DateTime?          @map("arrived_at") @db.Timestamptz(3)
  finishedAt           DateTime?          @map("finished_at") @db.Timestamptz(3)
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelReasonCode     String?            @map("cancel_reason_code")
  cancelledBySide      VisitSide?         @map("cancelled_by_side")
  cancelledById        String?            @map("cancelled_by_account_id") @db.Uuid
  lateNotifiedAt       DateTime?          @map("late_notified_at") @db.Timestamptz(3)
  /// The residents' side confirmed the arrival (ADR 0038), once.
  arrivalConfirmedAt   DateTime?          @map("arrival_confirmed_at") @db.Timestamptz(3)
  arrivalConfirmedById String?            @map("arrival_confirmed_by_account_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket             Ticket            @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_visits_tenant_id_ticket_id_fkey")
  technician         Account           @relation("VisitTechnician", fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_visits_tenant_id_technician_fkey")
  receiverAccount    Account?          @relation("VisitReceiver", fields: [tenantId, receiverAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_visits_tenant_id_receiver_account_fkey")
  receiverEngagement WorkerEngagement? @relation(fields: [tenantId, receiverEngagementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_visits_tenant_id_receiver_engagement_fkey")
  previous           TicketVisit?      @relation("VisitPrevious", fields: [tenantId, previousVisitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_visits_tenant_id_previous_fkey")
  next               TicketVisit[]     @relation("VisitPrevious")

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, createdAt, id], map: "ticket_visits_ticket_idx")
  @@map("ticket_visits")
}

/// Append-only: what happened to a visit and who did it. No window times.
model TicketVisitEvent {
  id         String         @id @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  visitId    String         @map("visit_id") @db.Uuid
  ticketId   String         @map("ticket_id") @db.Uuid
  kind       VisitEventKind
  actorSide  VisitSide      @map("actor_side")
  /// NULL for the system.
  actorId    String?        @map("actor_account_id") @db.Uuid
  reasonCode String?        @map("reason_code")
  at         DateTime       @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, ticketId, at, id], map: "ticket_visit_events_ticket_idx")
  @@map("ticket_visit_events")
}

/// One row per compound. Off until the manager turns it on.
model MaintenanceSlaSettings {
  tenantId   String    @id @map("tenant_id") @db.Uuid
  slaEnabled Boolean   @default(false) @map("sla_enabled")
  /// The last activation: an older clock is stopped, never resumed.
  enabledAt  DateTime? @map("enabled_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("maintenance_sla_settings")
}

model SlaTarget {
  tenantId          String         @map("tenant_id") @db.Uuid
  categoryId        String         @map("category_id") @db.Uuid
  priority          TicketPriority
  responseMinutes   Int            @map("response_minutes")
  resolutionMinutes Int            @map("resolution_minutes")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  category TicketCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "sla_targets_tenant_id_category_id_fkey")

  @@id([tenantId, categoryId, priority])
  @@map("sla_targets")
}

/// Append-only. `cycle` is the SLA's own (creation, reopen, activation).
model TicketSlaEvent {
  id            String       @id @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  ticketId      String       @map("ticket_id") @db.Uuid
  cycle         Int
  clock         SlaClock
  seq           Int
  kind          SlaEventKind
  at            DateTime     @db.Timestamptz(3)
  targetMinutes Int          @map("target_minutes")
  reasonCode    String?      @map("reason_code")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, ticketId, cycle, clock, seq], map: "ticket_sla_events_seq_key")
  @@map("ticket_sla_events")
}

/// The projection of ticket_sla_events: rebuildable from them alone.
model TicketSlaClock {
  tenantId      String        @map("tenant_id") @db.Uuid
  ticketId      String        @map("ticket_id") @db.Uuid
  cycle         Int
  clock         SlaClock
  state         SlaClockState
  targetMinutes Int           @map("target_minutes")
  startedAt     DateTime      @map("started_at") @db.Timestamptz(3)
  dueAt         DateTime?     @map("due_at") @db.Timestamptz(3)
  pausedAt      DateTime?     @map("paused_at") @db.Timestamptz(3)
  endedAt       DateTime?     @map("ended_at") @db.Timestamptz(3)
  lastSeq       Int           @map("last_seq")
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ticket_sla_clocks_tenant_id_ticket_id_fkey")

  @@id([tenantId, ticketId, cycle, clock])
  @@map("ticket_sla_clocks")
}

// ============================================================================
// Parcels (ADR 0035)
// ============================================================================

enum ParcelStatus {
  held
  handed_over
  rejected
  returned

  @@map("parcel_status")
}

enum ParcelCarrier {
  aramex
  dhl
  fedex
  ups
  bosta
  mylerz
  egypt_post
  amazon
  noon
  jumia
  talabat
  other

  @@map("parcel_carrier")
}

enum ParcelMethod {
  code
  resident_qr
  delegate

  @@map("parcel_method")
}

enum ParcelEventKind {
  received
  delegate_authorized
  delegate_revoked
  handed_over
  rejected
  returned

  @@map("parcel_event_kind")
}

enum ParcelActorSide {
  guard
  resident
  system

  @@map("parcel_actor_side")
}

enum ParcelCredentialKind {
  holder
  delegate

  @@map("parcel_credential_kind")
}

/// A parcel received at the gate for a unit. `labelName` and the two photos
/// are personal: never in the audit trail or a notification, and cleared 30
/// days after the parcel is handed over or returned. The ids of accounts
/// (guard, recipient) have no foreign key: they name no one.
model Parcel {
  id                   String        @id @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  number               Int
  unitId               String        @map("unit_id") @db.Uuid
  gateId               String        @map("gate_id") @db.Uuid
  shiftId              String        @map("shift_id") @db.Uuid
  receivedById         String        @map("received_by_account_id") @db.Uuid
  carrier              ParcelCarrier
  pieces               Int
  /// The recipient's name as printed on the label. Never shown to a guard
  /// or a manager.
  labelName            String?       @map("label_name")
  photoFileId          String?       @map("photo_file_id") @db.Uuid
  handoverPhotoFileId  String?       @map("handover_photo_file_id") @db.Uuid
  status               ParcelStatus  @default(held)
  receivedAt           DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  handedOverAt         DateTime?     @map("handed_over_at") @db.Timestamptz(3)
  handedOverMethod     ParcelMethod? @map("handed_over_method")
  /// The occupant whose entry QR received it (an id, on this row only).
  handedToId           String?       @map("handed_to_account_id") @db.Uuid
  rejectedAt           DateTime?     @map("rejected_at") @db.Timestamptz(3)
  rejectReason         String?       @map("reject_reason")
  returnedAt           DateTime?     @map("returned_at") @db.Timestamptz(3)
  returnReason         String?       @map("return_reason")
  /// Handover or return: the start of the 30 days of retention.
  closedAt             DateTime?     @map("closed_at") @db.Timestamptz(3)
  remindedAt           DateTime?     @map("reminded_at") @db.Timestamptz(3)
  heldLongAt           DateTime?     @map("held_long_at") @db.Timestamptz(3)
  unclaimableAt        DateTime?     @map("unclaimable_notified_at") @db.Timestamptz(3)
  dataClearedAt        DateTime?     @map("data_cleared_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit          Unit               @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  photo         StoredFile?        @relation("ParcelPhoto", fields: [tenantId, photoFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "parcels_tenant_id_photo_file_fkey")
  handoverPhoto StoredFile?        @relation("ParcelHandoverPhoto", fields: [tenantId, handoverPhotoFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "parcels_tenant_id_handover_photo_file_fkey")
  credentials   ParcelCredential[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status, receivedAt(sort: Desc), id(sort: Desc)], map: "parcels_tenant_id_status_received_at_idx")
  @@index([tenantId, unitId, receivedAt(sort: Desc)], map: "parcels_tenant_id_unit_id_idx")
  @@map("parcels")
}

/// The codes of a parcel: its holder code, and at most one live delegate
/// code. Only HMACs are stored, and only while the credential is live; the
/// token behind them is derived from PARCEL_TOKEN_KEY (ADR 0035).
model ParcelCredential {
  id            String               @id @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  parcelId      String               @map("parcel_id") @db.Uuid
  kind          ParcelCredentialKind
  /// Collision retries: the token is derived from (credential id, attempt).
  attempt       Int                  @default(0)
  codeHash      String?              @map("code_hash") @db.Char(64)
  qrTokenHash   String?              @map("qr_token_hash") @db.Char(64)
  /// A delegate's name: personal, kept only while useful (ADR 0035).
  delegateName  String?              @map("delegate_name")
  /// The guard who received the parcel, or the occupant who authorized
  /// the delegate (an id, no foreign key).
  createdById   String               @map("created_by_account_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  endedAt       DateTime?            @map("ended_at") @db.Timestamptz(3)
  endReason     String?              @map("end_reason")

  parcel Parcel @relation(fields: [tenantId, parcelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, parcelId], map: "parcel_credentials_parcel_idx")
  @@map("parcel_credentials")
}

/// Append-only (ADR 0035): SELECT and INSERT for jiwar_app, triggers refuse
/// the rest for every role. No foreign keys, like gate_entries. No text.
model ParcelEvent {
  id             String          @id @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  parcelId       String          @map("parcel_id") @db.Uuid
  kind           ParcelEventKind
  actorSide      ParcelActorSide @map("actor_side")
  /// NULL for the system (a sweep, a lifecycle hook).
  actorId        String?         @map("actor_account_id") @db.Uuid
  method         ParcelMethod?
  reasonCode     String?         @map("reason_code")
  at             DateTime        @default(now()) @db.Timestamptz(3)

  @@index([tenantId, parcelId, at, id], map: "parcel_events_parcel_idx")
  @@map("parcel_events")
}

/// One row per compound, created with it (like maintenance_settings).
model ParcelSettings {
  tenantId           String   @id @map("tenant_id") @db.Uuid
  parcelReminderDays Int      @default(3) @map("parcel_reminder_days")
  parcelManagerDays  Int      @default(14) @map("parcel_manager_days")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("parcel_settings")
}

/// The last parcel number of a compound, taken under its row lock.
model ParcelCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("parcel_counters")
}

// ============================================================================
// Phase R2 — talking to management (ADR 0039)
//
// A management request is a resident's question, general matter or
// appointment booking, with a conversation between its author and the staff.
// It is private to its author on the resident side. Internal notes are
// staff's alone. Messages, attachments, escalations and ratings never
// change: triggers refuse it for every role, and let through only the
// erasure that clears a message's body or a rating's comment.
// ============================================================================

enum ManagementRequestType {
  question
  general
  appointment

  @@map("management_request_type")
}

enum ManagementRequestStatus {
  open
  in_progress
  answered
  closed

  @@map("management_request_status")
}

enum ManagementSide {
  resident
  staff

  @@map("management_side")
}

enum ManagementActorSide {
  resident
  staff
  system

  @@map("management_actor_side")
}

enum ManagementAppointmentStatus {
  /// The resident's slot, waiting for staff.
  requested
  /// Staff's slot, waiting for the resident.
  proposed
  confirmed
  cancelled
  /// Replaced by a counter-proposal or a new booking.
  superseded

  @@map("management_appointment_status")
}

enum ManagementAppointmentMode {
  in_person
  phone

  @@map("management_appointment_mode")
}

/// A compound's closed list of topics. Never deleted; retired with `active`.
model ManagementRequestTopic {
  id                  String   @id @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  key                 String
  nameAr              String   @map("name_ar")
  nameEn              String   @map("name_en")
  /// The hours management gives itself to answer a request of this topic.
  targetResponseHours Int      @map("target_response_hours")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requests ManagementRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("management_request_topics")
}

/// One row per compound, created with it.
model ManagementRequestSettings {
  tenantId                String   @id @map("tenant_id") @db.Uuid
  /// Days an answered request waits for its author before it closes itself.
  autoCloseDays           Int      @default(7) @map("auto_close_days")
  appointmentSlotMinutes  Int      @default(30) @map("appointment_slot_minutes")
  /// Appointments one slot takes.
  appointmentSlotCapacity Int      @default(1) @map("appointment_slot_capacity")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("management_request_settings")
}

/// A weekly office-hours window: weekday 0 is Sunday, minutes after local
/// midnight. The set is replaced as a whole.
model ManagementOfficeHours {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, weekday, startMinute], map: "management_office_hours_window_key")
  @@map("management_office_hours")
}

/// The last request number of a compound, taken under its row lock.
model ManagementRequestCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("management_request_counters")
}

model ManagementRequest {
  id              String                  @id @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  number          Int
  type            ManagementRequestType
  topicId         String                  @map("topic_id") @db.Uuid
  /// Always the resident, also when staff opened it for them.
  authorId        String                  @map("author_account_id") @db.Uuid
  /// The staff member who opened it on the resident's behalf.
  openedById      String?                 @map("opened_by_account_id") @db.Uuid
  onBehalfReason  String?                 @map("on_behalf_reason")
  unitId          String?                 @map("unit_id") @db.Uuid
  status          ManagementRequestStatus @default(open)
  /// 1 at creation, +1 at every reopening.
  cycle           Int                     @default(1)
  cycleStartedAt  DateTime                @map("cycle_started_at") @db.Timestamptz(3)
  /// The cycle's start plus the topic's target, fixed for the cycle.
  responseDueAt   DateTime                @map("response_due_at") @db.Timestamptz(3)
  /// The cycle's first staff response: stops the response clock.
  firstResponseAt DateTime?               @map("first_response_at") @db.Timestamptz(3)
  /// The cycle was escalated (at most once).
  escalatedAt     DateTime?               @map("escalated_at") @db.Timestamptz(3)
  assigneeId      String?                 @map("assignee_account_id") @db.Uuid
  answeredAt      DateTime?               @map("answered_at") @db.Timestamptz(3)
  closedAt        DateTime?               @map("closed_at") @db.Timestamptz(3)
  closeReason     String?                 @map("close_reason")
  closedBySide    ManagementActorSide?    @map("closed_by_side")
  /// What both lists are ordered by. Internal notes do not move it.
  lastActivityAt  DateTime                @map("last_activity_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  topic        ManagementRequestTopic     @relation(fields: [tenantId, topicId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  author       Account                    @relation("ManagementRequestAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_requests_tenant_id_author_fkey")
  openedBy     Account?                   @relation("ManagementRequestOpenedBy", fields: [tenantId, openedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_requests_tenant_id_opened_by_fkey")
  assignee     Account?                   @relation("ManagementRequestAssignee", fields: [tenantId, assigneeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_requests_tenant_id_assignee_fkey")
  unit         Unit?                      @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  messages     ManagementRequestMessage[]
  rating       ManagementRequestRating?
  appointments ManagementAppointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, authorId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "management_requests_author_activity_idx")
  @@index([tenantId, status, lastActivityAt(sort: Desc), id(sort: Desc)], map: "management_requests_status_activity_idx")
  @@index([tenantId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "management_requests_activity_idx")
  @@map("management_requests")
}

model ManagementRequestMessage {
  id         String         @id @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  requestId  String         @map("request_id") @db.Uuid
  senderId   String         @map("sender_account_id") @db.Uuid
  senderSide ManagementSide @map("sender_side")
  /// A staff note: no resident route returns it or its attachments.
  internal   Boolean        @default(false)
  /// Chosen by staff when sending; makes the request answered.
  official   Boolean        @default(false)
  /// Free text, may name people: never in the audit trail or a
  /// notification. NULL once its sender is erased.
  body       String?
  cycle      Int
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  erasedAt   DateTime?      @map("erased_at") @db.Timestamptz(3)

  request     ManagementRequest             @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sender      Account                       @relation("ManagementMessageSender", fields: [tenantId, senderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_request_messages_tenant_id_sender_fkey")
  attachments ManagementRequestAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, requestId, id], map: "management_request_messages_request_message_key")
  @@index([tenantId, requestId, createdAt, id], map: "management_request_messages_request_idx")
  @@index([tenantId, senderId], map: "management_request_messages_sender_idx")
  @@map("management_request_messages")
}

model ManagementRequestAttachment {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  fileId       String   @unique @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message    ManagementRequestMessage @relation(fields: [tenantId, requestId, messageId], references: [tenantId, requestId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_request_attachments_message_fkey")
  file       StoredFile               @relation("ManagementAttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy Account                  @relation("ManagementAttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_request_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, messageId, createdAt, id], map: "management_request_attachments_message_idx")
  @@map("management_request_attachments")
}

/// Append-only, no foreign keys: one per cycle, written by the sweep.
model ManagementRequestEscalation {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  cycle     Int
  /// The response time that passed.
  dueAt     DateTime @map("due_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, requestId, cycle], map: "management_request_escalations_once_per_cycle")
  @@map("management_request_escalations")
}

/// Once per request, by its author. Shown only to `requests.manage`.
model ManagementRequestRating {
  tenantId  String   @map("tenant_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  authorId  String   @map("author_account_id") @db.Uuid
  rating    Int
  /// Free text: NULL once its author is erased.
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request ManagementRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  author  Account           @relation("ManagementRatingAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_request_ratings_tenant_id_author_fkey")

  @@id([tenantId, requestId])
  @@index([tenantId, authorId], map: "management_request_ratings_author_idx")
  @@map("management_request_ratings")
}

model ManagementAppointment {
  id              String                      @id @db.Uuid
  tenantId        String                      @map("tenant_id") @db.Uuid
  requestId       String                      @map("request_id") @db.Uuid
  status          ManagementAppointmentStatus
  mode            ManagementAppointmentMode
  startsAt        DateTime                    @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime                    @map("ends_at") @db.Timestamptz(3)
  proposedBySide  ManagementSide              @map("proposed_by_side")
  proposedById    String                      @map("proposed_by_account_id") @db.Uuid
  confirmedAt     DateTime?                   @map("confirmed_at") @db.Timestamptz(3)
  /// Cancelled or superseded.
  endedAt         DateTime?                   @map("ended_at") @db.Timestamptz(3)
  cancelReason    String?                     @map("cancel_reason")
  cancelledBySide ManagementActorSide?        @map("cancelled_by_side")
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  request    ManagementRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  proposedBy Account           @relation("ManagementAppointmentProposer", fields: [tenantId, proposedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "management_appointments_tenant_id_proposed_by_fkey")

  @@index([tenantId, status, startsAt, id], map: "management_appointments_status_idx")
  @@index([tenantId, requestId, createdAt, id], map: "management_appointments_request_idx")
  @@map("management_appointments")
}

/// A slot's lock row: a booking locks it, then counts the live appointments
/// on that window. It holds no count.
model ManagementAppointmentSlot {
  tenantId String   @map("tenant_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, startsAt])
  @@map("management_appointment_slots")
}

// ============================================================================
// Community life (ADR 0040): announcements, works and closures, events,
// consultative polls, suggestions. The domain is src/engagement.
// ============================================================================

/// One row per compound, created with it.
model EngagementSettings {
  tenantId       String   @id @map("tenant_id") @db.Uuid
  /// Guests one "going" answer to an event may bring, at most.
  eventMaxGuests Int      @default(2) @map("event_max_guests")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("engagement_settings")
}

/// The compound's closed list of what a suggestion is about. Never deleted;
/// retired with `active`.
model SuggestionTopic {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  suggestions Suggestion[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("suggestion_topics")
}

/// Which capacities a piece of community content is put to (ADR 0040).
enum AudienceOccupancy {
  everyone
  owners
  tenants

  @@map("audience_occupancy")
}

enum AnnouncementKind {
  general
  /// Works and closures: dated, with the area they affect.
  works

  @@map("announcement_kind")
}

enum AnnouncementPriority {
  normal
  important

  @@map("announcement_priority")
}

enum WorksAreaKind {
  road
  facility
  gate

  @@map("works_area_kind")
}

enum ReadMarkKind {
  account
  unit

  @@map("read_mark_kind")
}

/// An announcement (ADR 0040). Never deleted: archived. Draft while
/// `publishAt` is null, scheduled while it is ahead. Its audience is a rule
/// read against today's residents; `audienceBuildings` empty is the whole
/// compound. What it says is its current version's.
model Announcement {
  id                String               @id @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  kind              AnnouncementKind
  priority          AnnouncementPriority @default(normal)
  /// Only an important announcement is pinned (CHECK).
  pinnedUntil       DateTime?            @map("pinned_until") @db.Timestamptz(3)
  publishAt         DateTime?            @map("publish_at") @db.Timestamptz(3)
  /// A general announcement's; works end by their own dates.
  expiresAt         DateTime?            @map("expires_at") @db.Timestamptz(3)
  archivedAt        DateTime?            @map("archived_at") @db.Timestamptz(3)
  audienceBuildings String[]             @default([]) @map("audience_buildings")
  audienceOccupancy AudienceOccupancy    @default(everyone) @map("audience_occupancy")
  currentVersion    Int                  @default(1) @map("current_version")
  /// The last edit made after it was out: what "edited" shows.
  editedAt          DateTime?            @map("edited_at") @db.Timestamptz(3)
  /// When its audience was told (important ones only).
  notifiedAt        DateTime?            @map("notified_at") @db.Timestamptz(3)
  worksStartsAt     DateTime?            @map("works_starts_at") @db.Timestamptz(3)
  worksEndsAt       DateTime?            @map("works_ends_at") @db.Timestamptz(3)
  worksAreaKind     WorksAreaKind?       @map("works_area_kind")
  worksGateId       String?              @map("works_gate_id") @db.Uuid
  worksPlace        String?              @map("works_place")
  createdById       String               @map("created_by_account_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy   Account                  @relation("AnnouncementCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "announcements_tenant_id_created_by_fkey")
  worksGate   Gate?                    @relation(fields: [tenantId, worksGateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  versions    AnnouncementVersion[]
  attachments AnnouncementAttachment[]
  readMarks   AnnouncementReadMark[]

  @@unique([tenantId, id])
  @@index([tenantId, publishAt, id], map: "announcements_feed_idx")
  @@index([tenantId, createdAt, id], map: "announcements_created_idx")
  @@map("announcements")
}

/// What an announcement said, version by version. Append-only.
model AnnouncementVersion {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  version        Int
  titleEn        String?  @map("title_en")
  bodyEn         String?  @map("body_en")
  titleAr        String?  @map("title_ar")
  bodyAr         String?  @map("body_ar")
  /// The attachments this version shows (announcement_attachments ids).
  attachmentIds  String[] @default([]) @map("attachment_ids") @db.Uuid
  editedById     String   @map("edited_by_account_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  announcement Announcement @relation(fields: [tenantId, announcementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  editedBy     Account      @relation("AnnouncementVersionEditor", fields: [tenantId, editedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "announcement_versions_tenant_id_edited_by_fkey")

  @@unique([tenantId, announcementId, version], map: "announcement_versions_announcement_version_key")
  @@map("announcement_versions")
}

/// A file attached to an announcement. Append-only.
model AnnouncementAttachment {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  fileId         String   @unique @map("file_id") @db.Uuid
  uploadedById   String   @map("uploaded_by_account_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  announcement Announcement @relation(fields: [tenantId, announcementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file         StoredFile   @relation("AnnouncementAttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy   Account      @relation("AnnouncementAttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "announcement_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, announcementId, createdAt, id], map: "announcement_attachments_announcement_idx")
  @@map("announcement_attachments")
}

/// Counts an announcement's readers without naming them: `ref` is a keyed
/// hash of the account or the unit. Append-only.
model AnnouncementReadMark {
  tenantId       String       @map("tenant_id") @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  kind           ReadMarkKind
  ref            Bytes

  announcement Announcement @relation(fields: [tenantId, announcementId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, announcementId, kind, ref])
  @@map("announcement_read_marks")
}

enum EventRsvpResponse {
  going
  not_going

  @@map("event_rsvp_response")
}

/// An event of the compound (ADR 0040). Out from the moment it is written;
/// never deleted: cancelled. Its audience is a rule, as an announcement's.
model CommunityEvent {
  id                String            @id @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  titleEn           String?           @map("title_en")
  descriptionEn     String?           @map("description_en")
  titleAr           String?           @map("title_ar")
  descriptionAr     String?           @map("description_ar")
  place             String
  startsAt          DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime          @map("ends_at") @db.Timestamptz(3)
  /// Seats, guests included. Null: no limit.
  capacity          Int?
  audienceBuildings String[]          @default([]) @map("audience_buildings")
  audienceOccupancy AudienceOccupancy @default(everyone) @map("audience_occupancy")
  /// The attachments it shows (event_attachments ids).
  attachmentIds     String[]          @default([]) @map("attachment_ids") @db.Uuid
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  /// A code from the closed list `communityEventCancel`.
  cancelReason      String?           @map("cancel_reason")
  createdById       String            @map("created_by_account_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy   Account           @relation("CommunityEventCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "community_events_tenant_id_created_by_fkey")
  attachments EventAttachment[]
  rsvps       EventRsvp[]

  @@unique([tenantId, id])
  @@index([tenantId, startsAt, id], map: "community_events_starts_idx")
  @@map("community_events")
}

/// A file attached to an event. Append-only.
model EventAttachment {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  fileId       String   @unique @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event      CommunityEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file       StoredFile     @relation("EventAttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy Account        @relation("EventAttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "event_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, eventId, createdAt, id], map: "event_attachments_event_idx")
  @@map("event_attachments")
}

/// One account's answer to an event, changed in place. Seats are counted
/// under the event's row lock: 1 + guests for each "going".
model EventRsvp {
  id        String            @id @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  eventId   String            @map("event_id") @db.Uuid
  accountId String            @map("account_id") @db.Uuid
  unitId    String            @map("unit_id") @db.Uuid
  response  EventRsvpResponse
  guests    Int               @default(0)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  event   CommunityEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account Account        @relation("EventRsvpAccount", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit    Unit           @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, eventId, accountId], map: "event_rsvps_one_per_account")
  @@index([tenantId, eventId, createdAt, id], map: "event_rsvps_list_idx")
  @@index([tenantId, accountId], map: "event_rsvps_account_idx")
  @@map("event_rsvps")
}

/// A consultative poll (ADR 0040): one vote per unit, a secret ballot.
/// `ballotSalt` lives while the poll is neither closed nor cancelled.
model Poll {
  id                String            @id @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  questionEn        String?           @map("question_en")
  questionAr        String?           @map("question_ar")
  /// Several options may be chosen.
  multiple          Boolean           @default(false)
  opensAt           DateTime          @map("opens_at") @db.Timestamptz(3)
  closesAt          DateTime          @map("closes_at") @db.Timestamptz(3)
  audienceBuildings String[]          @default([]) @map("audience_buildings")
  audienceOccupancy AudienceOccupancy @default(everyone) @map("audience_occupancy")
  ballotSalt        Bytes?            @map("ballot_salt")
  closedAt          DateTime?         @map("closed_at") @db.Timestamptz(3)
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  /// Units that voted, written at the close.
  finalTurnout      Int?              @map("final_turnout")
  createdById       String            @map("created_by_account_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      Account             @relation("PollCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "polls_tenant_id_created_by_fkey")
  options        PollOption[]
  ballotBox      PollBallotBox?
  participations PollParticipation[]

  @@unique([tenantId, id])
  @@index([tenantId, closesAt, id], map: "polls_closes_idx")
  @@map("polls")
}

model PollOption {
  id         String  @id @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  pollId     String  @map("poll_id") @db.Uuid
  position   Int
  labelEn    String? @map("label_en")
  labelAr    String? @map("label_ar")
  /// Written once, when the poll closes.
  finalCount Int?    @map("final_count")

  poll Poll @relation(fields: [tenantId, pollId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, pollId, position], map: "poll_options_position_key")
  @@map("poll_options")
}

/// Every ballot of an open poll, in one row: `{ <ballot reference>: [option
/// ids] }`. No unit, no account, no time; deleted when the poll ends.
model PollBallotBox {
  tenantId String @map("tenant_id") @db.Uuid
  pollId   String @map("poll_id") @db.Uuid
  ballots  Json   @default("{}")

  poll Poll @relation(fields: [tenantId, pollId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, pollId])
  @@map("poll_ballot_boxes")
}

/// A unit took part in a closed poll; never what it chose. Written at the
/// close, for all units at once. Append-only.
model PollParticipation {
  tenantId String @map("tenant_id") @db.Uuid
  pollId   String @map("poll_id") @db.Uuid
  unitId   String @map("unit_id") @db.Uuid

  poll Poll @relation(fields: [tenantId, pollId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit Unit @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, pollId, unitId])
  @@map("poll_participations")
}

enum SuggestionStatus {
  received
  under_review
  planned
  done
  declined

  @@map("suggestion_status")
}

/// A resident's suggestion (ADR 0040): private to its author and the
/// staff. `body` is the resident's words; an erasure clears it and nothing
/// else. On the board it is shown by the staff's public summary, never by
/// the body or the author. A trigger keeps the author, topic and words.
model Suggestion {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  authorId          String           @map("author_account_id") @db.Uuid
  unitId            String?          @map("unit_id") @db.Uuid
  topicId           String           @map("topic_id") @db.Uuid
  body              String?
  erasedAt          DateTime?        @map("erased_at") @db.Timestamptz(3)
  status            SuggestionStatus @default(received)
  /// The staff's answer to the author, as it stands now.
  response          String?
  respondedAt       DateTime?        @map("responded_at") @db.Timestamptz(3)
  publishedAt       DateTime?        @map("published_at") @db.Timestamptz(3)
  publicTitleEn     String?          @map("public_title_en")
  publicTextEn      String?          @map("public_text_en")
  publicTitleAr     String?          @map("public_title_ar")
  publicTextAr      String?          @map("public_text_ar")
  doneAt            DateTime?        @map("done_at") @db.Timestamptz(3)
  doneNoteEn        String?          @map("done_note_en")
  doneNoteAr        String?          @map("done_note_ar")
  /// The photos the "we did" note shows (suggestion_attachments ids).
  doneAttachmentIds String[]         @default([]) @map("done_attachment_ids") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author      Account                @relation("SuggestionAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "suggestions_tenant_id_author_fkey")
  unit        Unit?                  @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  topic       SuggestionTopic        @relation(fields: [tenantId, topicId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  updates     SuggestionUpdate[]
  attachments SuggestionAttachment[]
  supports    SuggestionSupport[]

  @@unique([tenantId, id])
  @@index([tenantId, authorId, createdAt, id], map: "suggestions_author_idx")
  @@index([tenantId, createdAt, id], map: "suggestions_created_idx")
  @@index([tenantId, publishedAt, id], map: "suggestions_board_idx")
  @@index([tenantId, doneAt, id], map: "suggestions_done_idx")
  @@map("suggestions")
}

/// Each move and each answer of a suggestion, in the staff's words.
/// Append-only.
model SuggestionUpdate {
  id           String           @id @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  suggestionId String           @map("suggestion_id") @db.Uuid
  status       SuggestionStatus
  response     String?
  byId         String           @map("by_account_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  suggestion Suggestion @relation(fields: [tenantId, suggestionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  by         Account    @relation("SuggestionUpdateBy", fields: [tenantId, byId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "suggestion_updates_tenant_id_by_fkey")

  @@index([tenantId, suggestionId, createdAt, id], map: "suggestion_updates_suggestion_idx")
  @@map("suggestion_updates")
}

/// A photo of what was done. Append-only.
model SuggestionAttachment {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  suggestionId String   @map("suggestion_id") @db.Uuid
  fileId       String   @unique @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  suggestion Suggestion @relation(fields: [tenantId, suggestionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file       StoredFile @relation("SuggestionAttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy Account    @relation("SuggestionAttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "suggestion_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, suggestionId, createdAt, id], map: "suggestion_attachments_suggestion_idx")
  @@map("suggestion_attachments")
}

/// An account supports a published suggestion: one row, deleted to take it
/// back.
model SuggestionSupport {
  tenantId     String @map("tenant_id") @db.Uuid
  suggestionId String @map("suggestion_id") @db.Uuid
  accountId    String @map("account_id") @db.Uuid

  suggestion Suggestion @relation(fields: [tenantId, suggestionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account    Account    @relation("SuggestionSupporter", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, suggestionId, accountId])
  @@index([tenantId, accountId], map: "suggestion_supports_account_idx")
  @@map("suggestion_supports")
}

// ============================================================================
// Neighbours (ADR 0042): complaints between units, lost and found, the
// lending board, masked contact and the welcome. The domain is
// src/neighbours.
// ============================================================================

/// One row per compound, created with it.
model NeighbourSettings {
  tenantId                  String   @id @map("tenant_id") @db.Uuid
  /// Complaints one author may have open at once.
  maxOpenComplaints         Int      @default(5) @map("max_open_complaints")
  /// Days a lost or found post stays on the board.
  lostFoundExpiryDays       Int      @default(30) @map("lost_found_expiry_days")
  /// Days a lending post stays on the board.
  lendingExpiryDays         Int      @default(14) @map("lending_expiry_days")
  /// Posts one author may have on the boards at once.
  maxOpenPosts              Int      @default(5) @map("max_open_posts")
  /// Conversations one account may start in 24 hours.
  maxNewConversationsPerDay Int      @default(10) @map("max_new_conversations_per_day")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("neighbour_settings")
}

/// The compound's closed list of what a complaint against a unit is about.
/// Never deleted; retired with `active`.
model NeighbourComplaintCategory {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  complaints NeighbourComplaint[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("neighbour_complaint_categories")
}

enum NeighbourComplaintStatus {
  submitted
  under_review
  notice_sent
  mediation
  resolved
  dismissed

  @@map("neighbour_complaint_status")
}

/// Whose a complaint message is: the complainant's thread with the staff,
/// the complained-about unit's thread with the staff, or the staff's notes.
enum NeighbourThread {
  complainant
  target
  internal

  @@map("neighbour_thread")
}

enum NeighbourSide {
  resident
  staff

  @@map("neighbour_side")
}

/// Who a notice went to: the household living in the unit, or its owners.
enum NeighbourRecipientKind {
  household
  owners

  @@map("neighbour_recipient_kind")
}

/// One row per compound; its row lock serializes the compound's new
/// complaints.
model NeighbourComplaintCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("neighbour_complaint_counters")
}

/// A complaint against a unit, never a person. No free text of its own:
/// what it says is its first message. Its number, parties and category
/// never change (trigger).
model NeighbourComplaint {
  id             String                   @id @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  /// `NC-000123` to the complainant and the staff; never shown to the unit
  /// complained about.
  number         Int
  authorId       String                   @map("author_account_id") @db.Uuid
  /// One of the author's own units, when they name one.
  authorUnitId   String?                  @map("author_unit_id") @db.Uuid
  /// The unit complained about.
  targetUnitId   String                   @map("target_unit_id") @db.Uuid
  categoryId     String                   @map("category_id") @db.Uuid
  status         NeighbourComplaintStatus @default(submitted)
  closedAt       DateTime?                @map("closed_at") @db.Timestamptz(3)
  closeReason    String?                  @map("close_reason")
  closedBySide   NeighbourSide?           @map("closed_by_side")
  /// What the lists are ordered by. Internal notes and the unit's own
  /// thread do not move it.
  lastActivityAt DateTime                 @map("last_activity_at") @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author     Account                          @relation("NeighbourComplaintAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaints_tenant_id_author_fkey")
  authorUnit Unit?                            @relation("NeighbourComplaintAuthorUnit", fields: [tenantId, authorUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaints_tenant_id_author_unit_fkey")
  targetUnit Unit                             @relation("NeighbourComplaintTargetUnit", fields: [tenantId, targetUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaints_tenant_id_target_unit_fkey")
  category   NeighbourComplaintCategory       @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  history    NeighbourComplaintStatusChange[]
  messages   NeighbourComplaintMessage[]
  notice     NeighbourComplaintNotice?

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, authorId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "neighbour_complaints_author_activity_idx")
  @@index([tenantId, status, lastActivityAt(sort: Desc), id(sort: Desc)], map: "neighbour_complaints_status_activity_idx")
  @@index([tenantId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "neighbour_complaints_activity_idx")
  @@index([tenantId, targetUnitId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "neighbour_complaints_target_unit_idx")
  @@map("neighbour_complaints")
}

/// Every status a complaint has had, in order; the first is its filing.
/// Append-only.
model NeighbourComplaintStatusChange {
  id          String                    @id @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  complaintId String                    @map("complaint_id") @db.Uuid
  fromStatus  NeighbourComplaintStatus? @map("from_status")
  toStatus    NeighbourComplaintStatus  @map("to_status")
  actorId     String                    @map("actor_account_id") @db.Uuid
  actorSide   NeighbourSide             @map("actor_side")
  reasonCode  String?                   @map("reason_code")
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  complaint NeighbourComplaint @relation(fields: [tenantId, complaintId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  actor     Account            @relation("NeighbourComplaintStatusActor", fields: [tenantId, actorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaint_status_history_tenant_id_actor_fkey")

  @@index([tenantId, complaintId, createdAt, id], map: "neighbour_complaint_status_history_complaint_idx")
  @@map("neighbour_complaint_status_history")
}

/// One message in one of a complaint's three threads. Never changes; an
/// erasure clears its body.
model NeighbourComplaintMessage {
  id          String          @id @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  complaintId String          @map("complaint_id") @db.Uuid
  thread      NeighbourThread
  senderId    String          @map("sender_account_id") @db.Uuid
  senderSide  NeighbourSide   @map("sender_side")
  /// Free text, may name people: never in the audit trail or a
  /// notification. NULL once its sender is erased.
  body        String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  erasedAt    DateTime?       @map("erased_at") @db.Timestamptz(3)

  complaint   NeighbourComplaint             @relation(fields: [tenantId, complaintId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sender      Account                        @relation("NeighbourComplaintMessageSender", fields: [tenantId, senderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaint_messages_tenant_id_sender_fkey")
  attachments NeighbourComplaintAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, complaintId, id], map: "neighbour_complaint_messages_complaint_message_key")
  @@index([tenantId, complaintId, thread, createdAt, id], map: "neighbour_complaint_messages_thread_idx")
  @@index([tenantId, senderId], map: "neighbour_complaint_messages_sender_idx")
  @@map("neighbour_complaint_messages")
}

model NeighbourComplaintAttachment {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  complaintId  String   @map("complaint_id") @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  fileId       String   @unique @map("file_id") @db.Uuid
  uploadedById String   @map("uploaded_by_account_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message    NeighbourComplaintMessage @relation(fields: [tenantId, complaintId, messageId], references: [tenantId, complaintId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaint_attachments_message_fkey")
  file       StoredFile                @relation("NeighbourComplaintAttachmentFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy Account                   @relation("NeighbourComplaintAttachmentUploader", fields: [tenantId, uploadedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaint_attachments_tenant_id_uploaded_by_fkey")

  @@index([tenantId, messageId, createdAt, id], map: "neighbour_complaint_attachments_message_idx")
  @@map("neighbour_complaint_attachments")
}

/// The notice to the unit complained about: at most one per complaint, in
/// the staff's words. Append-only.
model NeighbourComplaintNotice {
  id            String                 @id @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  complaintId   String                 @map("complaint_id") @db.Uuid
  /// The staff's text: the only words of the matter the unit ever reads.
  body          String
  recipientKind NeighbourRecipientKind @map("recipient_kind")
  sentById      String                 @map("sent_by_account_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  complaint  NeighbourComplaint                  @relation(fields: [tenantId, complaintId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sentBy     Account                             @relation("NeighbourNoticeSender", fields: [tenantId, sentById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_complaint_notices_tenant_id_sent_by_fkey")
  recipients NeighbourComplaintNoticeRecipient[]

  @@unique([tenantId, id])
  @@unique([tenantId, complaintId], map: "neighbour_complaint_notices_one_per_complaint")
  @@map("neighbour_complaint_notices")
}

/// Who a notice went to, written down when it was sent. Append-only.
model NeighbourComplaintNoticeRecipient {
  tenantId  String @map("tenant_id") @db.Uuid
  noticeId  String @map("notice_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  notice  NeighbourComplaintNotice @relation(fields: [tenantId, noticeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account Account                  @relation("NeighbourNoticeRecipient", fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, noticeId, accountId])
  @@index([tenantId, accountId], map: "neighbour_complaint_notice_recipients_account_idx")
  @@map("neighbour_complaint_notice_recipients")
}

enum NeighbourPostKind {
  lost
  found
  lend
  borrow

  @@map("neighbour_post_kind")
}

enum NeighbourPostStatus {
  open
  closed

  @@map("neighbour_post_status")
}

enum NeighbourClaimStatus {
  pending
  handed_over
  declined
  withdrawn

  @@map("neighbour_claim_status")
}

/// A post on one of the two boards: lost and found (`lost`, `found`), or
/// lending (`lend`, `borrow`). It leaves the board at `expiresAt`, by the
/// reader's clock. Its author, kind and dates never change (trigger).
model NeighbourPost {
  id           String              @id @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  kind         NeighbourPostKind
  authorId     String              @map("author_account_id") @db.Uuid
  authorSide   NeighbourSide       @map("author_side")
  /// The resident author's own unit: only its building is ever shown.
  authorUnitId String?             @map("author_unit_id") @db.Uuid
  /// Free text: never in the audit trail or a notification. NULL once its
  /// author is erased.
  body         String?
  /// Free text, as `body`.
  place        String?
  occurredOn   DateTime?           @map("occurred_on") @db.Date
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(3)
  status       NeighbourPostStatus @default(open)
  closedAt     DateTime?           @map("closed_at") @db.Timestamptz(3)
  closeReason  String?             @map("close_reason")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  erasedAt     DateTime?           @map("erased_at") @db.Timestamptz(3)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author     Account                @relation("NeighbourPostAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_posts_tenant_id_author_fkey")
  authorUnit Unit?                  @relation(fields: [tenantId, authorUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_posts_tenant_id_author_unit_fkey")
  photos     NeighbourPostPhoto[]
  claims     NeighbourItemClaim[]
  handover   NeighbourItemHandover?
  conversations NeighbourConversation[]

  @@unique([tenantId, id])
  @@index([tenantId, status, kind, createdAt(sort: Desc), id(sort: Desc)], map: "neighbour_posts_board_idx")
  @@index([tenantId, authorId, createdAt(sort: Desc), id(sort: Desc)], map: "neighbour_posts_author_idx")
  @@map("neighbour_posts")
}

/// Never updated; deleted only with its file, by an erasure (trigger).
model NeighbourPostPhoto {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  fileId    String   @unique @map("file_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post NeighbourPost @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  file StoredFile    @relation("NeighbourPostPhotoFile", fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, postId, createdAt, id], map: "neighbour_post_photos_post_idx")
  @@map("neighbour_post_photos")
}

/// A resident's claim on a found item held at the office.
model NeighbourItemClaim {
  id            String               @id @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  postId        String               @map("post_id") @db.Uuid
  claimantId    String               @map("claimant_account_id") @db.Uuid
  /// Free text for the staff: NULL once its claimant is erased.
  note          String?
  status        NeighbourClaimStatus @default(pending)
  declineReason String?              @map("decline_reason")
  decidedAt     DateTime?            @map("decided_at") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  post     NeighbourPost          @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  claimant Account                @relation("NeighbourClaimant", fields: [tenantId, claimantId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_item_claims_tenant_id_claimant_fkey")
  handover NeighbourItemHandover?

  @@unique([tenantId, id])
  @@index([tenantId, postId, createdAt, id], map: "neighbour_item_claims_post_idx")
  @@index([tenantId, claimantId, createdAt(sort: Desc), id(sort: Desc)], map: "neighbour_item_claims_claimant_idx")
  @@map("neighbour_item_claims")
}

/// A found item handed over at the office: to whom, by whom, when.
/// Append-only.
model NeighbourItemHandover {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  /// The claim it settled; none for someone who came without one.
  claimId     String?  @map("claim_id") @db.Uuid
  recipientId String   @map("recipient_account_id") @db.Uuid
  handedById  String   @map("handed_by_account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post      NeighbourPost       @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  claim     NeighbourItemClaim? @relation(fields: [tenantId, claimId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  recipient Account             @relation("NeighbourHandoverRecipient", fields: [tenantId, recipientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_item_handovers_tenant_id_recipient_fkey")
  handedBy  Account             @relation("NeighbourHandoverStaff", fields: [tenantId, handedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_item_handovers_tenant_id_handed_by_fkey")

  @@unique([tenantId, postId], map: "neighbour_item_handovers_one_per_post")
  @@unique([tenantId, claimId], map: "neighbour_item_handovers_claim_id_key")
  @@map("neighbour_item_handovers")
}

enum NeighbourReportStatus {
  open
  closed

  @@map("neighbour_report_status")
}

/// A masked conversation on a board post, between the post's author and
/// one responder. Names show only when both `*RevealAt` are set. Its
/// parties never change (trigger).
model NeighbourConversation {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  postId           String    @map("post_id") @db.Uuid
  /// The post's author.
  authorId         String    @map("author_account_id") @db.Uuid
  responderId      String    @map("responder_account_id") @db.Uuid
  /// The responder's own unit: only its building is ever shown.
  responderUnitId  String?   @map("responder_unit_id") @db.Uuid
  authorRevealAt   DateTime? @map("author_reveal_at") @db.Timestamptz(3)
  responderRevealAt DateTime? @map("responder_reveal_at") @db.Timestamptz(3)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  /// Never shown to a participant: both read the same "closed".
  closeReason      String?   @map("close_reason")
  lastMessageAt    DateTime  @map("last_message_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  post          NeighbourPost                  @relation(fields: [tenantId, postId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  author        Account                        @relation("NeighbourConversationAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversations_tenant_id_author_fkey")
  responder     Account                        @relation("NeighbourConversationResponder", fields: [tenantId, responderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversations_tenant_id_responder_fkey")
  responderUnit Unit?                          @relation(fields: [tenantId, responderUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversations_tenant_id_responder_unit_fkey")
  messages      NeighbourConversationMessage[]
  blocks        NeighbourBlock[]
  reports       NeighbourConversationReport[]

  @@unique([tenantId, id])
  @@unique([tenantId, postId, responderId], map: "neighbour_conversations_one_per_responder")
  @@index([tenantId, authorId, lastMessageAt(sort: Desc), id(sort: Desc)], map: "neighbour_conversations_author_idx")
  @@index([tenantId, responderId, lastMessageAt(sort: Desc), id(sort: Desc)], map: "neighbour_conversations_responder_idx")
  @@index([tenantId, responderId, createdAt], map: "neighbour_conversations_started_idx")
  @@map("neighbour_conversations")
}

/// Text only. Never changes; an erasure clears its body.
model NeighbourConversationMessage {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_account_id") @db.Uuid
  /// Free text between two residents: read by the staff only through an
  /// open report. NULL once its sender is erased.
  body           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  erasedAt       DateTime? @map("erased_at") @db.Timestamptz(3)

  conversation NeighbourConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sender       Account               @relation("NeighbourConversationMessageSender", fields: [tenantId, senderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversation_messages_tenant_id_sender_fkey")

  @@index([tenantId, conversationId, createdAt, id], map: "neighbour_conversation_messages_conversation_idx")
  @@index([tenantId, senderId], map: "neighbour_conversation_messages_sender_idx")
  @@map("neighbour_conversation_messages")
}

/// One account keeps another away. Deleted to undo it.
model NeighbourBlock {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  blockerId      String   @map("blocker_account_id") @db.Uuid
  blockedId      String   @map("blocked_account_id") @db.Uuid
  /// Where it was made: the label on the blocker's list comes from it.
  conversationId String   @map("conversation_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker      Account               @relation("NeighbourBlocker", fields: [tenantId, blockerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_blocks_tenant_id_blocker_fkey")
  blocked      Account               @relation("NeighbourBlocked", fields: [tenantId, blockedId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_blocks_tenant_id_blocked_fkey")
  conversation NeighbourConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, blockerId, blockedId], map: "neighbour_blocks_one_per_pair")
  @@index([tenantId, blockedId], map: "neighbour_blocks_blocked_idx")
  @@map("neighbour_blocks")
}

/// A participant asks the staff to look at one conversation.
model NeighbourConversationReport {
  id             String                @id @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  reporterId     String                @map("reporter_account_id") @db.Uuid
  reasonCode     String                @map("reason_code")
  /// Free text for the staff: NULL once its reporter is erased.
  note           String?
  status         NeighbourReportStatus @default(open)
  outcome        String?
  closedById     String?               @map("closed_by_account_id") @db.Uuid
  closedAt       DateTime?             @map("closed_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation NeighbourConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reporter     Account               @relation("NeighbourReporter", fields: [tenantId, reporterId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversation_reports_tenant_id_reporter_fkey")
  closedBy     Account?              @relation("NeighbourReportCloser", fields: [tenantId, closedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "neighbour_conversation_reports_tenant_id_closed_by_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, conversationId, reporterId], map: "neighbour_conversation_reports_one_per_reporter")
  @@index([tenantId, status, createdAt(sort: Desc), id(sort: Desc)], map: "neighbour_conversation_reports_status_idx")
  @@map("neighbour_conversation_reports")
}

/// The compound's welcome text: one row per compound, created with it. A
/// language is whole or absent.
model NeighbourWelcomeTemplate {
  tenantId      String   @id @map("tenant_id") @db.Uuid
  /// Off: no household is greeted.
  enabled       Boolean  @default(true)
  rulesEn       String?  @map("rules_en")
  officeHoursEn String?  @map("office_hours_en")
  emergencyEn   String?  @map("emergency_en")
  rulesAr       String?  @map("rules_ar")
  officeHoursAr String?  @map("office_hours_ar")
  emergencyAr   String?  @map("emergency_ar")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("neighbour_welcome_templates")
}

/// A welcome sent to a household's primary: once per household.
/// Append-only.
model NeighbourWelcome {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// The occupancy that began as its unit's primary: the household.
  occupancyId String   @map("occupancy_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  occupancy UnitOccupancy @relation(fields: [tenantId, occupancyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit          @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account   Account       @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, occupancyId], map: "neighbour_welcomes_once_per_household")
  @@index([tenantId, accountId], map: "neighbour_welcomes_account_idx")
  @@map("neighbour_welcomes")
}

// ============================================================================
// Facilities and bookings, the club (ADR 0044). The domain is src/facilities.
// ============================================================================

enum FacilityMode {
  /// Courts, the hall, the barbecue area: slots, capacity, bookings.
  bookable
  /// The pool, the gym: what it is and when it is open, no booking.
  walk_in

  @@map("facility_mode")
}

enum FacilityCapacityUnit {
  /// A slot takes so many bookings (a court: one).
  bookings
  /// A slot takes so many people, each booking its booker and guests.
  people

  @@map("facility_capacity_unit")
}

/// One of the compound's facilities. Never deleted (bookings point at it);
/// retired with `active`. Its mode never changes (trigger). The rules are
/// set exactly when it is bookable (CHECK facilities_rules_shape).
model Facility {
  id                  String                @id @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  mode                FacilityMode
  nameEn              String                @map("name_en")
  nameAr              String                @map("name_ar")
  descriptionEn       String?               @map("description_en")
  descriptionAr       String?               @map("description_ar")
  active              Boolean               @default(true)
  /// The order the compound lists its facilities in.
  position            Int                   @default(0)
  slotMinutes         Int?                  @map("slot_minutes")
  capacity            Int?
  capacityUnit        FacilityCapacityUnit? @map("capacity_unit")
  maxDaysAhead        Int?                  @map("max_days_ahead")
  minMinutesBefore    Int?                  @map("min_minutes_before")
  cancelCutoffMinutes Int?                  @map("cancel_cutoff_minutes")
  maxGuests           Int?                  @map("max_guests")
  requiresApproval    Boolean               @default(false) @map("requires_approval")
  requiresMembership  Boolean               @default(false) @map("requires_membership")
  weeklyQuota         Int?                  @map("weekly_quota")
  peakQuota           Int?                  @map("peak_quota")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  hours       FacilityHours[]
  peakWindows FacilityPeakWindow[]
  slotLocks   FacilitySlotLock[]
  bookings    Booking[]
  closures    FacilityClosure[]

  @@unique([tenantId, id])
  @@index([tenantId, position, id], map: "facilities_position_idx")
  @@map("facilities")
}

/// A facility's opening hours: weekly windows in the compound's time zone
/// (weekday 0 is Sunday; minutes after local midnight), replaced as a whole
/// under the facility's row lock.
model FacilityHours {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  facilityId  String @map("facility_id") @db.Uuid
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, facilityId, weekday, startMinute], map: "facility_hours_window_key")
  @@map("facility_hours")
}

/// A bookable facility's peak times, inside its hours: a slot that
/// overlaps one is a peak slot, with its own quota.
model FacilityPeakWindow {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  facilityId  String @map("facility_id") @db.Uuid
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, facilityId, weekday, startMinute], map: "facility_peak_windows_window_key")
  @@map("facility_peak_windows")
}

/// A slot's lock row: a booking locks it, then counts what holds the
/// slot's window. It holds no count. One row per slot ever booked.
model FacilitySlotLock {
  tenantId   String   @map("tenant_id") @db.Uuid
  facilityId String   @map("facility_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)

  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, facilityId, startsAt])
  @@map("facility_slot_locks")
}

enum BookingStatus {
  /// Waits for the management's approval (a facility that requires it).
  pending
  confirmed
  rejected
  cancelled
  /// Confirmed, and nobody came: marked by the staff after the slot.
  no_show

  @@map("booking_status")
}

enum BookingSide {
  resident
  staff
  system

  @@map("booking_side")
}

/// A unit's booking of a facility's slot (ADR 0044), made by one of its
/// people. Its facility, unit, booker, times and party never change
/// (trigger); it is never deleted. An erased booker stays as the tombstone.
model Booking {
  id                String         @id @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  facilityId        String         @map("facility_id") @db.Uuid
  unitId            String         @map("unit_id") @db.Uuid
  bookedById        String         @map("booked_by_account_id") @db.Uuid
  startsAt          DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime       @map("ends_at") @db.Timestamptz(3)
  guests            Int
  /// The booker and their guests: what the booking takes of a slot counted in people.
  partySize         Int            @map("party_size")
  /// The slot overlapped a peak time when it was booked.
  peak              Boolean
  status            BookingStatus
  /// Approved or rejected by the staff; null for a booking confirmed at once.
  decidedById       String?        @map("decided_by_account_id") @db.Uuid
  decidedAt         DateTime?      @map("decided_at") @db.Timestamptz(3)
  rejectReason      String?        @map("reject_reason")
  cancelledSide     BookingSide?   @map("cancelled_side")
  cancelReason      String?        @map("cancel_reason")
  /// Null when the system cancelled it.
  cancelledById     String?        @map("cancelled_by_account_id") @db.Uuid
  cancelledAt       DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  noShowMarkedById  String?        @map("no_show_marked_by_account_id") @db.Uuid
  noShowMarkedAt    DateTime?      @map("no_show_marked_at") @db.Timestamptz(3)
  /// The reminder before the slot was sent (once).
  remindedAt        DateTime?      @map("reminded_at") @db.Timestamptz(3)
  /// The closure that cancelled it.
  closureId         String?        @map("closure_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  facility    Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  unit        Unit     @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  bookedBy    Account  @relation("BookingBooker", fields: [tenantId, bookedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_tenant_id_booked_by_fkey")
  decidedBy   Account? @relation("BookingDecider", fields: [tenantId, decidedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_tenant_id_decided_by_fkey")
  cancelledBy Account? @relation("BookingCanceller", fields: [tenantId, cancelledById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_tenant_id_cancelled_by_fkey")
  noShowBy    Account? @relation("BookingNoShowMarker", fields: [tenantId, noShowMarkedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_tenant_id_no_show_by_fkey")
  closure     FacilityClosure? @relation(fields: [tenantId, closureId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "bookings_tenant_id_closure_id_fkey")
  suspension  BookingSuspension?

  @@unique([tenantId, id])
  @@index([tenantId, unitId, startsAt, id], map: "bookings_unit_idx")
  @@index([tenantId, bookedById, startsAt, id], map: "bookings_booker_idx")
  @@index([tenantId, facilityId, startsAt, id], map: "bookings_facility_idx")
  @@index([tenantId, status, startsAt, id], map: "bookings_status_idx")
  @@map("bookings")
}

/// A facility closed for a time, with a reason code (ADR 0044). Creating
/// one cancels the future bookings it overlaps. Only lifting it changes it,
/// once (trigger); it is never deleted. Lifting restores nothing.
model FacilityClosure {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  facilityId     String    @map("facility_id") @db.Uuid
  startsAt       DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime  @map("ends_at") @db.Timestamptz(3)
  reasonCode     String    @map("reason_code")
  createdById    String    @map("created_by_account_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  liftedAt       DateTime? @map("lifted_at") @db.Timestamptz(3)
  liftedById     String?   @map("lifted_by_account_id") @db.Uuid
  liftReasonCode String?   @map("lift_reason_code")

  facility  Facility  @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy Account   @relation("FacilityClosureCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "facility_closures_tenant_id_created_by_fkey")
  liftedBy  Account?  @relation("FacilityClosureLifter", fields: [tenantId, liftedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "facility_closures_tenant_id_lifted_by_fkey")
  bookings  Booking[]

  @@unique([tenantId, id])
  @@index([tenantId, facilityId, startsAt, id], map: "facility_closures_facility_idx")
  @@map("facility_closures")
}

/// The compound's no-show rules (ADR 0044): one row per compound.
model FacilitySettings {
  tenantId          String   @id @map("tenant_id") @db.Uuid
  noShowThreshold   Int      @default(3) @map("no_show_threshold")
  noShowWindowDays  Int      @default(30) @map("no_show_window_days")
  suspensionDays    Int      @default(14) @map("suspension_days")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("facility_settings")
}

/// A unit suspended from booking after too many no-shows (ADR 0044). In
/// force while not lifted and not over. Only the lift changes it, once.
model BookingSuspension {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  unitId           String    @map("unit_id") @db.Uuid
  startsAt         DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime  @map("ends_at") @db.Timestamptz(3)
  /// The no-show that reached the threshold.
  triggerBookingId String    @map("trigger_booking_id") @db.Uuid
  noShowCount      Int       @map("no_show_count")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  liftedAt         DateTime? @map("lifted_at") @db.Timestamptz(3)
  liftedById       String?   @map("lifted_by_account_id") @db.Uuid
  liftReasonCode   String?   @map("lift_reason_code")

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit           Unit     @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  triggerBooking Booking  @relation(fields: [tenantId, triggerBookingId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "booking_suspensions_tenant_id_trigger_booking_id_fkey")
  liftedBy       Account? @relation("BookingSuspensionLifter", fields: [tenantId, liftedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "booking_suspensions_tenant_id_lifted_by_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, triggerBookingId], map: "booking_suspensions_trigger_booking_id_key")
  @@index([tenantId, unitId, startsAt, id], map: "booking_suspensions_unit_idx")
  @@index([tenantId, startsAt, id], map: "booking_suspensions_starts_idx")
  @@map("booking_suspensions")
}

// ----------------------------------------------------------------------------
// The club (ADR 0044): plans, a unit's membership and who it covers, and
// the payments made at the office that keep it.
// ----------------------------------------------------------------------------

enum ClubDurationKind {
  monthly
  quarterly
  annual
  /// `duration_days` days.
  custom

  @@map("club_duration_kind")
}

enum ClubPaymentKind {
  payment
  reversal

  @@map("club_payment_kind")
}

/// A plan the management offers. Never deleted; retired with `active`.
model ClubPlan {
  id           String           @id @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  nameEn       String           @map("name_en")
  nameAr       String           @map("name_ar")
  durationKind ClubDurationKind @map("duration_kind")
  durationDays Int?             @map("duration_days")
  /// What the plan costs, in EGP: shown, not enforced.
  price        Decimal          @db.Decimal(10, 2)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payments ClubPaymentRecord[]

  @@unique([tenantId, id])
  @@map("club_plans")
}

/// A unit's membership: one per unit, created on its first use. Its rows
/// of payments say when it is active; its people, whom it covers.
model ClubMembership {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  createdById String   @map("created_by_account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit      Unit                   @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy Account                @relation("ClubMembershipCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_memberships_tenant_id_created_by_fkey")
  people    ClubMembershipPerson[]
  payments  ClubPaymentRecord[]
  reminders ClubExpiryReminder[]

  @@unique([tenantId, id])
  @@unique([tenantId, unitId], map: "club_memberships_one_per_unit")
  @@map("club_memberships")
}

/// Someone a membership covers: one of the unit's occupancies or household
/// members (a minor too). Added, and later removed; never deleted. Covered
/// only while that occupancy or membership of the household is active.
model ClubMembershipPerson {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  membershipId      String    @map("membership_id") @db.Uuid
  occupancyId       String?   @map("occupancy_id") @db.Uuid
  householdMemberId String?   @map("household_member_id") @db.Uuid
  addedById         String    @map("added_by_account_id") @db.Uuid
  addedAt           DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  removedAt         DateTime? @map("removed_at") @db.Timestamptz(3)
  removedById       String?   @map("removed_by_account_id") @db.Uuid

  membership ClubMembership   @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  occupancy  UnitOccupancy?   @relation(fields: [tenantId, occupancyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_membership_people_tenant_id_occupancy_id_fkey")
  member     HouseholdMember? @relation(fields: [tenantId, householdMemberId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_membership_people_tenant_id_household_member_id_fkey")
  addedBy    Account          @relation("ClubPersonAdder", fields: [tenantId, addedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_membership_people_tenant_id_added_by_fkey")
  removedBy  Account?         @relation("ClubPersonRemover", fields: [tenantId, removedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_membership_people_tenant_id_removed_by_fkey")

  @@index([tenantId, membershipId, addedAt, id], map: "club_membership_people_membership_idx")
  @@map("club_membership_people")
}

/// A payment made at the office, or the reversal of one (ADR 0044).
/// Append-only: a wrong record is reversed by a new one, never edited.
model ClubPaymentRecord {
  id             String          @id @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  membershipId   String          @map("membership_id") @db.Uuid
  kind           ClubPaymentKind
  planId         String?         @map("plan_id") @db.Uuid
  amount         Decimal?        @db.Decimal(10, 2)
  currency       String?
  receiptNumber  String?         @map("receipt_number")
  paidOn         DateTime?       @map("paid_on") @db.Date
  /// The local days it pays for, the end excluded.
  periodStartsOn DateTime?       @map("period_starts_on") @db.Date
  periodEndsOn   DateTime?       @map("period_ends_on") @db.Date
  reversesId     String?         @map("reverses_id") @db.Uuid
  reasonCode     String?         @map("reason_code")
  recordedById   String          @map("recorded_by_account_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  membership ClubMembership     @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  plan       ClubPlan?          @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_payment_records_tenant_id_plan_id_fkey")
  reverses   ClubPaymentRecord? @relation("ClubReversal", fields: [tenantId, reversesId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_payment_records_tenant_id_reverses_id_fkey")
  reversedBy ClubPaymentRecord? @relation("ClubReversal")
  recordedBy Account            @relation("ClubPaymentRecorder", fields: [tenantId, recordedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "club_payment_records_tenant_id_recorded_by_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, reversesId], map: "club_payment_records_one_reversal")
  @@index([tenantId, membershipId, createdAt, id], map: "club_payment_records_membership_idx")
  @@map("club_payment_records")
}

/// A membership's reminder before it ends: once per end date. Append-only.
model ClubExpiryReminder {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  endsOn       DateTime @map("ends_on") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership ClubMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, membershipId, endsOn], map: "club_expiry_reminders_once")
  @@map("club_expiry_reminders")
}

// ============================================================================
// Phase G2 — vehicles and parking (ADR 0045)
// ============================================================================

enum VehicleType {
  car
  motorcycle
  van

  @@map("vehicle_type")
}

/// A vehicle's own state. `expires_soon` and `expired` are read from
/// `permitValidUntil`, never stored.
enum VehicleStatus {
  pending
  active
  rejected
  removed

  @@map("vehicle_status")
}

enum VehicleRemovalSide {
  resident
  staff
  system

  @@map("vehicle_removal_side")
}

enum VehicleCounterKind {
  vehicle
  parking_booking
  fine
  parking_report

  @@map("vehicle_counter_kind")
}

/// A compound's vehicle and parking settings: one row, created with it.
model VehicleSettings {
  tenantId                        String   @id @map("tenant_id") @db.Uuid
  maxVehiclesPerUnit              Int      @default(4) @map("max_vehicles_per_unit")
  visitorParkingMaxHours          Int      @default(12) @map("visitor_parking_max_hours")
  maxActiveVisitorParkingBookings Int      @default(3) @map("max_active_visitor_parking_bookings")
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("vehicle_settings")
}

/// The last number per kind (V-, P-, F-, R-), taken under its row lock.
model VehicleCounter {
  tenantId   String             @map("tenant_id") @db.Uuid
  kind       VehicleCounterKind
  lastNumber Int                @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, kind])
  @@map("vehicle_counters")
}

/// A unit's vehicle. Its unit, number and registrant never change; a
/// removal is final (trigger). One active permit per plate (unique).
model Vehicle {
  id                 String              @id @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  number             Int
  unitId             String              @map("unit_id") @db.Uuid
  registeredById     String              @map("registered_by_account_id") @db.Uuid
  plate              String
  /// Generated by the database from the plate (ADR 0045); never written.
  plateKey           String?             @map("plate_key")
  makeAndModel       String              @map("make_and_model")
  color              String
  type               VehicleType
  status             VehicleStatus       @default(pending)
  /// +1 on each plate edit; an approval names the version it saw.
  version            Int                 @default(1)
  stickerNumber      String?             @map("sticker_number")
  /// The last local day the permit is valid.
  permitValidUntil   DateTime?           @map("permit_valid_until") @db.Date
  rejectionReason    String?             @map("rejection_reason")
  licencePhotoFileId String?             @map("licence_photo_file_id") @db.Uuid
  decidedById        String?             @map("decided_by_account_id") @db.Uuid
  decidedAt          DateTime?           @map("decided_at") @db.Timestamptz(3)
  removedAt          DateTime?           @map("removed_at") @db.Timestamptz(3)
  removedById        String?             @map("removed_by_account_id") @db.Uuid
  removalSide        VehicleRemovalSide? @map("removal_side")
  removalReason      String?             @map("removal_reason")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  stickers  VehicleSticker[]
  reminders VehicleExpiryReminder[]

  @@unique([tenantId, id])
  @@unique([tenantId, number], map: "vehicles_number_key")
  @@index([tenantId, unitId, status], map: "vehicles_unit_idx")
  @@index([tenantId, status, createdAt, id], map: "vehicles_status_idx")
  @@map("vehicles")
}

/// A sticker issued to a vehicle: append-only, its number once per compound.
model VehicleSticker {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  vehicleId     String   @map("vehicle_id") @db.Uuid
  stickerNumber String   @map("sticker_number")
  issuedById    String   @map("issued_by_account_id") @db.Uuid
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, stickerNumber], map: "vehicle_stickers_number_key")
  @@unique([tenantId, vehicleId, stickerNumber], map: "vehicle_stickers_vehicle_number_key")
  @@map("vehicle_stickers")
}

/// A permit's expiring notice: once per vehicle and last day. Append-only.
model VehicleExpiryReminder {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  validUntil DateTime @map("valid_until") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, vehicleId, validUntil], map: "vehicle_expiry_reminders_once")
  @@map("vehicle_expiry_reminders")
}

